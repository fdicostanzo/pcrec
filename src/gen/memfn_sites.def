/* src/gen/memfn_sites.def — DELEG_SITES ([MEMFN] R4c; docs/design/memfn/
 * integration.md §8.5, §14.5): the search sites pcrec DELEGATES to the
 * memfn kit, one row per site, by SEMANTIC OPERATION and never by cost.
 * A site joins this table in its migration step's REPLACE commit and is
 * then rendered by the kit; tests/memfn/site_manifest.tsv carries the same
 * site as `delegated` (C17).
 *
 *   DELEG_SITE(id, op, handoffs, kinds, budget, use_ceiling, entry)
 *
 *   id           the site's name, the manifest's (PRE carries the manifest's
 *                SETREST row too: the set rest is one more predicate of the
 *                pre-check composite, §15.5). STAY, EDGE and VMSPAN ([MEMFN]
 *                R4h, M3) are the in-loop ADVANCE skips, built by
 *                pcrec_memfn_advance_site from a PcrecAdvance (memfn_sites.h).
 *                VMSTRIDE ([MEMFN] M6) is VMSPAN's strided sibling, the VM
 *                cursor rung's span scan at stride W > 1: one ADVANCE over
 *                W SET terms (MF_SITE_ABI 8), from the same builder; a
 *                row of its own so each stride class stays countable (Q-R10-6)
 *                MLINE ([MEMFN] M4) is the attempt engine's `(?m)^` skip, a
 *                FIND described by pcrec_emit_find (PcrecFind), as PF is.
 *                N7 ([MEMFN] M7) is the encoding seam's byte-wise span
 *                compare loop, a MISMATCH described by
 *                pcrec_memfn_span_site from the backend's site data
 *                (src/enc/enc.h PcrecEncSite, D58 addendum 2): budget 2,
 *                the compare runs at every VM backreference step (D91)
 *   op           the kit operation every instance has (MF_OP_*)
 *   handoffs     the handoffs an instance may take, as DELEG_H(MF_H_*) bits
 *   kinds        the term kinds an instance may use (MF_TK_*)
 *   budget       D91's budget: DELEG_SCAN (1) or DELEG_LOOP (2), the ONE
 *                source of MF_P_INLOOP (C10)
 *   use_ceiling  the most an instance's result may be ignored: MF_USE_DISCARD
 *                where an instance may only compare it with its miss value,
 *                MF_USE_POSITION where every instance reads it as a position.
 *                A CEILING, never the value: an instance's `use` is its own
 *                (req_use(cx) for PRE), checked per instance (§14.5 [rev4.6]).
 *                MF_USE_ENTRY (R17-b' B3b) is PRE's: the presence verdict's
 *                use, read as a position exactly where the site ASSIGNs
 *   entry        [MEMFN] R17-b' B3a (r17b_prime.md rev 3 §3.4's merge,
 *                Q-R17P-18): the presence verdict each instance takes as
 *                its ENTRY use, a closed DelegEntry. DELEG_ENTRY_PRE on the
 *                FIND rows a pre-check fronts (PF: the DFA body's forward
 *                scan, the DFA hat, the hybrid's inner prefilter and the VM
 *                hat; MLINE: ENG_ATTEMPT's seek), whose sites the PRE
 *                composite's verdict is merged into; DELEG_ENTRY_SELF on PRE
 *                itself, which stays the row of a PRESENCE-ONLY site (the
 *                no-DFA VM entry, the hybrid's `_search_run`, `attempt_entry`
 *                without MLINE), a FIND with no span 0; DELEG_ENTRY_NONE on
 *                every other row. DELEG_ENTRY_UNSTATED (0) is no statement
 *                and C10 refuses it. The ENTRY use's own vocabulary is the
 *                kit's MF_USE_ENTRY (MF_VOCAB 4, R17-b' B3b, Q-R17P-18):
 *                every PRE instance states it (its result the landmark's
 *                position under ASSIGN, else discarded), and the ALL_PRESENT
 *                renderers (precheck, precheck_assign, precheck_assign_byte)
 *                are that use's renderings (KW-7); every instance renders as
 *                before
 *
 * Checked by C10 (tests/memfn/run_deleg_sites.sh): the budget column against
 * D91's classification, every (op, handoff, kinds) against mf_vocab_has. */
DELEG_SITE(PRE, MF_OP_ALL_PRESENT, DELEG_H(MF_H_ON_MISS) | DELEG_H(MF_H_ASSIGN),
           MF_TK_SET | MF_TK_RUN, DELEG_SCAN, MF_USE_ENTRY, DELEG_ENTRY_SELF)
DELEG_SITE(OFS, MF_OP_FIND, DELEG_H(MF_H_RETURN),
           MF_TK_SET | MF_TK_RUN, DELEG_SCAN, MF_USE_POSITION, DELEG_ENTRY_NONE)
DELEG_SITE(VMRUN, MF_OP_VERIFY, DELEG_H(MF_H_BOOL),
           MF_TK_RUN, DELEG_LOOP, MF_USE_DISCARD, DELEG_ENTRY_NONE)
DELEG_SITE(PF, MF_OP_FIND, DELEG_H(MF_H_ASSIGN),
           MF_TK_SET, DELEG_SCAN, MF_USE_POSITION, DELEG_ENTRY_PRE)
DELEG_SITE(STAY, MF_OP_SKIP, DELEG_H(MF_H_ADVANCE),
           MF_TK_SET, DELEG_LOOP, MF_USE_POSITION, DELEG_ENTRY_NONE)
DELEG_SITE(EDGE, MF_OP_SKIP, DELEG_H(MF_H_ADVANCE),
           MF_TK_SET, DELEG_LOOP, MF_USE_POSITION, DELEG_ENTRY_NONE)
DELEG_SITE(VMSPAN, MF_OP_SKIP, DELEG_H(MF_H_ADVANCE),
           MF_TK_SET, DELEG_LOOP, MF_USE_POSITION, DELEG_ENTRY_NONE)
DELEG_SITE(VMSTRIDE, MF_OP_SKIP, DELEG_H(MF_H_ADVANCE),
           MF_TK_SET, DELEG_LOOP, MF_USE_POSITION, DELEG_ENTRY_NONE)
DELEG_SITE(MLINE, MF_OP_FIND, DELEG_H(MF_H_ASSIGN),
           MF_TK_SET, DELEG_SCAN, MF_USE_POSITION, DELEG_ENTRY_PRE)
DELEG_SITE(N7, MF_OP_MISMATCH, DELEG_H(MF_H_ON_DIFF),
           MF_TK_REF, DELEG_LOOP, MF_USE_POSITION, DELEG_ENTRY_NONE)
/* COVER ([KIT-VERIFY] U1 Z2; kit_proof.md §2.5): the `cover` LOCATE row's
 * REPORT description, a FIND / STMT / ASSIGN over span 0's k SET terms plus
 * its CONTEXT items (`mf_site.ctx`), built by `pcrec_cover_site`
 * (src/gen/known.c) and defined and used by `emit_cover` (emit_dfa.c). It is
 * the search entry's whole walk, once per call: budget 1. Routed only by the
 * harness lever at Z2 (`--harness=kit-proof`), so no shipped compile reaches
 * it before B1. */
DELEG_SITE(COVER, MF_OP_FIND, DELEG_H(MF_H_ASSIGN),
           MF_TK_SET, DELEG_SCAN, MF_USE_POSITION, DELEG_ENTRY_NONE)
