/* SPDX-License-Identifier: 0BSD
 * Provenance: original pcrec-memory-functions text; no third-party source
 *   (memfn/PROVENANCE.md).
 *
 * memfn/src/options.def — THE KIT'S OPTION REGISTRY (D147 addendum 9;
 * integration.md §R4.4.1). An X-macro in axes.def's and limits.def's idiom,
 * but the kit's own: pcrec's build never reads it and pcrec's sources never
 * include it. options.c includes it for the table behind mf_options() and
 * for the parser behind mf_opts_check(), so what `--list-axes`' `memfn`
 * section prints and what `--memfn=` accepts are one table.
 *
 * MF_OPT(name, kind, budget, layer, doc)
 *   name    kit-owned id, [a-z0-9-], arch-blind (C4)
 *   kind    MF_OPT_DENY | MF_OPT_PAIR    which --memfn= spellings it takes:
 *           `no-NAME` always; a bare `NAME` (force) only for MF_OPT_PAIR
 *   budget  MF_B_SCAN | MF_B_LOOP | MF_B_ANY       D91, as §8.5's INLOOP
 *   layer   MF_L_SCALAR | MF_L_SIMD      which acceptance reading owns it
 *           (§L.4); an MF_L_SIMD row is inert at -fno-memfn-simd
 *   doc     one line
 *
 * A kit change that moves an emitted byte adds its row HERE in the same
 * commit (D144 item 4): the row is that change's OFF arm, `--memfn=no-NAME`,
 * and the change raises the `memfn` section's floor in docs/spec/registry.md
 * §6. BORN EMPTY at R4a; the first rows are R4e' batch 1's SIMD rows
 * (request R-13, integration.md §R4.9.2.3 "The deny, per row"), one per
 * (form, width), Q-R9-7: each is its row's OFF arm at -fmemfn-simd, and is
 * accepted and inert at -fno-memfn-simd (the layer switch already declines
 * every SIMD row through `policy`). The first SCALAR row is R-15's
 * `precheck-assign-byte` (request R-15): live at both switch positions.
 */
MF_OPT("vrun-w32", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the 32-byte vector run scan (vrun-w16's form a level up; its short spans fall to "
       "vrun-w16 where both render); -fmemfn-simd only")
MF_OPT("vrun-w16", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the 16-byte vector run scan (a SIMD helper over a FUNC whose predicate is one run, "
       "sitting over the two-stream pair body); -fmemfn-simd only")
MF_OPT("vrun-kb", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the vector run scan's second filter position (the first position of pcrec's rarity "
       "ranking other than the scanned one); denied, the vrun rows filter on the scanned "
       "position alone; -fmemfn-simd only")
MF_OPT("vrun-trim", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the vector run scan's trimmed verify (each candidate's run compare skips the positions "
       "its filter already proved); denied, every candidate is verified over the whole run; "
       "-fmemfn-simd only")
MF_OPT("vrun-pad", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the vector run scan's padded verify (in the main block loop, a run of 3 or 5-7 bytes "
       "is compared as one wider masked word, the loop holding the bytes past the run it "
       "reads); denied, every candidate is verified by the run compare's words; "
       "-fmemfn-simd only")
MF_OPT("precheck-assign-byte", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the pre-check's kept one-byte landmark as one memchr (an ASSIGN pre-check whose kept "
       "position is its first byte's); denied, the generic row renders the site")
/* R17-b' B1 (lane fdb1; r17b_prime.md rev 3 §3.4 [rev3 B7, D8]): the finder
 * table's denies, one per built row the evaluator can score (regime_eval
 * §5.2). Each denies its fd_rows[] row through the shared walk (kit_walk's
 * `no-<opt>`). At B1 NO row is routed, so every one is ASSERT_ZERO: accepted,
 * and it moves no byte (its row decides nothing that renders). `fd-d1` flips
 * to DIFFER at B2 (its OFF arm is D1w, the walk), `fd-ndisp` stays
 * ASSERT_ZERO (no dispatch pays), `fd-r8` flips at B6. `fd-r0` and `fd-r5`
 * RETIRED at B4' with their rows (finder.c; finder_history.md). */
MF_OPT("fd-r8", MF_OPT_DENY, MF_B_ANY, MF_L_SIMD,
       "the finder table's row R8: a long one-shot call with a measured sparse gap takes the "
       "64-byte form; denied, the row is skipped (ASSERT_ZERO until it routes at B6)")
MF_OPT("fd-ndisp", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's N-dispatch rows R1 and R2: a one-shot call shorter than a crossover "
       "takes the shorter call's form behind a run-time dispatch; denied, no dispatch "
       "(ASSERT_ZERO until a dispatch pays, B4 or B8)")
MF_OPT("fd-d1", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's row D1: a one-member stop outside a VM attempt seek is searched by "
       "the C library; denied, the site takes D1w's table walk (ASSERT_ZERO until it routes "
       "at B2)")
/* R17-b' B3b (lane b3b; r17b_prime.md rev 3 §1.4, §3.4 [rev3 B7]): the PRES
 * slot's three denies, one per deniable row of the routed slot (P0 is
 * undeniable, D158; P9 is the total default). Each MOVES bytes (DIFFER): the
 * PRES rows are routed, so the deny reaches every pre-check its row decides.
 * `pres-set-lead` is pcrec's retired `-fno-req-set-lead` (bit 45, KW-11,
 * Q-WR-12), which lib/pcrec.h's PCREC_NO_REQ_SET_LEAD stays an alias of
 * (Q-R17P-19). */
MF_OPT("fd-pres-g1", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's PRES row P2 (G1, ported): a pre-check whose leading check the start "
       "search already proves is dropped; denied, the pre-check is kept (the pick decides it)")
MF_OPT("fd-pres-pick", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's PRES row P3 (the pick, ported): one necessary-set member, or the "
       "run's window, verified; denied, every member and the whole run are verified")
MF_OPT("pres-set-lead", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's PRES row P4 (set-leads, ported; pcrec's -fno-req-set-lead until "
       "B3b): a set member strictly rarer than the run's scan member is tested first; denied, "
       "the run pre-check alone")
