/* SPDX-License-Identifier: 0BSD
 * Provenance: original pcrec-memory-functions text; no third-party source
 *   (memfn/PROVENANCE.md).
 *
 * memfn/src/options.def — THE KIT'S OPTION REGISTRY (D147 addendum 9;
 * integration.md §R4.4.1). An X-macro in axes.def's and limits.def's idiom,
 * but the kit's own: pcrec's build never reads it and pcrec's sources never
 * include it. options.c includes it for the table behind mf_options() and
 * for the parser behind mf_opts_check(), so what `--list-axes`' `memfn`
 * section prints and what `--memfn=` accepts are one table.
 *
 * MF_OPT(name, kind, budget, layer, doc)
 *   name    kit-owned id, [a-z0-9-], arch-blind (C4)
 *   kind    MF_OPT_DENY | MF_OPT_PAIR    which --memfn= spellings it takes:
 *           `no-NAME` always; a bare `NAME` (force) only for MF_OPT_PAIR
 *   budget  MF_B_SCAN | MF_B_LOOP | MF_B_ANY       D91, as §8.5's INLOOP
 *   layer   MF_L_SCALAR | MF_L_SIMD      which acceptance reading owns it
 *           (§L.4); an MF_L_SIMD row is inert at -fno-memfn-simd
 *   doc     one line
 *
 * A kit change that moves an emitted byte adds its row HERE in the same
 * commit (D144 item 4): the row is that change's OFF arm, `--memfn=no-NAME`,
 * and the change raises the `memfn` section's floor in docs/spec/registry.md
 * §6. BORN EMPTY at R4a; the first rows are R4e' batch 1's SIMD rows
 * (request R-13, integration.md §R4.9.2.3 "The deny, per row"), one per
 * (form, width), Q-R9-7: each is its row's OFF arm at -fmemfn-simd, and is
 * accepted and inert at -fno-memfn-simd (the layer switch already declines
 * every SIMD row through `policy`). The first SCALAR row is R-15's
 * `precheck-assign-byte` (request R-15): live at both switch positions.
 */
MF_OPT("vrun-w32", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the 32-byte vector run scan (vrun-w16's form a level up; its short spans fall to "
       "vrun-w16 where both render); -fmemfn-simd only")
MF_OPT("vrun-w16", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the 16-byte vector run scan (a SIMD helper over a FUNC whose predicate is one run, "
       "sitting over the two-stream pair body); -fmemfn-simd only")
MF_OPT("vrun-kb", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the vector run scan's second filter position (the first position of pcrec's rarity "
       "ranking other than the scanned one); denied, the vrun rows filter on the scanned "
       "position alone; -fmemfn-simd only")
MF_OPT("vrun-trim", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the vector run scan's trimmed verify (each candidate's run compare skips the positions "
       "its filter already proved); denied, every candidate is verified over the whole run; "
       "-fmemfn-simd only")
MF_OPT("vrun-pad", MF_OPT_DENY, MF_B_SCAN, MF_L_SIMD,
       "the vector run scan's padded verify (in the main block loop, a run of 3 or 5-7 bytes "
       "is compared as one wider masked word, the loop holding the bytes past the run it "
       "reads); denied, every candidate is verified by the run compare's words; "
       "-fmemfn-simd only")
MF_OPT("precheck-assign-byte", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the pre-check's kept one-byte landmark as one memchr (an ASSIGN pre-check whose kept "
       "position is its first byte's); denied, the generic row renders the site")
/* R17-b' B1 (lane fdb1; r17b_prime.md rev 3 §3.4 [rev3 B7, D8]): the finder
 * table's denies, one per built row the evaluator can score (regime_eval
 * §5.2). Each denies its fd_rows[] row through the shared walk (kit_walk's
 * `no-<opt>`). `fd-d1` is the one left in this group and it MOVES bytes
 * (DIFFER, since B2: its OFF arm is D1w, the walk). `fd-r0` and `fd-r5`
 * RETIRED at B4' with their rows, `fd-r8` and `fd-ndisp` at span_pick 1f
 * with R8, R1 and R2 (finder.c; finder_history.md). */
MF_OPT("fd-d1", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's row D1: a one-member stop outside a VM attempt seek is searched by "
       "the C library; denied, the site takes D1w's table walk (a MOVING deny: it moves "
       "bytes at a one-byte search site)")
/* R17-b' B3b (lane b3b; r17b_prime.md rev 3 §1.4, §3.4 [rev3 B7]): the PRES
 * slot's three denies, one per deniable row of the routed slot (P0 is
 * undeniable, D158; P9 is the total default). Each MOVES bytes (DIFFER): the
 * PRES rows are routed, so the deny reaches every pre-check its row decides.
 * `pres-set-lead` is pcrec's retired `-fno-req-set-lead` (bit 45, KW-11,
 * Q-WR-12), which lib/pcrec.h's PCREC_NO_REQ_SET_LEAD stays an alias of
 * (Q-R17P-19). */
MF_OPT("fd-pres-g1", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's PRES row P2 (G1, ported): a pre-check whose leading check the start "
       "search already proves is dropped; denied, the pre-check is kept (the pick decides it)")
MF_OPT("fd-pres-pick", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's PRES row P3 (the pick, ported): one necessary-set member, or the "
       "run's window, verified; denied, every member and the whole run are verified")
MF_OPT("pres-set-lead", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the finder table's PRES row P4 (set-leads, ported; pcrec's -fno-req-set-lead until "
       "B3b): a set member strictly rarer than the run's scan member is tested first; denied, "
       "the run pre-check alone")
/* D172 S3 (window_site.md §5.2's deny rows): the window family's two
 * byte-moving rows, each its change's alpha OFF arm. `window-search` denies
 * Table E's E-find row: the family declines a REPORT site (the floor serves
 * none), mf_ask refuses it, and pcrec's `cover` declines, so the OFF arm is
 * the build before the window search was the default, exactly, not the
 * floor; any other site E-find renders falls to the floor. Its find is Table
 * B's pick (PAIR for any two bytes). `window-skip` denies T-FIND's D-hors
 * row (Table D's until span_pick 1e): the stop is found by the next row's
 * pick and the site resumes at c + 1. */
MF_OPT("window-search", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the window search: jump to the next byte of one window position's bytes (memchr for "
       "one byte, two memchr streams for any two, a byte walk for more; SIMD under "
       "-fmemfn-simd for a plain caseless literal), then test the rest of "
       "the window; denied, a fixed-width pattern takes the forward scan and any other "
       "window search a plain byte loop")
MF_OPT("window-skip", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "the window search's skip for a common byte set: read the window's last byte and skip "
       "by a table of where that byte can sit in a match; denied, the search finds its byte "
       "and steps one byte at a time")
/* R-38 Part D (part_d.md rev 4 §5.1 D2 [r1pd F6]; D174 name): the run
 * reply's verified extent may hold positions of three or more members, each
 * tested against its full set. Denied, EVERY stretch mode is clipped to the
 * maximal stretch of positions the kit finds (one member or a two-member
 * cube) holding the scan: the identity on every run stated before Part D, so
 * its emit_sweep cells are ASSERT_ZERO until pcrec's [RUN-POS-SET] stage 3
 * states such runs. Read through kit_run_opts_of (every reader of the
 * decision on the site). A scan-less REQUIRED run is not clipped (nothing to
 * clip around; K66's proof is undeniable, D158). */
MF_OPT("run-verify-wide", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "verify wide run positions: the run pre-check also tests the run's positions of three or "
       "more bytes, each against its whole byte set; denied, it tests only the stretch of "
       "one- and two-byte positions around the position it searches for")
/* R-45 (r45_reply rev 6 §3 "The option"; plan A, the owner's forms-now
 * ruling 2026-11-16): THE SPAN FORMS, the kit's FIRST pair row. Unset: the
 * default H(h*) (window.c WF_SPAN_HEAD, the inline head); `span-loop`
 * FORCES L (h = 0: every one-class repeat of two or more positions at a
 * non-negative offset is a loop), the answer-identity sweep's force arm;
 * `no-span-loop` forces I, today's all-inline text, pcrec's G1 deny (an
 * escape hatch, not the dial's always-inline option). The deny wins when
 * both are given (kit_opt_state). Dense near-miss subjects are the cover's
 * known slow regime in every form (r45_reply §4). */
MF_OPT("span-loop", MF_OPT_PAIR, MF_B_ANY, MF_L_SCALAR,
       "long window spans test a run of one byte set in a loop after an inline head; forced, "
       "every such run of two or more positions loops; denied, every position is tested "
       "inline (the text before the loop forms)")
/* R-47 (block_span.md rev 4.1 §7, unit U2; D201 add. 2 and add. 4, option
 * A): THE VECTOR SPAN. A window search's one-class stretch that the span
 * form table's V rows take (finder row D-hors with 16 to 1000 positions, or
 * R7w with 24 to 64, its positions tested by the kit's own set test) is
 * tested by a call of a selector function at EVERY layer: at -fno-memfn-simd
 * (and a target with no 32-byte vectors) its one body is the stretch's
 * inline text; at a target admitting w32 (unit U3) the selector calls the
 * block helper. Layer `scalar` on purpose: the deny is LIVE at both
 * settings (`wrap-deny`), un-wrapping the stretch too, so
 * `--memfn=no-span-vector` restores the bytes of the build before the
 * vector span at every layer and target, the wrapper's escape hatch and its
 * control. */
MF_OPT("span-vector", MF_OPT_DENY, MF_B_ANY, MF_L_SCALAR,
       "long window spans of one byte set are tested by a call of a function, at every setting: "
       "its one body is the inline test, or, where the SIMD layer admits a 32-byte level, a "
       "block test of 32 (under 32 positions, 16) bytes per step; denied, the span is "
       "tested inline as before, at every setting")
