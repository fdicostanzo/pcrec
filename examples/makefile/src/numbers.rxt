# examples/makefile — a MULTI-TARGET .rxt source: two independent pattern
# blocks, two built artifacts, one file. Building this alongside
# greeting.rxt (as the Makefile does, `pcrec -o gen/ src/*.rxt`) is what
# exercises pooling several .rxt FILES into one `-o DIR` invocation
# ([REL-1.10]/D118): three targets total, across two files, one `pcrec`
# call.
target digits = digits_def
target money = money_def

pattern [0-9]+
name digits_def

pattern \$[0-9]+(\.[0-9]{2})?
name money_def
