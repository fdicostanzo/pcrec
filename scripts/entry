#!/usr/bin/env -S python3 -I
"""scripts/entry -- the levelled accessor for tracker files ([DOC-INDEX], D192; docs/dev/doc_format.md).

    scripts/entry KEY [-l N] [--rev SHA]     one item; default level 2
    scripts/entry -g REGEX [-in N] [-l N] [-p PROFILE] [-s SECTION] [--state S] [--rev SHA]
                                             item grep: match each item at level -in (default 0), print it whole
                                             at level -l (default 0). The archive is read only with -p completed.
                                             Hits come best first (doc_profiles.RELEVANCE: ID/slug, statement,
                                             {keywords}, working fields, body; then more matches, then newer), at most
                                             15 per call: `entry: N hits; showing 1-15; next: --page 2`. --page K
                                             continues; --all lifts the cap. Over 15 hits -l 1/-l 2 is refused (rc 2).
    scripts/entry --work [-p PROFILE] [-s SECTION] [-k WORD]
                                             plan: every ready, started, blocked, not-started row (in that order), then ongoing, at level 1
    scripts/entry --levels [-p PROFILE]      the level and work-view rows of the profile table
    scripts/entry --over-cap                 soft-cap line for scripts/gestalt (docs/dev/doc_format.md)
    scripts/entry --lint-scripts             scripts/INDEX.md covers every script, every line names a file (make test-doc-lint)
    scripts/entry --selftest                 planted fixtures: one per routing row, dormant, over-cap, --rev
    Levels: 0 the index line(s); 1 + the working fields; 2 + the full entry (a script: its header comment).
    Profiles (-p): plan, completed (the archive), decisions, known, upstream (dormant until their unit), scripts.
    Examples:  entry D26 | entry D26 -l 0 | entry D47.a2 | entry LANECHECK -l 1 | entry boxqueue | entry hooks/pre-push
               entry -g kill -p scripts | entry -g 'trigger.*gate' -in 2 | entry --work -s backlog
    Output ends `entry: <n> items (profile <p>, level <l>)`; exit 0 found, 1 none, 2 ambiguous.

The profile table is scripts/doc_profiles.py; the plan grammar is scripts/plan_lint.py's (imported, never a
second parser). Read-only; the root is the repository this script lives in, so the cwd does not matter.
"""
import io
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)  # -I drops the script directory; emit_sweep.py does the same
import doc_profiles  # noqa: E402
import plan_lint  # noqa: E402

ROOT = os.path.dirname(HERE)
ARCH_HEAD = re.compile(r"^( *)- \[([^\]\n]+)\] STATE:(\S+)")  # the archive's states vary (completed, done, ...)
L1_PLAN = ("next", "trigger", "status", "refs", "now", "ready", "waits", "why", "review")
ALIAS = re.compile(
    r"^(D[0-9]+) (?:add\.|addendum|ADDENDUM|Addendum)(?: (.+))?$"
    r"|^(D[0-9]+) (first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth) (?:add\.|addendum|ADDENDUM)$")
ORDINALS = {n: str(i) for i, n in enumerate("first second third fourth fifth sixth seventh eighth ninth tenth".split(), 1)}
ADDENDUM_N = doc_profiles.ADDENDUM_N
EXIT_NONE, EXIT_AMBIG = 1, 2


class Source:
    """Reads tracker files from the working tree, or from a commit (--rev, read-only `git show`)."""

    def __init__(self, root, rev=None):
        self.root, self.rev = root, rev

    def read(self, path):
        if self.rev is None:
            try:
                with open(os.path.join(self.root, path), encoding="utf-8") as fh:
                    return fh.read()
            except OSError:
                return None
        r = subprocess.run(["git", "-C", self.root, "show", "%s:%s" % (self.rev, path)],
                           capture_output=True, text=True, encoding="utf-8")
        return r.stdout if r.returncode == 0 else None

    def size(self, path):
        t = self.read(path)
        return None if t is None else len(t.encode("utf-8"))


class Item:
    def __init__(self, profile, id_, head, section=None, state=None, indent=0):
        self.profile, self.id, self.head, self.section, self.state, self.indent = profile, id_, head, section, state, indent
        self.own, self.children, self.slug, self.index_line = [], [], None, head

    def attr_lines(self, keys=None):
        out = []
        for s in self.own:
            m = plan_lint.ATTR.match(s.strip())
            if m and (keys is None or m.group(1).split(" ")[0] in keys):
                out.append(s)
        return out

    def owner_wait(self):
        """The plain-words question of a `waits: owner — ...` field, else None (the work view's first section)."""
        for s in self.own:
            m = plan_lint.ATTR.match(s.strip())
            if m and m.group(1) == "waits" and m.group(3).startswith(OWNER_WAIT):
                return m.group(3)[len(OWNER_WAIT):]
        return None

    def text(self, level):
        """The item rendered at LEVEL (a list of lines)."""
        form = self.profile["form"]
        if form == "archive":
            head = self.head if len(self.head) <= 160 else self.head[:160] + "…"
            if level == 0:
                return [head]
            if level == 1:
                return [head] + self.attr_lines()
            return [self.head] + self.own
        if form == "pair":
            return pair_text(self, level)
        if form == "list":
            return [self.head] + (["    " + ln if ln else "" for ln in self.header()] if level >= 2 else [])
        kids = [c.head for c in self.children]
        if level == 0:
            return [self.head] + kids
        if level == 1:
            return [self.head] + self.attr_lines(L1_PLAN) + kids
        return [self.head] + self.own + kids


# ---------------------------------------------------------------- the single (plan) and archive forms

def parse_single(text, profile):
    """Plan: rows in the five item sections (Policy is not one). Archive: every `- [TAG] STATE:` line, any indent;
    other `- [TAG]` lines are body text of the row above."""
    archive = profile["form"] == "archive"
    items, stack, cur, section = [], [], None, None
    for raw in text.split("\n"):
        if raw.startswith("## "):
            section, cur, stack = raw[3:].strip(), None, []
            continue
        if not archive and (section is None or section == "Policy" or section not in plan_lint.SECTIONS):
            continue
        if archive:
            m = ARCH_HEAD.match(raw)
            mo = (m.group(1), m.group(2), m.group(3)) if m else None
        else:
            m = plan_lint.HEAD_OK.match(raw)
            mo = (m.group(1), m.group(2), m.group(3)) if m else None
        if mo:
            it = Item(profile, mo[1], raw, section, mo[2], len(mo[0]))
            while stack and stack[-1].indent >= it.indent:
                stack.pop()
            if stack and not archive:
                stack[-1].children.append(it)
            stack.append(it)
            items.append(it)
            cur = it
            continue
        if cur is None:
            continue
        if archive:
            cur.own.append(raw)
        elif raw.strip() == "" or plan_lint.HEAD.match(raw):
            cur = None  # a blank line (or a malformed head) ends a plan row
        else:
            cur.own.append(raw)
    if archive:
        for it in items:
            while it.own and it.own[-1].strip() == "":
                it.own.pop()
    return items


# ---------------------------------------------------------------- the list form (scripts/INDEX.md)

LIST_LINE = re.compile(r"^- (\S+) (\S+) — (.*)$")
LIST_SHAPE = re.compile(r"^when: .+?; does: .+\. \{[^{}]+\}$")


def header_block(text):
    """The file's own header comment (a list of lines): a `#` run, a leading docstring or a leading /* */ block,
    after an optional shebang. [] when there is none."""
    lines = text.split("\n")
    i = 1 if lines and lines[0].startswith("#!") else 0
    if i >= len(lines):
        return []
    first = lines[i].lstrip()
    for opener, closer in (('"""', '"""'), ("/*", "*/")):
        if first.startswith(opener):
            out = []
            for ln in lines[i:]:
                out.append(ln)
                if closer in (ln.lstrip()[len(opener):] if len(out) == 1 else ln):
                    break
            return out
    out = []
    while i < len(lines) and lines[i].startswith("#"):
        out.append(lines[i])
        i += 1
    return out


def list_index(text, profile, src):
    out = []
    for raw in text.split("\n"):
        m = LIST_LINE.match(raw)
        if m and re.fullmatch(profile["id"], m.group(1)):
            it = Item(profile, m.group(1), raw, state=m.group(2))
            it.header = (lambda path: lambda: header_block(src.read(path) or ""))(
                os.path.join(os.path.dirname(profile["index"]), m.group(1)))
            out.append(it)
    return out


def list_lookup(items, key):
    """An exact name (with or without the `scripts/` prefix), else a unique extension-less stem."""
    k = key[len("scripts/"):] if key.startswith("scripts/") else key
    hit = [i for i in items if i.id == k]
    if hit:
        return hit
    return [i for i in items if i.id.rsplit(".", 1)[0] == k] if "." not in k else []


def lint_scripts(root, profile, out, src=None):
    """Failures (a list of lines) of the scripts index against the tree under ROOT."""
    src = src or Source(root)
    d = os.path.dirname(profile["index"])
    text = src.read(profile["index"])
    if text is None:
        return ["%s: cannot read" % profile["index"]]
    exempt = [re.compile(x) for x in profile.get("exempt", ())]
    bad, names, lines = [], {}, 0
    for n, raw in enumerate(text.split("\n"), 1):
        if not raw.startswith("- "):
            continue
        m = LIST_LINE.match(raw)
        if not m or not re.fullmatch(profile["id"], m.group(1)):
            bad.append("%s:%d: not an index line `- NAME STATE — when: ...; does: .... {keywords}`: %s" % (profile["index"], n, raw[:80]))
            continue
        lines += 1
        name, state, rest = m.groups()
        if name in names:
            bad.append("%s:%d: %s listed twice (first at line %d)" % (profile["index"], n, name, names[name]))
        names[name] = n
        if state not in profile["states"]:
            bad.append("%s:%d: %s has state %r (want one of %s)" % (profile["index"], n, name, state, "/".join(profile["states"])))
        if not LIST_SHAPE.match(rest):
            bad.append("%s:%d: %s: after the dash want `when: <situation>; does: <what>. {keywords}`" % (profile["index"], n, name))
        path = os.path.join(root, d, name)
        if state != "retired":
            if not os.path.isfile(path):
                bad.append("%s:%d: %s names no file %s/%s" % (profile["index"], n, name, d, name))
            elif not [ln for ln in header_block(src.read(os.path.join(d, name)) or "") if ln.strip("#/* \t\"")]:
                bad.append("%s/%s: live script has no header comment" % (d, name))
    top = os.path.join(root, d)
    for dp, dns, fns in os.walk(top):
        dns[:] = sorted(x for x in dns if x != "__pycache__")
        for fn in sorted(fns):
            rel = os.path.relpath(os.path.join(dp, fn), top)
            if any(x.fullmatch(rel) for x in exempt) or fn.endswith(".pyc"):
                continue
            if rel not in names:
                bad.append("%s/%s has no line in %s" % (d, rel, profile["index"]))
    out.append(lines)
    return bad


# ---------------------------------------------------------------- the pair form

def pair_index(text, profile):
    """Index lines `- ID slug state[ aK] — statement` -> Items."""
    rx = re.compile(r"^- (%s) (\S+) (\S+?)(?: a(\d+))? — (.*)$" % profile["id"])
    out = []
    for raw in text.split("\n"):
        m = rx.match(raw)
        if m:
            it = Item(profile, m.group(1), raw, state=m.group(3))
            it.slug = m.group(2)
            out.append(it)
    return out


def pair_entries(text):
    """details text -> {id: [lines]} cut at `## ` headings (an entry runs to the next `## `)."""
    ents, cur = {}, None
    for raw in text.split("\n"):
        if raw.startswith("## "):
            m = re.match(r"^## (\S+)", raw)
            cur = m.group(1) if m else None
            if cur is not None:
                ents.setdefault(cur, [])
        if cur is not None:
            ents[cur].append(raw)
    for lines in ents.values():
        while lines and lines[-1].strip() == "":
            lines.pop()
    return ents


def later_cites(it, ents):
    """`later: D49* D58`: entries (other than IT) that mention IT's id; `*` = a line with a supersede/amend verb."""
    verb = re.compile(r"supersed|amend|replac|revers|overrid|retir|struck|settl|re-open|withdraw", re.I)
    mention = re.compile(r"\b%s\b" % re.escape(it.id))
    out = []
    for oid, lines in ents.items():
        if oid == it.id:
            continue
        hit = [ln for ln in lines if mention.search(ln)]
        if hit:
            out.append(oid + ("*" if any(verb.search(ln) for ln in hit) else ""))
    return out


def pair_text(it, level):
    ents = it.details_entries
    body = ents.get(it.id, [])
    if level == 0:
        return [it.index_line]
    if level == 2:
        return [it.index_line] + body
    out = [it.index_line]
    for ln in body:
        if ln.startswith("### ") or re.match(r"^r[0-9]+\*? ", ln):
            out.append(ln)
    later = later_cites(it, ents)
    if later:
        out.append("later: " + " ".join(later))
    return out


def addendum_block(it, n):
    """The `### ID.aN` block of IT's details entry (heading to the next heading), or None."""
    body = it.details_entries.get(it.id, [])
    start = None
    for i, ln in enumerate(body):
        if re.match(r"^### %s\.a%s( |$)" % (re.escape(it.id), re.escape(n)), ln):
            start = i
        elif start is not None and (ln.startswith("### ") or ln.startswith("## ")):
            return body[start:i]
    return body[start:] if start is not None else None


def addendum_rows(it):
    """[(N, date, lines)] of the `### ID.aN` blocks of IT's entry, with each (was: "...") label."""
    body = it.details_entries.get(it.id, [])
    rows, i = [], 0
    while i < len(body):
        m = re.match(r"^### %s\.a(%s) — (\S+?)[,:]" % (re.escape(it.id), ADDENDUM_N), body[i])
        if m:
            j = i + 1
            while j < len(body) and not body[j].startswith("### "):
                j += 1
            rows.append((m.group(1), m.group(2), body[i:j]))
            i = j
        else:
            i += 1
    return rows


# ---------------------------------------------------------------- loading and routing

class Ctx:
    def __init__(self, root, profiles, rev=None):
        self.root, self.profiles, self.src = root, profiles, Source(root, rev)
        self._cache = {}

    def items(self, p):
        """All Items of profile P (None = unreadable)."""
        if p["name"] in self._cache:
            return self._cache[p["name"]]
        text = self.src.read(p["index"])
        if text is None:
            res = None
        elif p["form"] in ("single", "archive"):
            res = parse_single(text, p)
        elif p["form"] == "list":
            res = list_index(text, p, self.src)
        else:
            res = pair_index(text, p)
            dt = self.src.read(p["details"]) if p["details"] else None
            ents = pair_entries(dt or "")
            for it in res:
                it.details_entries = ents
        self._cache[p["name"]] = res
        return res

    def live(self):
        return [p for p in self.profiles if p["form"] not in ("dormant",)]


class Result:
    def __init__(self, items=None, rc=0, note=None, level=None):
        self.items, self.rc, self.note, self.level = items or [], rc, note, level


def dormant_result(p, note=None):
    return Result(rc=EXIT_NONE, note="entry: profile %s dormant (%s)" % (p["name"], p["dormant"]))


def lookup(ctx, p, key):
    its = ctx.items(p)
    if its is None:
        return None
    return [i for i in its if i.id == key]


def route(ctx, key):
    """The routing table (design §2.3), first match wins."""
    k = key.strip()
    # 1 alias spellings
    m = ALIAS.match(k)
    if m:
        ap = [p for p in ctx.profiles if p.get("aliases")]
        if ap:
            p = ap[0]
            if p["form"] == "dormant":
                return dormant_result(p)
            return resolve_alias(ctx, p, m, k)
    # 2 a profile id, in full
    for p in ctx.profiles:
        if p["id"] and p["form"] != "list" and re.fullmatch(p["id"], k):
            if p["form"] == "dormant":
                return dormant_result(p)
            r = lookup(ctx, p, k)
            return Result(r or [], 0 if r else EXIT_NONE, None if r else "entry: %s not found in profile %s" % (k, p["name"]))
    # 3 a ruling number D47.6
    m = re.fullmatch(r"(D[0-9]+)\.([0-9]+)", k)
    if m:
        p = next((p for p in ctx.profiles if p["id"] and p["form"] != "list" and re.fullmatch(p["id"], m.group(1))), None)
        if p is not None:
            if p["form"] == "dormant":
                return dormant_result(p)
            r = lookup(ctx, p, m.group(1))
            return Result(r or [], 0 if r else EXIT_NONE, "ruling %s is in the body" % m.group(2) if r else None, level=2)
    # 4 an exact [TAG]: plan wins; the archive only on absence
    tag = k[1:-1] if k.startswith("[") and k.endswith("]") else k
    plan = [p for p in ctx.profiles if p["form"] == "single"]
    arch = [p for p in ctx.profiles if p["form"] == "archive"]
    for group in (plan, arch):
        hits = []
        for p in group:
            hits += lookup(ctx, p, tag) or []
        if hits:
            return Result(hits, EXIT_AMBIG if len(hits) > 1 else 0,
                          "%d archive rows for [%s]" % (len(hits), tag) if len(hits) > 1 else None)
    # 5 a decisions addendum Dn.aN
    m = re.fullmatch(r"(D[0-9]+)\.a(%s)" % ADDENDUM_N, k)
    if m:
        p = next((p for p in ctx.profiles if p["id"] and p["form"] != "list" and re.fullmatch(p["id"], m.group(1))), None)
        if p is not None:
            if p["form"] == "dormant":
                return dormant_result(p)
            r = lookup(ctx, p, m.group(1))
            blk = addendum_block(r[0], m.group(2)) if r else None
            if blk is None:
                return Result(rc=EXIT_NONE, note="entry: %s not found in profile %s" % (k, p["name"]))
            it = Item(p, k, "\n".join(blk))
            it.fixed = blk
            return Result([it])
    # 6 a lower-case kebab slug: every live pair profile's index
    if re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", k):
        hits = []
        for p in ctx.profiles:
            if p["form"] == "pair":
                hits += [i for i in (ctx.items(p) or []) if i.slug == k]
        if hits:
            return Result(hits, EXIT_AMBIG if len(hits) > 1 else 0,
                          "slug %s names %s" % (k, ", ".join(i.id for i in hits)) if len(hits) > 1 else None)
    # 6b a script name (`boxqueue`, `plan_lint.py`, `hooks/pre-push`): every live list profile's index
    hits = []
    for p in ctx.profiles:
        if p["form"] == "list":
            hits += list_lookup(ctx.items(p) or [], k)
    if hits:
        return Result(hits, EXIT_AMBIG if len(hits) > 1 else 0,
                      "name %s is ambiguous: %s" % (k, ", ".join(i.id for i in hits)) if len(hits) > 1 else None)
    # 7
    return Result(rc=EXIT_NONE, note="entry: no item for %r" % key)


def resolve_alias(ctx, p, m, key):
    did = m.group(1) or m.group(3)
    r = lookup(ctx, p, did)
    if not r:
        return Result(rc=EXIT_NONE, note="entry: %s not found in profile %s" % (did, p["name"]))
    rows = addendum_rows(r[0])
    tail = m.group(2) if m.group(1) else ORDINALS[m.group(4)]
    pick = []
    if tail is None:  # an unnumbered alias: every addendum whose old label carries no number
        pick = [x for x in rows if not any(re.search(r'\(was: "[^"]*[0-9]', ln) for ln in x[2])]
    elif re.fullmatch(r"\d{4}-\d{2}-\d{2}", tail):
        pick = [x for x in rows if x[1] == tail]
    else:
        lab = re.compile(r'\(was: "[^"]*(?:add\.|addendum|ADDENDUM)\s*%s\b' % re.escape(tail))
        pick = [x for x in rows if x[0] == tail or any(lab.search(ln) for ln in x[2])]
    if not pick:
        return Result(rc=EXIT_NONE, note="entry: no addendum matches %r" % key)
    out = []
    for n, _, blk in pick:
        it = Item(p, "%s.a%s" % (did, n), "\n".join(blk))
        it.fixed = blk
        out.append(it)
    return Result(out)


# ---------------------------------------------------------------- output

def render(items, level):
    out = []
    for i, it in enumerate(items):
        if i and level >= 1:
            out.append("")
        out += getattr(it, "fixed", None) or it.text(level)
    return out


def trailer(items, level, name=None):
    names = sorted({i.profile["name"] for i in items})
    return "entry: %d items (profile %s, level %d)" % (len(items), name or ",".join(names) or "-", level)


def emit(out, lines, items, level, name=None):
    for ln in lines:
        out.write(ln + "\n")
    out.write(trailer(items, level, name) + "\n")


def kb(b):
    t = b * 10 // 1024
    return "%d.%d" % (t // 10, t % 10)


def over_cap(ctx, out):
    """The gestalt `docs` line: pair-form indexes over their FILE cap (KB = 1024 B, one decimal, truncated)."""
    n, over = 0, []
    for p in ctx.profiles:
        if p["form"] != "pair" or not p["caps"] or not p["caps"][2]:
            continue
        size = ctx.src.size(p["index"])
        if size is None:
            out.write("entry: cannot read %s\n" % p["index"])
            return 1
        n += 1
        cap = p["caps"][2]
        if size > cap:
            over.append("%s %s KB over soft cap %s KB (+%s KB, %d%%)" % (
                os.path.basename(p["index"]), kb(size), kb(cap).replace(".0", ""), kb(size - cap), 100 * size // cap))
    if over:
        out.write("docs: " + "; ".join(over) + "\n")
    out.write("entry: over-cap checked %d pair %s, %d over\n" % (n, "index" if n == 1 else "indexes", len(over)))
    return 0


def lint_cmd(ctx, out):
    p = next((p for p in ctx.profiles if p["form"] == "list"), None)
    if p is None:
        out.write("entry: no list profile\n")
        return 1
    cnt = []
    bad = lint_scripts(ctx.root, p, cnt)
    for b in bad:
        out.write("FAIL: " + b + "\n")
    out.write("entry: lint %s: %d index lines, %d failures\n" % (p["index"], cnt[0] if cnt else 0, len(bad)))
    return 1 if bad else 0


def sel_profiles(ctx, name):
    if name:
        ps = [p for p in ctx.profiles if p["name"] == name]
        return ps
    return [p for p in ctx.profiles if p["form"] in ("single", "pair")]


def levels_table(ctx, name, out):
    for p in ctx.profiles:
        if name and p["name"] != name:
            continue
        out.write("%s [%s%s]: level 0 = the index line(s); level 1 = + %s; level 2 = + the full entry; work view: %s\n" % (
            p["name"], p["form"], " until " + p["dormant"] if p["form"] == "dormant" else "", p["level1"] or "-", p["work"]))
    return 0


def run(argv, out, root=ROOT, profiles=None):
    profiles = profiles or doc_profiles.PROFILES
    a = parse_args(argv)
    if a is None:
        out.write(__doc__)
        return 1
    ctx = Ctx(root, profiles, a["rev"])
    if a["levels"]:
        return levels_table(ctx, a["p"], out)
    if a["over_cap"]:
        return over_cap(ctx, out)
    if a["lint_scripts"]:
        return lint_cmd(ctx, out)
    if a["work"] or a["g"] is not None:
        return list_items(ctx, a, out)
    if not a["key"]:
        out.write(__doc__)
        return 1
    res = route(ctx, a["key"])
    level = a["l"] if a["l"] is not None else (res.level or 2)
    if res.note and not res.items:
        out.write(res.note + "\n")
        return res.rc
    lines = render(res.items, level)
    if res.note:
        lines.append("entry: " + res.note if not res.note.startswith("entry:") else res.note)
    emit(out, lines, res.items, level)
    return res.rc if res.items else EXIT_NONE


WORK_ORDER = ("ready", "started", "blocked", "not-started", "ongoing")
OWNER_WAIT = "owner — "      # a row waiting on the owner (Frank 2026-11-10): listed first, in its own section
OWNER_SECTION = "waiting on the owner"


def list_items(ctx, a, out):
    ps = sel_profiles(ctx, a["p"])
    if not ps:
        out.write("entry: no such profile %r\n" % a["p"])
        return 1
    rx = re.compile(a["g"]) if a["g"] is not None else None
    hits, level = [], (a["l"] if a["l"] is not None else (1 if a["work"] else 0))
    for p in ps:
        if p["form"] == "dormant":
            out.write("entry: profile %s dormant (%s)\n" % (p["name"], p["dormant"]))
            if a["p"]:
                return 1
            continue
        its = ctx.items(p)
        if its is None:
            out.write("entry: cannot read %s\n" % p["index"])
            return 1
        for it in its:
            if a["s"] and a["s"].lower() not in (it.section or "").lower():
                continue
            if a["state"] and it.state != a["state"]:
                continue
            if a["work"] and (p["form"] != "single" or it.state not in WORK_ORDER):
                continue
            blob = "\n".join(it.text(a["in"] if a["in"] is not None else 0))
            if rx is not None and not rx.search(blob):
                continue
            if a["k"] and a["k"].lower() not in "\n".join(it.text(1)).lower():
                continue
            hits.append(it)
    def work_group(it):
        return OWNER_SECTION if it.owner_wait() is not None else it.state
    if a["work"]:  # owner-waits first, then ready (Frank 2026-11-10: a ready stage outranks not-started work), ongoing last
        hits.sort(key=lambda it: -1 if work_group(it) == OWNER_SECTION else WORK_ORDER.index(it.state))

    n = len(hits)
    ranked = a["g"] is not None and not a["work"]
    if ranked:
        hits = rank_hits(hits, rx)
    size = doc_profiles.PAGE_SIZE
    note = None
    if ranked and n > size and not a["all"]:
        if level >= 1:
            out.write("entry: %d hits; -l %d refused above %d hits: narrow the regex, add -p/-s/--state, "
                      "or name one ID (--all overrides)\n" % (n, level, size))
            emit(out, [], hits, level, a["p"])
            return 2
        pages = (n + size - 1) // size
        pg = a["page"] or 1
        if pg < 1 or pg > pages:
            out.write("entry: %d hits; no page %d (pages 1-%d)\n" % (n, pg, pages))
            return 1
        lo = (pg - 1) * size
        hits = hits[lo:lo + size]
        note = "entry: %d hits; showing %d-%d" % (n, lo + 1, lo + len(hits))
        if pg < pages:
            note += "; next: --page %d" % (pg + 1)
    lines, sect = [], object()
    for i, it in enumerate(hits):
        if a["work"] and work_group(it) != sect:
            sect = work_group(it)
            lines.append("## " + str(sect))
        elif i and level >= 1:
            lines.append("")
        lines += it.text(level)
    if note:
        lines = [ln if len(ln) <= LINE_CLIP else ln[:LINE_CLIP] + "…" for ln in lines]  # a page stays small; KEY has the whole
        lines.append(note)
        out.write("".join(ln + "\n" for ln in lines))
        out.write("entry: %d items (profile %s, level %d)\n" % (n, a["p"] or ",".join(sorted({p["name"] for p in ps if p["form"] != "dormant"})), level))
        return 0
    emit(out, lines, hits, level, a["p"])
    return 0 if hits else EXIT_NONE


# -g relevance: the table is doc_profiles.RELEVANCE; each row's field is cut from the item here.
LINE_CLIP = 200
KEYWORDS = re.compile(r"\{[^{}]*\}\s*$")


def fields(it):
    head = it.index_line
    kw = KEYWORDS.search(head)
    l0, l1, l2 = it.text(0), it.text(1), it.text(2)
    return {
        "id": "\n".join(x for x in (it.id, it.slug) if x),
        "statement": head[:kw.start()] if kw else head,
        "keywords": kw.group(0) if kw else "",
        "working": "\n".join(l1[len(l0):]),
        "body": "\n".join(l2[len(l1):]),
    }


def rank_hits(hits, rx):
    """Order HITS by doc_profiles.RELEVANCE (first matching row), then more matches, then newer (higher numeric
    id, else later in the file) first. Stable for equal keys."""
    keyed = []
    for pos, it in enumerate(hits):
        f = fields(it)
        rank = next((r for r, (name, _) in enumerate(doc_profiles.RELEVANCE) if rx.search(f[name])), len(doc_profiles.RELEVANCE))
        count = len(rx.findall("\n".join(it.text(2))))
        m = re.fullmatch(r"[DKU]([0-9]+)", it.id)
        newer = int(m.group(1)) if m else -1  # D/K/U ids number by age; any other id: later in the file is newer
        keyed.append((rank, -count, -newer, -pos, it))
    keyed.sort(key=lambda k: k[:4])
    return [k[4] for k in keyed]


def parse_args(argv):
    a = dict(key=None, l=None, rev=None, g=None, **{"in": None}, p=None, s=None, state=None, k=None,
             work=False, all=False, page=None, levels=False, over_cap=False, lint_scripts=False)
    flags = {"-l": ("l", int), "--rev": ("rev", str), "-g": ("g", str), "-in": ("in", int), "-p": ("p", str),
             "-s": ("s", str), "--state": ("state", str), "-k": ("k", str), "--page": ("page", int)}
    i = 0
    while i < len(argv):
        t = argv[i]
        if t in flags:
            if i + 1 >= len(argv):
                return None
            name, conv = flags[t]
            try:
                a[name] = conv(argv[i + 1])
            except ValueError:
                return None
            i += 2
            continue
        if t == "--work":
            a["work"] = True
        elif t == "--all":
            a["all"] = True
        elif t == "--levels":
            a["levels"] = True
        elif t == "--over-cap":
            a["over_cap"] = True
        elif t == "--lint-scripts":
            a["lint_scripts"] = True
        elif t.startswith("-") and len(t) > 1:
            return None
        elif a["key"] is None:
            a["key"] = t
        else:
            return None
        i += 1
    return a


