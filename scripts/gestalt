#!/usr/bin/env bash
# gestalt -- one-shot, read-only status of the box and its sessions, for the manager heartbeats.
#   scripts/gestalt [--owner main|kit] [--all]
# DEFAULT OUTPUT = only the lines whose THRESHOLD ROW holds (the table "ROWS" near the end; Frank 2026-11-10:
# "only output items that pass threshold so that you're not considering noise"). When none holds it prints
# NOTHING (not even the DONE line); exit 0 either way. `--all` prints every NON-EMPTY line (a row whose line is empty prints nothing), then the DONE line.
# Threshold rows: load (load1 > nproc), session (a registered role with no live session), disk (a filesystem
# >= 85%), context (a registered manager > 70% of its compaction point), ci (latest main run not success, or
# gh unavailable; a cancelled-latest prints as completed/cancelled), queue (box idle while a ready job waits),
# idle-held (a hand `boxlock run` holder alive while load1 stayed < 1.5 across two readings >= 60 s apart),
# docs (a pair-form tracker index over its soft cap, or the accessor unavailable: `scripts/entry --over-cap`, D192).
# The gestalt/log.tsv line is written on every run either way.
# At most ~12 plain-text lines, each external call under `timeout`, whole run well under 5 s:
#   load      1/5/15-min load, nproc; when load1 > nproc/2 the top 3 CPU users (command name + %CPU, no args)
#   box       scripts/boxlock status, first line
#   queue     scripts/boxqueue status condensed: running job + age, pending count, last 3 ends + verdict
#   lanes     live lanewatch/watchrun/queuemon/queuewatch processes (count + labels); worktrees with
#             uncommitted changes newer than 30 min ("active")
#   sessions  ONE line: live Claude sessions (socket under /run/user/UID/cc-socks/ whose owner pid is alive):
#             pid, `claude -n` name, [role] (pid -> ~/.claude/sessions/PID.json sessionId -> worktrees/.mgr/roles/ID)
#   disk      use% and free of the repo fs, $PCREC_TMPDIR fs and /tmp ('!' at >= 85%); scratch/snap du if <2 s
#   context   per registered manager role: tokens from its statusline snapshot
#             $PCREC_TMPDIR/statusline/session-<id>.json when < 10 min old, else the LAST assistant message's usage
#             of its transcript (input + cache creation + cache read; numbers only, no content is ever printed)
#   subscription  5h/7d plan usage from $PCREC_TMPDIR/statusline/usage-latest.json (scripts/statusline.sh), else the
#             old ~/.claude/statusline/usage-latest.json (stale-flagged), else unavailable
#   ci        last run on main via gh (`ci: unavailable` when gh fails)
#   git       main tree: branch, +ahead/-behind, modified/untracked counts (names if <= 3), HEAD sha + age;
#             pcrec-bench as a compact suffix
#   unread    monitor lines waiting for main and kit (scripts/monread OWNER --peek: the cursor is NOT moved)
#   docs      pair-form tracker indexes over their soft cap (`scripts/entry --over-cap`, one line, `timeout 2`); empty = no line
# --owner puts that owner's unread count first, marked `*`. Never kills, never takes the box lock, writes
# nothing. Exit 0 always; with --all the last line is `gestalt: DONE rc=0`.
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")
[ -d "$main/worktrees" ] || main=$(cd "$here/.." && pwd)
owner=main
all=0
while [ $# -gt 0 ]; do
    case $1 in
        --owner) owner=${2:-main}; shift ;;
        --owner=*) owner=${1#--owner=} ;;
        --all) all=1 ;;
    esac
    shift
done
case $owner in main|kit) ;; *) owner=main ;; esac
trap '[ "$all" = 1 ] && echo "gestalt: DONE rc=0"; exit 0' EXIT
TO=timeout
now=$(date +%s)

fmt_age() { # seconds -> 45s / 12m / 3h
    local s=$1
    if [ "$s" -lt 120 ]; then echo "${s}s"; elif [ "$s" -lt 7200 ]; then echo "$((s / 60))m"; else echo "$((s / 3600))h"; fi
}

# --- load
read -r l1 l5 l15 _ < "${GESTALT_LOADAVG:-/proc/loadavg}"   # GESTALT_* overrides: test hooks
np=$(nproc 2>/dev/null || echo 1)
busy=""
if awk -v l="$l1" -v n="$np" 'BEGIN { exit !(l > n / 2) }'; then
    top3=$($TO 5 top -b -n2 -d0.5 -o %CPU 2>/dev/null | awk '
        /^ *PID /{ k++; n = 0; next }
        k == 2 && n < 3 && NF >= 12 { printf "%s%s %s%%", (n ? ", " : ""), $12, $9; n++ }')
    busy="; busiest: ${top3:-unavailable}"
fi
L_load="load: $l1 $l5 $l15 (nproc $np)$busy"
l1c=$(awk -v l="$l1" 'BEGIN { printf "%d", l * 100 }'); npc=$((np * 100))

# --- box
boxraw=$($TO 10 bash "${GESTALT_BOXLOCK:-$here/boxlock}" status 2>&1 | head -1)
L_box="box: $(printf '%s' "$boxraw" | sed 's/ cwd=.*//' | cut -c1-160)"

# --- queue
qs=$($TO 15 bash "${GESTALT_BOXQUEUE:-$here/boxqueue}" status 2>&1)
run=$(printf '%s\n' "$qs" | sed -n 's/^running: \([^ ]*\) .*/\1/p' | head -1)
if [ -n "$run" ]; then
    mt=$(stat -c %Y "$run" 2>/dev/null || echo "$now")
    runs="$(basename "$run") $(fmt_age $((now - mt)))"
else runs="none"; fi
pend=$(printf '%s\n' "$qs" | grep -c '^pending:')
ends=$(printf '%s\n' "$qs" | sed -n 's/^ended: .*\/[0-9T.]*-[0-9]*-\([^ ]*\) :: .*verdict=\([A-Z]*\).*/\1:\2/p' | tail -3 | tr '\n' ' ')
L_queue="queue: running $runs; pending $pend; last: ${ends:-none}"
# ready = a pending job whose answer is neither "not-ready: ..." nor "not asked yet"
qready=$(printf '%s\n' "$qs" | grep '^pending:' | grep -vc ' :: \(not-ready:\|not asked yet\)')
qidle_ready=0; [ -z "$run" ] && qidle_ready=$qready

# --- lanes / watchers
w=$(ps -eo pid=,args= 2>/dev/null | awk -v me="$$" '
    $1 != me && match($0, /^ *[0-9]+ +(bash +|sh +)?[^ ]*scripts\/(lanewatch|watchrun|queuemon|queuewatch)( |$)/) {
        t = $0; sub(/^.*scripts\//, "", t); split(t, a, " ")
        lab = a[1]; if (a[2] != "") lab = lab ":" a[length(a)]
        n++; l = l (n > 1 ? ", " : "") lab }
    END { printf "%d%s", n, (n ? " (" substr(l, 1, 150) ")" : "") }')
act=$(for d in "$main"/worktrees/*/; do
        [ -e "$d/.git" ] && echo "$d"
    done | xargs -r -P8 -I{} bash -c '
        d=${1%/}; now=$2
        f=$(timeout 8 git -C "$d" status --porcelain 2>/dev/null | cut -c4- | sed "s/.* -> //; s/\"//g" | head -200)
        [ -n "$f" ] || exit 0
        best=0
        while IFS= read -r p; do
            m=$(stat -c %Y "$d/$p" 2>/dev/null) && [ "$m" -gt "$best" ] && best=$m
        done <<< "$f"
        [ $((now - best)) -lt 1800 ] && basename "$d"
        exit 0' _ {} "$now" | sort | tr '\n' ' ')
nact=$(printf '%s\n' "$act" | wc -w)
L_lanes="lanes: watchers $w; active worktrees $nact${act:+ ($(printf '%s' "$act" | cut -c1-150))}"

# --- sessions (one line: pid, claude -n name, role from the role files keyed by session id)
sd=${GESTALT_SOCKS_DIR:-/run/user/$(id -u)/cc-socks}
roledir=${GESTALT_ROLES_DIR:-$main/worktrees/.mgr/roles}
claude_home=${GESTALT_CLAUDE_HOME:-$HOME/.claude}
sl=""
ns=0
liveroles=" "
if [ -d "$sd" ]; then
    for s in "$sd"/*.sock; do
        [ -S "$s" ] || continue
        pid=$(basename "$s" .sock)
        [ -d "/proc/$pid" ] || continue
        ns=$((ns + 1))
        name=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | awk '$0 == "-n" || $0 == "--name" { getline; print; exit }')
        sid=$($TO 2 jq -r '.sessionId // empty' "$claude_home/sessions/$pid.json" 2>/dev/null)
        role=""
        case $sid in ''|*[!A-Za-z0-9_-]*) ;; *) role=$(head -1 "$roledir/$sid" 2>/dev/null) ;; esac
        sl="$sl${sl:+, }$pid ${name:-?}${role:+ [$role]}"
        liveroles="$liveroles$role "
    done
fi
L_session="session: ${ns} live${sl:+ ($(printf '%s' "$sl" | cut -c1-150))}"
goneroles=""   # registered manager roles (worktrees/.mgr/roles) with no live session
if [ -d "$roledir" ]; then
    for rf in "$roledir"/*; do
        [ -f "$rf" ] || continue
        r=$(head -1 "$rf" 2>/dev/null)
        case $r in main|kit) case $liveroles in *" $r "*) ;; *) goneroles="$goneroles $r" ;; esac ;; esac
    done
fi
L_session="$L_session${goneroles:+; GONE:$goneroles}"

# --- disk (use% and free for repo fs, $PCREC_TMPDIR fs, /tmp; ! at >= 85%; scratch size only when quick)
. "$here/tmpdir.sh" 2>/dev/null
dl=""
diskhot=""
for pair in "repo:$main" "tmp:${PCREC_TMPDIR:-/var/tmp}" "/tmp:/tmp"; do
    lab=${pair%%:*}; path=${pair#*:}
    [ "$lab" = "/tmp" ] && path=/tmp
    row=$($TO 3 df -P -h "$path" 2>/dev/null | awk 'NR == 2 { print $5, $4 }')
    [ -n "$row" ] || { dl="$dl${dl:+, }$lab ?"; continue; }
    u=${row%% *}; fr=${row#* }
    flag=""; [ "${u%\%}" -ge 85 ] 2>/dev/null && { flag="!"; diskhot=1; }
    dl="$dl${dl:+, }$lab $u$flag ${fr} free"
done
sc=$($TO 1 du -sh "${PCREC_TMPDIR:-/var/tmp}/scratch" 2>/dev/null | cut -f1)
sn=$($TO 1 du -sh "${PCREC_TMPDIR:-/var/tmp}/snap" 2>/dev/null | cut -f1)
L_disk="disk: $dl${sc:+; scratch $sc}${sn:+, snap $sn}"

# --- context: last assistant usage line of each registered manager session's transcript (numbers only)
projects=${GESTALT_PROJECTS:-$claude_home/projects}
sdir=${GESTALT_STATUSLINE_DIR:-${PCREC_TMPDIR:-/var/tmp/pcrec-$(id -un)}/statusline}
snap=$sdir/usage-latest.json
[ -f "$snap" ] || snap=$claude_home/statusline/usage-latest.json
swin=""
cl=""
ctxn=""   # " role:tokens" for each registered manager whose count is known
if [ -d "$roledir" ]; then
    for rf in "$roledir"/*; do
        [ -f "$rf" ] || continue
        sid=$(basename "$rf")
        case $sid in *[!A-Za-z0-9_-]*) continue ;; esac
        role=$(head -1 "$rf" 2>/dev/null)
        case $role in main|kit) ;; *) continue ;; esac
        sf=$sdir/session-$sid.json
        if [ -f "$sf" ]; then
            r=$($TO 2 jq -r '[.captured_at // 0, (.context_window.current_usage // null | if . == null then "" else ((.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)) end), (.context_window.context_window_size // "")] | @tsv' "$sf" 2>/dev/null)
            IFS=$'\t' read -r scap sn sw <<< "$r"
            case $scap in ''|*[!0-9]*) scap=0 ;; esac
            if [ "$((now - scap))" -lt 600 ]; then
                case $sn in ''|*[!0-9]*) ;; *)
                    ctxn="$ctxn $role:$sn"; cl="$cl${cl:+ / }$role $((sn / 1000))k"; swin=${swin:-$sw}; continue ;;
                esac
            fi
        fi
        tf=$(ls "$projects"/*/"$sid".jsonl 2>/dev/null | head -1)
        [ -n "$tf" ] || { cl="$cl${cl:+ / }$role ?"; continue; }
        n=$($TO 3 tail -c 1500000 "$tf" 2>/dev/null | $TO 3 jq -Rr 'fromjson? | select(type == "object" and .type == "assistant" and (.message.usage? != null))
            | .message.usage | (.input_tokens // 0) + (.cache_creation_input_tokens // 0) + (.cache_read_input_tokens // 0)' 2>/dev/null | tail -1)
        case $n in ''|*[!0-9]*) cl="$cl${cl:+ / }$role ?" ;; *) ctxn="$ctxn $role:$n"; cl="$cl${cl:+ / }$role $((n / 1000))k" ;; esac
    done
fi
win=$swin
[ -n "$win" ] || win=$($TO 2 jq -r '.context_window.window_size // empty' "$snap" 2>/dev/null)
winraw=$win
# The effective ceiling is the owner's auto-compact window (~/.claude/settings.json `autoCompactWindow`,
# Frank 2026-11-07: "the context max is somewhat illusory because I've set the auto compact"); read that one key.
acw=$($TO 2 jq -r '.. | objects | .autoCompactWindow? // empty' "$claude_home/settings.json" 2>/dev/null | head -1)
case $acw in ''|*[!0-9]*) acw="" ;; esac
wk=""; case $win in ''|*[!0-9]*) ;; *) wk="$((win / 1000))k" ;; esac
# context threshold input: tokens at > 70% of the compaction point (else of the window)
ceil=${acw:-$winraw}; ctxhot=""
case $ceil in ''|*[!0-9]*) ;; *)
    for e in $ctxn; do [ $((${e#*:} * 100)) -gt $((70 * ceil)) ] && ctxhot="$ctxhot ${e%%:*}"; done ;;
esac
if [ -n "$acw" ]; then win=" (compacts at $((acw / 1000))k${wk:+; window $wk})"
elif [ -n "$wk" ]; then win=" (window $wk)"; else win=""; fi

# --- logs (recorded to gestalt/log.tsv, not printed): each registered session's transcript size (Frank 2026-11-07: long sessions once froze when the
# transcript reached some size; /clear starts a new file, compaction keeps appending to the same one).
# The 50 MB mark is UNMEASURED (the freeze size was never recorded); it only flags, it decides nothing.
ll=""
if [ -d "$roledir" ]; then
    for rf in "$roledir"/*; do
        [ -f "$rf" ] || continue
        sid=$(basename "$rf"); case $sid in *[!A-Za-z0-9_-]*) continue ;; esac
        role=$(head -1 "$rf" 2>/dev/null); case $role in main|kit) ;; *) continue ;; esac
        tf=$(ls "$projects"/*/"$sid".jsonl 2>/dev/null | head -1); [ -n "$tf" ] || continue
        mb=$(( $(stat -c %s "$tf" 2>/dev/null || echo 0) / 1048576 ))
        ll="$ll${ll:+ / }$role ${mb}M$([ "$mb" -ge 50 ] && echo ' LARGE')"
    done
fi
L_context="context: ${cl:-no registered sessions}$([ -n "$cl" ] && echo "$win")"
# Not printed (Frank 2026-11-07: "not actionable"); appended with a timestamp so the trend can be watched:
# $PCREC_TMPDIR/gestalt/log.tsv = time, load1, context per role, transcript MB per role.
gl="${PCREC_TMPDIR:-/var/tmp/pcrec-$(id -un)}/gestalt"
# idle-held input: the PREVIOUS sample, read before this run appends its own
prev=$(tail -n 1 "$gl/log.tsv" 2>/dev/null); prev_t=$(printf '%s' "$prev" | cut -f1); prev_l=$(printf '%s' "$prev" | cut -f2)
mkdir -p "$gl" 2>/dev/null && printf '%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$l1" "${cl:-}" "${ll:-}" >> "$gl/log.tsv" 2>/dev/null

# --- subscription: the statusline snapshot (~/.claude/statusline/usage-latest.json, written by the user's
# statusline.sh from Claude Code's own rate_limits input); stale once a window has reset or it is >30 min old
sub="unavailable (check /usage)"
if [ -f "$snap" ]; then
    r=$($TO 2 jq -r '[.captured_at // 0, .five_hour.used_percentage // "", .five_hour.resets_at // 0, .seven_day.used_percentage // "", .seven_day.resets_at // 0] | @tsv' "$snap" 2>/dev/null)
    if [ -n "$r" ]; then
        IFS=$'\t' read -r cap p5 r5 p7 r7 <<< "$r"
        case $cap in ''|*[!0-9]*) cap=0 ;; esac
        if [ -n "$p5" ] && [ -n "$p7" ] && [ "$cap" -gt 0 ]; then
            age=$((now - cap))
            if [ "$age" -gt 1800 ] || [ "$r5" -lt "$now" ]; then
                sub="stale: 5h ${p5}% · 7d ${p7}% · captured $(fmt_age $age) ago (check /usage)"
            else
                sub="5h ${p5}% (resets in $(fmt_age $((r5 - now)))) · 7d ${p7}% · captured $(fmt_age $age) ago"
            fi
        fi
    fi
fi
L_subscription="subscription: $sub"

# --- git (main tree, then pcrec-bench as a compact suffix)
git_one() { # DIR LABEL
    local o br=? ab="" m u names sha age
    o=$($TO 2 git -C "$1" status --porcelain=v1 -b --untracked-files=normal 2>/dev/null) || return 0
    br=$(printf '%s\n' "$o" | sed -n '1s/^## //; 1s/\.\.\..*//; 1s/ \[.*//; 1p')
    ab=$(printf '%s\n' "$o" | sed -n '1s/.*\[\(.*\)\]$/\1/p; 1s/.*\[.*//p' | sed 's/ahead /+/; s/behind /-/; s/, //')
    m=$(printf '%s\n' "$o" | tail -n +2 | grep -vc '^??')
    u=$(printf '%s\n' "$o" | tail -n +2 | grep -c '^??')
    names=""
    [ "$u" -gt 0 ] && [ "$u" -le 3 ] && names=" ($(printf '%s\n' "$o" | grep '^??' | cut -c4- | tr '\n' ' ' | sed 's/ $//'))"
    sha=$($TO 2 git -C "$1" log -1 --format='%h %ct' 2>/dev/null)
    age=$(fmt_age $((now - ${sha#* })))
    printf '%s %s%s, %s mod, %s untracked%s, %s %s ago' "$2" "$br" "${ab:+ $ab}" "$m" "$u" "$names" "${sha% *}" "$age"
}
gl=$(git_one "$main" "")
bd=$(dirname "$main")/pcrec-bench
[ -d "$bd/.git" ] && gb=$(git_one "$bd" "bench") || gb=""
L_git="git: ${gl# }${gb:+ | $gb}"

# --- CI
ci=$($TO 20 gh run list --branch main --limit 1 --json status,conclusion,headSha,createdAt \
    --jq '.[0] | "\(.status)/\(.conclusion) \(.headSha[0:9]) \(.createdAt)"' 2>/dev/null)
if [ -n "$ci" ]; then
    set -- $ci
    ts=$(date -d "$3" +%s 2>/dev/null || echo "$now")
    L_ci="ci: ${1%/} $(fmt_age $((now - ts))) ago"
    case ${1%/} in completed/success|completed/skipped|in_progress*|queued*|waiting*|pending*) ci_bad=0 ;; *) ci_bad=1 ;; esac
else L_ci="ci: unavailable"; ci_bad=1; fi

# --- unread monitor lines (peek: cursor untouched)
um=$($TO 10 bash "$here/monread" main --peek 2>/dev/null | wc -l)
uk=$($TO 10 bash "$here/monread" kit --peek 2>/dev/null | wc -l)
if [ "$owner" = kit ]; then L_unread="unread: *kit=$uk main=$um"; else L_unread="unread: *main=$um kit=$uk"; fi

# --- idle-held: a NON-queue box-lock holder (a hand `boxlock run`; a queue job is boxqueue's IDLE-SUSPECT, a holder
# blocking a waiting job is its HOLDER-IDLE-SUSPECT) that is alive while load1 stayed under IDLE_LOAD in two readings
# at least IDLE_GAP s apart (a dead owner is boxlock's HELD-ORPHAN / "free (stale owner record)", never this row).
# IDLE_LOAD 1.5: below every one of the 104 log.tsv samples taken while a queue job held the box (min 1.92: mech
# single-thread phases; p10 3.65), above the held-less baseline (p25 0.96 of 30 samples). IDLE_GAP 60 = load1's own
# averaging window, so the two readings do not share an interval. Evidence: scripts/NOTES.md "gestalt idle-held".
IDLE_LOAD=150 IDLE_GAP=60
idleheld=""; L_idleheld=""
case $boxraw in "HELD pid="*)
    hp=${boxraw#HELD pid=}; hp=${hp%% *}
    hl=${boxraw#*label=}; hl=${hl%% *}
    hd=$(printf '%s' "$boxraw" | sed -n 's/.* since=[^ ]* (\([^)]*\)).*/\1/p')
    pt=$(date -d "$prev_t" +%s 2>/dev/null || echo "$now")
    pc=$(awk -v l="${prev_l:-99}" 'BEGIN { printf "%d", l * 100 }')
    case $hl in queue:*) ;; *)
        if [ -d "/proc/$hp" ] && [ "$l1c" -lt "$IDLE_LOAD" ] && [ "$pc" -lt "$IDLE_LOAD" ] && [ $((now - pt)) -ge "$IDLE_GAP" ]; then
            idleheld=1
            L_idleheld="idle-held: $hl held ${hd:-?}, load1 $prev_l then $l1 (< $(awk -v t="$IDLE_LOAD" 'BEGIN { printf "%.1f", t / 100 }'))"
        fi ;;
    esac ;;
esac

# --- docs: `entry --over-cap` prints at most ONE `docs:` line then its `entry: over-cap` trailer ([DOC-INDEX], D192).
# Silent under every cap (L_docs empty); a non-zero exit, a timeout (2 s) or a missing trailer is `docs: unavailable` (K35).
L_docs=""; docbad=""
dout=$($TO 2 python3 -I "${GESTALT_ENTRY:-$here/entry}" --over-cap 2>/dev/null); drc=$?
if [ "$drc" != 0 ] || ! printf '%s\n' "$dout" | grep -q '^entry: over-cap'; then
    L_docs="docs: unavailable"; docbad=1
else
    L_docs=$(printf '%s\n' "$dout" | grep -m1 '^docs:'); [ -n "$L_docs" ] && docbad=1
fi

# --- plan health (Frank 2026-11-10: "waiting on me, open items count over 6, others?"). One parser: `scripts/entry --work`
# (GESTALT_WORK_ENTRY overrides, a python script like GESTALT_ENTRY); its text is only SPLIT here into tag / state /
# status date / waits-owner flag. Every threshold below is "default, unmeasured" (a first guess, tuned from what fires).
OPEN_MAX=6         # started+ready rows above this print `open`                    (default, unmeasured)
READY_IDLE_D=7     # a ready row older than this many days prints `ready-idle`     (default, unmeasured)
STALE_D=21         # a started row untouched this many days prints `stale`         (default, unmeasured)
QUESTION_H=24      # an unanswered owner question older than this prints `questions` (default, unmeasured)
PUSH_OWED_H=2      # main ahead of origin/main this long prints `push-owed`        (default, unmeasured)
PRUNE_OWED_N=5     # more than this many removable worktrees prints `prune-owed`   (default, unmeasured)
PRUNE_CACHE_MIN=30 # wtprune's dry run takes ~5 s, so its count is cached this long and refreshed in the background
pgit=${GESTALT_PLAN_GIT:-$main}   # repo whose history dates plan rows (git -S pickaxe on docs/dev/plan.md)
fmt_d() { if [ "$1" -lt 172800 ]; then fmt_age "$1"; else echo "$(($1 / 86400))d"; fi; }
# oldest: stdin "epoch tag" lines -> "COUNT AGE-SECONDS OLDEST-TAG" (nothing when empty)
oldest() { sort -n | awk -v now="$now" 'NR == 1 { e = $1; t = $2 } { n++ } END { if (n) printf "%d %d %s", n, now - e, t }'; }
L_ownerwaits=""; L_open=""; L_readyidle=""; L_stale=""; L_planbad=""
owbad=""; openbad=""; ribad=""; stalebad=""; planbad=""
wk=$($TO 4 python3 -I "${GESTALT_WORK_ENTRY:-$here/entry}" --work 2>/dev/null)
if [ $? != 0 ] || ! printf '%s\n' "$wk" | grep -q '^entry: '; then
    L_planbad="plan: unavailable (scripts/entry --work failed)"; planbad=1
else
    # one record per tag (a row listed in two sections is merged, keeping any waits-owner flag): tag state status-date waits
    recs=$(printf '%s\n' "$wk" | awk '
        /^ *- \[[^]]+\] STATE:/ { t = $0; sub(/^ *- \[/, "", t); sub(/\].*/, "", t); s = $0; sub(/^.*STATE:/, "", s); sub(/[^a-z-].*/, "", s)
            cur = t; if (!(t in st)) order[++n] = t; st[t] = s; next }
        cur != "" && /^ +status \([0-9-]+\)/ { d = $0; sub(/^ +status \(/, "", d); sub(/\).*/, "", d); sd[cur] = d; next }
        cur != "" && /^ +waits: owner —/ { wo[cur] = 1 }
        END { for (i = 1; i <= n; i++) { t = order[i]; print t, st[t], (t in sd ? sd[t] : "-"), (t in wo ? 1 : 0) } }')
    # owner-waits: the line carries no date, so the age is the row's status date (else the last commit adding/removing its tag)
    ow=$(printf '%s\n' "$recs" | awk '$4 == 1 { print $1 "\t" $3 }' | xargs -r -P8 -d '\n' -I{} bash -c '
        IFS=$'"'"'\t'"'"' read -r tag sd <<< "$1"
        e=""; [ "$sd" != - ] && e=$(date -d "$sd" +%s 2>/dev/null)
        [ -n "$e" ] || e=$(timeout 5 git -C "$2" log -1 --format=%ct -S"[$tag]" -- docs/dev/plan.md 2>/dev/null)
        echo "${e:-$3} $tag"' _ {} "$pgit" "$now")
    r=$(printf '%s\n' "$ow" | grep . | oldest)
    [ -n "$r" ] && { set -- $r; L_ownerwaits="owner-waits: $1 (oldest $(fmt_d "$2"), $3)"; owbad=1; }
    ns=$(printf '%s\n' "$recs" | awk '$2 == "started"' | wc -l); nr=$(printf '%s\n' "$recs" | awk '$2 == "ready"' | wc -l)
    nb=$(printf '%s\n' "$recs" | awk '$2 == "blocked"' | wc -l)
    L_open="open: started $ns / ready $nr / blocked $nb (started+ready > $OPEN_MAX)"
    [ $((ns + nr)) -gt "$OPEN_MAX" ] && openbad=1
    # ready-idle / stale: one git pickaxe per ready/started row, in parallel. A ready row's age = the commit that set
    # `[TAG] STATE:ready` (its `ready:` line carries no date); a started row is as fresh as its newer sign of life
    # (status date or last commit touching its tag).
    jo=$(printf '%s\n' "$recs" | awk '$2 == "ready" || $2 == "started" { print $1 "\t" $2 "\t" $3 }' | xargs -r -P8 -d '\n' -I{} bash -c '
        IFS=$'"'"'\t'"'"' read -r tag state sd <<< "$1"
        if [ "$state" = ready ]; then pat="[$tag] STATE:ready"; else pat="[$tag]"; fi
        e=$(timeout 5 git -C "$2" log -1 --format=%ct -S"$pat" -- docs/dev/plan.md 2>/dev/null)
        s=""; [ "$sd" != - ] && s=$(date -d "$sd" +%s 2>/dev/null)
        if [ -n "$s" ] && { [ -z "$e" ] || { [ "$state" = started ] && [ "$s" -gt "$e" ]; }; }; then e=$s; fi
        echo "$state ${e:-0} $tag"' _ {} "$pgit")
    rl=$(printf '%s\n' "$jo" | awk -v now="$now" -v lim=$((READY_IDLE_D * 86400)) '$1 == "ready" && $2 > 0 && now - $2 > lim { print $2, $3 }' | oldest)
    [ -n "$rl" ] && { set -- $rl; L_readyidle="ready-idle: $1 (oldest $(fmt_d "$2"), $3; > ${READY_IDLE_D}d)"; ribad=1; }
    sl=$(printf '%s\n' "$jo" | awk -v now="$now" -v lim=$((STALE_D * 86400)) '$1 == "started" && $2 > 0 && now - $2 > lim { print $2, $3 }' | oldest)
    nodate=$(printf '%s\n' "$jo" | awk '$2 == 0 { n++ } END { print n + 0 }')
    [ -n "$sl" ] && { set -- $sl; L_stale="stale: $1 started untouched > ${STALE_D}d (oldest $(fmt_d "$2"), $3)"; stalebad=1; }
    # a row whose date could not be found is counted and said, never hidden
    if [ "$nodate" -gt 0 ]; then L_stale="${L_stale:-stale: 0 started untouched > ${STALE_D}d}; $nodate undated"; stalebad=1; fi
fi

# questions: unanswered entries of owner.md "Questions for you" (a top-level `- ` item not starting "(answered"; `- FYI` items
# are information, not questions). Age = the first date in the entry's first line; NO date = counted and said "undated",
# never guessed from the file's mtime. An undated entry prints the row (its age cannot be shown to be under the threshold).
ownmd=${GESTALT_OWNER_MD:-$main/docs/dev/owner.md}
qrows=$(awk '/^## /{ inq = ($0 ~ /^## Questions for you/); next } inq && /^- / { print }' "$ownmd" 2>/dev/null \
    | grep -v -e '^- (answered' -e '^- FYI')
nq=0; nund=0; nold=0; oldq=0
while IFS= read -r ln; do
    [ -n "$ln" ] || continue
    nq=$((nq + 1))
    dt=$(printf '%s' "$ln" | grep -oE -m1 '[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2})?' | head -1)
    e=""; [ -n "$dt" ] && e=$(date -d "$dt" +%s 2>/dev/null)
    if [ -z "$e" ]; then nund=$((nund + 1)); continue; fi
    a=$((now - e)); [ "$a" -gt $((QUESTION_H * 3600)) ] && { nold=$((nold + 1)); [ "$a" -gt "$oldq" ] && oldq=$a; }
done <<< "$qrows"
if [ "$nold" -gt 0 ]; then L_questions="questions: $nq unanswered ($nold over ${QUESTION_H}h, oldest $(fmt_d "$oldq"); $nund undated)"
else L_questions="questions: $nq unanswered (none over ${QUESTION_H}h; $nund undated)"; fi
qbad=""; { [ "$nold" -gt 0 ] || [ "$nund" -gt 0 ]; } && qbad=1

# push-owed: main ahead of origin/main; age = the OLDEST unpushed commit
pdir=${GESTALT_PUSH_DIR:-$main}
pl=$($TO 3 git -C "$pdir" log origin/main..main --format=%ct 2>/dev/null)
npush=$(printf '%s\n' "$pl" | grep -c .); oldp=$(printf '%s\n' "$pl" | grep . | sort -n | head -1)
L_pushowed="push-owed: ${npush} commit(s) ahead of origin/main${oldp:+, oldest $(fmt_age $((now - oldp)))}"
pushbad=""; [ "$npush" -gt 0 ] && [ $((now - ${oldp:-$now})) -gt $((PUSH_OWED_H * 3600)) ] && pushbad=1

# prune-owed: wtprune's own dry-run verdict ("N removable"; its gates are not reimplemented). The dry run takes ~5 s, so the
# count is cached PRUNE_CACHE_MIN min and refreshed by a detached background run; no cache yet = `prune-owed: unknown`.
pc=${PCREC_TMPDIR:-/var/tmp/pcrec-$(id -un)}/gestalt/prune.cache   # "epoch removable"
pcn=""; pca=""
if [ -f "$pc" ]; then read -r pca pcn < "$pc"; fi
case $pca in ''|*[!0-9]*) pca=0 ;; esac
if [ $((now - pca)) -ge $((PRUNE_CACHE_MIN * 60)) ]; then
    mkdir -p "$(dirname "$pc")" 2>/dev/null
    setsid bash -c 'o=$(timeout 60 bash "$1" 2>/dev/null | sed -n "s/^wtprune: \([0-9][0-9]*\) removable.*/\1/p" | tail -1)
        [ -n "$o" ] && { echo "$(date +%s) $o" > "$2.tmp$$" && mv "$2.tmp$$" "$2"; }' _ "${GESTALT_WTPRUNE:-$here/wtprune}" "$pc" </dev/null >/dev/null 2>&1 &
fi
case $pcn in
    ''|*[!0-9]*) L_pruneowed="prune-owed: unknown (wtprune count not cached yet; refreshing)"; prunebad="" ;;
    *) L_pruneowed="prune-owed: $pcn removable worktree(s) (> $PRUNE_OWED_N; count $(fmt_age $((now - pca))) old)"
       prunebad=""; [ "$pcn" -gt "$PRUNE_OWED_N" ] && prunebad=1 ;;
esac

# --- THRESHOLD ROWS: kind | condition (shell test, evaluated) | the line it prints (a variable above).
# Default output = the lines of the rows whose condition holds, in this order; --all prints every row's line.
# A condition of `false` = no threshold: the line is --all only. Add a kind by adding a row (and its L_ line).
ROWS='load         | [ "$l1c" -gt "$npc" ]            | L_load
box          | false                              | L_box
queue        | [ "$qidle_ready" -gt 0 ]           | L_queue
lanes        | false                              | L_lanes
session      | [ -n "$goneroles" ]                | L_session
disk         | [ -n "$diskhot" ]                  | L_disk
context      | [ -n "$ctxhot" ]                   | L_context
subscription | false                              | L_subscription
git          | false                              | L_git
ci           | [ "$ci_bad" = 1 ]                  | L_ci
unread       | false                              | L_unread
idle-held    | [ -n "$idleheld" ]                 | L_idleheld
docs         | [ -n "$docbad" ]                   | L_docs
plan         | [ -n "$planbad" ]                  | L_planbad
owner-waits  | [ -n "$owbad" ]                    | L_ownerwaits
open         | [ -n "$openbad" ]                  | L_open
ready-idle   | [ -n "$ribad" ]                    | L_readyidle
stale        | [ -n "$stalebad" ]                 | L_stale
questions    | [ -n "$qbad" ]                     | L_questions
push-owed    | [ -n "$pushbad" ]                  | L_pushowed
prune-owed   | [ -n "$prunebad" ]                 | L_pruneowed'
while IFS='|' read -r kind cond var; do
    kind=${kind%% *}; var=${var// /}
    # a row whose line is EMPTY prints nothing, even under --all (idle-held and docs are empty when they do not fire)
    if [ "$all" = 1 ] || eval "$cond"; then [ -n "${!var}" ] && printf '%s\n' "${!var}"; fi
done <<< "$ROWS"
