#!/usr/bin/env bash
# scripts/size_diff — [ART-SIZE.1b] post-test examination tool: Frank's
# ruling (docs/dev/plan.md [ART-SIZE.1b]) makes the artifact-size LOG the
# deliverable and per-pattern movement a `git diff` a reviewer reads, never
# a gate — this is that reading tool, one summarised report instead of a
# raw two-file diff.
#
# Usage: scripts/size_diff OLD.tsv NEW.tsv
#   Both arguments are tests/size/run_size_log.sh's own output shape: a
#   `# artifact_size_log...` header line, a `# pattern\t...` column-name
#   line, then data rows (docs/dev/artifact_size_log.tsv's own format).
#
# Reports, in order: every pattern whose SIZE moved (any byte difference —
# size is deterministic given an unchanged emitter and an unchanged
# pattern, so ANY difference is real signal, never noise) or whose GCC CPU
# TIME moved past a noise threshold (CPU is NOT deterministic run to run —
# see the threshold note below), by name, with old/new/ratio, sorted by
# how far each row's ratio sits from 1.0 (the biggest mover first); then
# every pattern present in only one file (NEW / VANISHED); then totals.
#
# WHY GCC CPU GETS A NOISE THRESHOLD AND SIZE DOES NOT. Two re-runs of the
# identical corpus on the identical commit produce byte-identical
# `size_bytes` (the emitter is a pure function of the pattern) but
# DIFFERENT `gcc_cpu_s` every time (scheduler jitter, cache state, ambient
# load) — a size_diff with no CPU tolerance would never be empty even for
# a truly no-op re-run, which defeats "an empty report" as a signal at
# all. SIZE_DIFF_CPU_RATIO (default 1.25 — a pattern's CPU must move by
# more than 25% to be reported) and SIZE_DIFF_CPU_ABS (default 0.05s — and
# by at least 50ms in absolute terms, so a 0.001s -> 0.002s jump, a 2x
# ratio on a value too small to mean anything, is not reported either) are
# BOTH required before a CPU move is reported; SIZE has neither knob,
# deliberately.
set -u

if [ "$#" -ne 2 ]; then
    echo "usage: scripts/size_diff OLD.tsv NEW.tsv" >&2
    exit 2
fi
OLD="$1"
NEW="$2"
for f in "$OLD" "$NEW"; do
    [ -f "$f" ] || { echo "size_diff: file not found: $f" >&2; exit 2; }
done

CPU_RATIO_T="${SIZE_DIFF_CPU_RATIO:-1.25}"
CPU_ABS_T="${SIZE_DIFF_CPU_ABS:-0.05}"
LC_ALL=C
export LC_ALL

report="$(LC_ALL=C awk -F'\t' -v cpuRatioT="$CPU_RATIO_T" -v cpuAbsT="$CPU_ABS_T" '
    function abs(x) { return x < 0 ? -x : x }
    FNR == 1 { fileidx++ }
    /^#/ { next }
    fileidx == 1 {
        osize[$1] = $5 + 0; ocpu[$1] = $6 + 0; oseen[$1] = 1
        next
    }
    fileidx == 2 {
        nsize[$1] = $5 + 0; ncpu[$1] = $6 + 0; nseen[$1] = 1
        if (!(($1) in allkeys)) { allkeys[$1] = 1; order[++norder] = $1 }
        next
    }
    END {
        # every OLD key first (so a VANISHED-only pattern is not lost),
        # then any NEW-only key not already seen.
        for (k in oseen) {
            if (!(k in allkeys)) { allkeys[k] = 1; order[++norder] = k }
        }
        total_old = 0; total_new = 0
        n_common = 0; n_changed = 0; n_new = 0; n_vanished = 0
        for (i = 1; i <= norder; i++) {
            k = order[i]
            if (oseen[k]) total_old += osize[k]
            if (nseen[k]) total_new += nsize[k]
            if (oseen[k] && nseen[k]) {
                n_common++
                sr = (osize[k] > 0) ? nsize[k] / osize[k] : (nsize[k] > 0 ? 999 : 1)
                size_changed = (osize[k] != nsize[k])
                cr = (ocpu[k] > 0) ? ncpu[k] / ocpu[k] : 1
                cpu_abs_delta = abs(ncpu[k] - ocpu[k])
                cpu_changed = (abs(cr - 1) > (cpuRatioT - 1)) && (cpu_abs_delta > cpuAbsT)
                if (size_changed || cpu_changed) {
                    n_changed++
                    dev = abs(sr - 1); cdev = abs(cr - 1)
                    if (cdev > dev) dev = cdev
                    printf "%.6f\t%s\tCHANGED\t%d\t%d\t%.4f\t%.3f\t%.3f\t%.4f\n", \
                        dev, k, osize[k], nsize[k], sr, ocpu[k], ncpu[k], cr
                }
            } else if (nseen[k] && !oseen[k]) {
                n_new++
                printf "%.6f\t%s\tNEW\t\t%d\t\t\t%.3f\t\n", 999999, k, nsize[k], ncpu[k]
            } else if (oseen[k] && !nseen[k]) {
                n_vanished++
                printf "%.6f\t%s\tVANISHED\t%d\t\t\t%.3f\t\t\n", 999999, k, osize[k], ocpu[k]
            }
        }
        printf "TOTALS\t%d\t%d\t%d\t%d\t%d\t%d\n", total_old, total_new, n_common, n_changed, n_new, n_vanished > "/dev/stderr"
    }
' "$OLD" "$NEW" 2>"${TMPDIR:-/tmp}/.size_diff_totals.$$")"

totals_line="$(cat "${TMPDIR:-/tmp}/.size_diff_totals.$$" 2>/dev/null)"
rm -f "${TMPDIR:-/tmp}/.size_diff_totals.$$"

echo "== scripts/size_diff: $OLD -> $NEW =="
if [ -z "$report" ]; then
    echo "(no patterns moved past the size/CPU thresholds)"
else
    echo "$report" | LC_ALL=C sort -t $'\t' -k1,1gr \
        | cut -f2- \
        | awk -F'\t' '
            BEGIN { print "pattern\tstatus\told_size\tnew_size\tsize_ratio\told_cpu\tnew_cpu\tcpu_ratio" }
            { print }
        '
fi

if [ -n "$totals_line" ]; then
    IFS=$'\t' read -r _tag total_old total_new n_common n_changed n_new n_vanished <<< "$totals_line"
    echo
    echo "totals:"
    echo "  patterns in OLD only (VANISHED): $n_vanished"
    echo "  patterns in NEW only (NEW):      $n_new"
    echo "  patterns in both, moved:         $n_changed / $n_common common"
    if [ "${total_old:-0}" -gt 0 ]; then
        pct="$(awk -v o="$total_old" -v n="$total_new" 'BEGIN { printf "%+.2f", 100.0*(n-o)/o }')"
        echo "  total size_bytes: OLD=$total_old NEW=$total_new (${pct}%)"
    else
        echo "  total size_bytes: OLD=$total_old NEW=$total_new"
    fi
fi
