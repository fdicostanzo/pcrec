#!/usr/bin/env bash
# boxqueue_window — the FIXED placeholder job for an imported bench window ([BENCH-RESERVE], lane benchres,
# 2026-10-25). `boxqueue`'s import step copies this file, byte for byte, to pending/ as PRIO-bench-NAME for every
# accepted <NAME>.window; nothing from the .window is ever interpolated into it. The window's PARSED values live in
# QUEUE/.bench/KEY.params (key=value lines the importer validated; read below with a case, never sourced or eval'd).
# It runs under the box lock like any job and HOLDS it while the bench runs its own window elsewhere (neither side
# runs the other's code): it waits for the bench's log to say the window is over, and tells the bench through
# QUEUE/reservations/PRIO-bench-NAME.state (ONE line, rewritten atomically):
#   QUEUED <iso> | RUNNING <iso> <pid> | DONE <green|red|failed|cancelled> <iso> <reason>
# RUNNING is written first thing in the work (the lock is ours then), DONE last before the work exits (the lock
# is released after). boxqueue's own machinery carries the rest: cap = the declared wall cap (timeout's TERM is
# trapped here and written as CAP-FIRED), patience/idle-ok are declarations only (no auto-withdraw), and the done line's count is a
# declared `expect window=N last=DONE_ERE` population, read from THIS job's log: the placeholder echoes the last
# done_ere line found in the appended bytes, so the bench's own log (stale lines, red lines) never decides the verdict.
# Ends: done_ere last match with integer == expect -> DONE green; != expect (or no integer) -> DONE red POPULATION;
# a fail_ere line -> DONE failed BENCH-FAIL; the log does not GROW within start_s of RUNNING -> DONE failed NO-START (a log that
# already exists at RUNNING is fine: its size is the offset and only appended bytes are scanned); cap -> DONE failed CAP-FIRED; <NAME>.cancel in the inbox ->
# DONE cancelled. BOXQUEUE_WINDOW_POLL (2 s) is the poll pace.
set -u
Q=${BQ_QUEUE:-}; K=${BQ_KEY:-}
PARAMS=$Q/.bench/$K.params
POLL=${BOXQUEUE_WINDOW_POLL:-2}
W_prio="" W_name="" W_cap="" W_patience="" W_idle_ok="" W_log="" W_start_s="" W_done_ere="" W_expect="" W_witness="" W_fail_ere="" W_cancel=""
load() {
    local l k v
    [ -n "$Q" ] && [ -n "$K" ] && [ -f "$PARAMS" ] || { echo "no params $PARAMS" >&2; return 1; }
    while IFS= read -r l || [ -n "$l" ]; do
        k=${l%%=*}; v=${l#*=}
        case $k in
            prio) W_prio=$v ;; name) W_name=$v ;; cap) W_cap=$v ;; patience) W_patience=$v ;; idle_ok) W_idle_ok=$v ;;
            log) W_log=$v ;; start_s) W_start_s=$v ;; done_ere) W_done_ere=$v ;; expect) W_expect=$v ;;
            witness) W_witness=$v ;; fail_ere) W_fail_ere=$v ;; cancel) W_cancel=$v ;;
        esac
    done < "$PARAMS"
    [ -n "$W_cap$W_log$W_done_ere$W_fail_ere$W_witness$W_expect$W_start_s$W_patience" ] || { echo "empty params $PARAMS" >&2; return 1; }
}
case "${1:-}" in
    --dry-run)
        load || exit 1
        echo "boxqueue: cap $W_cap"; echo "boxqueue: patience $W_patience"
        if [ -n "$W_idle_ok" ]; then echo "boxqueue: idle-ok $W_idle_ok"; fi
        printf 'boxqueue: expect window=%s last=%s\n' "$W_expect" "$W_done_ere"
        printf 'boxqueue: witness window=%s\n' "$W_witness"
        echo "would hold the box lock for bench window $W_name until $W_log reports it (start within ${W_start_s}s)"
        exit 0 ;;
    --ready)    # a window cancelled while still queued ends here (77 = never); boxqueue's reconcile then writes DONE cancelled
        load || exit 77
        [ -e "$W_cancel" ] && { echo "cancelled by the bench ($W_cancel)"; exit 77; }
        exit 0 ;;
esac

load || exit 1
SD=$Q/reservations SF=$SD/$BQ_JOB.state
iso() { date -Iseconds; }
wstate() { local t=$SD/.tmp.$$.$RANDOM; mkdir -p "$SD"; printf '%s\n' "$1" > "$t" && mv -f "$t" "$SF"; }
t0=$(date +%s)
fin() { # fin OUTCOME REASON RC: DONE is written before the work exits, i.e. before the lock is released
    wstate "DONE $1 $(iso) $2"; echo "bench window $W_name: DONE $1"; exit "$3"
}
on_term() {
    local el=$(( $(date +%s) - t0 ))
    if [ "$el" -ge $(( W_cap - 3 )) ]; then fin failed "CAP-FIRED (${W_cap}s)" 124; fi
    fin failed "TERMINATED (after ${el}s, before the cap)" 143
}
trap on_term TERM INT HUP
wstate "RUNNING $(iso) $$"
echo "bench window $W_name: RUNNING pid $$, waiting on $W_log"
# R1/R2: a log that already exists is ALLOWED. Its byte size at RUNNING is the offset; only bytes appended after it
# are ever scanned (a stale done line never matches), and "the window started" means the log GREW past the offset.
off=0; [ -f "$W_log" ] && off=$(stat -c %s "$W_log" 2>/dev/null || echo 0)
TAIL=$Q/.bench/$K.tail
grown=0
while :; do
    if [ -e "$W_cancel" ]; then fin cancelled "CANCELLED by the bench" 77; fi
    sz=0; [ -f "$W_log" ] && sz=$(stat -c %s "$W_log" 2>/dev/null || echo 0)
    [ "$sz" -lt "$off" ] && off=0    # the log was truncated or replaced: everything in it is new
    if [ "$sz" -gt "$off" ]; then
        grown=1
        tail -c +$((off + 1)) "$W_log" > "$TAIL" 2>/dev/null
        if [ "$(bash "$BOXQUEUE" _pop lines "$W_fail_ere" "$TAIL")" -gt 0 ] 2>/dev/null; then fin failed "BENCH-FAIL" 1; fi
        if [ "$(bash "$BOXQUEUE" _pop lines "$W_done_ere" "$TAIL")" -gt 0 ] 2>/dev/null; then
            n=$(bash "$BOXQUEUE" _pop last "$W_done_ere" "$TAIL")
            # the queue reads the population from THIS job's log, never the bench's (a stale line or a red line
            # already in the bench log must not decide the verdict): echo the last done line, appended bytes only
            RE=$W_done_ere awk 'match($0, ENVIRON["RE"]) { l = $0 } END { print l }' "$TAIL"
            if [ "$n" = "$W_expect" ]; then fin green "WINDOW-COMPLETE n=$n" 0; fi
            fin red "POPULATION n=$n expect=$W_expect" 1
        fi
    fi
    if [ $grown = 0 ] && [ $(( $(date +%s) - t0 )) -gt "$W_start_s" ]; then
        fin failed "NO-START (${W_log} did not grow within ${W_start_s}s of RUNNING)" 1
    fi
    sleep "$POLL" & wait $!
done
