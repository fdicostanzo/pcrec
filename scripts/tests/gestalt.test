#!/usr/bin/env bash
# gestalt self-test (--all = the full output; default = threshold rows only, silent when normal): line bound, exit 0 with gh unavailable, DONE line last, monread cursors untouched,
# --owner marks the owner's unread count. Read-only toward the box; runs in a few seconds.
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
. "$here/../tests/lib/timeout_bin.sh" 2>/dev/null
TO=${TIMEOUT_BIN:-timeout}
T=$(mktemp -d "${TMPDIR:-/var/tmp}/gestalt.test.XXXXXX")
trap 'rm -rf "$T"' EXIT
export PCREC_TMPDIR="$T/tmproot"   # gestalt appends gestalt/log.tsv; keep fake rows out of the real log
pass=0 fail=0
ok()  { echo "PASS: $*"; pass=$((pass+1)); }
bad() { echo "FAIL: $*"; fail=$((fail+1)); }
main=$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")
cur() { cat "$main/worktrees/.mgr/monitor.cursor.$1" 2>/dev/null || echo none; }

# gh replaced by a failing stub first on PATH
mkdir "$T/bin"; printf '#!/bin/sh\nexit 1\n' > "$T/bin/gh"; chmod +x "$T/bin/gh"
cm=$(cur main) ck=$(cur kit)
out=$(PATH="$T/bin:$PATH" "$TO" 10 bash "$here/gestalt" --all --owner kit 2>&1); rc=$?
[ "$rc" = 0 ] && ok "exit 0 with gh failing" || bad "rc=$rc"
printf '%s\n' "$out" | grep -qx 'ci: unavailable' && ok "ci: unavailable" || bad "no 'ci: unavailable'"
[ "$(printf '%s\n' "$out" | tail -1)" = "gestalt: DONE rc=0" ] && ok "DONE line last" || bad "last line: $(printf '%s\n' "$out" | tail -1)"
n=$(printf '%s\n' "$out" | wc -l)
[ "$n" -le 19 ] && ok "$n lines (<= 19)" || bad "$n lines"
for k in load box queue lanes disk context subscription git unread; do
    printf '%s\n' "$out" | grep -q "^$k:" && ok "has $k line" || bad "missing $k line"
done
printf '%s\n' "$out" | grep -q '^unread: \*kit=' && ok "--owner kit marks kit" || bad "owner mark"
[ "$cm" = "$(cur main)" ] && [ "$ck" = "$(cur kit)" ] && ok "monread cursors unchanged" || bad "cursor moved"
# context: fake roles dir + fake transcript carrying a canary string that must never be printed
mkdir -p "$T/roles" "$T/proj/p"
sid=aaaa1111-2222-3333-4444-555566667777
echo main > "$T/roles/$sid"
CAN=CANARY_SECRET_TEXT_9137
{ printf '{"type":"assistant","message":{"content":"%s","usage":{"input_tokens":1,"cache_creation_input_tokens":1000,"cache_read_input_tokens":9000}}}\n' "$CAN"
  printf '{"type":"user","message":{"content":"%s"}}\n' "$CAN"
  printf '{"type":"assistant","message":{"content":"%s","usage":{"input_tokens":5,"cache_creation_input_tokens":2000,"cache_read_input_tokens":123000}}}\n' "$CAN"
  printf '{"type":"user","message":{"content":"%s"}}\n' "$CAN"; } > "$T/proj/p/$sid.jsonl"
out2=$(GESTALT_ROLES_DIR="$T/roles" GESTALT_PROJECTS="$T/proj" GESTALT_CLAUDE_HOME="$T/none" GESTALT_STATUSLINE_DIR="$T/nosl" PATH="$T/bin:$PATH" "$TO" 10 bash "$here/gestalt" --all 2>&1)
printf '%s\n' "$out2" | grep -qE '^context: main 125k( \(.*\))?(; logs main [0-9]+M( LARGE)?)?$' && ok "context line from fake transcript" || bad "context: $(printf '%s\n' "$out2" | grep '^context:')"
printf '%s\n' "$out2" | grep -q "$CAN" && bad "canary leaked" || ok "no transcript content in output"
printf '%s\n' "$out2" | grep -qx 'subscription: unavailable (check /usage)' && ok "subscription unavailable without snapshot" || bad "subscription line"
# statusline snapshots: fresh session file wins over the transcript; usage-latest feeds the subscription line
mkdir -p "$T/sl"; nowt=$(date +%s)
printf '{"captured_at":%s,"context_window":{"context_window_size":1000000,"current_usage":{"input_tokens":1,"cache_creation_input_tokens":500,"cache_read_input_tokens":299499}}}\n' "$nowt" > "$T/sl/session-$sid.json"
printf '{"five_hour":{"used_percentage":12,"resets_at":%s},"seven_day":{"used_percentage":34,"resets_at":%s},"session_id":"x","captured_at":%s}\n' "$((nowt+3600))" "$((nowt+86400))" "$nowt" > "$T/sl/usage-latest.json"
G="env GESTALT_ROLES_DIR=$T/roles GESTALT_PROJECTS=$T/proj GESTALT_CLAUDE_HOME=$T/none GESTALT_STATUSLINE_DIR=$T/sl PATH=$T/bin:$PATH"
out3=$($G "$TO" 10 bash "$here/gestalt" --all 2>&1)
printf '%s\n' "$out3" | grep -qE '^context: main 300k( \(.*\))?(; logs main [0-9]+M( LARGE)?)?$' && ok "context from fresh session snapshot" || bad "snapshot context: $(printf '%s\n' "$out3" | grep '^context:')"
printf '%s\n' "$out3" | grep -q '^subscription: 5h 12% .* 7d 34%' && ok "subscription from usage-latest.json" || bad "subscription: $(printf '%s\n' "$out3" | grep '^subscription:')"
printf '{"captured_at":%s,"context_window":{"current_usage":{"input_tokens":1}}}\n' "$((nowt-3000))" > "$T/sl/session-$sid.json"
out4=$($G "$TO" 10 bash "$here/gestalt" --all 2>&1)
printf '%s\n' "$out4" | grep -qE '^context: main 125k' && ok "stale snapshot falls back to transcript" || bad "stale fallback: $(printf '%s\n' "$out4" | grep '^context:')"
# plan-health fixtures (defined early: G2 points the plan rows at the quiet ones)
mkdir -p "$T/pw/nogit" "$T/pw/tmpq/gestalt"
dago() { date -d "-$1 day" +%Y-%m-%d; }
pwork() { # FILE ROW...: print a --work text file; each ROW is "TAG|STATE|STATUSDATE|waits(0/1)"
    local f=$1; shift; { echo "## work"; local r tag st sd w
    for r in "$@"; do IFS='|' read -r tag st sd w <<< "$r"
        echo "- [$tag] STATE:$st — t"; [ -n "$sd" ] && echo "  status ($sd): s"; [ "$w" = 1 ] && echo "  waits: owner — go?"; done
    echo "entry: $# items (profile plan, level 1)"; } > "$f.txt"
    printf 'print(open("%s.txt").read(), end="")\n' "$f" > "$f.py"; }
pwork "$T/pw/quiet"
# --- threshold rows (default output): silent when everything is normal, each row fires on a crafted input
mkdir -p "$T/ch" "$T/socks" "$T/emptyroles" "$T/ghok" "$T/ghfail" "$T/ghcanc" "$T/dffull"
ghstub() { printf '#!/bin/sh\necho "%s abc123456 2026-11-10T00:00:00Z"\n' "$2" > "$1/gh"; chmod +x "$1/gh"; }
ghstub "$T/ghok" completed/success; ghstub "$T/ghfail" completed/failure; ghstub "$T/ghcanc" completed/cancelled
printf '#!/bin/sh\necho "Filesystem Size Used Avail Use%% Mounted"\necho "x 100G 92G 8G 92%% /"\n' > "$T/dffull/df"; chmod +x "$T/dffull/df"
printf '0.10 0.10 0.10 1/100 1\n' > "$T/load.low"; printf '99.00 50.00 20.00 1/100 1\n' > "$T/load.high"
printf '#!/bin/sh\necho "running: /q/running/1-x 1 1"\necho "pending: 2-y :: not-ready: waiting on x"\n' > "$T/bq.busy"
printf '#!/bin/sh\necho "runner: live"\necho "pending: 2-y :: ready"\n' > "$T/bq.idleready"
printf '#!/bin/sh\necho "runner: live"\necho "pending: 2-y :: not-ready: waiting on x"\n' > "$T/bq.idlewait"
printf '{"autoCompactWindow":150000}\n' > "$T/ch/settings.json"
# the docs row's accessor, stubbed (python: gestalt runs `python3 -I $GESTALT_ENTRY --over-cap`)
mkdir -p "$T/ent"
printf 'print("entry: over-cap checked 1 pair index, 0 over")\n' > "$T/ent/under.py"
printf 'print("docs: decisions.md 51.3 KB over soft cap 48 KB (+3.3 KB, 107%%)")\nprint("entry: over-cap checked 1 pair index, 1 over")\n' > "$T/ent/over.py"
printf 'import sys\nprint("entry: over-cap checked 1 pair index, 0 over")\nsys.exit(3)\n' > "$T/ent/exit3.py"
printf 'import time\ntime.sleep(5)\nprint("entry: over-cap checked 1 pair index, 0 over")\n' > "$T/ent/sleep.py"
printf 'print("nothing useful")\n' > "$T/ent/notrailer.py"
printf '\n' > "$T/ent/blank.py"
# G [VAR=val ...]: run gestalt (default output) over the all-normal inputs, later VARs overriding earlier ones
G2() { env GESTALT_ROLES_DIR="$T/emptyroles" GESTALT_PROJECTS="$T/proj" GESTALT_CLAUDE_HOME="$T/ch" GESTALT_STATUSLINE_DIR="$T/nosl" \
    GESTALT_SOCKS_DIR="$T/socks" GESTALT_LOADAVG="$T/load.low" GESTALT_BOXQUEUE="$T/bq.busy" GESTALT_ENTRY="$T/ent/under.py" \
    GESTALT_WORK_ENTRY="$T/pw/quiet.py" GESTALT_OWNER_MD="$T/pw/owner.quiet" GESTALT_PUSH_DIR="$T/pw/nogit" GESTALT_PLAN_GIT="$T/pw/repo" \
    GESTALT_WTPRUNE="$T/pw/wtprune" PCREC_TMPDIR="$T/pw/tmpq" "$@" ; }
run() { local pre=$1; shift; G2 "$@" PATH="$pre:$PATH" "$TO" 20 bash "$here/gestalt" $GARGS 2>&1; }
GARGS=""
q=$(run "$T/ghok"); rc=$?
[ "$rc" = 0 ] && [ -z "$q" ] && ok "silent (no output, rc 0) when all normal" || bad "not silent rc=$rc: [$q]"
GARGS=--all; qa=$(run "$T/ghok"); GARGS=""
printf '%s\n' "$qa" | tail -1 | grep -qx 'gestalt: DONE rc=0' && printf '%s\n' "$qa" | grep -q '^load:' && ok "--all prints every line + DONE" || bad "--all on normal input"
# J1: --all on a normal fixture with the accessor printing only its trailer: <= 12 lines, no empty line
GARGS=--all; qj=$(run "$T/ghok"); GARGS=""
[ "$(printf '%s\n' "$qj" | wc -l)" -le 19 ] && ok "--all <= 19 lines with a silent docs row" || bad "--all lines: $(printf '%s\n' "$qj" | wc -l)"
printf '%s\n' "$qj" | grep -q '^$' && bad "--all printed an empty line" || ok "--all prints no empty line"
kinds() { sed -n 's/^\([a-z-]*\):.*/\1/p' | tr '\n' ' ' | sed 's/ $//'; }
fires() { local what=$1 want=$2 pre=$3; shift 3; local o; o=$(run "$pre" "$@" | kinds)
    [ "$o" = "$want" ] && ok "row fires: $what" || bad "row $what: got [$o] want [$want]"; }
fires "load1 > nproc" load "$T/ghok" GESTALT_LOADAVG="$T/load.high"
fires "ci failure" ci "$T/ghfail"
fires "ci cancelled-latest" ci "$T/ghcanc"
fires "ci unavailable" ci "$T/bin"
fires "queue idle, ready job waits" queue "$T/ghok" GESTALT_BOXQUEUE="$T/bq.idleready"
fires "queue idle, nothing ready: silent" "" "$T/ghok" GESTALT_BOXQUEUE="$T/bq.idlewait"
fires "disk >= 85%" disk "$T/dffull:$T/ghok"
fires "registered session not live" session "$T/ghok" GESTALT_ROLES_DIR="$T/roles" GESTALT_PROJECTS="$T/none"
fires "context > 70% of compaction point" "session context" "$T/ghok" GESTALT_ROLES_DIR="$T/roles"
# J2: the docs row: silent under cap (the first test above); exactly the docs: line when over; J3: unavailable cases
dq=$(run "$T/ghok" GESTALT_ENTRY="$T/ent/over.py")
[ "$dq" = "docs: decisions.md 51.3 KB over soft cap 48 KB (+3.3 KB, 107%)" ] && ok "docs row prints exactly the docs: line when over cap" || bad "docs over: [$dq]"
fires "docs over soft cap" docs "$T/ghok" GESTALT_ENTRY="$T/ent/over.py"
fires "docs accessor exits non-zero" docs "$T/ghok" GESTALT_ENTRY="$T/ent/exit3.py"
fires "docs accessor prints no trailer" docs "$T/ghok" GESTALT_ENTRY="$T/ent/notrailer.py"
fires "docs accessor prints a blank line only" docs "$T/ghok" GESTALT_ENTRY="$T/ent/blank.py"
fires "docs accessor missing" docs "$T/ghok" GESTALT_ENTRY="$T/ent/nonexistent.py"
t0=$(date +%s); dq=$(run "$T/ghok" GESTALT_ENTRY="$T/ent/sleep.py"); t1=$(date +%s)
[ "$dq" = "docs: unavailable" ] && [ $((t1 - t0)) -lt 5 ] && ok "docs accessor hangs: 'docs: unavailable' in $((t1 - t0)) s (< 5)" || bad "docs hang: [$dq] $((t1 - t0)) s"
for u in exit3 notrailer blank; do
    dq=$(run "$T/ghok" GESTALT_ENTRY="$T/ent/$u.py"); [ "$dq" = "docs: unavailable" ] && ok "docs: unavailable ($u)" || bad "docs $u: [$dq]"
done
mv "$T/ch/settings.json" "$T/ch/s.off"; printf '{"autoCompactWindow":1000000}\n' > "$T/ch/settings.json"
fires "context 12% of compaction point: not hot" session "$T/ghok" GESTALT_ROLES_DIR="$T/roles"
# idle-held: a non-queue holder, alive, with load1 low in two readings >= 60 s apart
mv "$T/ch/s.off" "$T/ch/settings.json"
bl() { printf '#!/bin/sh\necho "%s"\n' "$2" > "$1"; chmod +x "$1"; }   # bl FILE STATUS-LINE
bl "$T/bl.hand" "HELD pid=$$ label=hand-mech since=2026-11-10T09:00:00-05:00 (42m) cwd=/x"
bl "$T/bl.queue" "HELD pid=$$ label=queue:5-main-x since=2026-11-10T09:00:00-05:00 (42m) cwd=/x"
bl "$T/bl.dead" "HELD pid=99999999 label=hand-mech since=2026-11-10T09:00:00-05:00 (42m) cwd=/x"
bl "$T/bl.orphan" "HELD-ORPHAN pid=99999999 label=hand-mech since=2026-11-10T09:00:00-05:00 (42m) cwd=/x"
bl "$T/bl.free" "free"
printf '0.30 0.30 0.30 1/100 1\n' > "$T/load.low2"; printf '3.00 3.00 3.00 1/100 1\n' > "$T/load.mid"
# seed PREV-LOAD AGE-SECONDS -> a PCREC_TMPDIR whose last log.tsv sample is that old
seed() { local d; d=$(mktemp -d "$T/tr.XXXXXX"); mkdir -p "$d/gestalt"
    printf '%s\t%s\tctx\tlogs\n' "$(date -Iseconds -d "-$2 sec")" "$1" > "$d/gestalt/log.tsv"; echo "$d"; }
ih() { local what=$1 want=$2 bls=$3 prevl=$4 age=$5 cur=$6 o
    o=$(run "$T/ghok" GESTALT_BOXLOCK="$bls" GESTALT_LOADAVG="$cur" PCREC_TMPDIR="$(seed "$prevl" "$age")")
    case $o in *"$want"*) ok "idle-held: $what" ;; *) bad "idle-held $what: got [$o]" ;; esac
    [ -z "$want" ] && [ -n "$o" ] && bad "idle-held $what: expected silence, got [$o]"; return 0; }
ih "fires on held(non-queue)+low+low" "idle-held: hand-mech held 42m, load1 0.40 then 0.30 (< 1.5)" "$T/bl.hand" 0.40 600 "$T/load.low2"
ih "silent: held+low then high" "" "$T/bl.hand" 0.40 600 "$T/load.mid"
ih "silent: held+high then low (one quiet reading)" "" "$T/bl.hand" 3.00 600 "$T/load.low2"
ih "silent: previous sample < 60 s old (same reading)" "" "$T/bl.hand" 0.40 5 "$T/load.low2"
ih "silent: not held" "" "$T/bl.free" 0.40 600 "$T/load.low2"
ih "silent: queue-job holder (boxqueue's IDLE-SUSPECT owns it)" "" "$T/bl.queue" 0.40 600 "$T/load.low2"
ih "silent: dead holder pid (not this row)" "" "$T/bl.dead" 0.40 600 "$T/load.low2"
ih "silent: HELD-ORPHAN (boxlock's own state)" "" "$T/bl.orphan" 0.40 600 "$T/load.low2"

# --- plan-health rows (owner-waits, open, ready-idle, stale, questions, push-owed, prune-owed): fixtures for `entry --work` text,
# a throwaway plan.md history (commit dates back-dated), an owner.md, an origin/main pair, and a fake wtprune + its count cache
pwork "$T/pw/ow"  "AA|started|$(dago 2)|0" "OW1|not-started|$(dago 9)|1" "OW2|started|$(dago 3)|1"
pwork "$T/pw/open7" "S1|started|$(dago 1)|0" "S2|started|$(dago 1)|0" "S3|started|$(dago 1)|0" "S4|started|$(dago 1)|0" "S5|ready|$(dago 1)|0" "S6|ready|$(dago 1)|0" "S7|blocked|$(dago 1)|0"
pwork "$T/pw/open7b" "S1|started|$(dago 1)|0" "S2|started|$(dago 1)|0" "S3|started|$(dago 1)|0" "S4|started|$(dago 1)|0" "S5|ready|$(dago 1)|0" "S6|ready|$(dago 1)|0"
pwork "$T/pw/open8" "S1|started|$(dago 1)|0" "S2|started|$(dago 1)|0" "S3|started|$(dago 1)|0" "S4|started|$(dago 1)|0" "S5|ready|$(dago 1)|0" "S6|ready|$(dago 1)|0" "S7|started|$(dago 1)|0"
pwork "$T/pw/rdy"   "RA|ready|$(dago 1)|0" "RB|ready|$(dago 1)|0"
pwork "$T/pw/stale" "OLD|started|$(dago 40)|0" "NEW|started|$(dago 2)|0"
pwork "$T/pw/nodate" "NODATE|started||0"
# plan.md history: RA set ready 10 days ago, RB 2 days ago, OLD touched 40 days ago, NEW 2 days ago
git init -q "$T/pw/repo"; mkdir -p "$T/pw/repo/docs/dev"
pc() { GIT_AUTHOR_DATE="$2" GIT_COMMITTER_DATE="$2" git -C "$T/pw/repo" -c user.name=t -c user.email=t@t commit -qam "$1"; }
printf '%s\n' "- [RA] STATE:ready — a" "- [OLD] STATE:started — o" > "$T/pw/repo/docs/dev/plan.md"; git -C "$T/pw/repo" add -A; pc c1 "$(date -d '-40 day' -Iseconds)"
printf '%s\n' "- [RA] STATE:ready — a" "- [OLD] STATE:started — o" "- [RB] STATE:ready — b" > "$T/pw/repo/docs/dev/plan.md"; pc c2 "$(date -d '-2 day' -Iseconds)"
# RA was ready at c1 (40d); make it 10d: rewrite so the ready tag is introduced later
printf '%s\n' "- [OLD] STATE:started — o" "- [RA] STATE:started — a" "- [RB] STATE:ready — b" > "$T/pw/repo/docs/dev/plan.md"; pc c3 "$(date -d '-11 day' -Iseconds)"
printf '%s\n' "- [OLD] STATE:started — o" "- [RA] STATE:ready — a" "- [RB] STATE:ready — b" > "$T/pw/repo/docs/dev/plan.md"; pc c4 "$(date -d '-10 day' -Iseconds)"
printf '%s\n' "- [OLD] STATE:started — o" "- [RA] STATE:ready — a" "- [RB] STATE:ready — b" "- [NEW] STATE:started — n" > "$T/pw/repo/docs/dev/plan.md"; pc c5 "$(date -d '-2 day' -Iseconds)"
pq() { run "$T/ghok" "$@"; }
fires "plan rows quiet on a quiet fixture" "" "$T/ghok"
o=$(pq GESTALT_WORK_ENTRY="$T/pw/ow.py")
[ "$o" = "owner-waits: 2 (oldest 9d, OW1)" ] && ok "owner-waits: count, oldest age + tag" || bad "owner-waits: [$o]"
fires "owner-waits" owner-waits "$T/ghok" GESTALT_WORK_ENTRY="$T/pw/ow.py"
fires "open: 6 started+ready (at threshold) silent" "" "$T/ghok" GESTALT_WORK_ENTRY="$T/pw/open7b.py"
o=$(pq GESTALT_WORK_ENTRY="$T/pw/open8.py")
[ "$o" = "open: started 5 / ready 2 / blocked 0 (started+ready > 6)" ] && ok "open: 7 fires with counts" || bad "open: [$o]"
o=$(pq GESTALT_WORK_ENTRY="$T/pw/open7.py" | kinds); [ "$o" = "" ] && ok "open: blocked rows do not count" || bad "open blocked: [$o]"
o=$(pq GESTALT_WORK_ENTRY="$T/pw/rdy.py")
[ "$o" = "ready-idle: 1 (oldest 10d, RA; > 7d)" ] && ok "ready-idle: only the row ready > 7d" || bad "ready-idle: [$o]"
o=$(pq GESTALT_WORK_ENTRY="$T/pw/stale.py")
case $o in "stale: 1 started untouched > 21d (oldest "*"d, OLD)") ok "stale: only the row untouched > 21d" ;; *) bad "stale: [$o]" ;; esac
o=$(pq GESTALT_WORK_ENTRY="$T/pw/nodate.py" GESTALT_PLAN_GIT="$T/pw/nogit")
case $o in *"1 undated"*) ok "stale: an undated started row is counted and said" ;; *) bad "undated: [$o]" ;; esac
# questions
printf '## Questions for you\n\n- OPEN (%s, x): a?\n  1. cont\n- (answered %s: done)\n- FYI (%s): news\n\n## Next\n- OPEN (2000-01-01): not in the section\n' "$(date -d '-2 day' +%F)" "$(dago 3)" "$(dago 5)" > "$T/pw/owner.old"
printf '## Questions for you\n\n- OPEN (%s 23:59): fresh?\n\n## Next\n' "$(date +%F)" > "$T/pw/owner.new"
printf '## Questions for you\n\n- OPEN: no date here\n\n## Next\n' > "$T/pw/owner.undated"
printf '## Questions for you\n\n- (answered 2026-11-10: x)\n- FYI (2026-01-01): y\n' > "$T/pw/owner.answered"
o=$(pq GESTALT_OWNER_MD="$T/pw/owner.old"); case $o in "questions: 1 unanswered (1 over 24h, oldest "*"; 0 undated)") ok "questions: unanswered > 24h fires (answered/FYI/other sections ignored)" ;; *) bad "questions old: [$o]" ;; esac
fires "questions fresh (< 24h): silent" "" "$T/ghok" GESTALT_OWNER_MD="$T/pw/owner.new"
o=$(pq GESTALT_OWNER_MD="$T/pw/owner.undated"); [ "$o" = "questions: 1 unanswered (none over 24h; 1 undated)" ] && ok "questions: undated entry is counted and said (mtime not used)" || bad "questions undated: [$o]"
fires "questions all answered/FYI: silent" "" "$T/ghok" GESTALT_OWNER_MD="$T/pw/owner.answered"
# push-owed: a clone whose origin/main is behind main by commits aged 3 h / 1 h
git init -q -b main "$T/pw/up"; git -C "$T/pw/up" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
git clone -q "$T/pw/up" "$T/pw/cl" 2>/dev/null
GIT_COMMITTER_DATE="$(date -d '-3 hour' -Iseconds)" git -C "$T/pw/cl" -c user.name=t -c user.email=t@t commit -q --allow-empty -m old
git -C "$T/pw/cl" -c user.name=t -c user.email=t@t commit -q --allow-empty -m new
o=$(pq GESTALT_PUSH_DIR="$T/pw/cl"); [ "$o" = "push-owed: 2 commit(s) ahead of origin/main, oldest 3h" ] && ok "push-owed: count + oldest age" || bad "push-owed: [$o]"
git clone -q "$T/pw/up" "$T/pw/cl2" 2>/dev/null; git -C "$T/pw/cl2" -c user.name=t -c user.email=t@t commit -q --allow-empty -m young
fires "push-owed: newest-only unpushed < 2 h: silent" "" "$T/ghok" GESTALT_PUSH_DIR="$T/pw/cl2"
fires "push-owed: nothing unpushed: silent" "" "$T/ghok" GESTALT_PUSH_DIR="$T/pw/up"
# prune-owed: the cache holds wtprune's count; a fresh cache is used as is, a stale/absent one spawns the (stub) wtprune
printf '#!/bin/sh\necho "wtprune: 1 removable, 3 kept — dry run; re-run with --apply"\n' > "$T/pw/wtprune"; chmod +x "$T/pw/wtprune"
printf '#!/bin/sh\necho "wtprune: 9 removable, 3 kept — dry run; re-run with --apply"\n' > "$T/pw/wtprune9"; chmod +x "$T/pw/wtprune9"
pcache() { local d; d=$(mktemp -d "$T/pc.XXXXXX"); mkdir -p "$d/gestalt"; [ -n "$2" ] && echo "$(( $(date +%s) - $2 )) $1" > "$d/gestalt/prune.cache"; echo "$d"; }
o=$(pq PCREC_TMPDIR="$(pcache 6 60)"); case $o in "prune-owed: 6 removable worktree(s) (> 5; count 6"[0-9]"s old)") true ;; *) false ;; esac && ok "prune-owed: 6 > 5 fires" || bad "prune-owed: [$o]"
fires "prune-owed: 5 (at threshold) silent" "" "$T/ghok" PCREC_TMPDIR="$(pcache 5 60)"
d=$(pcache 1 7200); pq PCREC_TMPDIR="$d" GESTALT_WTPRUNE="$T/pw/wtprune9" >/dev/null; sleep 2
read -r _ n < "$d/gestalt/prune.cache"; [ "$n" = 9 ] && ok "prune-owed: stale cache refreshed in the background from wtprune" || bad "prune cache not refreshed: [$n]"
d=$(pcache 1 ""); o=$(GARGS=--all; pq PCREC_TMPDIR="$d" | grep '^prune-owed:'); sleep 2
case $o in "prune-owed: unknown"*) ok "prune-owed: no cache yet = unknown, not silent-green under --all" ;; *) bad "prune unknown: [$o]" ;; esac
# --all shows the plan rows even when quiet
GARGS=--all; qa=$(run "$T/ghok"); GARGS=""
for k in open questions push-owed prune-owed; do printf '%s\n' "$qa" | grep -q "^$k:" && ok "--all shows $k" || bad "--all missing $k"; done
# the work accessor failing is a row, not silence (K35)
fires "plan accessor fails" plan "$T/ghok" GESTALT_WORK_ENTRY="$T/ent/exit3.py"
# the log line is written on a silent run too
[ -s "$T/tmproot/gestalt/log.tsv" ] && ok "log.tsv written" || bad "log.tsv missing"
echo "gestalt.test: $pass pass, $fail fail"
[ "$fail" = 0 ]
