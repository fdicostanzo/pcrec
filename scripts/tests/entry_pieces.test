#!/usr/bin/env bash
# scripts/entry's `predicates` profile (form `pieces`): KEY = a path tag or a details slug, levels 0/1/2, exit codes
# 0 found / 1 none / 2 ambiguous, `-g` and `--state open` over the committed sample pred_doc/root, hand-written
# expectations. The lint's parser is the one the profile calls (pred_doc_lint.load_pieces).
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
. "$here/../tests/lib/timeout_bin.sh" 2>/dev/null
TO=${TIMEOUT_BIN:-timeout}
. "$here/tmpdir.sh"
scratch=$(mktemp -d -p "$PCREC_TMPDIR" entry_pieces.XXXXXX) || { echo "FAIL: no scratch"; exit 1; }
trap 'rm -rf "$scratch"' EXIT
$TO 120 python3 -I - "$here" "$scratch" <<'PY' || { echo "FAIL: entry_pieces"; exit 1; }
import importlib.machinery, importlib.util, io, os, shutil, sys
here, scratch = sys.argv[1], sys.argv[2]
sys.path.insert(0, here)
loader = importlib.machinery.SourceFileLoader("entry_mod", os.path.join(here, "entry"))
spec = importlib.util.spec_from_loader("entry_mod", loader)
entry = importlib.util.module_from_spec(spec)
loader.exec_module(entry)
import doc_profiles
root = os.path.join(here, "tests", "pred_doc", "root")
bad = []

def run(argv, rt=root):
    out = io.StringIO()
    rc = entry.run(argv, out, root=rt)
    return rc, out.getvalue().rstrip("\n").split("\n")

def check(label, cond):
    if not cond:
        bad.append(label)
        print("entry_pieces: FAIL " + label)

rc, o = run(["core/holes/class", "-l", "0"])
check("tag level 0", rc == 0 and o == ["### Class   [core/holes/class]   reading 2026-11-02",
      "A hole stands for one pattern fragment of the named class.", "entry: 1 items (profile predicates, level 0)"])
rc, o = run(["core/holes/class", "-l", "1"])
check("tag level 1 is the base piece (7 lines + trailer)", rc == 0 and len(o) == 8 and o[6].startswith("modes: n/a"))
rc, o = run(["core/holes/class"])
check("default level 2 adds the details entry", rc == 0 and "## core/holes/class — Class" in o and "slugs: hole-class shared-q" in o)
rc, o = run(["hole-class", "-l", "0"])
check("a slug finds its piece", rc == 0 and o[0].startswith("### Class "))
rc, o = run(["shared-q", "-l", "0"])
check("a slug on two tags is ambiguous (2)", rc == 2 and sum(1 for x in o if x.startswith("### ")) == 2)
rc, o = run(["no-such-slug"])
check("unknown slug exits 1", rc == 1)
rc, o = run(["core/holes/nowhere"])
check("unknown tag exits 1", rc == 1)
LD = "docs/design/predicates/library_details.md"
LB = "docs/design/predicates/library.md"


def variant(name, *edits):
    """A copy of the sample root with (path, old, new) edits applied (each OLD occurs once)."""
    d = os.path.join(scratch, name)
    shutil.copytree(root, d)
    for path, old, new in edits:
        f = os.path.join(d, path)
        t = open(f, encoding="utf-8").read()
        assert t.count(old) == 1, (name, path, old)
        open(f, "w", encoding="utf-8").write(t.replace(old, new))
    return d


WAS = "was: core/holes/word (2026-11-05, moved to the library)\n"
rc, o = run(["core/holes/word", "-l", "0"])
check("a previous tag resolves to its piece, the first line says so", rc == 0 and o[0] == "entry: was core/holes/word -> lib/names/word"
      and o[1] == "### Word   [lib/names/word]   ?  2026-11-05" and o[-1] == "entry: 1 items (profile predicates, level 0)")
rc, o = run(["core/holes/word"])
check("a previous tag at level 2 shows the details entry with its was: line",
      rc == 0 and o[0].startswith("entry: was ") and "was: core/holes/word (2026-11-05, moved to the library)" in o)
rc, o = run(["lib/names/word", "-l", "0"])
check("the current tag prints no was line", rc == 0 and o[0].startswith("### Word"))
rc, o = run(["-g", "core/holes/word", "-p", "predicates", "-l", "0"])
check("-g finds a piece by a previous tag", rc == 0 and o[0].startswith("### Word") and o[-1].startswith("entry: 1 items"))
v = variant("noentry", (LD, "\n## lib/names/word — Word\n" + WAS + "slugs:\n", ""))
rc, o = run(["lib/names/padded", "-l", "0"], rt=v)
check("a piece with no details entry resolves (its was list is empty)", rc == 0 and o[0].startswith("### Padded"))
rc, o = run(["core/holes/word", "-l", "0"], rt=v)
check("a previous tag whose entry is gone resolves to nothing, rc 1", rc == 1)
v = variant("twowas", (LD, WAS, WAS + "was: parked/ideas/old (2026-11-05, merged)\n"))
rc, o = run(["parked/ideas/old", "-l", "0"], rt=v)
check("a second was: line of an entry resolves too", rc == 0 and o[0] == "entry: was parked/ideas/old -> lib/names/word")
v = variant("badwas", (LD, WAS, "was: core/holes/word nodate\n"))
rc, o = run(["core/holes/word", "-l", "0"], rt=v)
check("an ungrammatical was: line still resolves by its first word", rc == 0 and o[0] == "entry: was core/holes/word -> lib/names/word")
v = variant("twoowners", (LD, "## lib/names/trimmed — Trimmed\n", "## lib/names/trimmed — Trimmed\n" + WAS))
rc, o = run(["core/holes/word", "-l", "0"], rt=v)
check("a previous tag retired by two entries is ambiguous (2), the first line names both",
      rc == 2 and o[0] in ("entry: was core/holes/word -> lib/names/trimmed, lib/names/word",
                           "entry: was core/holes/word -> lib/names/word, lib/names/trimmed"))
v = variant("dup", (LB, "[lib/names/trimmed]", "[lib/names/padded]"))
rc, o = run(["lib/names/padded", "-l", "0"], rt=v)
check("a live tag on two pieces is ambiguous (2) as a previous tag is", rc == 2 and sum(1 for x in o if x.startswith("### ")) == 2)
rc, o = run(["-g", ".", "-p", "predicates", "--state", "open"])
check("--state open lists the open pieces", rc == 0 and o[0].startswith("### Trimmed") and o[-1].startswith("entry: 1 items"))
rc, o = run(["-g", ".", "-p", "predicates", "--state", "principle"])
check("--state principle lists the principle pieces", rc == 0 and o[0].startswith("### Stated") and o[-1].startswith("entry: 1 items"))
rc, o = run(["-g", "regex", "-p", "predicates"])
check("-g finds a piece by its text", rc == 0 and any("regex-default" in x for x in o))
rc, o = run(["-g", ".", "-p", "predicates"], rt="/nonexistent-root-for-entry-test")
check("absent files: no items, rc 1, no crash", rc == 1)
rc, o = run(["--levels", "-p", "predicates"])
check("--levels names the profile", rc == 0 and o[0].startswith("predicates [pieces"))
rc, o = run(["D26"])
check("existing routing still reaches decisions (dormant, rc 1)", rc == 1)
check("the tag shape is a PL18 key shape", any(s == doc_profiles.PIECE_TAG_SHAPE for s in doc_profiles.KEY_SHAPES))
print("entry_pieces: %d failures" % len(bad))
sys.exit(1 if bad else 0)
PY
echo "PASS: entry_pieces"
