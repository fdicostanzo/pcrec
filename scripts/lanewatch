#!/usr/bin/env bash
# lanewatch — zero-model-call check that agents ended on a passing lanecheck
# ([LANECHECK] v1). One line per agent whose `.done` marker is missing,
# stale (the report or the DELIVER file changed after the marker) or
# hand-written (the marker's seal does not match its content; scripts/lanecheck
# writes it). An agent whose report said `STATE: stopped` has NAME.stopped:
# shown as one informational line, not a miss.
#
#   scripts/lanewatch [--dir D] NAME...
#
# Marker dir: --dir D for every NAME, else <main tree>/worktrees/NAME/build/
# lanecheck (where lanecheck puts it for a lane). Each miss is appended to
# worktrees/.mgr/lanecheck_misses.log (LANEWATCH_LOG overrides) as
# `UTC-time name kind`, skipping a repeat of the log's last entry for that
# name, so the file counts misses rather than polls.
#
# Output: the miss lines, then ONE final `lanewatch: DONE rc=N`.
# Exit: 0 every NAME has a good marker (or stopped); 1 at least one miss; 64 usage.
#
#   scripts/lanewatch --follow [--quiet-min N] [--every S] [--max-sec S] [--dir D] NAME
#
# FOLLOW MODE (the manager arms it in the background at every lane launch and
# relaunches it on CAP). Polls every S seconds (default 60) until ONE
# actionable state, prints that line, then the final `lanewatch: DONE rc=N`:
#   lanewatch: DONE NAME      the one-shot check above passes (it IS that check,
#                             run as `lanewatch [--dir D] NAME`; rc 0)
#   lanewatch: STOPPED NAME   no good marker, but the report said STATE: stopped (rc 13)
#   lanewatch: QUIET NAME <minutes> last-change=<ISO> last-commit=<ISO>   (rc 10)
#                             no good marker and no file change in the worktree
#                             AND no new commit for N minutes (default 25),
#                             counted from the LATEST of watch start, last file
#                             change, last commit
#   lanewatch: GONE NAME      the worktree disappeared (rc 11)
#   lanewatch: CAP NAME       --max-sec reached (default 14400 = 4 h): relaunch (rc 12)
# ACTIVITY = the newest mtime of any file under worktrees/NAME EXCEPT .git and
# build/lanecheck (the marker dir). build/ OTHERWISE COUNTS: measured on
# finished lanes (2026-10-27), a lane running its own sections writes
# build/*.log, build/watchdog.log, build/scr/, build/jobs/, objects; an idle
# lane writes nothing anywhere. Polling never appends to the misses log.
# Test overrides: --quiet-sec S (replaces --quiet-min), --tree D (worktree dir).
set -u
dir="" names=() follow=0 quiet_min=25 quiet_sec="" every=60 max_sec=14400 tree=""
while [ $# -gt 0 ]; do
    case $1 in
        --dir) [ $# -ge 2 ] || { echo "usage: scripts/lanewatch [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64; }; dir=$2; shift 2 ;;
        --follow) follow=1; shift ;;
        --quiet-min|--quiet-sec|--every|--max-sec|--tree)
            [ $# -ge 2 ] || { echo "usage: scripts/lanewatch [--follow ...] [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64; }
            case $1 in --quiet-min) quiet_min=$2 ;; --quiet-sec) quiet_sec=$2 ;; --every) every=$2 ;; --max-sec) max_sec=$2 ;; --tree) tree=$2 ;; esac
            shift 2 ;;
        -h|--help) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*) echo "usage: scripts/lanewatch [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64 ;;
        *) names+=("$1"); shift ;;
    esac
done
[ ${#names[@]} -gt 0 ] || { echo "usage: scripts/lanewatch [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64; }
common=$(git -C "$(dirname "$0")" rev-parse --git-common-dir 2>/dev/null) || common=""
case $common in /*) ;; *) common=$(cd "$(dirname "$0")" && cd "$common" 2>/dev/null && pwd) ;; esac
main=$(dirname "${common:-/nonexistent/.git}")
log=${LANEWATCH_LOG:-$main/worktrees/.mgr/lanecheck_misses.log}
if command -v sha256sum > /dev/null; then hsum() { sha256sum "$@" | cut -d' ' -f1; }; else hsum() { shasum -a 256 "$@" | cut -d' ' -f1; }; fi
if [ $follow = 1 ]; then
    [ ${#names[@]} = 1 ] || { echo "usage: scripts/lanewatch --follow [--quiet-min N] [--every S] [--max-sec S] NAME"; echo "lanewatch: DONE rc=64"; exit 64; }
    n=${names[0]}; t=${tree:-$main/worktrees/$n}
    qs=${quiet_sec:-$((quiet_min*60))}
    iso() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ; }
    start=$(date +%s)
    fin() { echo "lanewatch: $1"; echo "lanewatch: DONE rc=$2"; exit "$2"; }
    while :; do
        [ -d "$t" ] || fin "GONE $n" 11
        out=$(LANEWATCH_LOG=/dev/null bash "$0" ${dir:+--dir "$dir"} "$n" 2>&1); rc=$?
        if [ $rc = 0 ]; then
            case $out in *"stopped early"*) fin "STOPPED $n" 13 ;; *) fin "DONE $n" 0 ;; esac
        fi
        act=$(find "$t" \( -name .git -o -path "$t/build/lanecheck" \) -prune -o -type f -printf '%T@\n' 2>/dev/null | cut -d. -f1 | sort -n | tail -1)
        cm=$(git -C "$t" log -1 --format=%ct 2>/dev/null)
        act=${act:-0}; cm=${cm:-0}
        now=$(date +%s)
        last=$start; [ "$act" -gt "$last" ] && last=$act; [ "$cm" -gt "$last" ] && last=$cm
        [ $((now-last)) -ge "$qs" ] && fin "QUIET $n $(( (now-last)/60 )) last-change=$([ "$act" = 0 ] || iso "$act") last-commit=$([ "$cm" = 0 ] || iso "$cm")" 10
        [ $((now-start)) -ge "$max_sec" ] && fin "CAP $n" 12
        sleep "$every"
    done
fi
miss=0
field() { sed -n "s/^$1=//p" "$2" | head -1; }
note() { # NAME KIND TEXT
    echo "$1: $3"; miss=$((miss+1))
    mkdir -p "$(dirname "$log")" 2>/dev/null
    local last; last=$(grep -F " $1 " "$log" 2>/dev/null | tail -1 | awk '{print $3}')
    [ "$last" = "$2" ] || printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> "$log" 2>/dev/null
}
for n in "${names[@]}"; do
    d=${dir:-$main/worktrees/$n/build/lanecheck}
    m=$d/$n.done
    if [ ! -f "$m" ]; then
        if [ -f "$d/$n.stopped" ]; then echo "$n: stopped early per its report ($(field report "$d/$n.stopped"))"; continue; fi
        note "$n" missing "no $n.done in $d: the agent has not passed scripts/lanecheck"; continue
    fi
    want=$({ printf 'lanecheck-v1\n'; grep -v '^seal=' "$m"; } | hsum /dev/stdin)
    if [ "$(field seal "$m")" != "$want" ] || [ "$(field name "$m")" != "$n" ]; then
        note "$n" hand-written "$m is not a lanecheck marker (seal mismatch)"; continue
    fi
    rep=$(field report "$m"); dl=$(field deliver "$m")
    if [ ! -f "$rep" ] || [ "$(hsum "$rep")" != "$(field report_sha "$m")" ]; then
        note "$n" stale "the report $rep changed (or vanished) after the marker; run scripts/lanecheck again"; continue
    fi
    if [ ! -f "$dl" ] || [ "$(hsum "$dl")" != "$(field deliver_sha "$m")" ]; then
        note "$n" stale "the DELIVER file $dl changed after the marker; run scripts/lanecheck again"; continue
    fi
done
rc=0; [ $miss -gt 0 ] && rc=1
echo "lanewatch: DONE rc=$rc"; exit $rc
