#!/usr/bin/env bash
# lanewatch — zero-model-call check that agents ended on a passing lanecheck
# ([LANECHECK] v1). One line per agent whose `.done` marker is missing,
# stale (the report or the DELIVER file changed after the marker) or
# hand-written (the marker's seal does not match its content; scripts/lanecheck
# writes it). An agent whose report said `STATE: stopped` has NAME.stopped:
# shown as one informational line, not a miss.
#
#   scripts/lanewatch [--dir D] NAME...
#
# Marker dir: --dir D for every NAME, else <main tree>/worktrees/NAME/build/
# lanecheck (where lanecheck puts it for a lane). Each miss is appended to
# worktrees/.mgr/lanecheck_misses.log (LANEWATCH_LOG overrides) as
# `UTC-time name kind`, skipping a repeat of the log's last entry for that
# name, so the file counts misses rather than polls.
#
# Output: the miss lines, then ONE final `lanewatch: DONE rc=N`.
# Exit: 0 every NAME has a good marker (or stopped); 1 at least one miss; 64 usage.
set -u
dir="" names=()
while [ $# -gt 0 ]; do
    case $1 in
        --dir) [ $# -ge 2 ] || { echo "usage: scripts/lanewatch [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64; }; dir=$2; shift 2 ;;
        -h|--help) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*) echo "usage: scripts/lanewatch [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64 ;;
        *) names+=("$1"); shift ;;
    esac
done
[ ${#names[@]} -gt 0 ] || { echo "usage: scripts/lanewatch [--dir D] NAME..."; echo "lanewatch: DONE rc=64"; exit 64; }
common=$(git -C "$(dirname "$0")" rev-parse --git-common-dir 2>/dev/null) || common=""
case $common in /*) ;; *) common=$(cd "$(dirname "$0")" && cd "$common" 2>/dev/null && pwd) ;; esac
main=$(dirname "${common:-/nonexistent/.git}")
log=${LANEWATCH_LOG:-$main/worktrees/.mgr/lanecheck_misses.log}
if command -v sha256sum > /dev/null; then hsum() { sha256sum "$@" | cut -d' ' -f1; }; else hsum() { shasum -a 256 "$@" | cut -d' ' -f1; }; fi
miss=0
field() { sed -n "s/^$1=//p" "$2" | head -1; }
note() { # NAME KIND TEXT
    echo "$1: $3"; miss=$((miss+1))
    mkdir -p "$(dirname "$log")" 2>/dev/null
    local last; last=$(grep -F " $1 " "$log" 2>/dev/null | tail -1 | awk '{print $3}')
    [ "$last" = "$2" ] || printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> "$log" 2>/dev/null
}
for n in "${names[@]}"; do
    d=${dir:-$main/worktrees/$n/build/lanecheck}
    m=$d/$n.done
    if [ ! -f "$m" ]; then
        if [ -f "$d/$n.stopped" ]; then echo "$n: stopped early per its report ($(field report "$d/$n.stopped"))"; continue; fi
        note "$n" missing "no $n.done in $d: the agent has not passed scripts/lanecheck"; continue
    fi
    want=$({ printf 'lanecheck-v1\n'; grep -v '^seal=' "$m"; } | hsum /dev/stdin)
    if [ "$(field seal "$m")" != "$want" ] || [ "$(field name "$m")" != "$n" ]; then
        note "$n" hand-written "$m is not a lanecheck marker (seal mismatch)"; continue
    fi
    rep=$(field report "$m"); dl=$(field deliver "$m")
    if [ ! -f "$rep" ] || [ "$(hsum "$rep")" != "$(field report_sha "$m")" ]; then
        note "$n" stale "the report $rep changed (or vanished) after the marker; run scripts/lanecheck again"; continue
    fi
    if [ ! -f "$dl" ] || [ "$(hsum "$dl")" != "$(field deliver_sha "$m")" ]; then
        note "$n" stale "the DELIVER file $dl changed after the marker; run scripts/lanecheck again"; continue
    fi
done
rc=0; [ $miss -gt 0 ] && rc=1
echo "lanewatch: DONE rc=$rc"; exit $rc
