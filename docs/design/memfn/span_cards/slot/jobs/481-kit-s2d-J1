#!/usr/bin/env bash
# 481-kit-s2d-J1: the S2d window's timing job J1 (span_cards §3.7; quiet-gated, idle-ok). Ready: kit-s2d-prep green, then kit-s2d-screen green
# (its verdict UNDER the half gate; non-green -> 77, [rev1.3 r9fc-FIX-7]).
. "${PCREC_TMPDIR:-/var/tmp/pcrec-$(id -un)}/scratch/memfn/s2c/jobs/s2d/common.sh"   # absolute: boxqueue runs a COPY of this file from its own dir
case "${1:-}" in
    --dry-run) timing_dry J1 400 ;;
    --ready) ready_after  ;;
esac
timing_job J1
