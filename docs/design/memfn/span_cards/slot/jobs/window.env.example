# window.env for the S2d jobs (copy beside the queued job copies as window.env; main fills it when the window is
# cleared with Frank). Shell assignments only.
RUN_ID=""                                            # the window's run id
FROZEN=""                                            # the commit the window times: its sha (hex; resolved to the full sha)
TREE=/home/pcrec/projects/pcrec/worktrees/s2c        # the checkout (its HEAD must be FROZEN)
HOLD=""                                              # optional: a script whose non-zero exit holds every job
