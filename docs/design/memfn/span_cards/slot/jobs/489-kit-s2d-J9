#!/usr/bin/env bash
# 489-kit-s2d-J9: the S2d window's LAST step (span_cards §3.5 READY-2, [rev1.3 r9-G6]): record.py finalize, the
# window facts, `jobs` from the queue's end states by record.py's CAUSE table (green, failed, wait-timeout,
# cancelled, none), `plan` and `floor` from the dry run's frozen plan, the transcript's sha. Ready when the prep and
# the screen ENDED and every window job ended or was never queued (a failed, cancelled or never-queued job is recorded,
# never waited for).
. "${PCREC_TMPDIR:-/var/tmp/pcrec-$(id -un)}/scratch/memfn/s2c/jobs/s2d/common.sh"   # absolute: boxqueue runs a COPY of this file from its own dir
case "${1:-}" in
    --dry-run)
        check_inputs "$(basename "$0")" || exit 1
        echo "would run: python3 -I $SLOT/record.py finalize $RUNDIR $RUN_ID $CODE_COMMIT $RUNDIR/states"
        echo "boxqueue: cap 300"; echo "boxqueue: patience none"; echo "boxqueue: est 10"
        echo "boxqueue: expect none reason=one record write; its line == s2 FINALIZE"
        exit 0 ;;
    --ready)
        hold
        for k in kit-s2d-prep kit-s2d-screen; do
            ended $k || { echo "waits: $k $(bq state $k)"; exit 75; }
        done
        for j in $JOBS; do      # `none`: never queued, recorded as such, never waited for
            s=$(bq state kit-s2d-$j)
            case $s in green|failed|cancelled|none) ;; *) echo "waits: kit-s2d-$j $s"; exit 75 ;; esac
        done
        exit 0 ;;
esac
: > "$RUNDIR/states"
for j in $JOBS; do
    s=$(bq state kit-s2d-$j)
    case $s in
        failed) grep -q "^$j	quiet	wait-timeout" "$RUNDIR/transcript.tsv" 2>/dev/null && s=wait-timeout ;;
    esac
    printf '%s\t%s\n' "$j" "$s" >> "$RUNDIR/states"
done
python3 -I "$SLOT/record.py" finalize "$RUNDIR" "$RUN_ID" "$CODE_COMMIT" "$RUNDIR/states"
