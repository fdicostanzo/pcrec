+static void proto_fold(Ctx *cx, uint8_t *f)
+{
+    /* superset of every fold relation pcrec uses: ASCII pairs; anything
+     * >= 0x80, or any letter under a non-byte encoding, widens to all */
+    const PcrecEnc *e = pcrec_enc_by_id(cx->opt->encoding);
+    for (int c = 0x80; c < 256; c++) if (cls_has(f, (unsigned)c)) { bs_all(f); return; }
+    for (int c = 'a'; c <= 'z'; c++)
+        if (cls_has(f, (unsigned)c) || cls_has(f, (unsigned)(c - 32))) {
+            if (e->max_cp > 0xFF && (c == 'k' || c == 's')) { bs_all(f); return; }
