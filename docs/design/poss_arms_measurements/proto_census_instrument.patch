+/* polarity mask of class `x` against set C: bit0 = has a member outside C,
+ * bit1 = has a member inside C. Interval arithmetic, exact. */
+static unsigned proto_pol(const Ast *x, const PcrecCpRange *C, int n)
+{
+    unsigned m = 0;
+    for (int i = 0; i < x->u.cls.n; i++) {
+        unsigned lo = x->u.cls.iv[i].lo, hi = x->u.cls.iv[i].hi, c = lo;
+        while (c <= hi) {
+            /* find the C interval covering c, or the next one */
+            int j = 0;
+            while (j < n && C[j].hi < c) j++;
+            if (j < n && C[j].lo <= c) { m |= 2; if (C[j].hi >= hi) break; c = C[j].hi + 1; }
+            else { m |= 1; if (j == n || C[j].lo > hi) break; c = C[j].lo; }
+        }
+    }
+    return m;
+}
