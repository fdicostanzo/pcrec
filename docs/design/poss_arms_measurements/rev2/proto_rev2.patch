+/* S(P): the code points <= 0xFF whose membership in C is admitted by fn for
+ * some p in pmask (bit0: p=0, bit1: p=1).  Returns false when Q(P) = {0,1}
+ * (no narrowing).  A-F3: Q(P) non-empty but S empty -> widen (return false). */
+static bool px_S(const Ast *g, unsigned pmask, uint8_t *out)
+{
+    bool qok[2] = { false, false };
+    for (int p = 0; p < 2; p++) if (pmask & (1u << p))
+        for (int q = 0; q < 2; q++)
+            if (g->u.ctx.fn & (1u << ((p << 1) | q))) qok[q] = true;
+    if (qok[0] && qok[1]) return false;
+    bs_clear(out);
+    bool any = false;
+    for (unsigned c = 0; c < 256; c++) {
+        bool in = iv_has(g->u.ctx.iv, g->u.ctx.n, c);
+        if (qok[in]) { cls_set(out, c); any = true; }
+    }
+    if (!any && (qok[0] || qok[1]) && !PX.sab_nowiden) return false;
+    return true;
