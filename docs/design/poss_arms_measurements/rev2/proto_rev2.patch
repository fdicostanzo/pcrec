+static First first_ctx(Ctx *cx, const Ast *a)
+{
+    switch (a->k) {
+    case A_CTX: {
+        First r;
+        if (!PX.a0only && px_S(a, px_pmask(a), r.f)) { r.nullable = false; return r; }
+        return first_of(cx, a);
+    }
+    case A_CAP: case A_ATOMIC: return first_ctx(cx, a->l);
+    case A_CAT: {
+        First acc = fst_empty(true);
+        const Ast *t = a;
+        while (t->k == A_CAT) { acc = fst_seq(first_ctx(cx, t->r), acc); t = t->l; }
+        return fst_seq(first_ctx(cx, t), acc);
+    }
+    case A_ALT: {
+        First acc = fst_empty(false);
+        const Ast *t = a;
+        for (;;) {
+            const Ast *br = t->k == A_ALT ? t->r : t;
+            First r = first_ctx(cx, br);
+            bs_or(acc.f, r.f); acc.nullable = acc.nullable || r.nullable;
+            if (t->k != A_ALT) break;
+            t = t->l;
+        }
