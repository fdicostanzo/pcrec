# edge W: ucp/ctxnode.rxt:400; the newline context
# pcre2-only
pattern (?m)(?<=\n)a|b$
tag edge=W
ms 0 "\naa" 1 2
ms 1 "\naa" 1 2
ns 2 "\naa"
ns 3 "\naa"
ms 0 "\na" 1 2
ms 1 "\na" 1 2
ns 2 "\na"
ms 0 "x\na" 2 3
