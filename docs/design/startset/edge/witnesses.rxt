ms 1 "azw" 1 2
ms 2 "azw" 2 3
ns 3 "azw"
ms 0 "aaz" 2 3
ms 1 "aaz" 2 3
ms 2 "aaz" 2 3
ns 3 "aaz"
ns 0 "za"
ns 1 "za"
ns 2 "za"
ms 0 "waz" 0 1
ms 1 "waz" 2 3
ms 2 "waz" 2 3
ns 3 "waz"
ms 0 "zaz" 2 3
ms 1 "zaz" 2 3
ms 2 "zaz" 2 3
ns 3 "zaz"
ms 0 "aaaz" 3 4
ms 1 "aaaz" 3 4
ms 2 "aaaz" 3 4
ms 3 "aaaz" 3 4
ns 4 "aaaz"
ms 0 "awz" 1 2
ms 1 "awz" 1 2
ns 2 "awz"
ns 3 "awz"
ns 0 ""

