ns 1 "b\n"
ns 2 "b\n"
ms 0 "\nab" 1 2
ms 1 "\nab" 1 2
ms 2 "\nab" 2 3
ns 3 "\nab"
ms 0 "a\nb" 2 3
ms 1 "a\nb" 2 3
ms 2 "a\nb" 2 3
ns 3 "a\nb"
ns 0 "aa"
ns 1 "aa"
ns 2 "aa"

# edge W3: THREE seed states (s0, a-ctx, b-ctx), S\E = {y,z}: E* without any ONE seed is still 256 here, so the omit-one-seed mutant is the identical table; r3's S ∩ E = {w} loses both
# pcre2-only
pattern (?:(?<=a)z|(?<=b)y|w)
tag edge=W3
ms 0 "az" 1 2
ms 1 "az" 1 2
ns 2 "az"
ms 0 "by" 1 2
ms 1 "by" 1 2
ns 2 "by"
ms 0 "xaz" 2 3
ms 1 "xaz" 2 3
ms 2 "xaz" 2 3
ns 3 "xaz"
ms 0 "xby" 2 3
ms 1 "xby" 2 3
ms 2 "xby" 2 3
ns 3 "xby"
ms 0 "abyaz" 2 3
ms 1 "abyaz" 2 3
ms 2 "abyaz" 2 3
ms 3 "abyaz" 4 5
ms 4 "abyaz" 4 5
ns 5 "abyaz"
ns 0 "bz"
ns 1 "bz"
ns 2 "bz"
ns 0 "ay"
ns 1 "ay"
ns 2 "ay"
ms 0 "w" 0 1
ns 1 "w"

# edge W: S\E = {x} but Tdfa = {y}: x is a CONTEXT here (its own class), never a thread start; r3's set is UNSOUND only where an S\E byte is in Tdfa, and this block is the control that it is not always
# pcre2-only
pattern (?:\b|x)y
tag edge=W
ms 0 "xy" 0 2
ns 1 "xy"
ns 2 "xy"
ms 0 " xy" 1 3
ms 1 " xy" 1 3
ns 2 " xy"
ns 3 " xy"
ms 0 "zxy" 1 3
ms 1 "zxy" 1 3
ns 2 "zxy"
ns 3 "zxy"
ms 0 "y" 0 1
ns 1 "y"
ms 0 " y" 1 2
ms 1 " y" 1 2
ns 2 " y"
ns 0 "zy"
ns 1 "zy"
ns 2 "zy"

# edge S0: a 2-seed MOVER where E* WITHOUT s0 drops a: a begins a match only from the nonword context, so a set built from the word-context seed alone skips the start at 1 of ' ab'
# pcre2-only
pattern (?:\bab|x)
tag edge=S0
ms 0 " ab" 1 3
ms 1 " ab" 1 3
ns 2 " ab"
ns 3 " ab"
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ns 0 "zab"
ns 1 "zab"
ns 2 "zab"
ns 3 "zab"
ms 0 "xab" 0 1
ns 1 "xab"
ns 2 "xab"
ns 3 "xab"
ms 0 " x" 1 2
ms 1 " x" 1 2
ns 2 " x"
ms 0 "abab" 0 2
ns 1 "abab"
ns 2 "abab"
ns 3 "abab"
ns 4 "abab"
ms 0 " ax ab" 2 3
ms 1 " ax ab" 2 3
ms 2 " ax ab" 2 3
ms 3 " ax ab" 4 6
ms 4 " ax ab" 4 6
ns 5 " ax ab"
ns 6 " ax ab"

