# edge W: matrix.rxt:1064; S\E = {z}: z begins a match only in the a-context the skip reaches by leaving s0
# pcre2-only
pattern (?:(?<=a)z|w)
tag edge=W
ms 0 "aza" 1 2
ms 1 "aza" 1 2
ns 2 "aza"
ns 3 "aza"
ms 0 "az" 1 2
ms 1 "az" 1 2
ns 2 "az"
