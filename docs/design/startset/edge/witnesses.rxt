# pcre2-only
pattern (?:\Bab|x)
tag edge=S0
ms 0 "zab" 1 3
ms 1 "zab" 1 3
ns 2 "zab"
ns 3 "zab"
ns 0 "ab"
ns 1 "ab"
ns 2 "ab"
ns 0 " ab"
ns 1 " ab"
ns 2 " ab"
ns 3 " ab"
ms 0 "zzab" 2 4
