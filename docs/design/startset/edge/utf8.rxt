# edge U8: the context character é is TWO bytes C3 A9: the byte before the start is a CONTINUATION byte
# pcre2-only
pattern (?:(?<=é)a|\bw)
encoding utf8
tag edge=U8
ms 0 "\xc3\xa9a" 2 3
ms 2 "\xc3\xa9a" 2 3
ns 3 "\xc3\xa9a"
ms 0 "x\xc3\xa9a" 3 4
ms 1 "x\xc3\xa9a" 3 4
ms 3 "x\xc3\xa9a" 3 4
ns 4 "x\xc3\xa9a"
ns 0 "ea"
ns 1 "ea"
ns 2 "ea"
ms 0 "w" 0 1
ns 1 "w"
ms 0 "\xc3\xa9w" 2 3
ms 2 "\xc3\xa9w" 2 3
ns 3 "\xc3\xa9w"
ns 0 "\xa9a"
ns 1 "\xa9a"
ns 2 "\xa9a"
ms 0 "\xc3\xa9\xc3\xa9a" 4 5
ms 2 "\xc3\xa9\xc3\xa9a" 4 5
ms 4 "\xc3\xa9\xc3\xa9a" 4 5
ns 5 "\xc3\xa9\xc3\xa9a"

# edge U8: the witness under utf8, with ill-formed bytes around the context
# pcre2-only
pattern (?:(?<=a)z|w)
encoding utf8
tag edge=U8
ms 0 "az" 1 2
ms 1 "az" 1 2
ns 2 "az"
ms 0 "\xc3\xa9az" 3 4
ms 2 "\xc3\xa9az" 3 4
ms 3 "\xc3\xa9az" 3 4
ns 4 "\xc3\xa9az"
ns 0 "a\xc3\xa9z"
