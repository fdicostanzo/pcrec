ns 3 "a\xc3\xa9z"
ns 4 "a\xc3\xa9z"
ns 0 "a\xffz"
ns 1 "a\xffz"
ns 2 "a\xffz"
ns 3 "a\xffz"
ms 0 "\xffaz" 2 3
ms 1 "\xffaz" 2 3
ms 2 "\xffaz" 2 3
ns 3 "\xffaz"
ms 0 "aza" 1 2
ms 1 "aza" 1 2
ns 2 "aza"
ns 3 "aza"

# edge U8: utf8, ASCII \b: a multi-byte character is a NONWORD context; a lone continuation or 0xFF too
# pcre2-only
pattern \b(?:ab|cd)\b
encoding utf8
tag edge=U8
ms 0 "\xc3\xa9ab ab" 2 4
ms 2 "\xc3\xa9ab ab" 2 4
ms 3 "\xc3\xa9ab ab" 5 7
ms 4 "\xc3\xa9ab ab" 5 7
ms 5 "\xc3\xa9ab ab" 5 7
ns 6 "\xc3\xa9ab ab"
ns 7 "\xc3\xa9ab ab"
ms 0 "x\xc3\xa9ab" 3 5
ms 1 "x\xc3\xa9ab" 3 5
ms 3 "x\xc3\xa9ab" 3 5
ns 4 "x\xc3\xa9ab"
ns 5 "x\xc3\xa9ab"
ms 0 "\xc3ab" 1 3
ms 1 "\xc3ab" 1 3
ns 2 "\xc3ab"
ns 3 "\xc3ab"
ms 0 "\xffab ab" 1 3
ms 1 "\xffab ab" 1 3
ms 2 "\xffab ab" 4 6
ms 3 "\xffab ab" 4 6
ms 4 "\xffab ab" 4 6
ns 5 "\xffab ab"
ns 6 "\xffab ab"
ms 0 "\xe4\xb8\x80ab" 3 5
ms 3 "\xe4\xb8\x80ab" 3 5
ns 4 "\xe4\xb8\x80ab"
ns 5 "\xe4\xb8\x80ab"
ms 0 "ab\x80" 0 2
ns 1 "ab\x80"
ns 3 "ab\x80"

# edge U8CI: utf8 caseless: KELVIN SIGN (E2 84 AA) folds to k but is not an ASCII word byte
# pcre2-only
pattern \b(?:ab|cd)\b
flags i
encoding utf8
tag edge=U8CI
ms 0 "\xe2\x84\xaaab ab" 3 5
ms 3 "\xe2\x84\xaaab ab" 3 5
ms 4 "\xe2\x84\xaaab ab" 6 8
ms 5 "\xe2\x84\xaaab ab" 6 8
ms 6 "\xe2\x84\xaaab ab" 6 8
ns 7 "\xe2\x84\xaaab ab"
ns 8 "\xe2\x84\xaaab ab"
ns 0 "Kab"
ns 1 "Kab"
ns 2 "Kab"
ns 3 "Kab"
ms 0 "kAB ab" 4 6
ms 1 "kAB ab" 4 6
ms 2 "kAB ab" 4 6
ms 3 "kAB ab" 4 6
ms 4 "kAB ab" 4 6
ns 5 "kAB ab"
ns 6 "kAB ab"

# edge U8CI: a caseless start set holding a UTF-8 LEAD byte (E2 for U+212A)
# pcre2-only
pattern \bk\w
flags i
encoding utf8
tag edge=U8CI
ns 0 "\xe2\x84\xaax"
ns 3 "\xe2\x84\xaax"
ns 4 "\xe2\x84\xaax"
ms 0 "x\xe2\x84\xaax" 1 5
ms 1 "x\xe2\x84\xaax" 1 5
ns 4 "x\xe2\x84\xaax"
ns 5 "x\xe2\x84\xaax"
ms 0 "kx" 0 2
ns 1 "kx"
ns 2 "kx"
ms 0 " Kx" 1 3
ms 1 " Kx" 1 3
ns 2 " Kx"
ns 3 " Kx"
ms 0 "x kx" 2 4
ms 1 "x kx" 2 4
ms 2 "x kx" 2 4
ns 3 "x kx"
ns 4 "x kx"
