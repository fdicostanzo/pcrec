oracle pcre2/10.46

# edge LB2: a hybrid MOVER (T = {d,w}): the two-byte context bc spans the skipped bytes; the prefilter erases the lookbehind and the VM verifies
# pcre2-only
pattern \b(?:(?<=bc)d|w)
tag edge=LB2
ns 0 "bcd"
ns 1 "bcd"
ns 2 "bcd"
ns 3 "bcd"
ns 0 " bcd"
ns 1 " bcd"
ns 2 " bcd"
ns 3 " bcd"
ns 4 " bcd"
ns 0 "bc d"
ns 1 "bc d"
ns 2 "bc d"
ns 3 "bc d"
ns 4 "bc d"
ns 0 "abcd"
ns 1 "abcd"
ns 2 "abcd"
ns 3 "abcd"
ns 4 "abcd"
ms 0 "w" 0 1
ns 1 "w"
ms 0 " w" 1 2
ms 1 " w" 1 2
ns 2 " w"
ns 0 "xw"
ns 1 "xw"
ns 2 "xw"
ns 0 "bcw"
ns 1 "bcw"
ns 2 "bcw"
ns 3 "bcw"
ns 0 "d"
ns 1 "d"
ns 0 " d"
ns 1 " d"
ns 2 " d"

# edge LB2: a hybrid mover; the two context bytes are both skipped (neither is in T = {z,w})
# pcre2-only
pattern (?<=ab)z|\bw
