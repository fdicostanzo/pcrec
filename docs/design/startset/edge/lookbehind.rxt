ms 2 "aabcd" 4 5
ms 3 "aabcd" 4 5
ms 4 "aabcd" 4 5
ns 5 "aabcd"
ms 0 "w" 0 1
ns 1 "w"
ns 0 "abcw"
ns 1 "abcw"
ns 2 "abcw"
ns 3 "abcw"
ns 4 "abcw"
ms 0 "abcda" 3 4
ms 1 "abcda" 3 4
ms 2 "abcda" 3 4
ms 3 "abcda" 3 4
ns 4 "abcda"
ns 5 "abcda"

# edge LBN: nested lookbehind beside a one-byte context: a seeded hybrid, S\E = {z} (declined; r3 admits it)
# pcre2-only
pattern (?:(?<=b(?<=ab)c)d|(?<=a)z)
tag edge=LBN
ms 0 "abcd" 3 4
ms 1 "abcd" 3 4
ms 2 "abcd" 3 4
ms 3 "abcd" 3 4
ns 4 "abcd"
ms 0 "az" 1 2
ms 1 "az" 1 2
ns 2 "az"
ns 0 "xbcd"
ns 1 "xbcd"
ns 2 "xbcd"
ns 3 "xbcd"
ns 4 "xbcd"
ms 0 "aza" 1 2
ms 1 "aza" 1 2
ns 2 "aza"
ns 3 "aza"
ms 0 "abcdaz" 3 4
ms 1 "abcdaz" 3 4
ms 2 "abcdaz" 3 4
ms 3 "abcdaz" 3 4
ms 4 "abcdaz" 5 6
ms 5 "abcdaz" 5 6
ns 6 "abcdaz"

# edge LBNEG: a NEGATIVE one-byte lookbehind: a DFA mover; the skipped a must suppress z
# pcre2-only
pattern (?:(?<!a)z|w)
tag edge=LBNEG
ns 0 "az"
ns 1 "az"
ns 2 "az"
ms 0 "z" 0 1
ns 1 "z"
