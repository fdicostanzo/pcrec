# edge BD: match at subject start and end, the empty subject; the bounded skip's n-1 stop
# pcre2-only
pattern \b(?:ab|cd)\b
tag edge=BD
ns 0 ""
ns 0 "a"
ns 1 "a"
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ns 0 "b"
ns 1 "b"
ns 0 "xab"
ns 1 "xab"
ns 2 "xab"
ns 3 "xab"
ns 0 "abx"
ns 1 "abx"
ns 2 "abx"
ns 3 "abx"
ms 0 "x ab" 2 4
ms 1 "x ab" 2 4
ms 2 "x ab" 2 4
ns 3 "x ab"
ns 4 "x ab"
ms 0 "ab " 0 2
ns 1 "ab "
ns 2 "ab "
ns 3 "ab "

# edge BD: the witness at the subject edges
# pcre2-only
pattern (?:(?<=a)z|w)
tag edge=BD
ns 0 ""
ns 0 "z"
ns 1 "z"
ms 0 "w" 0 1
ns 1 "w"
ns 0 "a"
ns 1 "a"
ms 0 "az" 1 2
ms 1 "az" 1 2
ns 2 "az"

# edge BG: \G: an ATTEMPT-scan machine (no DFA-hat skip site); the unconditional re-seed's only hazard is a \G start state, and \G never reaches the unanchored scan
# pcre2-only
pattern \G(?:ab|cd)\b
tag edge=BG
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ns 0 "xab"
ms 1 "xab" 1 3
ns 2 "xab"
ns 3 "xab"
ns 0 "abab"
ns 1 "abab"
ms 2 "abab" 2 4
ns 3 "abab"
ns 4 "abab"
ms 0 "ab ab" 0 2
ns 1 "ab ab"
ns 2 "ab ab"
ms 3 "ab ab" 3 5
ns 4 "ab ab"
ns 5 "ab ab"
ns 0 ""

# edge BG: \G beside \b: a HYBRID with a \G start family (attempt scan)
# pcre2-only
pattern (?:\Gx|\b)(?:ab|cd)\b
tag edge=BG
ms 0 "xab" 0 3
ns 1 "xab"
ns 2 "xab"
ns 3 "xab"
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ns 0 "zxab"
ms 1 "zxab" 1 4
ns 2 "zxab"
ns 3 "zxab"
ns 4 "zxab"
ms 0 "x ab" 2 4
ms 1 "x ab" 2 4
ms 2 "x ab" 2 4
ns 3 "x ab"
ns 4 "x ab"
ms 0 " ab" 1 3
ms 1 " ab" 1 3
ns 2 " ab"
ns 3 " ab"

# edge SF: search_from > 0 with a word byte BEFORE search_from: the entry initializer reads s[startpos-1]
# pcre2-only
pattern \b(?:ab|cd)\b
tag edge=SF
ms 0 "zab ab" 4 6
ms 1 "zab ab" 4 6
ms 2 "zab ab" 4 6
ms 3 "zab ab" 4 6
ms 4 "zab ab" 4 6
ns 5 "zab ab"
ns 6 "zab ab"
ms 0 "z ab" 2 4
ms 1 "z ab" 2 4
ms 2 "z ab" 2 4
ns 3 "z ab"
ns 4 "z ab"
ms 0 "zzab ab" 5 7
ms 1 "zzab ab" 5 7
ms 2 "zzab ab" 5 7
ms 3 "zzab ab" 5 7
ms 4 "zzab ab" 5 7
