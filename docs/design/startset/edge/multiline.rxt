oracle pcre2/10.46

# edge ML: the line start as a skip context: \r is NOT a newline (LF is pcrec's only convention, D64)
# pcre2-only
pattern (?m)(?:^|x)(?:ab|cd)
tag edge=ML
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ms 0 "\nab" 1 3
ms 1 "\nab" 1 3
ns 2 "\nab"
ns 3 "\nab"
ms 0 "xab" 0 3
ns 1 "xab"
ns 2 "xab"
ns 3 "xab"
ns 0 "zab"
ns 1 "zab"
ns 2 "zab"
ns 3 "zab"
ms 0 "z\nab" 2 4
ms 1 "z\nab" 2 4
ms 2 "z\nab" 2 4
ns 3 "z\nab"
ns 4 "z\nab"
ns 0 "\rab"
ns 1 "\rab"
ns 2 "\rab"
ns 3 "\rab"
ms 0 "\r\nab" 2 4
ms 1 "\r\nab" 2 4
ms 2 "\r\nab" 2 4
ns 3 "\r\nab"
ns 4 "\r\nab"
ms 0 "zxab" 1 4
ms 1 "zxab" 1 4
ns 2 "zxab"
ns 3 "zxab"
ns 4 "zxab"

# edge ML: (?m)$ before LF only
# pcre2-only
pattern (?m)(?:ab|cd)$
tag edge=ML
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ms 0 "ab\n" 0 2
ns 1 "ab\n"
ns 2 "ab\n"
ns 3 "ab\n"
ns 0 "abx"
