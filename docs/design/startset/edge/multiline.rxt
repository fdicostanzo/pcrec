ns 3 "ab\r\n"
ns 4 "ab\r\n"
ns 0 "ab\r"
ns 1 "ab\r"
ns 2 "ab\r"
ns 3 "ab\r"
ms 0 "xab\nab" 1 3
ms 1 "xab\nab" 1 3
ms 2 "xab\nab" 4 6
ms 3 "xab\nab" 4 6
ms 4 "xab\nab" 4 6
ns 5 "xab\nab"
ns 6 "xab\nab"

# edge ML: the witness at CR and CRLF bytes
# pcre2-only
pattern (?m)(?<=\n)a|b$
tag edge=ML
ms 0 "\r\na" 2 3
ms 1 "\r\na" 2 3
ms 2 "\r\na" 2 3
ns 3 "\r\na"
ns 0 "\ra"
ns 1 "\ra"
ns 2 "\ra"
ms 0 "\n\na" 2 3
ms 1 "\n\na" 2 3
ms 2 "\n\na" 2 3
ns 3 "\n\na"
ns 0 "b\r"
ns 1 "b\r"
ns 2 "b\r"
ms 0 "\na\r" 1 2
ms 1 "\na\r" 1 2
ns 2 "\na\r"
ns 3 "\na\r"

# edge ML: a CR context: an ordinary byte
# pcre2-only
pattern (?:(?<=\r)a|w)
tag edge=ML
ms 0 "\ra" 1 2
ms 1 "\ra" 1 2
ns 2 "\ra"
ns 0 "\r\na"
ns 1 "\r\na"
ns 2 "\r\na"
ns 3 "\r\na"
ns 0 "a"
ns 1 "a"
ns 0 "\na"
ns 1 "\na"
ns 2 "\na"
ms 0 "x\ra" 2 3
ms 1 "x\ra" 2 3
ms 2 "x\ra" 2 3
ns 3 "x\ra"
ms 0 "\ra\r" 1 2
ms 1 "\ra\r" 1 2
ns 2 "\ra\r"
ns 3 "\ra\r"

# edge ML: \b and (?m)$ together
# pcre2-only
pattern (?m)\b(?:ab|cd)$
tag edge=ML
ms 0 "ab" 0 2
ns 1 "ab"
