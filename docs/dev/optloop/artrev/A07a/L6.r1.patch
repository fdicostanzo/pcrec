+/* [ARTREV L6] the run counters live in locals for the attempt.  The slot
+   stores are ptrdiff_t and the depth counters size_t: the same type for
+   aliasing purposes, so through `run->` every slot or trail store forces the
+   counters to be re-loaded and re-stored.  Locals cannot alias; they are
+   written back on every return (rx_reset_for_next_attempt reads them). */
+#undef RX_CHARGE_WORK
+#undef RX_TRAIL
+#undef RX_PUSH
+#undef RX_CUT
+#define RX_RET(v_) do { run->resume_depth = rx_rd; run->trail_depth = rx_td; \
+        run->steps_left = rx_steps; run->work_left = rx_work; return (v_); } while (0)
+#define RX_CHARGE_WORK(n_) do {                                    \
+        ptrdiff_t nw_ = (ptrdiff_t)(n_);                     \
+        if (nw_ > 0) {                                       \
+            rx_work -= (long long)nw_;                       \
+            if (rx_work < 0) RX_RET(RX_R_WORK);               \
+        }                                                    \
+    } while (0)
+#define RX_TRAIL(slot_) do {                                  \
+        if (rx_td >= rx_trail_cap) RX_RET(RX_R_FRAMES);    \
+        rx_trail[rx_td].slot_index = (unsigned)(slot_);               \
+        rx_trail[rx_td].saved_value = slot_values[(slot_)];                       \
+        rx_td++;                                             \
+    } while (0)
+#define RX_PUSH(lbl_, p_) do {                                \
+        if (rx_rd >= rx_resume_cap) RX_RET(RX_R_FRAMES);       \
+        rx_stack[rx_rd].resume_label = (lbl_);                             \
+        rx_stack[rx_rd].resume_position = (p_);                             \
+        rx_stack[rx_rd].trail_mark = rx_td;                          \
+        rx_rd++;                                             \
+    } while (0)
