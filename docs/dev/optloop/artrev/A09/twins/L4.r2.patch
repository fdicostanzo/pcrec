+/* [ARTREV L4] 1 when the prefilter's window [start, end) is itself the match the
+   VM would report from start: start holds a whole level literal and its \b
+   (the DFA proved both), end is the first keyword\b after it on its line (the
+   DFA dies there), and the gap between them fits .{0,200}.  The lazy step
+   tries keywords left to right, so it stops at that same keyword. */
+static int rx_window_is_match(const unsigned char *subject, size_t start, size_t end)
+{
+    static const struct { const char *text; size_t len; } rx_keywords[5] = {
+        { "timed out", 9 }, { "timeout", 7 }, { "refused", 7 }, { "denied", 6 }, { "unreachable", 11 },
+    };
+    size_t level_end = start + (subject[start] == 'C' ? 4 : 5);
+    int k;
+    for (k = 0; k < 5; k++) {
+        size_t len = rx_keywords[k].len;
+        if (end >= level_end + len && !memcmp(subject + end - len, rx_keywords[k].text, len))
+            return end - len - level_end <= 200;
+    }
+    return 0;
+}
