+/* [ARTREV L1] position of the next byte c at or after from, or n when there is none. */
+static inline size_t rx_next_byte(const unsigned char *subject, size_t n, size_t from, int c)
+{
+    const unsigned char *hit = (const unsigned char *)memchr(subject + from, c, n - from);
+    return hit ? (size_t)(hit - subject) : n;
