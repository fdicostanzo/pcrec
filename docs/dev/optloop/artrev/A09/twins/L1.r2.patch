+/* [ARTREV L1] the first p >= from where one of ERROR/FATAL/CRIT starts at a word
+   start (p == 0 or subject[p-1] is \W), or n.  Two streams: 'O' (ERROR+3) and
+   'T' (FATAL+2, CRIT+3); the rarest bytes of the three literals on the bench's
+   loglines subjects (measured; a byte-frequency choice). */
+static inline int rx_word_start(const unsigned char *subject, size_t p, const unsigned char *can_begin)
+{ return p == 0 || !can_begin[subject[p - 1]]; }
+static size_t rx_next_level_o(const unsigned char *subject, size_t n, size_t from, const unsigned char *can_begin)
+{
+    size_t x = from + 3;
+    for (;; x++) {
+        if (x >= n || (x = rx_next_byte(subject, n, x, 'O')) >= n) return n;
+        if (x + 2 <= n && rx_w4(subject + x - 3) == rx_w4("ERRO") && subject[x + 1] == 'R'
+            && rx_word_start(subject, x - 3, can_begin)) return x - 3;
+    }
+}
+static size_t rx_next_level_t(const unsigned char *subject, size_t n, size_t from, const unsigned char *can_begin)
+{
+    size_t x = from + 2;
+    for (;; x++) {
+        if (x >= n || (x = rx_next_byte(subject, n, x, 'T')) >= n) return n;
+        if (x + 3 <= n && rx_w2(subject + x - 2) == rx_w2("FA") && rx_w2(subject + x + 1) == rx_w2("AL")
+            && rx_word_start(subject, x - 2, can_begin)) return x - 2;
+        if (x >= from + 3 && rx_w4(subject + x - 3) == rx_w4("CRIT")
+            && rx_word_start(subject, x - 3, can_begin)) return x - 3;
+    }
+}
 
