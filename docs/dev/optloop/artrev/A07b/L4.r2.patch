+/* [ARTREV L1] the first atom is \b and every start byte is a \w byte, so an
+ * attempt can only pass rx_L0 where the PREVIOUS byte is not \w: skip the rest
+ * of a word we are inside, then the non-word bytes.  Skipped attempts fail at
+ * rx_L0 with no frame pushed, no slot written and no budget charged. */
+#define RX_L1_W(c_) ((rx_class_bitmap0[(c_) >> 3] >> ((c_) & 7)) & 1)
+static inline size_t rx_next_word_start(const unsigned char *subject, size_t subject_length, size_t p)
+{
+    if (p > 0 && p < subject_length && RX_L1_W(subject[p - 1]))
+        while (p < subject_length && RX_L1_W(subject[p])) p++;
+    while (p < subject_length && !RX_L1_W(subject[p])) p++;
+    return p;
 }
 
