+/* window FIND: 4 kset terms + look-behind \\W term; walk on 0 */
+static inline size_t p9_find(const unsigned char *s, size_t n, size_t c)
+{
+    if (n < 4) return n;
+    const size_t last = n - 4;   /* the last position a candidate may sit at */
+    while (c <= last) {
+        while (c < last && !p9_s0[s[c + 0]]) c++;
+        if (!p9_s0[s[c + 0]]) return n;
+        if ((c == 0 || !p9_word[s[c - 1]]) && p9_s1[s[c + 1]] && p9_s2[s[c + 2]] && p9_s3[s[c + 3]]) return c;
+        c++;
+    }
+    return n;
+}
