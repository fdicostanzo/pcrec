PLANT v1lane: DETECTED  (expect pickable, check rc=3, excluded: o-fwd v1,)  -- the one-term SWAR find answers one byte late
PLANT walktab: DETECTED  (expect pickable, check rc=3, excluded: o-fwd libc,o-fwd loop,o-fwd none,o-fwd v1,o-fwd walk,)  -- the BASE walk's table holds the wrong member byte (leg O: base vs libpcre2)
PLANT nonerev: DETECTED  (expect pickable, check rc=3, excluded: o-fwd none,)  -- the NONE arm's match start one byte late
PLANT tw0walk: DETECTED  (expect instrument, check rc=0, excluded: dig tw0,)  -- the twin's walk helper inverted
PLANT tw1mask: DETECTED  (expect instrument, check rc=0, excluded: dig tw1,)  -- the twin's V1 mask misses the digit 9
PLANT sc0walk: DETECTED  (expect instrument, check rc=0, excluded: hex-run sc0,)  -- the scaffold's walk helper inverted (only a GATE-ONLY dense group can see it)
PLANT tw2cycle: DETECTED  (expect instrument, check rc=0, excluded: dig tw2,f3-dig tw2,)  -- the streamed timed loop re-times buffer 0 forever (leg C)
restore: check.sh green again
plants: ALL DETECTED
