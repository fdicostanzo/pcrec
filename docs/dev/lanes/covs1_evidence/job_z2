#!/usr/bin/env bash
# covs1-z2: the Z2 census on the candidate trace build (COVERSET + the listing) and X0's stated check, 1-in-M (cover_cap.md §3.6 Q2, K35)
set -u
. /home/pcrec/projects/pcrec/worktrees/covs1/docs/dev/lanes/covs1_evidence/common.sh
MOD=${COVS1_STATED_MOD:-10}
case "${1:-}" in
    --dry-run)
        [ -f "$TREE/docs/dev/kvcensus/patterns.tsv.gz" ] || { echo "no census" >&2; exit 1; }
        echo "would run in $TREE: z2.py census, hist, stated --mod $MOD"
        echo "boxqueue: cap 3600"; echo "boxqueue: est 2400"; echo "boxqueue: patience none"
        echo "boxqueue: expect none reason=the stated check's rc is the job's rc (exec'd last)"
        exit 0 ;;
    --ready) ready_after ;;
esac
tree_build || exit 1
mkdir -p "$TREE/build/x0"
gcc -O2 -std=gnu11 -o "$TREE/build/x0/x0pcre" "$TREE/docs/design/kit_proof/x0/x0pcre.c" -lpcre2-8 || exit 1
cd "$TREE" || exit 1
export X0PCRE=build/x0/x0pcre PCREC=build/pcrec HT=build/z2trace/pcrec-harness
python3 docs/design/kit_proof/z2/z2.py census "$SC/z2census.jsonl" -j 16 || exit 1
python3 docs/design/kit_proof/z2/z2.py hist "$SC/z2census.jsonl" > "$SC/z2hist.txt" || exit 1
tail -40 "$SC/z2hist.txt"
exec python3 docs/design/kit_proof/z2/z2.py stated "$SC/z2census.jsonl" --mod "$MOD" -j 16
