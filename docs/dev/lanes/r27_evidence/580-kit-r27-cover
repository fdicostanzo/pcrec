#!/usr/bin/env bash
# 580-kit-r27-cover: lane r27 (DESIGN ONLY): the 650 harness's 8 cells x 3 regimes x 3 classes over
# FIVE arms (DEF, COV, AA, and the hand-rendered PROPOSED REPORT form PRO and its shifted twin SHF,
# proto_bodies.py), 5 launches, one pinned core. Reading rule: read_r27.py's header.
# Queue it with:  scripts/boxqueue add --name 580-kit-r27-cover FILE
# Everything it writes is under $OUT (the r27 worktree's build/r27/job, gitignored).
#   --dry-run  measure_r27.sh smoke (cached build + both answer gates): NO clock
#   --ready    the 650 job's quiet gate: load1 < 2.0 on two samples >= 55 s apart, no running
#              queue job, no box-lock holder
#   (work)     exec measure_r27.sh run
set -u
W=/home/pcrec/projects/pcrec/worktrees/memfn-r27
E=$W/docs/dev/lanes/r27_evidence
OUT=$W/build/r27/job
MAIN=/home/pcrec/projects/pcrec
export TMPDIR=$W/build/tmp
export MEASURE_CPU=7 MEASURE_SIBLING=15
L=5 T=20000000 N=9
case "${1:-}" in
    --dry-run)
        mkdir -p "$TMPDIR" "$OUT" || exit 1
        [ -x "$W/build/pcrec" ] && [ -x "$W/build/pcrec-harness" ] || { echo "build/pcrec or build/pcrec-harness missing in $W" >&2; exit 1; }
        python3 -I -c 'import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]' "$E/read_r27.py" "$E/proto_bodies.py" || exit 1
        bash "$E/measure_r27.sh" smoke "$OUT" > "$OUT/dry.out" 2>&1 || { tail -5 "$OUT/dry.out" >&2; exit 1; }
        tail -3 "$OUT/dry.out" | sed 's/^/dry: /'
        echo "would run: measure_r27.sh run $OUT $L $T $N (pinned to cpu $MEASURE_CPU), arms DEF COV AA PRO SHF"
        echo "boxqueue: cap 1500"
        echo "boxqueue: patience none"
        echo "boxqueue: idle-ok"
        echo "boxqueue: expect done=1 lines=^== r27 COMPLETE"
        exit 0 ;;
    --ready)
        mkdir -p "$OUT" || exit 1
        st=$OUT/ready.state
        now=$(date +%s)
        if ls "$MAIN"/worktrees/.boxqueue/running/* > /dev/null 2>&1; then rm -f "$st"; echo "a queue job is running"; exit 75; fi
        h=$("$MAIN/scripts/boxlock" status 2>&1 | head -1)
        case "$h" in HELD*) rm -f "$st"; echo "box lock $h"; exit 75 ;; esac
        l=$(cut -d' ' -f1 /proc/loadavg)
        if ! awk -v l="$l" 'BEGIN { exit !(l < 2.0) }'; then rm -f "$st"; echo "load1 $l >= 2.0"; exit 75; fi
        first=$(cat "$st" 2>/dev/null || echo 0)
        if [ "$first" -gt 0 ] && [ $((now - first)) -le 600 ]; then
            [ $((now - first)) -ge 55 ] && exit 0
            echo "second quiet sample due in $((55 - now + first)) s (load1 $l)"; exit 75
        fi
        echo "$now" > "$st"
        echo "first quiet sample taken (load1 $l); the second is due in 55 s"; exit 75 ;;
esac
rm -f "$OUT/ready.state"
exec bash "$E/measure_r27.sh" run "$OUT" "$L" "$T" "$N"
