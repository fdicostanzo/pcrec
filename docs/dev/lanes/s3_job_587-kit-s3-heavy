#!/usr/bin/env bash
# 587-kit-s3-heavy: lane s3 (D172 S3, branch lane/memfn-s3w), the CORRECTNESS job before main lands
# S3 (window_site.md rev 3.2 §5.2, §6; the manager's R1-R6). Stages, each "== s3 step NAME rc=N":
#   build, strict   make -j16; make strict
#   refbuild        main c3ea619c3 built from `git archive` under $OUT/ref (the reference compiler)
#   census          s3_evidence/census.py: every distinct corpus (pattern, its block's options:
#                   flags i/u, encoding; code review r1 C11) x {c-default, c-utf8, c-vm,
#                   --emit-ir, --emit-facts, the OFF arm --memfn=no-wf-find,no-wf-hors, and (the
#                   S3 review's item D) c-simd (-fmemfn-simd) and c-norun (-fno-run-prefilter) with
#                   their own OFF arms off-simd/off-norun} against the reference, abi digits mapped
#                   back; the movers DECLARED from the S3 artifact's own RX_DFA_SCAN "cover" stamp
#                   on that arm (pcrec-side, never the kit's `moved`) and judged BOTH ways; each
#                   OFF arm expects ZERO movers. It stands in for emit_sweep's streams,
#                   which have no abi normalization (corefix's census precedent, b3build's note)
#   sweep_start     emit_sweep.py --arms start, the S3 binary on both sides: the DIFFER_PINS floors
#                   (a reader the cover population moves: cover patterns leave the start family)
#   evidence        s3_evidence/bytediff.sh (the PREDICTED manifest, default and OFF arms) and
#                   list_axes_delta.sh (the declared --list-axes delta), against the same reference
#   codegen         make test-codegen
#   test            the full make test through scripts/perfrun (verdict: make's *** [..test-X] lines)
#   memfn_link      make test-memfn-link
#   plants          memfn/tests/run_g2_win.sh --plants (S1400-S1410, S1422, S1423, S1425-S1429, S1540),
#                   tests/memfn/run_proof.sh --plants, tests/memfn/run_wreply.sh --plants
#   mech            the derived sabotage union (window_site.md §5.4; s3_report.md "Build" part): the
#                   rows re-anchored (S693 S1079 S1105) and every row of an arm whose detector S3
#                   edited (nomatchcaps dfastamps offsetskip scanedge facts memfnfinder memfnarms
#                   memfnmanifest; the codegen arm's rows tied to its edited blocks): 108 rows;
#                   and (the S3 code review r1's C1 build) every row whose SAB_FILE or detector is a
#                   file that build edited (window/finder/ofsskip/gate/compose/kit, fields/options.def,
#                   the G2 window family, rows.tsv/finder_check/simd floors): 125 rows in all
#   reach           REACH_ONLY=1 over the whole matrix ([MECH-REACH]: cover took 828 DFA witnesses)
# Code review r2 (lane s3pair, 2026-10-23; the PAIR widening R2-1, one two-stream renderer R2-6,
# Table D's row actions R2-7): the tree is worktrees/s3pair, and against the C1 TIP (ae83da9d4,
# built under $OUT/c1ref) it adds
#   census_r2       s3_evidence/census_r2.py: every corpus (pattern, options) x {c-default, c-utf8,
#                   c-simd, c-norun, c-vm, ir, facts, off, off-simd}, the movers DECLARED from the
#                   artifacts' own B-pair text (`_mfN_ha < `) and judged both ways
#   evidence_r2     bytediff_r2.sh (predicted_r2.tsv, default and OFF arms) against the C1 tip
#   diff_r2         s3_evidence/diff_r2.py: the widened PAIR's answers against Python `re`, both
#                   layers, ASan+UBSan (>= 1,000 witness cases, its own floor)
#   axes_measure    tests/axes/memfn_arm.py --measure over wf-find/wf-hors at both layers: the
#                   per-cell counts MEMFN_CLASS's floors for those rows are pinned from (OWED)
#   axes_memfn      tests/axes' memfn arm alone (AXES=--memfn MEMFN_REACH_ONLY=1): every kit row,
#                   wf-find and wf-hors now in MEMFN_CLASS (R2-4)
# and the plant S1540 (the shared renderer) and the mech row S1026 (the axes memfn arm's own).
# Correctness run: no quiet gate; held while i2build-parity is pending or running.
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/s3pair
BASE=c3ea619c3
C1TIP=ae83da9d4
OUT=$TREE/build/s3/heavy587
E=$TREE/docs/dev/lanes/s3_evidence
NSTEPS=19
IDS="S185 S186 S227 S277 S278 S279 S284 S285 S287 S296 S297 S298 S299 S300 S302 S303 S306 S307 S316 S318 S438 S439 S443 S444 S446 S447 S448 S449 S450 S451 S452 S453 S454 S455 S457 S458 S459 S510 S511 S512 S520 S528 S570 S596 S613 S617 S618 S619 S666 S667 S669 S670 S671 S673 S676 S677 S681 S682 S684 S685 S686 S687 S688 S689 S690 S691 S692 S693 S694 S695 S709 S712 S724 S728 S729 S730 S754 S773 S774 S782 S783 S787 S788 S791 S800 S801 S802 S803 S804 S846 S847 S848 S917 S919 S921 S1018 S1020 S1025 S1079 S1080 S1081 S1082 S1083 S1084 S1089 S1091 S1092 S1100 S1103 S1105 S1106 S1107 S1108 S1109 S1110 S1122 S1221 S1224 S1225 S1415 S1416 S1417 S1418 S1419 S1421 S1026"
case "${1:-}" in
    --dry-run)
        [ -e "$TREE/.git" ] || { echo "no tree $TREE" >&2; exit 1; }
        git -C "$TREE" rev-parse --verify -q "$BASE^{commit}" >/dev/null || { echo "BASE $BASE unknown" >&2; exit 1; }
        git -C "$TREE" rev-parse --verify -q "$C1TIP^{commit}" >/dev/null || { echo "C1TIP $C1TIP unknown" >&2; exit 1; }
        # docs/dev/artifact_size_log.tsv is a full-suite run's byproduct (tests/size/run_size_log.sh),
        # dirty after any `make test` in this tree and never this job's input
        git -C "$TREE" diff --quiet HEAD -- . ':(exclude)docs/dev/artifact_size_log.tsv' ||
            { echo "worktree dirty" >&2; exit 1; }
        python3 -I -c 'import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]' "$E/census.py" "$E/census_r2.py" "$E/diff_r2.py" || exit 1
        python3 "$TREE/scripts/emit_sweep.py" --help >/dev/null 2>&1 || { echo "emit_sweep --help fails" >&2; exit 1; }
        [ -x "$TREE/scripts/perfrun" ] || { echo "no scripts/perfrun" >&2; exit 1; }
        # the 126-row mech field validation takes ~100 s, over boxqueue's 30 s
        # dry-run bound, so it runs as the job's FIRST step (mechval) instead
        echo "would run in $TREE: mechval(126 ids) build strict refbuild c1ref census census_r2 sweep_start evidence evidence_r2 diff_r2 codegen axes_measure axes_memfn test memfn_link plants mech(126 rows) reach"
        echo "boxqueue: cap 21600"
        echo "boxqueue: patience none"
        echo "boxqueue: idle-ok"
        echo "boxqueue: expect steps=$NSTEPS lines=^== s3 step [a-z_]+ rc=0\$"
        exit 0 ;;
    --ready)
        case "$(bash /home/pcrec/projects/pcrec/scripts/boxqueue state i2build-parity 2>/dev/null)" in pending*|running*) echo held; exit 75;; esac
        exit 0 ;;
esac
cd "$TREE" || exit 1
TIP=$(git rev-parse HEAD)
echo "== s3 heavy tip $TIP vs $BASE"
mkdir -p "$OUT"
export TMPDIR=$TREE/build/tmp
mkdir -p "$TMPDIR"
bad=0
step() {
    local name=$1; shift
    echo "== s3 step $name start $(date +%T): $*"
    "$@" > "$OUT/$name.log" 2>&1
    local rc=$?
    grep -E 'strict:|census:|movers|UNEXPECTED|COMPLETE|bytediff[_a-z0-9]*:|list-axes delta|DONE rc=|\*\*\* \[|checks (passed|failed)|PLANT|R-28|ANOMALY|mech run COMPLETE|REACH|memfn arm:|DIFF |FAILED' "$OUT/$name.log" | tail -40
    echo "== s3 step $name rc=$rc"
    [ "$rc" -eq 0 ] || bad=$((bad + 1))
}
refbuild() {
    rm -rf "$OUT/ref" && mkdir -p "$OUT/ref" &&
        git -C "$TREE" archive "$BASE" | tar -x -C "$OUT/ref" &&
        make -C "$OUT/ref" -j16
}
c1ref() {
    rm -rf "$OUT/c1ref" && mkdir -p "$OUT/c1ref" &&
        git -C "$TREE" archive "$C1TIP" | tar -x -C "$OUT/c1ref" &&
        make -C "$OUT/c1ref" -j16
}
evidence_r2() {
    local r=0
    bash "$E/bytediff_r2.sh" "$OUT/c1ref/build/pcrec" build/pcrec "$OUT/bd2_def" || r=1
    bash "$E/bytediff_r2.sh" "$OUT/c1ref/build/pcrec" build/pcrec "$OUT/bd2_off" --memfn=no-wf-find,no-wf-hors || r=1
    return $r
}
evidence() {
    local r=0
    bash "$E/bytediff.sh" "$OUT/ref/build/pcrec" build/pcrec "$OUT/bd_def" || r=1
    bash "$E/bytediff.sh" "$OUT/ref/build/pcrec" build/pcrec "$OUT/bd_off" --memfn=no-wf-find,no-wf-hors || r=1
    bash "$E/list_axes_delta.sh" "$OUT/ref/build/pcrec" build/pcrec || r=1
    return $r
}
plants() {
    local r=0
    bash memfn/tests/run_g2_win.sh --plants || r=1
    bash tests/memfn/run_proof.sh --plants || r=1
    bash tests/memfn/run_wreply.sh --plants || r=1
    return $r
}
mechval() {
    local out n
    out=$(VALIDATE_ONLY=1 bash tests/mech/run_sabotage_matrix.sh $IDS 2>&1) || { printf '%s\n' "$out" | tail -3; return 1; }
    n=$(printf '%s\n' "$out" | sed -n 's/^== mech FIELD VALIDATION COMPLETE: \([0-9]*\) def.*/\1/p')
    echo "mechval: ${n:-none} ids valid"
    [ "$n" = 126 ]
}
step mechval mechval
step build make -j16
step strict make strict
step refbuild refbuild
step c1ref c1ref
step census python3 -I "$E/census.py" --base "$OUT/ref/build/pcrec" --new build/pcrec --tree "$TREE" --out "$OUT/census.tsv" --jobs 16
step census_r2 python3 -I "$E/census_r2.py" --base "$OUT/c1ref/build/pcrec" --new build/pcrec --tree "$TREE" --out "$OUT/census_r2.tsv" --jobs 16
step sweep_start python3 scripts/emit_sweep.py --ref-bin build/pcrec --bin build/pcrec --tree "$TREE" --no-self-check --arms start --out "$OUT/sw_start"
step evidence evidence
step evidence_r2 evidence_r2
step diff_r2 python3 -I "$E/diff_r2.py" --pcrec build/pcrec --out "$OUT/diff_r2"
step codegen make test-codegen
step axes_measure python3 -I tests/axes/memfn_arm.py --pcrec build/pcrec --root "$TREE" --jobs 16 --measure \
    --cell 'wf-find|default|--memfn=no-wf-find' --cell 'wf-find|simd|-fmemfn-simd --memfn=no-wf-find' \
    --cell 'wf-hors|default|--memfn=no-wf-hors' --cell 'wf-hors|simd|-fmemfn-simd --memfn=no-wf-hors'
step axes_memfn env AXES=--memfn MEMFN_REACH_ONLY=1 bash tests/axes/run_axes.sh
step test scripts/perfrun --label s3 -- "$OUT/test.make.log"
grep -E '\*\*\* \[(Makefile:[0-9]+: )?test-' "$OUT/test.make.log" | sed 's/^/test-red: /'
step memfn_link make test-memfn-link
step plants plants
step mech bash tests/mech/run_sabotage_matrix.sh $IDS
step reach env REACH_ONLY=1 bash tests/mech/run_sabotage_matrix.sh
echo "== s3 heavy: $bad step(s) failed"
[ "$bad" -eq 0 ]
