+            reverse_state = rw_reverse_step(rw_reverse_next_state, reverse_state, rw_reverse_byte_class[subject[--rewind_position]]);
+            if (!rw_reverse_is_stop(reverse_state)) continue;   // the generic path
+            if (rw_reverse_is_dead(reverse_state)) break;   // dead: no match can continue
