+ptrdiff_t rx_match(const rx_ctx *ctx);
 int rx_search(const unsigned char *subject, size_t subject_length, size_t search_from, ptrdiff_t (*capture_spans)[2])
 {
+    /* p1dsg TWIN: candidates from the landmark byte 64; P's reverse DFA seeded at the
+     * landmark (here: P.L's reverse machine seeded at the landmark's end), floored at
+     * search_from; one anchored forward match at the smallest accepting start. */
+    {
+        size_t p = search_from;
+        while (p < subject_length) {
+            const unsigned char *q = memchr(subject + p, 64, subject_length - p);
+            if (!q) return 0;
+            size_t at = (size_t)(q - subject);
+            size_t st = rw_walk(subject, at + 1, search_from);
+            if (st != (size_t)-1) {
+                rx_ctx c; c.subject = subject; c.len = subject_length; c.pos = st;
+                ptrdiff_t m = rx_match(&c);
+                if (m >= 0) {
+                    if (capture_spans) { capture_spans[0][0] = (ptrdiff_t)st; capture_spans[0][1] = (ptrdiff_t)(st + (size_t)m); }
+                    return 1;
+                }
+            }
+            p = at + 1;
+        }
+        return 0;
+    }
+
     if (subject_length <= search_from ||
         !memchr(subject + search_from, 64, subject_length - search_from))
