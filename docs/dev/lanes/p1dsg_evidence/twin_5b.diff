+typedef unsigned rw_reverse_state;
+static inline rw_reverse_state rw_reverse_step(const unsigned short *transitions, rw_reverse_state s, unsigned cl)
+{ return transitions[s + cl]; }
+static inline int rw_reverse_is_dead(rw_reverse_state s) { return s == 65535; }
+static inline int rw_reverse_is_stop(rw_reverse_state s) { return (unsigned)s >= 6u; }
+static inline int rw_reverse_accepts(const unsigned char *accepting, rw_reverse_state s)
+{ return accepting[s]; }
