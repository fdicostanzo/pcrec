    '9:59'       -> accept 
    '10:00'      -> accept 
    '10:01'      -> reject 
    '8:59'       -> reject 
    '11:00'      -> reject 
    '9:5'        -> reject 
  triple_between(/\d{1,2}/, ":", /\d\d/, /\d\d/, 9, 30, 5, 10, 0, 0)   (h:m:s, 9:30:05 to 10:00:00)
    '9:30:05'    -> accept 
    '09:30:05'   -> accept 
    '9:59:59'    -> accept 
    '10:00:00'   -> accept 
    '9:30:04'    -> reject 
    '10:00:01'   -> reject 
