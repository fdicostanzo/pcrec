== m byte
(?<=a{1,2}|b)x	bx	[1-2]
(?<=a{2,3}|b)x	bx	[1-2]
(?<=a{1,2}|bc)x	bcx	[2-3]
(?<=a{1,2})a	aaa	[1-2][2-3]
(?<!a{1,2})a	aaa	[0-1]
(?<*(a|aaa))c\1	aaaca	[3-5,2-3]
(?<*(a{1,3}))c\1	aaaca	[3-5,2-3]
(?<=(a|aa))c	aac	[2-3,0-2]
(?<=a{1,2})x	abx	nomatch
(?<=(a|ab)(b|))x	abbx	[3-4,0-2,2-3]
(?<!ab?)x	acx	[2-3]
(?<=(a)|(aa))c	aac	[2-3,1-2]
(?<=bc|d)x	abcx	[3-4]
(?<!bc|d)x	bcax	[3-4]
(?<=(a{1,2}|b)c)x	bcx	[2-3,0-1]
(?<!a{1,2}|b)x	bx	nomatch
(?<=a{1,2})b	aab	[2-3]
(?<!a{1,2})b	aab	nomatch
(?<=\ba{1,2})x	baax	nomatch
== m utf
(?<=(é{1,2}))x	éx	[2-3,0-2]
(?<=(é{1,2}))x	aééx	[5-6,1-5]
(?<=(é{1,2}))x	aéx	[3-4,1-3]
(?<=\ba{1,2})x	baax	[3-4]
== c byte
(?<=(?:a{1000}){65})x		ACCEPT lb=65000
(?<=(?:a{1000}){66})x		REJECT 187
(?<=a{65535}b)x		REJECT 187
(?<=a{65535})x		ACCEPT lb=65535
(?<=a{1,255})x		ACCEPT lb=255
(?<=a{1,256})x		REJECT 200
(?<=a{300}|b{1,2})x		REJECT 200
(?<=a{300}|b)x		ACCEPT lb=300
(a{300})(?<=\1)x		ACCEPT lb=300
(a)(?<=\1|b{300})x		ACCEPT lb=300
(?<=\1)(a{300})x		ACCEPT lb=300
(a{300})(?<=\1|b{1,2})x		REJECT 200
(?<=(a)\1)x		ACCEPT lb=2
(?<=\1(a))x		ACCEPT lb=2
(?<=\1)(a)		ACCEPT lb=1
(?<=(a\1))x		REJECT 125
(a(?1)?)(?<=\1)x		REJECT 125
(?J)(?:(?<n>a)|(?<n>b))(?<=\k<n>)x		REJECT 125
(?J)(?<n>a)(?<n>b)?(?<=\k<n>)x		REJECT 125
(?J)(?<n>a)|(?<n>bc)(?<=\k<n>)x		REJECT 125
(?J)(?<n>a)|(?<n>bc)(?<=\1)x		ACCEPT lb=1
(?|(a)|(b))(?<=\1)x		REJECT 125
(?|x)(a)(?<=\1)x		REJECT 125
(?|(a)|(b))(c)(?<=\2)x		REJECT 125
(a+)(?<=\1)x		REJECT 125
(a|bc)(?<=\1)x		ACCEPT lb=2
(?<=(a|bc)\1)x		ACCEPT lb=4
(a)?(?<=\1)x		ACCEPT lb=1
