+static inline size_t rx_proto_h(const unsigned char *subject, size_t n, size_t pos)
+{   /* memchr on 'h' (the literal's rarest byte here, 3.58M of 362M) + one compare */
+    while (pos + 12 <= n) {
+        const unsigned char *q = memchr(subject + pos, 'h', n - pos - 11);
+        if (!q) return n;
+        size_t c = (size_t)(q - subject);
+        if (rx_w8(subject + c) == rx_w8("https://") && rx_w8(subject + c + 4) == rx_w8("s://www.")) return c;
+        pos = c + 1;
+    }
+    return n;
+}
