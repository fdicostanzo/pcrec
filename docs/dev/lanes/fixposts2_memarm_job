#!/usr/bin/env bash
# fixposts2: the memfn arm's reach (FLOORS-2: run-verify-wide floors re-measured after rule (1); FLOORS-3: the
# vrun utf8 floors now count corpus patterns only, its `corpus=` column gives the exact counts to pin).
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/fixposts2
case "${1:-}" in
    --dry-run)
        [ -f "$TREE/tests/axes/run_axes.sh" ] || { echo "no run_axes.sh in $TREE" >&2; exit 1; }
        echo "would run in $TREE: MEMFN_REACH_ONLY=1 bash tests/axes/run_axes.sh"
        echo "boxqueue: cap 5400"; echo "boxqueue: patience none"
        echo "boxqueue: expect none reason=exec'd, so the tool's rc is the job's rc"
        exit 0 ;;
    --ready)   # not 20:00-01:00 (Frank's hold)
        h=$((10#$(date +%H)))
        if [ "$h" -ge 20 ] || [ "$h" -lt 1 ]; then echo "evening hold 20:00-01:00"; exit 75; fi
        exit 0 ;;
esac
cd "$TREE" || exit 1
export MEMFN_REACH_ONLY=1
exec bash tests/axes/run_axes.sh
