#!/usr/bin/env bash
# SUPERSEDED 2026-10-31 by docs/dev/lanes/r30b2_jobs/ (lane r30bfix: one stage per job, BASE main 5c60e118c); kept as job 697's record.
# kit-r30b-heavy: lane r30b ([MEMFN] R-30: the run window's ask dropped where the whole run
# implies it; abi 92 -> 94), the CORRECTNESS job before main lands R-30. STAGED by lane r30b
# (2026-10-29), not queued; the manager queues it (boxqueue add --name NNN-kit-r30b-heavy).
# Shape: lane s3m's s3_job_622-kit-s3m-heavy, cut to what R-30 touches.
#   tree / ref   worktrees/r30b; the reference is main 1f5574fac (abi 92), the lane's base.
#                r30b_evidence/census.py maps NEW's 94 back to 92 and judges every mover
#                against the BOTH-ASKS population read from the reference's own artifact
#   lever        the test-only `--harness=pres-window` arm of tests/axes/run_axes.sh: the old
#                form's answers over the whole corpus (the census's lever arms read its bytes)
#   mech         the rows on every file R-30 touches (tests/mech/rows_for.sh), the six new
#                plants S1543-S1548, S278 (re-aimed), S449 and S693 (the abi row)
#   label        perfrun --label r30b; output under build/r30b/heavy
# abi: the tree is at 94 on the assumption trailgc lands 93 first; if R-30 lands first the
# landing renumbers to 93 at every reader (r30b_report.md "abi readers") and this job's abi
# check moves with it.
# Correctness run: no quiet gate, no hold.
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/r30b
BASE=5c60e118c   # r30bfix 2026-10-31: the merged main tip (was 1f5574fac). SUPERSEDED: re-run as r30b2_jobs/ (one stage per job)
OUT=$TREE/build/r30b/heavy
E=$TREE/docs/dev/lanes/r30b_evidence
NSTEPS=13
NIDS=76
IDS="S185 S265 S267 S278 S279 S285 S443 S444 S445 S447 S449 S450 S454 S455 S464 S570 S571 S573 S678 S681 S682 S686 S687 S688 S689 S690 S691 S692 S693 S694 S695 S724 S728 S729 S730 S754 S793 S797 S800 S801 S802 S803 S804 S846 S847 S848 S921 S994 S1018 S1031 S1080 S1081 S1083 S1084 S1089 S1092 S1104 S1106 S1107 S1109 S1221 S1224 S1228 S1245 S1294 S1332 S1380 S1421 S1543 S1544 S1545 S1546 S1547 S1548 S1582 S1740"
MEMFN_SECTIONS="test-memfn-arch test-memfn-arms test-memfn-deleg test-memfn-finder test-memfn-forms test-memfn-g2 test-memfn-guarded test-memfn-link test-memfn-manifest test-memfn-rank test-memfn-reach test-memfn-rows test-memfn-simdfloor test-memfn-stamps test-kitproof"
case "${1:-}" in
    --dry-run)
        [ -e "$TREE/.git" ] || { echo "no tree $TREE" >&2; exit 1; }
        git -C "$TREE" rev-parse --verify -q "$BASE^{commit}" >/dev/null || { echo "BASE $BASE unknown" >&2; exit 1; }
        git -C "$TREE" merge-base --is-ancestor "$BASE" HEAD || { echo "BASE $BASE is not merged into the tip" >&2; exit 1; }
        grep -q '^#define PCREC_ARTIFACT_ABI 94$' "$TREE/src/gen/emit_dfa.c" || { echo "tree is not at abi 94" >&2; exit 1; }
        git -C "$TREE" diff --quiet HEAD -- . ':(exclude)docs/dev/artifact_size_log.tsv' ':(exclude)r30b_rulings.md' ||
            { echo "worktree dirty" >&2; exit 1; }
        python3 -I -c 'import ast,sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]' "$E/census.py" || exit 1
        [ -x "$TREE/scripts/perfrun" ] || { echo "no scripts/perfrun" >&2; exit 1; }
        n=$(echo $IDS | wc -w); [ "$n" = "$NIDS" ] || { echo "IDS has $n ids, not $NIDS" >&2; exit 1; }
        for t in $MEMFN_SECTIONS test-codegen test-registry test-rxtsource; do
            grep -q "^$t:" "$TREE/Makefile" || { echo "no make target $t" >&2; exit 1; }
        done
        echo "would run in $TREE: mechval($NIDS ids) build strict refbuild census codegen registry rxtsource memfn axes_lever test mech($NIDS rows) reach"
        echo "boxqueue: not-before 2026-10-31T09:00"
        echo "boxqueue: cap 14400"
        echo "boxqueue: patience none"
        echo "boxqueue: idle-ok"
        echo "boxqueue: expect steps=$NSTEPS lines=^== r30b step [a-z_0-9]+ rc=0\$"
        exit 0 ;;
    --ready)
        exit 0 ;;
esac
cd "$TREE" || exit 1
TIP=$(git rev-parse HEAD)
echo "== r30b heavy tip $TIP vs $BASE"
mkdir -p "$OUT"
export TMPDIR=$TREE/build/tmp
mkdir -p "$TMPDIR"
bad=0
step() {
    local name=$1; shift
    echo "== r30b step $name start $(date +%T): $*"
    "$@" > "$OUT/$name.log" 2>&1
    local rc=$?
    grep -E 'strict:|== arm|UNEXPECTED|COMPLETE|DONE rc=|\*\*\* \[|checks (passed|failed)|ANOMALY|mech run COMPLETE|REACH|FAILED|lost|LOST' "$OUT/$name.log" | tail -40
    echo "== r30b step $name rc=$rc"
    [ "$rc" -eq 0 ] || bad=$((bad + 1))
}
refbuild() {
    rm -rf "$OUT/ref" && mkdir -p "$OUT/ref" &&
        git -C "$TREE" archive "$BASE" | tar -x -C "$OUT/ref" &&
        make -C "$OUT/ref" -j16 && echo "$BASE" > "$OUT/ref/REV" && echo "refbuild: ref $BASE; tip $TIP"
}
mechval() {
    local out n
    out=$(VALIDATE_ONLY=1 bash tests/mech/run_sabotage_matrix.sh $IDS 2>&1) || { printf '%s\n' "$out" | tail -3; return 1; }
    n=$(printf '%s\n' "$out" | sed -n 's/^== mech FIELD VALIDATION COMPLETE: \([0-9]*\) def.*/\1/p')
    echo "mechval: ${n:-none} ids valid"
    [ "$n" = "$NIDS" ]
}
step mechval mechval
step build make -j16
step strict make strict
step refbuild refbuild
step census python3 -I "$E/census.py" --base "$OUT/ref/build/pcrec" --new build/pcrec --harness build/pcrec-harness --tree "$TREE" --out "$OUT/census.txt" --jobs 16
step codegen make test-codegen
step registry make test-registry
step rxtsource make test-rxtsource
step memfn make -k -j16 -Otarget $MEMFN_SECTIONS
step axes_lever env AXES=--harness=pres-window bash tests/axes/run_axes.sh
step test scripts/perfrun --label r30b -- "$OUT/test.make.log"
grep -E '\*\*\* \[(Makefile:[0-9]+: )?test-' "$OUT/test.make.log" | sed 's/^/test-red: /'
step mech bash tests/mech/run_sabotage_matrix.sh $IDS
step reach env REACH_ONLY=1 bash tests/mech/run_sabotage_matrix.sh
echo "== r30b heavy: $bad step(s) failed"
[ "$bad" -eq 0 ]
