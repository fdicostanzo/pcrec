#!/usr/bin/env bash
# 503-p48-relaxcorpus2: rerun after the twin kept (6)+(8); answer sections of make test against the p48 RELAX twin (scratch tree; one-state relaxation)
set -u
TREE=/var/tmp/pcrec-pcrec/scratch/p48/trelax
SECS="test-corpus test-counterk test-possessify test-prefilter test-assertions test-anchored-match test-search-pinned test-revend-twin test-compound"
case "${1:-}" in
    --dry-run)
        [ -x "$TREE/build/pcrec" ] || { echo "no twin build" >&2; exit 1; }
        echo "would run in $TREE: make -k -j8 -Otarget $SECS"
        echo "boxqueue: cap 3600"; echo "boxqueue: patience none"
        echo "boxqueue: expect none reason=make's rc is the job's rc (exec'd); verdict read from the make error lines"
        exit 0 ;;
    --ready) exit 0 ;;
esac
exec make -C "$TREE" -k -j8 -Otarget $SECS
