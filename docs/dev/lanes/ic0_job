#!/usr/bin/env bash
# ic0: [INLINE-C] stage 0 owed validation of lane/ic0 (the rx_matchfn INTERNAL comment line + abi 87 -> 88, nothing else): build, strict, make test-codegen, the identity sweep (emit_sweep.py with the unchanged base 43414ddac patched ONLY by the two intended movers as --ref-bin: any other mover shows), then the full make test.
# Queued by the lane itself (scripts/boxqueue add --name 530-ic0-test docs/dev/lanes/ic0_job); the job runs in the lane worktree.
# Not ready from 2026-10-26 21:30 local: the job must end before the 00:05 full suite owns the box.
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/ic0
REFBIN="$TREE/build/refpatched/build/pcrec"
case "${1:-}" in
    --dry-run)
        [ -d "$TREE" ] && [ -x "$TREE/scripts/perfrun" ] && [ -x "$REFBIN" ] && [ -f "$TREE/scripts/emit_sweep.py" ] \
            || { echo "no tree, perfrun, emit_sweep.py or patched reference binary $REFBIN" >&2; exit 1; }
        echo "would run in $TREE: make -j16; make strict > \$BQ_LOG.strict; make test-codegen > \$BQ_LOG.codegen; emit_sweep.py --ref-bin $REFBIN > \$BQ_LOG.sweep; scripts/perfrun --label ic0 -- \$BQ_LOG.make"
        echo "boxqueue: cap 14400"; echo "boxqueue: patience 54000"
        echo "boxqueue: expect strict=1 log=job.log.strict lines=^strict: whole tree compiles clean"
        echo "boxqueue: expect sweep=1 log=job.log.sweep lines=^emit_sweep: DONE rc=0$"
        echo "boxqueue: expect sections=79 log=job.log.make last=^sections ran:"
        echo "boxqueue: witness sections=sections ran: 79/79"
        exit 0 ;;
    --ready)
        now=$(date +%s); stop=$(date -d '2026-10-26 21:30' +%s) || exit 1
        [ "$now" -lt "$stop" ] || { echo "past 2026-10-26 21:30: would overrun the 00:05 full suite; manager re-times this job"; exit 75; }
        exit 0 ;;
esac
rc=0
make -C "$TREE" -j16 >/dev/null || exit 1
make -C "$TREE" strict > "$BQ_LOG.strict" 2>&1 || rc=1
make -C "$TREE" test-codegen > "$BQ_LOG.codegen" 2>&1 || rc=1
python3 "$TREE/scripts/emit_sweep.py" --tree "$TREE" --bin "$TREE/build/pcrec" --ref-bin "$REFBIN" --jobs 8 \
    --out "$TREE/build/ic0_sweep_corpus" > "$BQ_LOG.sweep" 2>&1 || rc=1
cd "$TREE" || exit 1
scripts/perfrun --label ic0 -- "$BQ_LOG.make" || rc=1
exit $rc
