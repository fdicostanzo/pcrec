#!/usr/bin/env bash
# kit-bsu6fix-inlane: lane bsu6fix's in-lane checks on worktrees/bsu6fix (R-2, kit manager 2026-11-23), non-timing:
# full c6selftest, the 80-mutant gate (table -> scratch/bsu6fix/mutants/table.txt), prepare + DRY over C6,C6c with
# CARD_TIME preset + c6decide round trip, g1 manifest/dry (base, deny-fail, crlf), make strict, make test-memfn-arch.
# ONE job by the manager's ruling (R-2), so its cap exceeds 3600: the mutant gate alone is 80 c6selftest runs.
# Verdict: the "== STAGE" lines and "INLANE ALL DONE rc=N" in job.log; per-stage logs scratch/bsu6fix/inlane_<stage>.log.
set -u
S=/var/tmp/pcrec-pcrec/scratch/bsu6fix
W=/home/pcrec/projects/pcrec/worktrees/bsu6fix
case "${1:-}" in
    --dry-run)
        [ -f "$W/memfn/tests/span_forms/cards.py" ] && [ -x "$S/inlane.sh" ] && [ -f "$S/mutants/mutb.py" ] && [ -x "$W/build/pcrec" ] ||
            { echo "missing tree, runner, mutant harness or build/pcrec" >&2; exit 1; }
        bash -n "$S/inlane.sh" || exit 1
        echo "would run: $S/inlane.sh all (stages selftest mutants dryfull g1 strict arch) on $W"
        echo "boxqueue: cap 18000"; echo "boxqueue: patience none"; echo "boxqueue: not-before 2026-11-23T01:00"; echo "boxqueue: est 7200"
        echo "boxqueue: expect stages=6 lines=^== STAGE "
        exit 0 ;;
    --ready)
        t=$(date +%H%M); t=$((10#$t)); if [ $t -lt 100 ] || [ $t -ge 1800 ]; then echo "evening hold: start only 01:00-18:00 (now $t)"; exit 75; fi
        exec bash /home/pcrec/projects/pcrec/scripts/boxqueue after kit-bsu6-reach ;;
esac
bash "$S/inlane.sh" all; rc=$?
cat "$S/inlane_all.log"
exit $rc
