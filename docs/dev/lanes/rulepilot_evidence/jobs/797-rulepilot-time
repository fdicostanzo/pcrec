#!/usr/bin/env bash
# 797-rulepilot-time: lane rulepilot's timing shard 7 of 7 (9 sites, 51 groups,
# estimated 16 min at 0.75 s per launch). grid2 time.sh (method kit-grid@2: CPU 14, 3 launches, the
# base launched three times, the rerun rule, the per-group quiet gate) over the shard's cells of the slot
# 790-rulepilot-build made. QUIET-GATED, so idle-ok. Results: OUT/time_RP7.log, OUT/time/raw_RP7.tsv.
# The LAST shard: after timing, read_slot.py + search.py print the pilot's VERDICT (OUT/search.out).
set -u
W=/home/pcrec/projects/pcrec/worktrees/rulepilot
E=$W/docs/dev/lanes/rulepilot_evidence
OUT=/var/tmp/pcrec-pcrec/scratch/rulepilot/slot
RE='^rp-(S16|S17|S18|S19|S20|S21|S22|S23|S24)$'
BQ=${BOXQUEUE:-/home/pcrec/projects/pcrec/scripts/boxqueue}
case "${1:-}" in
    --dry-run)
        [ -f "$W/docs/dev/lanes/grid2/time.sh" ] && [ -f "$E/read_slot.py" ] && [ -f "$E/search.py" ] || { echo "missing scripts" >&2; exit 1; }
        n=51
        if [ -f "$OUT/ext/rp/arms.tsv" ]; then   # the slot exists (re-run at START): count the shard's real groups
            n=$(python3 -I "$W/docs/dev/lanes/grid1/arms.py" "$OUT" groups timed EXT | awk -F'\t' -v re="$RE" '$1 ~ re' | wc -l)
            [ "$n" -gt 0 ] || { echo "no groups for this shard in $OUT" >&2; exit 1; }
        fi
        echo "would run in $OUT: PHASE=EXT CELLS_RE=$RE RAW_TAG=RP7 CPU=14 LAUNCHES=3 LOADWAIT=15 bash grid2/time.sh"
        echo "boxqueue: cap 3600"; echo "boxqueue: patience none"; echo "boxqueue: idle-ok"
        echo "boxqueue: not-before 2026-11-02T05:00"
        echo "boxqueue: expect groups=$n last=^time.sh: COMPLETE rows=[0-9]+ groups="
        echo "boxqueue: witness groups=time.sh: COMPLETE rows=$((n * 5)) groups=$n reruns=0 xreruns=0 requeued=0 wall=2000s"
        exit 0 ;;
    --ready) exec bash "$BQ" after rulepilot-time.s6 ;;
esac
cd "$OUT" || exit 1
w=0; while :; do l=$(cut -d' ' -f1 /proc/loadavg); awk "BEGIN{exit !($l < 1.5)}" && break; [ "$w" -ge 600 ] && break; sleep 30; w=$((w + 30)); done
echo "rulepilot-time 7: quiet load1=$(cut -d' ' -f1 /proc/loadavg) waited=${w}s"
env OUT="$OUT" PHASE=EXT CELLS_RE="$RE" RAW_TAG=RP7 PASS_STATUS="$OUT/time_RP7.status" CPU=14 LAUNCHES=3 LOADWAIT=15 \
    bash "$W/docs/dev/lanes/grid2/time.sh" > "$OUT/time_RP7.log" 2>&1
grep -q '# ANSWER MISMATCH' "$OUT/time_RP7.log" && { grep '# ANSWER MISMATCH' "$OUT/time_RP7.log" | head; echo "rulepilot-time 7: answer mismatch"; exit 1; }
tail -1 "$OUT/time_RP7.log" | grep -q 'time.sh: COMPLETE' || { tail -5 "$OUT/time_RP7.log"; echo "rulepilot-time 7: timing did not complete"; exit 1; }
python3 -I "$E/read_slot.py" "$OUT" "$OUT/dataset.json" && python3 -I "$E/search.py" "$OUT/dataset.json" --json "$OUT/search.json" | tee "$OUT/search.out" \
    || echo "rulepilot-time: the reading failed (the timing above is complete; re-run read_slot.py + search.py by hand)"
tail -1 "$OUT/time_RP7.log"
