#!/usr/bin/env bash
# 795-rulepilot-time.s5: lane rulepilot's timing shard 5 of 7 (22 sites, 132 groups,
# estimated 40 min at 0.75 s per launch). grid2 time.sh (method kit-grid@2: CPU 14, 3 launches, the
# base launched three times, the rerun rule, the per-group quiet gate) over the shard's cells of the slot
# 790-rulepilot-build made. QUIET-GATED, so idle-ok. Results: OUT/time_RP5.log, OUT/time/raw_RP5.tsv.
set -u
W=/home/pcrec/projects/pcrec/worktrees/rulepilot
E=$W/docs/dev/lanes/rulepilot_evidence
OUT=/var/tmp/pcrec-pcrec/scratch/rulepilot/slot
RE='^rp-(M14|M15|M16|M17|M18|M19|M20|M21|M22|M23|N04|N05|N16|N20|P01|P02|P03|P04|P05|P08|P09|P10)$'
BQ=${BOXQUEUE:-/home/pcrec/projects/pcrec/scripts/boxqueue}
case "${1:-}" in
    --dry-run)
        [ -f "$W/docs/dev/lanes/grid2/time.sh" ] && [ -f "$E/read_slot.py" ] && [ -f "$E/search.py" ] || { echo "missing scripts" >&2; exit 1; }
        n=132
        if [ -f "$OUT/ext/rp/arms.tsv" ]; then   # the slot exists (re-run at START): count the shard's real groups
            n=$(python3 -I "$W/docs/dev/lanes/grid1/arms.py" "$OUT" groups timed EXT | awk -F'\t' -v re="$RE" '$1 ~ re' | wc -l)
            [ "$n" -gt 0 ] || { echo "no groups for this shard in $OUT" >&2; exit 1; }
        fi
        echo "would run in $OUT: PHASE=EXT CELLS_RE=$RE RAW_TAG=RP5 CPU=14 LAUNCHES=3 LOADWAIT=15 bash grid2/time.sh"
        echo "boxqueue: cap 3600"; echo "boxqueue: patience none"; echo "boxqueue: idle-ok"
        echo "boxqueue: not-before 2026-11-02T05:00"
        echo "boxqueue: expect groups=$n last=^time.sh: COMPLETE rows=[0-9]+ groups="
        echo "boxqueue: witness groups=time.sh: COMPLETE rows=$((n * 5)) groups=$n reruns=0 xreruns=0 requeued=0 wall=2000s"
        exit 0 ;;
    --ready) exec bash "$BQ" after rulepilot-time.s4 ;;
esac
cd "$OUT" || exit 1
w=0; while :; do l=$(cut -d' ' -f1 /proc/loadavg); awk "BEGIN{exit !($l < 1.5)}" && break; [ "$w" -ge 600 ] && break; sleep 30; w=$((w + 30)); done
echo "rulepilot-time 5: quiet load1=$(cut -d' ' -f1 /proc/loadavg) waited=${w}s"
env OUT="$OUT" PHASE=EXT CELLS_RE="$RE" RAW_TAG=RP5 PASS_STATUS="$OUT/time_RP5.status" CPU=14 LAUNCHES=3 LOADWAIT=15 \
    bash "$W/docs/dev/lanes/grid2/time.sh" > "$OUT/time_RP5.log" 2>&1
grep -q '# ANSWER MISMATCH' "$OUT/time_RP5.log" && { grep '# ANSWER MISMATCH' "$OUT/time_RP5.log" | head; echo "rulepilot-time 5: answer mismatch"; exit 1; }
tail -1 "$OUT/time_RP5.log" | grep -q 'time.sh: COMPLETE' || { tail -5 "$OUT/time_RP5.log"; echo "rulepilot-time 5: timing did not complete"; exit 1; }
tail -1 "$OUT/time_RP5.log"
