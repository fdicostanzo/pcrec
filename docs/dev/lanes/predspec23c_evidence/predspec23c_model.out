  NULLABLE-B B = /(?:(?<n>\d),)*/ & (n = 9: >=5), text.none(B) on `1,`: by the definition (empty rows included) False ; non-empty rows only True
  NULLABLE-B B = /(?:(?<n>\d),)*/ & (n = 9: >=5), text.none(B) on `7,`: by the definition (empty rows included) False ; non-empty rows only False
  NULLABLE-B B = /(?:(?<n>\d),)*/ & (n = 9: >=5), text.none(B) on `a`: by the definition (empty rows included) False ; non-empty rows only True
  SWEEP L56/L65 /(?<n>\d)*x/ & NOT (n: <5) on `x`: WHOLE FAILS | SEARCHED FAILS
  SWEEP L56/L65 /(?<n>\d)?x/ & NOT (n: <5) on `x`: WHOLE FAILS | SEARCHED FAILS
  SWEEP L56/L65 /x|(?<n>\d)+/ & NOT (n: <5) on `x`: WHOLE FAILS | SEARCHED FAILS
  SWEEP L94 SEARCHED NOT (h: <5, k = 3: between(3, 7)): /x?/ vs /(?:x|)/ differ 0 of 121 first None
  SWEEP L94 WHOLE NOT (h: <5, k = 3: between(3, 7)): /x?/ vs /(?:x|)/ differ 0 of 121 first None
  SWEEP L55 WHOLE (323 spans over {a,b,x,y} to length 4 with no hit) occurrences(r) & NOT (g: "x") vs min = 1: differ 0 first None (the first holds on 0)
  SWEEP L30 SEARCHED SV (341) [NOT (h: <0)] vs [(h: !<0)] differ 0 first None
  SWEEP L30 SEARCHED SV (341) [NOT (h: <10)] vs [(h: !<10)] differ 0 first None
  SWEEP L30 WHOLE SV (341) [NOT (h: <0)] vs [(h: !<0)] differ 0 first None
  SWEEP L30 WHOLE SV (341) [NOT (h: <10)] vs [(h: !<10)] differ 0 first None
END
