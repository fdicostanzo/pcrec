#!/usr/bin/env bash
# ic2: test-axes on worktrees/ic2 ([INLINE-C] stage 2, module code-c; abi 89 -> 90): every axis answer-identical to default over the corpus, tests/code/ included (its manifest grants code-c to the directory's entry files), at AXES_FULL=1 HARNESS_BATCH=64 (the battery's full shape: rungs plain and shared added); plus the form census. The two scripts `make test-axes` runs, called directly (the job already holds the box lock).
# Every expect is a FINAL trailer: a DONE line per script carrying its rc, and the census's own `checks failed:` trailer.
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/ic2
case "${1:-}" in
    --ready) exit 0 ;;
    --dry-run)
        [ -f "$TREE/tests/axes/run_axes.sh" ] && [ -f "$TREE/tests/codegen/run_form_census.sh" ] \
            || { echo "no run_axes.sh or run_form_census.sh in $TREE" >&2; exit 1; }
        echo "would run in $TREE: make -j16; AXES_FULL=1 HARNESS_BATCH=64 tests/axes/run_axes.sh > \$BQ_LOG.axes; tests/codegen/run_form_census.sh > \$BQ_LOG.census"
        echo "boxqueue: cap 15600"; echo "boxqueue: patience 54000"
        echo "boxqueue: expect axes=0 log=job.log.axes last=^axes: DONE rc="
        echo "boxqueue: witness axes=axes: DONE rc=0"
        echo "boxqueue: expect census=0 log=job.log.census last=^checks failed:"
        echo "boxqueue: witness census=checks failed: 0"
        echo "boxqueue: expect census_rc=0 log=job.log.census last=^census: DONE rc="
        echo "boxqueue: witness census_rc=census: DONE rc=0"
        exit 0 ;;
esac
rc=0
make -C "$TREE" -j16 >/dev/null || exit 1
( cd "$TREE" && AXES_FULL=1 HARNESS_BATCH=64 bash tests/axes/run_axes.sh ) > "$BQ_LOG.axes" 2>&1; a=$?
echo "axes: DONE rc=$a" >> "$BQ_LOG.axes"
[ "$a" -eq 0 ] || rc=1
( cd "$TREE" && PROCS="$(bash tests/lib/procs_default.sh)" bash tests/codegen/run_form_census.sh ) > "$BQ_LOG.census" 2>&1; c=$?
echo "census: DONE rc=$c" >> "$BQ_LOG.census"
[ "$c" -eq 0 ] || rc=1
exit $rc
