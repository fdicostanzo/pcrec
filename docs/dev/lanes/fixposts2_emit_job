#!/usr/bin/env bash
# fixposts2: emit_sweep byte-neutrality proof for CONTRACT-1/4 (0 bytes moved), ref = the branch base 3ed7d9d71.
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/fixposts2
case "${1:-}" in
    --dry-run)
        [ -f "$TREE/scripts/emit_sweep.py" ] || { echo "no emit_sweep.py in $TREE" >&2; exit 1; }
        echo "would run in $TREE: python3 scripts/emit_sweep.py --ref 3ed7d9d71 --tree $TREE"
        echo "boxqueue: cap 5400"; echo "boxqueue: patience none"
        echo "boxqueue: expect none reason=exec'd, so the tool's rc is the job's rc"
        exit 0 ;;
    --ready)   # not 20:00-01:00 (Frank's hold)
        h=$((10#$(date +%H)))
        if [ "$h" -ge 20 ] || [ "$h" -lt 1 ]; then echo "evening hold 20:00-01:00"; exit 75; fi
        exit 0 ;;
esac
cd "$TREE" || exit 1
exec python3 scripts/emit_sweep.py --ref 3ed7d9d71c60d046ab6ac05476db52a9b8e32c39 --tree "$TREE" --out "${TMPDIR:-/var/tmp/pcrec-pcrec}/fixposts2_sweep" --jobs 8
