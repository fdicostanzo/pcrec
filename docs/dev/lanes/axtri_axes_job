#!/usr/bin/env bash
# 45x-main-axtri-axes: run_axes.sh on worktrees/axtri for the four memfn rows whose reach pins axtri re-pinned (fd-pres-g1 witness, fd-pres-pick, precheck-assign-byte, pres-set-lead), both layers, AXES= by spelling: answer identity plus the memfn arm's floors/witnesses.
# The expect is a FINAL trailer: the DONE line carrying run_axes.sh's rc.
set -u
TREE=/home/pcrec/projects/pcrec/worktrees/axtri
AXSEL="--memfn=no-fd-pres-g1 --memfn=no-fd-pres-pick --memfn=no-precheck-assign-byte --memfn=no-pres-set-lead"
case "${1:-}" in
    --ready) exit 0 ;;
    --dry-run)
        [ -f "$TREE/tests/axes/run_axes.sh" ] || { echo "no run_axes.sh in $TREE" >&2; exit 1; }
        echo "would run in $TREE: make -j16; AXES_FULL=1 HARNESS_BATCH=64 AXES=\"$AXSEL\" tests/axes/run_axes.sh > \$BQ_LOG.axes"
        echo "boxqueue: cap 9000"; echo "boxqueue: patience 54000"
        echo "boxqueue: expect axes=0 log=job.log.axes last=^axes: DONE rc="
        echo "boxqueue: witness axes=axes: DONE rc=0"
        exit 0 ;;
esac
make -C "$TREE" -j16 >/dev/null || exit 1
( cd "$TREE" && AXES_FULL=1 HARNESS_BATCH=64 AXES="$AXSEL" bash tests/axes/run_axes.sh ) > "$BQ_LOG.axes" 2>&1; a=$?
echo "axes: DONE rc=$a" >> "$BQ_LOG.axes"
exit $([ "$a" -eq 0 ] && echo 0 || echo 1)
