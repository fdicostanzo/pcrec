            /* every group this artifact promises is reached only
               through a subroutine call or sits under a {0}, so no
               match can set it (PCRE2 reports the same) */
            capture_spans_out[rx_g][0] = PCREC_UNSET;
            capture_spans_out[rx_g][1] = PCREC_UNSET;
        }
