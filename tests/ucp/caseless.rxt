# [UCP] U1 -- the CASELESS rules under UCP (ucp_design.md §1.3, T2):
# (1) an ASCII-RESTRICTED set folds by the ASCII fold even under UTF|UCP
# (`(?aW)(?i)\w` does NOT reach U+212A/U+017F; `(?aP)(?i)[[:lower:]]` is
# exactly [A-Za-z]); (2) the narrow UCP sets are fold-closed; (3) folding is
# per contribution -- a literal beside a UCP set folds by the encoding's fold.
# `[:lower:]`/`[:upper:]`'s own FOLD-INERT rule is wide under utf8 and is
# pinned under `byte` (byte.rxt).#
# ORACLE: libpcre2, the options the block states (`encoding utf8` = PCRE2_UTF,
# `(*UCP)`/`flags u` = PCRE2_UCP, `flags i` = PCRE2_CASELESS). Every expectation
# was READ FROM THE ORACLE (10.48, the generator) and re-verified against the
# 10.46 reference; `verify_ucp.py` in this directory re-checks every cell on
# every `make test` against the resolved libpcre2 (it SKIPS loudly without one).
# `# pcre2-only` throughout: python `re` has no PCRE2_UCP and its subject
# decoder is byte-oriented (U14).

# pcre2-only
pattern (*UCP)(?i)(?aW)\w
encoding utf8
m "A" 0 1
m "a" 0 1
n "\xe2\x84\xaa"
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (*UCP)(?i)(?aP)[[:lower:]]
encoding utf8
m "A" 0 1
m "a" 0 1
n "\xe2\x84\xaa"
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (*UCP)(?i)(?aP)[[:upper:]]
encoding utf8
m "A" 0 1
m "a" 0 1
n "\xe2\x84\xaa"
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (*UCP)(?i)(?aP)[[:alpha:]]
encoding utf8
m "A" 0 1
m "a" 0 1
n "\xe2\x84\xaa"
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (*UCP)(?i)[[:xdigit:]]
encoding utf8
m "A" 0 1
m "a" 0 1
n "\xe2\x84\xaa"
n "k"
n "K"
n "\xc5\xbf"
n "s"
m "\xef\xbc\xa1" 0 3
m "\xef\xbd\x81" 0 3
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (*UCP)(?i)[[:^xdigit:]]
encoding utf8
n "A"
n "a"
m "\xe2\x84\xaa" 0 3
m "k" 0 1
m "K" 0 1
m "\xc5\xbf" 0 2
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
m "\xc3\x89" 0 2
m "\xc3\xa9" 0 2
m "\xd9\xa0" 0 2

# pcre2-only
pattern (*UCP)(?i)\d
encoding utf8
n "A"
n "a"
n "\xe2\x84\xaa"
n "k"
n "K"
n "\xc5\xbf"
n "s"
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
m "\xd9\xa0" 0 2

# pcre2-only
pattern (*UCP)(?i)[\dk]
encoding utf8
n "A"
n "a"
m "\xe2\x84\xaa" 0 3
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
n "s"
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
m "\xd9\xa0" 0 2

# pcre2-only
pattern (*UCP)(?i)[\d\x{e9}]
encoding utf8
n "A"
n "a"
n "\xe2\x84\xaa"
n "k"
n "K"
n "\xc5\xbf"
n "s"
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
m "\xc3\x89" 0 2
m "\xc3\xa9" 0 2
m "\xd9\xa0" 0 2

# pcre2-only
pattern (*UCP)(?i)(?aP)[[:lower:]k]
encoding utf8
m "A" 0 1
m "a" 0 1
m "\xe2\x84\xaa" 0 3
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (*UCP)(?i)k
encoding utf8
n "A"
n "a"
m "\xe2\x84\xaa" 0 3
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
n "s"
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"

# pcre2-only
pattern (?i)(?aW)\w
encoding utf8
m "A" 0 1
m "a" 0 1
n "\xe2\x84\xaa"
m "k" 0 1
m "K" 0 1
n "\xc5\xbf"
m "s" 0 1
n "\xef\xbc\xa1"
n "\xef\xbd\x81"
n "\xc3\x89"
n "\xc3\xa9"
n "\xd9\xa0"
