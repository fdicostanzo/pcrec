n "a\xf0\x9d\x9f\x98\n \n"
ns 1 "a\xf0\x9d\x9f\x98\n \n"
mg "$12" 1
mg "$12\xc3\xa9" 0
mg "$12 " 1
mg "x12" 0

# a dot between boundaries
