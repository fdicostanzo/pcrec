m "\xd9\xa3\xd9\xa4 x" 0 4
ms 4 "\xd9\xa3\xd9\xa4 x" 5 6
m "\xf0\x9f\x98\x80ab\xf0\x9f\x98\x80" 4 6
ns 10 "\xf0\x9f\x98\x80ab\xf0\x9f\x98\x80"
m "\xce\xa9mega" 0 6
ns 4 "\xce\xa9mega"
m "__" 0 2
ns 1 "__"
m "o\xc3\xa9 foo1\xc3\xa9 foo_" 0 3
ms 5 "o\xc3\xa9 foo1\xc3\xa9 foo_" 11 15
m "\xc3\xa9 foo\xf0\x9d\x9f\x98\xc7\x85\xc2\xa0f\xd9\xa3" 0 2
ns 15 "\xc3\xa9 foo\xf0\x9d\x9f\x98\xc7\x85\xc2\xa0f\xd9\xa3"
m "\xc2\xb7 _\xce\xb1" 3 6
ns 6 "\xc2\xb7 _\xce\xb1"
m "_" 0 1
ns 1 "_"
m "\xcc\x81a b" 0 3
ms 4 "\xcc\x81a b" 4 5
m "\xc3\xa9f\xc3\xa9.\xf0\x9f\x98\x80" 0 5
ns 2 "\xc3\xa9f\xc3\xa9.\xf0\x9f\x98\x80"
mc "h\xc3\xa9llo w\xc3\xb6rld" 2
mc "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e \xe3\x83\x86\xe3\x82\xad\xe3\x82\xb9\xe3\x83\x88" 2
mc "a\xcc\x81b c" 2
mc "\xd9\xa3\xd9\xa4 x" 2

