mg "a\xce\xb1\xce\xb2" 0
mg "\xce\xb1\xce\xb2 \xce\xb4" 2
mg "\xce\xa9x" 0

# caseless
# pcre2-only
pattern (*UCP)(?i)\bstra\w+e\b
encoding utf8
features all
m "STRA\xc3\x9fE" 0 7
ns 2 "STRA\xc3\x9fE"
m "stra\xc3\x9fe" 0 7
ns 3 "stra\xc3\x9fe"
n "xstra\xc3\x9fe"
ns 1 "xstra\xc3\x9fe"
