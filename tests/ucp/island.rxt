# [UCP] U3 -- THE ISLAND: the character-stepped DFA (ucp_design.md §3,
# D134 item 1). Every pattern here holds a context set this encoding
# cannot express byte by byte (UCP \b/\B under utf8: T4 row 1), so it
# takes the `island` LOCATE row (RX_DFA_SCAN "island"): ASCII bytes step
# the table, a non-ASCII character steps as its character atom. Cells:
# wide and narrow consuming sets beside \b, the forward machine's
# position views ($, \z, (?m)$), two context sets on one machine,
# startpos seeds (the character before search_from), and `mc` find-all
# counts, whose empty matches run the island retry machine.
#
# ORACLE: libpcre2 10.46 2025-08-27, PCRE2_UTF|PCRE2_UCP (`mc`: PCRE2's own global loop),
# GENERATED by docs/dev/lanes/ucpu3b_evidence/gen_island_rxt.py, never
# from pcrec. verify_ucp.py re-checks the m/n/ms/ns cells; the harness
# runs pcrec on all of them. Ill-formed subjects: tests/utf8/
# island_illformed.rxt.

# T4 row 1: UCP \b around a literal
# pcre2-only
pattern (*UCP)\bfoo\b
encoding utf8
features all
m "foo" 0 3
ns 1 "foo"
n "\xc3\xa9foo"
ns 3 "\xc3\xa9foo"
n "foo\xc3\xa9"
ns 5 "foo\xc3\xa9"
m "a foo b" 2 5
ns 5 "a foo b"
m "\xc2\xb7foo\xc2\xb7" 2 5
ns 3 "\xc2\xb7foo\xc2\xb7"
n "_foo"
ns 2 "_foo"
n "foo\xcc\x81"
ns 2 "foo\xcc\x81"
n "\xe6\x97\xa5foo"
ns 4 "\xe6\x97\xa5foo"
n "\xce\xa9_\xc2\xb7"
ns 3 "\xce\xa9_\xc2\xb7"
n "\xf0\x9d\x9f\x98\xf0\x9f\x98\x80\xf0\x9d\x9f\x98\xe2\x80\xa8\xc3\xa9."
ns 18 "\xf0\x9d\x9f\x98\xf0\x9f\x98\x80\xf0\x9d\x9f\x98\xe2\x80\xa8\xc3\xa9."
n "\xd9\xa3."
ns 2 "\xd9\xa3."
m "\xc3\xa9 foo." 3 6
ms 2 "\xc3\xa9 foo." 3 6
n "\xd9\xa3\xc3\x9f\xd9\xa3x\xc3\xa9"
ns 6 "\xd9\xa3\xc3\x9f\xd9\xa3x\xc3\xa9"
n "\xc2\xb7\xe6\x97\xa5\xf0\x9d\x9f\x98\xc3\x9f$\xf0\x9d\x9f\x98"
ns 11 "\xc2\xb7\xe6\x97\xa5\xf0\x9d\x9f\x98\xc3\x9f$\xf0\x9d\x9f\x98"
mc "foo" 1
mc "\xc3\xa9foo" 0
mc "foo\xc3\xa9" 0
mc "a foo b" 1

# the headline: a Unicode word
