ns 4 "_x\xc3\xa9\xc2\xa0_"
m "bo1" 1 2
ns 2 "bo1"
mc "abc" 1
mc "\xc3\xa9\xc3\xa0\xc3\xbc" 1
mc "ab" 0
mc "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e" 1

