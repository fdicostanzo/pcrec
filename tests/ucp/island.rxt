m "\xd9\xa3 \xf0\x9f\x98\x80  " 0 2
ns 8 "\xd9\xa3 \xf0\x9f\x98\x80  "
mg "ab cd" 4
mg "\xc3\xa9" 2
mg "" 0
mg " " 0

# the retry machine SUCCEEDS: an empty first branch, then a word (checks-5)
