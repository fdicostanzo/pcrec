ns 1 "f \xc7\x85"
n "\xce\xa9foo"
ns 3 "\xce\xa9foo"
n "\xc3\xa9 foo.b "
ns 5 "\xc3\xa9 foo.b "
n "f"
ns 1 "f"
n "\xc3\xa9 foo \n\xe6\x97\xa5\xc3\xa9 foo"
ns 13 "\xc3\xa9 foo \n\xe6\x97\xa5\xc3\xa9 foo"
n "\xf0\x9f\x98\x80foo"
ns 4 "\xf0\x9f\x98\x80foo"
