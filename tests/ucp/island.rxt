# a lookbehind context set beside \b (two context sets)
# pcre2-only
pattern (*UCP)(?<=\$)\d+\b
encoding utf8
features all
m "$12" 1 3
ns 3 "$12"
n "$12\xc3\xa9"
ns 3 "$12\xc3\xa9"
m "$12 " 1 3
ms 1 "$12 " 1 3
n "x12"
ns 2 "x12"
n "bab\xf0\x9d\x9f\x98"
ns 3 "bab\xf0\x9d\x9f\x98"
n ".-$"
ns 3 ".-$"
n " "
ns 1 " "
n "a\xe6\x97\xa5o \xf0\x9d\x9f\x98\xe6\x97\xa5"
ns 13 "a\xe6\x97\xa5o \xf0\x9d\x9f\x98\xe6\x97\xa5"
