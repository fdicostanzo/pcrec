pattern (*UCP)\b(?:|\w+)
encoding utf8
features all
m "ab cd" 0 0
ms 5 "ab cd" 5 5
m "\xe6\x97\xa5\xe6\x9c\xac \xe8\xaa\x9e" 0 0
ms 7 "\xe6\x97\xa5\xe6\x9c\xac \xe8\xaa\x9e" 7 7
