# [UCP] U3 -- THE CHARACTER-STEPPED DFA (ucp_design.md §3, D134 item 1).
# Every pattern here holds a context set this encoding cannot express
# byte by byte (UCP \b/\B under utf8), so it takes the character-stepped
# DFA (RX_DFA_SCAN "char-step"; run_ucp_tests.sh §5 pins the route):
# ASCII bytes step the table, a non-ASCII character steps as its
# character atom. Cells: wide and narrow consuming sets beside \b, the
# forward machine's position views ($, \z, (?m)$), two context sets on
# one machine, startpos seeds (the character before search_from), `mg`
# find-all counts whose empty matches run the retry machine (two
# patterns where it SUCCEEDS), and the EDGE blocks: every interval edge
# of the sets the machines step, one cell each.
#
# oracle-options: UTF|UCP
# ORACLE: libpcre2 10.46 2025-08-27 (`mg`: PCRE2's own global loop), GENERATED by
# tests/ucp/gen_island_rxt.py, never from pcrec; its --verify mode and
# verify_ucp.py re-check the cells. Ill-formed subjects:
# tests/utf8/island_illformed.rxt.

# T4 row 1: UCP \b around a literal
# pcre2-only
pattern (*UCP)\bfoo\b
encoding utf8
features all
m "foo" 0 3
ns 1 "foo"
n "\xc3\xa9foo"
ns 3 "\xc3\xa9foo"
n "foo\xc3\xa9"
ns 5 "foo\xc3\xa9"
m "a foo b" 2 5
ns 5 "a foo b"
m "\xc2\xb7foo\xc2\xb7" 2 5
ns 3 "\xc2\xb7foo\xc2\xb7"
n "_foo"
ns 2 "_foo"
n "fo\xc3\xb3"
ns 1 "fo\xc3\xb3"
n "\xe6\x97\xa5foo"
ns 4 "\xe6\x97\xa5foo"
n "\xce\xa9_\xc2\xb7"
ns 3 "\xce\xa9_\xc2\xb7"
n "\xf0\x9d\x9f\x98\xf0\x9f\x98\x80\xf0\x9d\x9f\x98 \xc3\xa9."
ns 16 "\xf0\x9d\x9f\x98\xf0\x9f\x98\x80\xf0\x9d\x9f\x98 \xc3\xa9."
n "\xd9\xa3."
ns 2 "\xd9\xa3."
m "\xc3\xa9 foo." 3 6
ms 2 "\xc3\xa9 foo." 3 6
n "\xd9\xa3\xc3\x9f\xd9\xa3x\xc3\xa9"
ns 6 "\xd9\xa3\xc3\x9f\xd9\xa3x\xc3\xa9"
n "\xc2\xb7\xe6\x97\xa5\xf0\x9d\x9f\x98\xc3\x9f$\xf0\x9d\x9f\x98"
ns 11 "\xc2\xb7\xe6\x97\xa5\xf0\x9d\x9f\x98\xc3\x9f$\xf0\x9d\x9f\x98"
mg "foo" 1
mg "\xc3\xa9foo" 0
mg "foo\xc3\xa9" 0
mg "a foo b" 1

# the headline: a Unicode word
# pcre2-only
pattern (*UCP)\b\w+\b
encoding utf8
features all
m "h\xc3\xa9llo w\xc3\xb6rld" 0 6
ns 8 "h\xc3\xa9llo w\xc3\xb6rld"
m "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e \xe3\x83\x86\xe3\x82\xad\xe3\x82\xb9\xe3\x83\x88" 0 9
ns 13 "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e \xe3\x83\x86\xe3\x82\xad\xe3\x82\xb9\xe3\x83\x88"
m "\xc3\xa1b c" 0 3
ms 2 "\xc3\xa1b c" 4 5
m "\xd9\xa3\xd9\xa4 x" 0 4
ms 4 "\xd9\xa3\xd9\xa4 x" 5 6
m "\xf0\x9f\x98\x80ab\xf0\x9f\x98\x80" 4 6
ns 10 "\xf0\x9f\x98\x80ab\xf0\x9f\x98\x80"
m "\xce\xa9mega" 0 6
ns 3 "\xce\xa9mega"
m "__" 0 2
ns 2 "__"
m "\xc3\xa9 foo\xf0\x9d\x9f\x98\xc7\x85 f\xd9\xa3" 0 2
ms 2 "\xc3\xa9 foo\xf0\x9d\x9f\x98\xc7\x85 f\xd9\xa3" 3 12
m "\xc2\xb7 _\xce\xb1" 3 6
ms 2 "\xc2\xb7 _\xce\xb1" 3 6
m "_" 0 1
ns 1 "_"
m "\xcc\x81a b" 0 3
ms 3 "\xcc\x81a b" 4 5
m "\xc3\xa9f\xc3\xa9.\xf0\x9f\x98\x80" 0 5
ns 10 "\xc3\xa9f\xc3\xa9.\xf0\x9f\x98\x80"
m "$\xc2\xb7\xce\xb1\xce\xb1\xce\xa9x" 3 10
ns 10 "$\xc2\xb7\xce\xb1\xce\xb1\xce\xa9x"
mg "h\xc3\xa9llo w\xc3\xb6rld" 2
mg "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e \xe3\x83\x86\xe3\x82\xad\xe3\x82\xb9\xe3\x83\x88" 2
mg "\xc3\xa1b c" 2
mg "\xd9\xa3\xd9\xa4 x" 2

# \B between word characters
# pcre2-only
pattern (*UCP)\B\w\B
encoding utf8
features all
m "abc" 1 2
ns 3 "abc"
m "\xc3\xa9\xc3\xa0\xc3\xbc" 2 4
ns 4 "\xc3\xa9\xc3\xa0\xc3\xbc"
n "ab"
ns 2 "ab"
m "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e" 3 6
ns 9 "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e"
n "x"
ns 1 "x"
m "_\xce\xb1\xd9\xa3 foox" 1 3
ms 1 "_\xce\xb1\xd9\xa3 foox" 1 3
m "_x\xc3\xa9 _" 1 2
ns 2 "_x\xc3\xa9 _"
m "bo1" 1 2
ms 1 "bo1" 1 2
m "\xc3\xa9 foo\xcc\x81\xce\xb1\xc3\xa9\xc7\x85" 4 5
ms 4 "\xc3\xa9 foo\xcc\x81\xce\xb1\xc3\xa9\xc7\x85" 4 5
m "fo_\xc3\xa9 foo\xd9\xa3" 1 2
ms 8 "fo_\xc3\xa9 foo\xd9\xa3" 8 9
n ".\n"
ns 1 ".\n"
mg "abc" 1
mg "\xc3\xa9\xc3\xa0\xc3\xbc" 1
mg "ab" 0
mg "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e" 1

# a wide consuming set beside \b (one character edge)
# pcre2-only
pattern (*UCP)\w+\b
encoding utf8
features all
m "\xce\xb1\xce\xb2\xce\xb3 \xce\xb4" 0 6
ms 7 "\xce\xb1\xce\xb2\xce\xb3 \xce\xb4" 7 9
m "\xc7\x85x" 0 3
ms 2 "\xc7\x85x" 2 3
m "a b" 0 1
ms 1 "a b" 2 3
m " 1\xc3\xa9" 1 4
ms 2 " 1\xc3\xa9" 2 4
m "\xc7\x85\xce\xa9f \xc3\x9f" 0 5
ms 6 "\xc7\x85\xce\xa9f \xc3\x9f" 6 8
m "\n\xf0\x9f\x98\x80a " 5 6
ms 1 "\n\xf0\x9f\x98\x80a " 5 6
m "1" 0 1
ns 1 "1"
m "x$\xc3\xa91" 0 1
ms 4 "x$\xc3\xa91" 4 5
m "\xc7\x85\xc3\xa9foo$b" 0 7
ns 9 "\xc7\x85\xc3\xa9foo$b"
mg "\xce\xb1\xce\xb2\xce\xb3 \xce\xb4" 2
mg "\xc7\x85x" 1
mg "a b" 2
mg " 1\xc3\xa9" 1

# a non-ASCII literal before \b
# pcre2-only
pattern (*UCP)é\b
encoding utf8
features all
m "\xc3\xa9" 0 2
ns 2 "\xc3\xa9"
n "\xc3\xa9a"
ns 3 "\xc3\xa9a"
m "\xc3\xa9\xc3\xa9" 2 4
ns 4 "\xc3\xa9\xc3\xa9"
m "\xc3\xa9 " 0 2
ns 3 "\xc3\xa9 "
m "caf\xc3\xa9" 3 5
ns 5 "caf\xc3\xa9"
n "\xd9\xa3\xc3\x9f \xf0\x9d\x9f\x98\xc7\x85"
ns 11 "\xd9\xa3\xc3\x9f \xf0\x9d\x9f\x98\xc7\x85"
n "\no_\n"
ns 1 "\no_\n"
m "\xf0\x9d\x9f\x98\xf0\x9f\x98\x80\xc3\xa9 foo\xcc\x81\xc2\xb7a" 8 10
ns 12 "\xf0\x9d\x9f\x98\xf0\x9f\x98\x80\xc3\xa9 foo\xcc\x81\xc2\xb7a"
n "o a."
ns 1 "o a."
n "\xf0\x9d\x9f\x98 "
ns 5 "\xf0\x9d\x9f\x98 "
n "\xc2\xb7\xd9\xa3\xe6\x97\xa5-"
ns 4 "\xc2\xb7\xd9\xa3\xe6\x97\xa5-"
mg "\xc3\xa9" 1
mg "\xc3\xa9a" 0
mg "\xc3\xa9\xc3\xa9" 1
mg "\xc3\xa9 " 1

# a narrow set (\d) with \b
# pcre2-only
pattern (*UCP)\b\d+\b
encoding utf8
features all
m "12 34" 0 2
ms 1 "12 34" 3 5
n "a12"
ns 2 "a12"
m "\xd9\xa1\xd9\xa2\xd9\xa3" 0 6
ns 4 "\xd9\xa1\xd9\xa2\xd9\xa3"
n "x\xd9\xa3"
ns 1 "x\xd9\xa3"
n "12\xc3\xa9"
ns 2 "12\xc3\xa9"
m " x\n\xf0\x9d\x9f\x98" 3 7
ms 1 " x\n\xf0\x9d\x9f\x98" 3 7
n "\xc3\x9f\xc2\xb7"
ns 4 "\xc3\x9f\xc2\xb7"
n "- -"
ns 1 "- -"
n "x \xc3\x9f"
ns 2 "x \xc3\x9f"
n " foob"
ns 2 " foob"
n " \xc7\x85"
ns 1 " \xc7\x85"
mg "12 34" 2
mg "a12" 0
mg "\xd9\xa1\xd9\xa2\xd9\xa3" 1
mg "x\xd9\xa3" 0

# trailing \B
# pcre2-only
pattern (*UCP)x\B
encoding utf8
features all
n "x"
ns 1 "x"
m "x\xc3\xa9" 0 1
ns 3 "x\xc3\xa9"
n "x "
ns 2 "x "
m "xx" 0 1
ns 2 "xx"
n " \xce\xb1\xc3\xa9 foo"
ns 6 " \xce\xb1\xc3\xa9 foo"
n ".\xce\xa9foo\xc7\x85"
ns 8 ".\xce\xa9foo\xc7\x85"
n " \xc3\xa9 foo\xce\xa9\xc3\x9f\xc2\xb7"
ns 7 " \xc3\xa9 foo\xce\xa9\xc3\x9f\xc2\xb7"
n "\xe6\x97\xa5$"
ns 4 "\xe6\x97\xa5$"
n "\n$\n"
ns 1 "\n$\n"
n "\xf0\x9d\x9f\x98"
ns 4 "\xf0\x9d\x9f\x98"
mg "x" 0
mg "x\xc3\xa9" 1
mg "x " 0
mg "xx" 1

# $ and \z after \b (the forward machine's position views)
# pcre2-only
pattern (*UCP)\bfoo\b$
encoding utf8
features all
m "foo" 0 3
ns 3 "foo"
m "foo\n" 0 3
ns 4 "foo\n"
m "a foo" 2 5
ns 5 "a foo"
n "foo\n\n"
ns 4 "foo\n\n"
n "\xc3\xa9foo"
ns 3 "\xc3\xa9foo"
n "  \xf0\x9f\x98\x80"
ns 6 "  \xf0\x9f\x98\x80"
n " \xf0\x9d\x9f\x98\xc3\x9f$o"
ns 5 " \xf0\x9d\x9f\x98\xc3\x9f$o"
n "f_\xc7\x85.."
ns 4 "f_\xc7\x85.."
n "\xce\xb1f$"
ns 4 "\xce\xb1f$"
n "\xc3\xa9"
ns 2 "\xc3\xa9"
n "f\xd9\xa3foo\xd9\xa3"
ns 1 "f\xd9\xa3foo\xd9\xa3"
mg "foo" 1
mg "foo\n" 1
mg "a foo" 1
mg "foo\n\n" 0

# \z
# pcre2-only
pattern (*UCP)\bfoo\b\z
encoding utf8
features all
m "foo" 0 3
ns 1 "foo"
n "foo\n"
ns 1 "foo\n"
m "x foo" 2 5
ms 2 "x foo" 2 5
n " \xc7\x85"
ns 1 " \xc7\x85"
n "\xc7\x85"
ns 2 "\xc7\x85"
n "\xd9\xa3a\xc2\xb7\n\xf0\x9d\x9f\x98"
ns 2 "\xd9\xa3a\xc2\xb7\n\xf0\x9d\x9f\x98"
n "\xc3\x9f"
ns 2 "\xc3\x9f"
n "\xce\xa9 .a1_"
ns 7 "\xce\xa9 .a1_"
n "\xc3\x9f  _"
ns 3 "\xc3\x9f  _"
mg "foo" 1
mg "foo\n" 0
mg "x foo" 1
mg " \xc7\x85" 0

# (?m)$ after \b
# pcre2-only
pattern (*UCP)(?m)\bfoo$
encoding utf8
features all
m "foo\nx" 0 3
ns 5 "foo\nx"
n "afoo\n"
ns 5 "afoo\n"
m "\xc3\xa9 foo\nb" 3 6
ms 3 "\xc3\xa9 foo\nb" 3 6
n "\xce\xa9foo\xc3\x9f_"
ns 2 "\xce\xa9foo\xc3\x9f_"
n " \xce\xb1"
ns 1 " \xce\xb1"
n "b.\xc3\xa9\nb"
ns 1 "b.\xc3\xa9\nb"
n " \xce\xa9\xcc\x81x"
ns 5 " \xce\xa9\xcc\x81x"
n "\no.b\n\xf0\x9d\x9f\x98"
ns 3 "\no.b\n\xf0\x9d\x9f\x98"
n "$-"
ns 1 "$-"
mg "foo\nx" 1
mg "afoo\n" 0
mg "\xc3\xa9 foo\nb" 1
mg "\xce\xa9foo\xc3\x9f_" 0

# alternation across \b
# pcre2-only
pattern (*UCP)(?:\bab|cd\b)
encoding utf8
features all
n "xab"
ns 2 "xab"
m "ab" 0 2
ns 1 "ab"
n "cd\xc3\xa9"
ns 4 "cd\xc3\xa9"
m "cd" 0 2
ns 2 "cd"
n "\xc7\x85\xcc\x81"
ns 4 "\xc7\x85\xcc\x81"
n "bx\xc2\xb7_"
ns 5 "bx\xc2\xb7_"
n "\xce\xa9\xc3\xa9\xc3\xa9 \xf0\x9d\x9f\x98\xc7\x85"
ns 13 "\xce\xa9\xc3\xa9\xc3\xa9 \xf0\x9d\x9f\x98\xc7\x85"
n "f \xe6\x97\xa5\xc3\x9f.\xc2\xb7"
ns 5 "f \xe6\x97\xa5\xc3\x9f.\xc2\xb7"
n "\xe6\x97\xa5\xc7\x85 b"
ns 6 "\xe6\x97\xa5\xc7\x85 b"
n "_x b-\xf0\x9d\x9f\x98"
ns 2 "_x b-\xf0\x9d\x9f\x98"
mg "xab" 0
mg "ab" 1
mg "cd\xc3\xa9" 0
mg "cd" 1

# a property class between boundaries
