mg "stra\xc3\x9fe" 1
mg "xstra\xc3\x9fe" 0
mg "Strasse" 1

# nullable: the iterator's retry machine
# pcre2-only
pattern (*UCP)\b\w*
encoding utf8
features all
m "ab cd" 0 2
ms 2 "ab cd" 2 2
m "\xc3\xa9" 0 2
ms 2 "\xc3\xa9" 2 2
n ""
n " "
ns 1 " "
m "\xe6\x97\xa5\xe6\x9c\xac \xe8\xaa\x9e" 0 6
