m "\xe2\x80\xa8" 0 3
m "\xc2\x85" 0 2
m "x\xef\xbc\x90y" 0 1
m "\xef\xbc\xa1" 0 3
m "\x7f" 0 1
m "\xc2\x80" 0 2
m "\xc3\xa9" 0 2
m " \x09" 0 1
m "_" 0 1
