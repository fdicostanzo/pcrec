pattern (*UCP)(?aW)\w+
encoding utf8
n "\xd9\xa0"
m "5" 0 1
n "\xc2\xa0"
n " "
n "\xc3\xa9"
m "a" 0 1
n "\xe2\x84\xaa"
m "k" 0 1
