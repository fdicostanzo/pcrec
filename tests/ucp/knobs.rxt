pattern (*UCP)(?aW)\W
encoding utf8
m "\xd9\xa0" 0 2
n "5"
m "\xc2\xa0" 0 2
m " " 0 1
m "\xc3\xa9" 0 2
n "a"
m "\xe2\x84\xaa" 0 3
n "k"
m "\xef\xbc\x90" 0 3
m "\xe3\x80\x80" 0 3

