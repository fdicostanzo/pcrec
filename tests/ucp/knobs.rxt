# `(?aW)` REACHES `\b`/`\B`: inside its scope the boundary reads the ASCII word set, which U1 builds (UCP `\b` itself is refused, refusals.rxt)
# pcre2-only
pattern (*UCP)(?aW:a\b)
encoding utf8
features classes,modifiers,assertions
m "a\xc3\xa9" 0 1
m "a b" 0 1
n "ab"

# `(?aW)` REACHES `\b`/`\B`: inside its scope the boundary reads the ASCII word set, which U1 builds (UCP `\b` itself is refused, refusals.rxt)
# pcre2-only
pattern (*UCP)(?aW)a\b
encoding utf8
features classes,modifiers,assertions
m "a\xc3\xa9" 0 1
m "a b" 0 1
n "ab"

# `(?aW)` REACHES `\b`/`\B`: inside its scope the boundary reads the ASCII word set, which U1 builds (UCP `\b` itself is refused, refusals.rxt)
# pcre2-only
pattern (*UCP)(?aW)a\B
encoding utf8
features classes,modifiers,assertions
n "a\xc3\xa9"
n "a b"
m "ab" 0 1
