# [UCP] U1 -- WHAT IS REFUSED, BY NAME, and never answered with the ASCII
# meaning (which would be a miscompile). libpcre2 ACCEPTS every construct
# here but the last three; pcrec refuses them as CAPABILITY limits:
#   - the WIDE UCP sets under `-e utf8` (D130 Q3; limits.md §3.8): \w \W and
#     [:alpha:] [:alnum:] [:word:] [:lower:] [:upper:] [:graph:] [:print:]
#     [:punct:], either polarity, at an atom or inside a class, spelled
#     `(*UCP)` or `flags u`, and `(?aW)` does NOT help [:word:] (aP does);
#   - UCP `\b`/`\B` under BOTH encodings (U2 for byte, U3/U4 for utf8);
#   - `--ucp` without module `ucp` enabled (the byte default).
# The last three are PCRE2 errors too: (*UTF) is refused under `byte`
# (D130 Q2), and a start-of-pattern option is start-only.
# `verify_ucp.py` counts these blocks and checks nothing about them: a
# `perr` is pcrec's refusal, not a libpcre2 answer.

# a WIDE UCP set under utf8
pattern (*UCP)\w
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)\W+
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[\w-]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[^\W]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[[:alpha:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[[:^alnum:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[x[:word:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[[:lower:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)(?i)[[:upper:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[[:graph:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[[:print:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)[[:punct:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)(?aW)[[:word:]]
encoding utf8
perr

# a WIDE UCP set under utf8
pattern (*UCP)(?aD)\w
encoding utf8
perr

# `flags u` reaches the same refusal
pattern \w+
encoding utf8
flags u
perr

# UCP \b under utf8
pattern (*UCP)\b
encoding utf8
features classes,modifiers,assertions
perr

# UCP \B under utf8
pattern (*UCP)a\B
encoding utf8
features classes,modifiers,assertions
perr

# UCP \b under byte (U2)
pattern (*UCP)\b
encoding byte
features classes,modifiers,assertions,ucp
perr

# `flags u` + \b under byte
pattern \bx
encoding byte
flags u
features classes,modifiers,assertions,ucp
perr

# --ucp with module ucp NOT enabled (byte does not imply it)
pattern \d
encoding byte
flags u
features classes,modifiers
perr

# (*UTF) under byte, gate open
pattern (*UTF)a
encoding byte
features classes,modifiers,ucp
perr

# a start-of-pattern option not at the start
pattern a(*UCP)
encoding utf8
perr

# an option is not a repeatable item
pattern (*UCP)*
encoding utf8
perr
