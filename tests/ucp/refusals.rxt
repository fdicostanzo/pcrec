# [UCP] U1 -- WHAT IS REFUSED, BY NAME, and never answered with the ASCII
# meaning (which would be a miscompile): `--ucp` without module `ucp`
# enabled (the byte default), a capability gate libpcre2 has no analogue of;
# and three that are PCRE2 errors too: (*UTF) under `byte` (D130 Q2), and a
# start-of-pattern option that is not at the start or is repeated.
# [UCP] U3 LIFTED the two capability refusals this file held: the WIDE UCP
# sets under `-e utf8` now build (tests/ucp/ucp_compare.py compares them
# exactly), and UCP `\b`/`\B` under `-e utf8` takes the character-stepped
# DFA (tests/ucp/island.rxt).
# `verify_ucp.py` counts these blocks and checks nothing about them: a
# `perr` is pcrec's refusal, not a libpcre2 answer.

# --ucp with module ucp NOT enabled (byte does not imply it)
pattern \d
encoding byte
flags u
features classes,modifiers
perr

# (*UTF) under byte, gate open
pattern (*UTF)a
encoding byte
features classes,modifiers,ucp
perr

# a start-of-pattern option not at the start
pattern a(*UCP)
encoding utf8
perr

# an option is not a repeatable item
pattern (*UCP)*
encoding utf8
perr
