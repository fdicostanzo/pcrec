# tests/backrefs/dupnames.rxt -- module `backrefs` ([M6.5.2]): `(?J)`, its scoping rule, and the resolution rule for a reference to a duplicated name (S8)
#
# GENERATED BY tests/backrefs/gen_corpus.py, and that is a property rather
# than a convenience: every expectation below was produced by driving the cell
# through libpcre2 10.46 (via the committed ctypes binding at
# docs/design/backrefs_measurements/probes/br_oracle.py) BEFORE it was written.
# python3 `re` was driven over the SAME cells in the same pass, and a block
# carries `# pcre2-only` exactly where python diverged or could not compile the
# pattern -- DETECTED, never assumed, with the first divergence and the cell
# count recorded above the marking.
#
# THAT MARKING IS THE WHOLE REASON THE GENERATOR EXISTS. This module has the
# largest oracle divergence pcrec has met: python `re` refuses EVERY
# self-reference and EVERY forward reference at compile time, has no `\g`, no
# `\k` and no `(?J)` at all, rejects the `(?<n>...)` declaring spelling, and
# refuses `(?i)` anywhere but the pattern start -- which is exactly where the
# two cells that decide WHERE the caseless flag is read live. R32 C3 found the
# first test plan marking two files python-verifiable in the direction that
# LOSES the oracle; computing the marking removes the species.
#
# Design: docs/design/backrefs_design.md. Divergences are catalogued in
# docs/dev/upstream_issues.md.

# ====================================================================
# THE `(?J)` SCOPING RULE: checked AT EACH DECLARATION (§8.1)
# ====================================================================

# python DIVERGES here, measured rather than assumed: "xy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?J)(?<a>x)(?<a>y)$
features backrefs,modifiers,named-groups
m "xy" 0 2
g 1 0 1
g 2 1 2

# LEGAL, and it is the cell that kills "the check is made at the pattern's start": the SECOND declaration is under `(?J)`, which is all the rule requires.
# python DIVERGES here, measured rather than assumed: "xy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<a at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?<a>x)(?J)(?<a>y)$
features backrefs,modifiers,named-groups
m "xy" 0 2
g 1 0 1
g 2 1 2

# python DIVERGES here, measured rather than assumed: "xy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?J:(?<a>x)(?<a>y))$
features backrefs,modifiers,named-groups
m "xy" 0 2
g 1 0 1
g 2 1 2

# ERROR: the second declaration is NOT under the `(?J)`, which was scoped away at its own closing paren.
# pcre2 refuses: pcre2_compile failed at offset 18: two named subpatterns have the same name
pattern ^(?J:(?<a>x))(?<a>y)$
features backrefs,modifiers,named-groups
perr

# ERROR, and this is the sharpest cell of the four: `(?J)` AFTER both declarations does not help, which kills the reading that `(?J)` anywhere in the pattern legalises everything.
# pcre2 refuses: pcre2_compile failed at offset 13: two named subpatterns have the same name
pattern ^(?<a>x)(?<a>y)(?J)$
features backrefs,modifiers,named-groups
perr

# ERROR: an inline `(?-J)` turns the state back OFF, and measured against libpcre2 it does so EVEN WITH the PCRE2_DUPNAMES API bit set -- the inline letter is the authoritative scoped state, not a way of turning an option on. That measurement is what settles ASK-2: pcrec gets the letter and no option bit.
# pcre2 refuses: pcre2_compile failed at offset 22: two named subpatterns have the same name
pattern ^(?J)(?<a>x)(?-J)(?<a>y)$
features backrefs,modifiers,named-groups
perr

# LEGAL: the `(?-J)` really is scoped to its group and restored at the closing paren -- the ordinary modifier-scope discipline, not a special case.
# python DIVERGES here, measured rather than assumed: "xqy" @0 pcre2=('m', 0, 3) python=('ERR', 'unknown extension ?J at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?J)(?<a>x)(?:(?-J)q)(?<a>y)$
features backrefs,modifiers,named-groups
m "xqy" 0 3
g 1 0 1
g 2 2 3

# `(?^)` resets the options to their defaults and does NOT clear J -- measured, not inherited from the letter list. Clearing it would turn a legal pattern into an error: the safe-LOOKING direction, and still wrong.
# python DIVERGES here, measured rather than assumed: "xy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?J)(?<a>x)(?^)(?<a>y)$
features backrefs,modifiers,named-groups
m "xy" 0 2
g 1 0 1
g 2 1 2

# Names are CASE-SENSITIVE, so these are not duplicates at all and no `(?J)` is needed (D59, reconfirmed).
# python DIVERGES here, measured rather than assumed: "xy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<a at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?<a>x)(?<A>y)$
features backrefs,modifiers,named-groups
m "xy" 0 2
g 1 0 1
g 2 1 2

# The base case: without `(?J)` in force, a duplicate name is a compile error.
# pcre2 refuses: pcre2_compile failed at offset 13: two named subpatterns have the same name
pattern ^(?<a>x)(?<a>y)$
features backrefs,modifiers,named-groups
perr

# ====================================================================
# THE RESOLUTION RULE: FIRST OF THE NAME-RUN, BY NUMBER, THAT IS SET (§8.3)
# ====================================================================

# The four cells that separate four candidate rules. "yy" MATCHES with group 1 unset and group 2 = (0,1), which eliminates "first by number" taken unconditionally; "xy" and "yx" do NOT match, which eliminates "any one of them".
# python DIVERGES here, measured rather than assumed: "xx" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (4 of 4 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))\k<a>$
features backrefs,modifiers,named-groups
m "xx" 0 2
g 1 0 1
g 2 -1 -1
m "yy" 0 2
g 1 -1 -1
g 2 0 1
n "xy"
n "yx"

# BOTH members set. "xyx" matches (it used #1) and "xyy" does NOT, which eliminates "last set" / "highest number". Sabotage rows S114 and S115 are these two rules, and each is caught by exactly ONE of these cells -- which is the point of writing them as separate rows.
# python DIVERGES here, measured rather than assumed: "xyx" @0 pcre2=('m', 0, 3) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?<a>x)(?<a>y)\k<a>$
features backrefs,modifiers,named-groups
m "xyx" 0 3
g 1 0 1
g 2 1 2
n "xyy"

# Three duplicates, with the MIDDLE and the LAST participating in turn -- the shape a two-member run cannot distinguish.
# python DIVERGES here, measured rather than assumed: "pp" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (4 of 4 cells)
# pcre2-only
pattern (?J)^(?:(?<a>p)|(?<a>q)|(?<a>r))\k<a>$
features backrefs,modifiers,named-groups
m "pp" 0 2
g 1 0 1
g 2 -1 -1
g 3 -1 -1
m "qq" 0 2
g 1 -1 -1
g 2 0 1
g 3 -1 -1
m "rr" 0 2
g 1 -1 -1
g 2 -1 -1
g 3 0 1
n "pq"

# NONE set: §3.3's ordinary unset-reference failure applies. There is no separate rule for names.
# python DIVERGES here, measured rather than assumed: "z" @0 pcre2=('n',) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y)|z)\k<a>$
features backrefs,modifiers,named-groups
n "z"
n "zz"

# "SET" INCLUDES SET-TO-EMPTY. The run's FIRST entry captured the empty string, resolution STOPPED THERE, and the reference consumed nothing -- so "y" matches and "yy" does not. A "first NON-EMPTY" reading gets both cells wrong.
# python DIVERGES here, measured rather than assumed: "y" @0 pcre2=('m', 0, 1) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?<a>x?)(?<a>y)\k<a>$
features backrefs,modifiers,named-groups
m "y" 0 1
g 1 0 0
g 2 0 1
n "yy"

# NUMERIC references are unaffected by dupnames: a number names ONE group, duplicated name or not.
# python DIVERGES here, measured rather than assumed: "yy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))\2$
features backrefs,modifiers,named-groups
m "yy" 0 2
g 1 -1 -1
g 2 0 1
n "xx"

# python DIVERGES here, measured rather than assumed: "yy" @0 pcre2=('n',) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))\1$
features backrefs,modifiers,named-groups
n "yy"
m "xx" 0 2
g 1 0 1
g 2 -1 -1

# ====================================================================
# ALL FOUR BY-NAME SPELLINGS AGREE on the resolution
# ====================================================================

# python DIVERGES here, measured rather than assumed: "yy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (1 of 1 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))\k'a'$
features backrefs,modifiers,named-groups
m "yy" 0 2
g 1 -1 -1
g 2 0 1

# python DIVERGES here, measured rather than assumed: "yy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (1 of 1 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))\k{a}$
features backrefs,modifiers,named-groups
m "yy" 0 2
g 1 -1 -1
g 2 0 1

# python DIVERGES here, measured rather than assumed: "yy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (1 of 1 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))(?P=a)$
features backrefs,modifiers,named-groups
m "yy" 0 2
g 1 -1 -1
g 2 0 1

# python DIVERGES here, measured rather than assumed: "yy" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?J at position 1') (1 of 1 cells)
# pcre2-only
pattern (?J)^(?:(?<a>x)|(?<a>y))\g{a}$
features backrefs,modifiers,named-groups
m "yy" 0 2
g 1 -1 -1
g 2 0 1

# ====================================================================
# THE RE-ENTRY CELLS OVER A NAME RUN (R32 re-check E13)
# ====================================================================

# THE CELL THAT MADE THE MARKED SET A UNION. "aba" is (0,3) with group 1 UNSET and group 2 = (1,3): the resolution chain falls THROUGH the unset first member to the second, which is the one being RE-ENTERED -- so it is exactly the member that must be published at close. Marking only the "resolved" member is not merely incomplete; there is no statically resolved member to speak of. Sabotage S104 marks one member of the run and this cell is its only detector.
# python DIVERGES here, measured rather than assumed: "aba" @0 pcre2=('m', 0, 3) python=('ERR', 'unknown extension ?J at position 1') (3 of 3 cells)
# pcre2-only
pattern (?J)^(?:(?<a>q))?(?:(?<a>a|b\k<a>))+$
features backrefs,modifiers,named-groups
m "aba" 0 3
g 1 -1 -1
g 2 1 3
m "a" 0 1
g 1 -1 -1
g 2 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "aba" @0 pcre2=('m', 0, 3) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?:(?<a>a|b\k<a>))+$
features backrefs,modifiers,named-groups
m "aba" 0 3
g 1 1 3
m "a" 0 1
g 1 0 1

# The same shape with the fall-through removed: both members set, and the chain stops at the first.
# python DIVERGES here, measured rather than assumed: "xbx" @0 pcre2=('m', 0, 3) python=('ERR', 'unknown extension ?J at position 1') (2 of 2 cells)
# pcre2-only
pattern (?J)^(?<a>x)(?:(?<a>a|b\k<a>))+$
features backrefs,modifiers,named-groups
m "xbx" 0 3
g 1 0 1
g 2 1 3
n "x"
