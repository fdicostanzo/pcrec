# tests/backrefs/spellings.rxt -- module `backrefs` ([M6.5.2]): every spelling of a backreference, and the `\g` doorway's OTHER construct (S2)
#
# GENERATED BY tests/backrefs/gen_corpus.py, and that is a property rather
# than a convenience: every expectation below was produced by driving the cell
# through libpcre2 10.46 (via the committed ctypes binding at
# docs/design/backrefs_measurements/probes/br_oracle.py) BEFORE it was written.
# python3 `re` was driven over the SAME cells in the same pass, and a block
# carries `# pcre2-only` exactly where python diverged or could not compile the
# pattern -- DETECTED, never assumed, with the first divergence and the cell
# count recorded above the marking.
#
# THAT MARKING IS THE WHOLE REASON THE GENERATOR EXISTS. This module has the
# largest oracle divergence pcrec has met: python `re` refuses EVERY
# self-reference and EVERY forward reference at compile time, has no `\g`, no
# `\k` and no `(?J)` at all, rejects the `(?<n>...)` declaring spelling, and
# refuses `(?i)` anywhere but the pattern start -- which is exactly where the
# two cells that decide WHERE the caseless flag is read live. R32 C3 found the
# first test plan marking two files python-verifiable in the direction that
# LOSES the oracle; computing the marking removes the species.
#
# Design: docs/design/backrefs_design.md. Divergences are catalogued in
# docs/dev/upstream_issues.md.

# ====================================================================
# `\g` BY NUMBER and BY RELATIVE POSITION
# ====================================================================

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'bad escape \\g at position 4') (2 of 2 cells)
# pcre2-only
pattern ^(a)\g1$
features backrefs
m "aa" 0 2
g 1 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "abb" @0 pcre2=('m', 0, 3) python=('ERR', 'bad escape \\g at position 7') (2 of 2 cells)
# pcre2-only
pattern ^(a)(b)\g2$
features backrefs
m "abb" 0 3
g 1 0 1
g 2 1 2
n "aba"

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'bad escape \\g at position 4') (2 of 2 cells)
# pcre2-only
pattern ^(a)\g{1}$
features backrefs
m "aa" 0 2
g 1 0 1
n "ab"

# RELATIVE resolution happens at COMPILE time against the count SO FAR: `\g{-1}` is the most recently OPENED group.
# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'bad escape \\g at position 4') (2 of 2 cells)
# pcre2-only
pattern ^(a)\g{-1}$
features backrefs
m "aa" 0 2
g 1 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "abb" @0 pcre2=('m', 0, 3) python=('ERR', 'bad escape \\g at position 7') (2 of 2 cells)
# pcre2-only
pattern ^(a)(b)\g{-1}$
features backrefs
m "abb" 0 3
g 1 0 1
g 2 1 2
n "aba"

# python DIVERGES here, measured rather than assumed: "aba" @0 pcre2=('m', 0, 3) python=('ERR', 'bad escape \\g at position 7') (2 of 2 cells)
# pcre2-only
pattern ^(a)(b)\g{-2}$
features backrefs
m "aba" 0 3
g 1 0 1
g 2 1 2
n "abb"

# `\g{+1}` is a relative FORWARD reference and resolves at compile time in that direction too -- it COMPILES, and then fails at match time on the unset rule, which is the same answer §3.5's forward references get.
# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('n',) python=('ERR', 'bad escape \\g at position 1') (2 of 2 cells)
# pcre2-only
pattern ^\g{+1}(a)$
features backrefs
n "aa"
n "a"

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'bad escape \\g at position 4') (2 of 2 cells)
# pcre2-only
pattern ^(a)\g-1$
features backrefs
m "aa" 0 2
g 1 0 1
n "ab"

# Measured: the BARE `\g+1` really is relative-forward, not a literal '+'. `(a)\g+1` alone is error 115 -- there is no group 2 -- so this cell adds the group that makes it legal.
# python DIVERGES here, measured rather than assumed: "abb" @0 pcre2=('n',) python=('ERR', 'bad escape \\g at position 4') (2 of 2 cells)
# pcre2-only
pattern ^(a)\g+1(b)$
features backrefs
n "abb"
n "aab"

# MEASURED over all 256 bytes in both positions: HT and SP -- and only those two -- are skipped at each end of a `\g{...}` or `\k{...}` body. The angle-bracket, quote and `(?P=` forms skip NOTHING (`\k< n >` is a PCRE2 error), which is why this cell exists in the brace form only.
# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'bad escape \\g at position 4') (2 of 2 cells)
# pcre2-only
pattern ^(a)\g{ 1 }$
features backrefs
m "aa" 0 2
g 1 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'bad escape \\g at position 4') (1 of 1 cells)
# pcre2-only
pattern ^(a)\g{01}$
features backrefs
m "aa" 0 2
g 1 0 1

# ====================================================================
# `\g` REFUSALS
# ====================================================================

# there is no capture group 0
# pcre2 refuses: pcre2_compile failed at offset 9: reference to non-existent subpattern
pattern ^(a)\g{0}$
features backrefs
perr

# pcre2 refuses: pcre2_compile failed at offset 7: reference to non-existent subpattern
pattern ^(a)\g0$
features backrefs
perr

# pcre2 refuses: pcre2_compile failed at offset 6: a relative value of zero is not allowed
pattern ^(a)\g{-0}$
features backrefs
perr

# pcre2 refuses: pcre2_compile failed at offset 6: reference to non-existent subpattern
pattern ^(a)\g{-2}x$
features backrefs
perr

# pcre2 refuses: pcre2_compile failed at offset 6: \g is not followed by a braced, angle-bracketed, or quoted name/number or by a plain number
pattern ^(a)\g$
features backrefs
perr

# pcre2 refuses: pcre2_compile failed at offset 6: \g is not followed by a braced, angle-bracketed, or quoted name/number or by a plain number
pattern ^(a)\g{1x}$
features backrefs
perr

# pcre2 refuses: pcre2_compile failed at offset 7: subpattern name expected
pattern ^(a)\g{}$
features backrefs
perr

# ====================================================================
# `\k` BY NAME -- three delimiters, one meaning
# ====================================================================

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<n at position 2') (2 of 2 cells)
# pcre2-only
pattern ^(?<n>a)\k<n>$
features backrefs,named-groups
m "aa" 0 2
g 1 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<n at position 2') (2 of 2 cells)
# pcre2-only
pattern ^(?<n>a)\k'n'$
features backrefs,named-groups
m "aa" 0 2
g 1 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<n at position 2') (2 of 2 cells)
# pcre2-only
pattern ^(?<n>a)\k{n}$
features backrefs,named-groups
m "aa" 0 2
g 1 0 1
n "ab"

# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<n at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?<n>a)\k{ n }$
features backrefs,named-groups
m "aa" 0 2
g 1 0 1

# python DIVERGES here, measured rather than assumed: "xx" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<a at position 2') (1 of 1 cells)
# pcre2-only
pattern ^(?<a_1>x)\k<a_1>$
features backrefs,named-groups
m "xx" 0 2
g 1 0 1

# ====================================================================
# `\k` REFUSALS: a name may not start with a digit, and a delimiter is required
# ====================================================================

# pcre2 refuses: pcre2_compile failed at offset 7: subpattern name must start with a non-digit
pattern ^(a)\k<1>$
features backrefs,named-groups
perr

# pcre2 refuses: pcre2_compile failed at offset 7: subpattern name must start with a non-digit
pattern ^(a)\k{1}$
features backrefs,named-groups
perr

# pcre2 refuses: pcre2_compile failed at offset 10: \k is not followed by a braced, angle-bracketed, or quoted name
pattern ^(?<n>a)\kn$
features backrefs,named-groups
perr

# pcre2 refuses: pcre2_compile failed at offset 12: syntax error in subpattern name
pattern ^(?<n>a)\k<n$
features backrefs,named-groups
perr

# pcre2 refuses: pcre2_compile failed at offset 11: subpattern name expected
pattern ^(?<n>a)\k<>$
features backrefs,named-groups
perr

# A well-formed name this pattern never declares: the error-115 class, raised by §5.3's END-OF-PARSE pass rather than at the escape.
# pcre2 refuses: pcre2_compile failed at offset 7: reference to non-existent subpattern
pattern ^(a)\k<q>$
features backrefs,named-groups
perr

# ====================================================================
# `(?P=name)` -- the python spelling, and the one by-name form python has
# ====================================================================

pattern ^(?P<n>a)(?P=n)$
features backrefs,named-groups
m "aa" 0 2
g 1 0 1
n "ab"

# LEGAL in PCRE2 and a python COMPILE ERROR: python has only the `(?P<n>...)` declaring spelling. Measured, not assumed.
# python DIVERGES here, measured rather than assumed: "aa" @0 pcre2=('m', 0, 2) python=('ERR', 'unknown extension ?<n at position 2') (2 of 2 cells)
# pcre2-only
pattern ^(?<n>a)(?P=n)$
features backrefs,named-groups
m "aa" 0 2
g 1 0 1
n "ab"

# pcre2 refuses: pcre2_compile failed at offset 8: subpattern name must start with a non-digit
pattern ^(a)(?P=1)$
features backrefs,named-groups
perr

# pcre2 refuses: pcre2_compile failed at offset 12: reference to non-existent subpattern
pattern ^(?<n>a)(?P=q)$
features backrefs,named-groups
perr

# pcre2 refuses: pcre2_compile failed at offset 12: subpattern name expected
pattern ^(?<n>a)(?P=)$
features backrefs,named-groups
perr

# ====================================================================
# `\g<` and `\g'` are SUBROUTINE CALLS -- module `recursion`, not this one
# ====================================================================

# THE MEASURED DISCRIMINATOR (§2). A subroutine call re-runs the group's PATTERN, so this matches "ab"; a BACKREFERENCE compares the captured TEXT, so `^(a|b)\1$` and `^(a|b)\g{1}$` report NO MATCH on the same subject. The split runs exactly along the DELIMITER, which is why the two tailed rows name module `recursion` and this module's port never sees them. With `recursion` unavailable the honest answer is a refusal that NAMES it -- claiming the spelling would be a miscompile of the kind D26 tier 1 forbids.
# libpcre2 ACCEPTS this and answers ('m', 0, 2) on "ab"; pcrec refuses it naming module 'recursion', which is the truthful answer while that module has no producer -- claiming the spelling would be the miscompile D26 tier 1 forbids
pattern ^(a|b)\g<1>$
features backrefs,named-groups
perr

# libpcre2 ACCEPTS this and answers ('m', 0, 2) on "ab"; pcrec refuses it naming module 'recursion', which is the truthful answer while that module has no producer -- claiming the spelling would be the miscompile D26 tier 1 forbids
pattern ^(a|b)\g'1'$
features backrefs,named-groups
perr
