# [LANDWALK] stage 1 THE `landmark-walk` ANSWER NET (lane p1build;
# docs/spec/tuning.md §2.54, docs/dev/lanes/p1build_report.md). GENERATED by
# tests/landwalk/gen_landwalk.py from libpcre2 10.46's answers (every
# m/n/ms/ns line is the oracle's, never pcrec's); tests/revend/verify_stage2.py
# re-reads this file and re-asks the oracle, so every block is `# pcre2-only`.
# Families W, R and U take the walk in the default build
# (`<PREFIX>_DFA_SCAN "landmark-walk"`, held by tests/landwalk/run_landwalk.sh);
# the axes sweep runs the same cells under `-fno-landmark-walk` and
# `-fno-anchored-dfa` (the forward-then-reverse search) and `--engine=vm`.
#
# FAMILIES: W the walk (dead hits, several hits, the floor at the start
# position, the landmark at 0 and at the end); R the reach guard (an anchored
# run that reads past the next landmark relocates); B word context and
# lookbehind at the walked-to start; U utf8 prefixes; D declines (the same
# answers by another scan).

# W: dead hits (no prefix before @, or no x after), then the match
# pcre2-only
pattern [a-z]+@x
features all
n "@x"
m "a@x" 0 3
m "@@a@x" 2 5
m "1@x a@y b@x" 8 11
m "ab@xy" 0 4
n "AB@x"
n "abc@"
n ""
n "@"
m "zz@x@x" 0 4

# W: the start position floors the walk (a match starting before it is not reported)
# pcre2-only
pattern [a-z]+@x
features all
m "abc@x" 0 5
ms 1 "abc@x" 1 5
ms 2 "abc@x" 2 5
ns 3 "abc@x"
ns 4 "abc@x"
ms 1 "ab@x cd@x" 1 4
ms 4 "ab@x cd@x" 5 9
ms 5 "ab@x cd@x" 5 9
ms 6 "ab@x cd@x" 6 9
ns 9 "ab@x cd@x"

# W: the landmark is the last byte; runs of a before and between hits
# pcre2-only
pattern a+b
features all
n "b"
m "ab" 0 2
m "aab" 0 3
m "bab" 1 3
m "cbaab" 2 5
n "aaaa"
n "ba"
m "aaba ab" 0 3

# W: a+b from a start position inside the run
# pcre2-only
pattern a+b
features all
m "aaab" 0 4
ms 1 "aaab" 1 4
ms 2 "aaab" 2 4
ns 3 "aaab"
ns 4 "aaab"
ms 2 "ab aab" 3 6
ms 3 "ab aab" 3 6
ms 4 "ab aab" 4 6
ns 6 "ab aab"

# W: the walk's smallest start is reached over a nullable run
# pcre2-only
pattern [0-9]*aa[bc]
features all
m "aab" 0 3
m "12aac" 0 5
m "aaab" 1 4
m "a1aab" 1 5
n "aa"
m "aabaac" 0 3
m "9aa9aab" 3 7

# W: T3 (r5 SOUND-2): a landmark inside the last verify's span; a non-overlapping hit stream answers NOMATCH
# pcre2-only
pattern [0-9]*aa[bc]
features all
m "00000aaabb" 6 9
m "aaabb" 1 4
m "0aab0aac" 0 4

# W: the nullable run from a start position
# pcre2-only
pattern [0-9]*aa[bc]
features all
m "123aab" 0 6
ms 2 "123aab" 2 6
ms 3 "123aab" 3 6
ns 4 "123aab"
ms 1 "aaab" 1 4
ns 2 "aaab"

# W: the 5b population row (mask-email), the walk on @
# pcre2-only
pattern [A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}
features all
m "x@y.zz" 0 6
m "mail me at a.b@c.de now" 11 19
n "@@@"
n "a@b"
n "a@b.c"
m "a@b.cd.e" 0 6
m "first@x second@y.org" 8 20
n "a@@b.cd"
m ".@-.co" 0 6
m "a b@c.de" 2 8

# W: mask-email from start positions
# pcre2-only
pattern [A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}
features all
m "ab@cd.ef gh@ij.kl" 0 8
ms 1 "ab@cd.ef gh@ij.kl" 1 8
ms 2 "ab@cd.ef gh@ij.kl" 9 17
ms 3 "ab@cd.ef gh@ij.kl" 9 17
ms 9 "ab@cd.ef gh@ij.kl" 9 17
ns 12 "ab@cd.ef gh@ij.kl"
ns 17 "ab@cd.ef gh@ij.kl"

# W: a prefix of alternated pairs: the walk recovers the pair boundary
# pcre2-only
pattern (?:ab|cd)+@x
features all
m "ab@x" 0 4
m "cdab@x" 0 6
n "b@x"
m "xab@x" 1 5
n "abc@x"
m "acd@x ab@x" 1 5

# W: a possessive prefix (the walk's start is the run's first byte)
# pcre2-only
pattern [a-z]++@x
features all
m "ab@x" 0 4
n "@x"
m "a1b@x" 2 5
m "ab@y cd@x" 5 9

# W: an atomic prefix discharged to the same machine
# pcre2-only
pattern (?>[a-z]+)@x
features all
m "ab@x" 0 4
n "@x"
m "a1b@x" 2 5
m "ab@y cd@x" 5 9

# W: a caseless landmark and prefix
# pcre2-only
pattern (?i)[a-z]+@X
features all
m "Ab@x" 0 4
m "ab@X" 0 4
n "1@x"
m "AB@Y cd@x" 5 9

# W: a negated prefix class (every byte but the landmark and a space)
# pcre2-only
pattern [^@ ]+@x
features all
m "a@x" 0 3
m "a b@x" 2 5
n "@x"
m "\x01\x7f@x" 0 4
m "a@y b@x" 4 7

# R: the anchored run reads past the next @, so a later hit relocates
# pcre2-only
pattern [a-z]+@(?:[a-z]+@)*[a-z]+ 
features all
m "a@b " 0 4
m "a@b@c " 0 6
n "a@b@c@d"
m "a@b@c@d " 0 8
n "a@b@@c "
m "@a@b " 1 5
m "ab@cd@ef@gh@ ij@kl " 13 19

# R: T6 (rev 1 cell 4): `!` is the landmark, every verify of (a@)^8 reads to the end
# pcre2-only
pattern [a-z]+@(?:[a-z]+@)*[a-z]+!
features all
n "a@a@a@a@a@a@a@a@"
m "a@a@a@a@a@a@a@a@a!" 0 18
m "a@b!" 0 4

# R: a failed verify reads past the next landmark, whose match starts after the first one (the guard relocates; a hit stream resumed at the reach loses it)
# pcre2-only
pattern [a-z]+@...x
features all
m "a@b@cdex" 2 8
n "a@b@cdey"
m "ab@c@defx" 3 9
m "a@bcdx" 0 6
m "a@@@@x" 0 6

# R: the relocation from start positions
# pcre2-only
pattern [a-z]+@(?:[a-z]+@)*[a-z]+ 
features all
m "a@b@c d@e " 0 6
ms 1 "a@b@c d@e " 2 6
ms 2 "a@b@c d@e " 2 6
ms 3 "a@b@c d@e " 6 10
ms 4 "a@b@c d@e " 6 10
ms 6 "a@b@c d@e " 6 10
ns 7 "a@b@c d@e "

# B: \b at the walked-to start and after the landmark's tail
# pcre2-only
pattern \b[a-z]+@x\b
features all
m "ab@x" 0 4
n "1ab@x"
n "ab@xy"
n "ab@x1"
n "_a@x"
m "a@x b@x" 0 3

# B: \b from a start position inside the word
# pcre2-only
pattern \b[a-z]+@x\b
features all
m "ab@x" 0 4
ns 1 "ab@x"
ns 2 "ab@x"
ms 1 "cd ab@x" 3 7
ms 3 "cd ab@x" 3 7
ns 4 "cd ab@x"

# B: \B: the start is never at a word start
# pcre2-only
pattern \B[a-z]+@x
features all
m "ab@x" 1 4
m "1ab@x" 1 5
m "aab@x" 1 5
n "a b@x"

# B: a lookbehind before the landmark
# pcre2-only
pattern [a-z]+(?<=a)@x
features all
m "ba@x" 0 4
n "ab@x"
m "a@x" 0 3
m "b@x ca@x" 4 8

# U: a multi-byte prefix member: the walk lands on a code-point boundary
# pcre2-only
pattern [a-zé]+@x
encoding utf8
features all
m "\xc3\xa9@x" 0 4
m "a\xc3\xa9@x" 0 5
m "\xc3\xa9\xc3\xa9@x" 0 6
m "K\xc3\xa9@x" 1 5
m "\xe2\x82\xac\xc3\xa9@x" 3 7
m "\xc3\xa9@y \xc3\xa9@x" 5 9

# U: a negated prefix over multi-byte text
# pcre2-only
pattern [^@ ]+@x
encoding utf8
features all
m "\xe2\x82\xac@x" 0 5
m "a\xe2\x82\xacb@x" 0 7
m "\xe2\x82\xac \xc3\xa9@x" 4 8
n "@x"

# U: mask-email under utf8 (ASCII landmark, multi-byte text around it)
# pcre2-only
pattern [A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}
encoding utf8
features all
m "\xc3\xa9 a@b.cd" 3 9
n "\xe2\x82\xac@b.cd"
n "a@\xc3\xa9.cd"
m "x\xe2\x82\xacy@b.cd" 4 10

# D: rarity: the prefix is almost every byte, the expected walk is long
# pcre2-only
pattern [^@]+@x
features all
m "abc@x" 0 5
n "@x"
m "a@y@x" 2 5

# D: exclusion: the prefix can consume the landmark
# pcre2-only
pattern a.*b@c
features all
m "ab@c" 0 4
m "a@b@c" 0 5
m "ab@d b@c" 0 8

# D: rarity: a nullable prefix as rare as the landmark
# pcre2-only
pattern x*@y
features all
m "@y" 0 2
m "xx@y" 0 4
m "x@z@y" 3 5

# D: next-landmark: the start filter already hands off to a landmark
# pcre2-only
pattern [a-z]{2,5}@x
features all
m "ab@x" 0 4
n "a@x"
m "abcdef@x" 1 8

# D: utf8 has no byte-rate prior, so b is no rarer than a
# pcre2-only
pattern a+b
encoding utf8
features all
m "aab" 0 3
n "b"
n "aaa"

# D: the cls-s-ucp population row under utf8 (rarity)
# pcre2-only
pattern (*UCP)a\sb
encoding utf8
features all
m "a b" 0 3
m "a\xc2\xa0b" 0 4
n "ab"

# D: \G (an attempt scan)
# pcre2-only
pattern \Ga+b
features all
m "aab" 0 3
ms 1 "aab" 1 3
n "xab"
ms 1 "xab" 1 3

# D: \K (a VM finisher)
# pcre2-only
pattern a+\Kb
features all
m "aab" 2 3
n "b"
m "ab" 1 2

# D: g1/gstart: \G in a {0} body (a suffix)
# pcre2-only
pattern [a-z]+@x(?:\G){0}
features all
m "a@x" 0 3
n "@x"
m "1@x ab@x" 4 8
ms 1 "ab@x" 1 4
ns 2 "ab@x"

# D: g1/gstart: \G in a {0} body (the prefix head)
# pcre2-only
pattern (?:\G){0}[a-z]+@x
features all
m "a@x" 0 3
n "@x"
m "1@x ab@x" 4 8
ms 1 "ab@x" 1 4
ns 2 "ab@x"

# D: g1/gstart: \G in a named group in a DEFINE body
# pcre2-only
pattern [a-z]+@x(?(DEFINE)(?<g>y\G))
features all
m "a@x" 0 3
m "y@x" 0 3
m "1@x ab@xy" 4 8
ms 1 "ab@x" 1 4

# D: g1/gstart: \G in an alternation in a repeated capture in a {0} body
# pcre2-only
pattern [a-z]+@x(?:(y|\G)+){0}
features all
m "a@x" 0 3
n "@x"
m "ab@xy" 0 4
ms 1 "ab@x" 1 4

# D: g1/gstart: \G after a class in a {0} body
# pcre2-only
pattern [a-z]+@x(?:[yz]\G){0}
features all
m "a@x" 0 3
n "@x"
m "ab@xz" 0 4
ms 1 "ab@x" 1 4

# D: \K in a DEFINE body (a VM finisher, never the g1 row)
# pcre2-only
pattern [a-z]+@x(?(DEFINE)(?<k>\K))
features all
m "a@x" 0 3
n "@x"
m "ab@x" 0 4
ms 1 "ab@x" 1 4

# D: T1 (r5 SLOT-4): a VM hybrid's erased prefilter body declines at finisher-dfa
# pcre2-only
pattern (?![a-z]*b)[a-z]+@x
features all
m "ba@x" 1 4
n "ab@x"
n "bb@x"
n "cab@x"

# D: branches
# pcre2-only
pattern ab|cd
features all
m "ab" 0 2
m "xcd" 1 3
n "ac"
