# High-byte coverage (docs/reviews/2026-08-09-m1.md P-N2; plan M2.4).
# \x80-\xFF in both patterns (literals and classes) and subjects. pcrec
# treats bytes >=0x80 as plain byte semantics (ascii encoding, 8-bit
# clean, per lib/pcrec.h); python re over these codepoints (U+0080-U+00FF)
# agrees byte-for-byte, so no oracle exclusion is needed.

# single high-byte literal 0x80
pattern \x80
m "a\x80b" 1 2

# single high-byte literal 0xFF
pattern \xff
m "a\xffb" 1 2

# high-byte literal must not match a different high byte
pattern \x81
n "a\x80b"

# high-byte class [\x80-\xbf] matches inside its range
pattern [\x80-\xbf]
m "\x80" 0 1
m "\xbf" 0 1
m "\xa0" 0 1

# high-byte class [\x80-\xbf] rejects outside its range
pattern [\x80-\xbf]
n "\x7f"
n "\xc0"

# negated high-byte class [^\x80-\xbf]
pattern [^\x80-\xbf]
m "\xc0" 0 1
n "\x80"

# high-byte literal sequence \xDE\xAD\xBE\xEF
pattern \xde\xad\xbe\xef
m "\xde\xad\xbe\xef" 0 4
m "xx\xde\xad\xbe\xefyy" 2 6
n "\xde\xad\xbe\xee"

# high-byte quantifier \xff+
pattern \xff+
m "\xff\xff\xff" 0 3
m "a\xff\xffb" 1 3

# high-byte alternation \x80|\xff
pattern \x80|\xff
m "z\x80z" 1 2
m "z\xffz" 1 2
n "z\xfez"

# dot matches a high byte (byte semantics, not UTF-8)
pattern a.b
m "a\x80b" 0 3
m "a\xffb" 0 3

# mixed ascii and high-byte class [a\x80-\x9f]
pattern [a\x80-\x9f]+
m "a\x80\x9fa" 0 4
n "\xa0"

# full high-byte class [\x80-\xff] spans the entire upper half
pattern [\x80-\xff]+
m "\x80\x90\xa0\xb0\xc0\xd0\xe0\xff" 0 8
n "\x7f"

