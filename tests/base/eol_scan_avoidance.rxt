# M2.12: scan avoidance restored on the `$` (EOL-variant) engine path.
#
# M2.7 removed the memchr/bitmap prefilter and the self-loop skip loops from
# the `$` path because both advance `pos` without consulting accept flags,
# which is unsound when a state can accept at an EOL position. M2.12 puts them
# back, bounded at n-1.
#
# Every case here failed on the FIRST M2.12 attempt, which bounded the skips
# correctly but still evaluated the EOL view BEFORE the skip ran — so a skip
# landing on n-1 consumed that byte without ever taking its EOL view. A sweep
# of 27 `$` patterns x 69 subjects found 53 divergences; these are the shapes
# that produced them. All expectations verified against python3 `re`.

# --- the case that lost the match entirely: skip lands exactly on n-1 ---
pattern .*=.*$
m "xyz=abc" 0 7
m "xyz=abc\n" 0 7
m "a=b\n" 0 3
n "noequals\n"

# --- two nullable stars: the empty match at EOF outranked the real one ---
pattern a*b*$
m "a" 0 1
m "a\n" 0 1
m "aa\n" 0 2
m "\n\n" 1 1
m "aaab\n" 0 4
m "bar\n" 3 3

# --- a skip state that itself accepts only at EOL ---
pattern [a-z]*$
m "abc" 0 3
m "abc\n" 0 3
m "abc\ndef" 4 7
m "" 0 0

pattern [^\n]*$
m "hello" 0 5
m "hello\n" 0 5

# --- memchr prefilter on the EOL path (single escape byte) ---
pattern a*b$
m "aaab" 0 4
m "aaab\n" 0 4
# `a*` can match zero 'a', so the leftmost START is the 'b' itself
m "xxxxxxxxxxxxxxxxxxxxb" 20 21
m "xxxxxxxxxxxxxxxxxxxxb\n" 20 21
n "xxxxxxxxxxxxxxxxxxxxbx"
n "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# --- prefilter must not early-return: the EOL view can still accept ---
pattern b*$
m "aaaa" 4 4
m "aaaa\n" 4 4
m "aaab" 3 4
m "aaab\n" 3 4

pattern $
m "" 0 0
m "abc" 3 3
m "abc\n" 3 3
m "\n" 0 0

# --- dot-star shapes where the skip covers almost the whole subject ---
pattern a.*$
m "abbbbbbbbbb" 0 11
m "abbbbbbbbbb\n" 0 11
n "bbbbbbbbbb"

pattern .*$
m "" 0 0
m "abc" 0 3
m "abc\n" 0 3
m "\n" 0 0

# --- reverse-machine skip: the match START must not be skipped past ---
pattern [a-z]+@[a-z]+$
m "aaaaaaaaaaaaaaaaaaaa@bbbbbbbbbbbbbbbbbbbb" 0 41
m "aaaaaaaaaaaaaaaaaaaa@bbbbbbbbbbbbbbbbbbbb\n" 0 41
m "..aa@bb" 2 7

# --- short subjects: n = 0, 1, 2 exercise the pos+1 bounds directly ---
pattern a$
m "a" 0 1
m "a\n" 0 1
n ""
n "\n"

pattern .$
m "a" 0 1
m "ab" 1 2
m "a\n" 0 1
n "\n"

pattern a*$
m "" 0 0
m "a" 0 1
m "\n" 0 0
m "a\n" 0 1
m "ba" 1 2

# --- R3.4: a FORWARD skip state whose PLAIN accept flag is set --------------
#
# Everything above this line has a hole, found by the R3 semantics critic: in
# none of those 13 patterns does a forward skip state have its plain (non-EOL)
# accept flag set. D11 is written about ordering scan avoidance against ACCEPT
# EVALUATION, and this is the forward half of that interaction — a skip loop
# running across positions where the state ALREADY accepts. The EOL-only accept
# states above exercise the other half.
#
# (The first version of this comment said that half "had no committed case".
# That was false and is corrected below: tests/base/dot.rxt caught it with one.
# It was checkable by running the sabotage against the whole corpus, which is
# exactly what produced the numbers quoted alongside the claim.)
#
# The shape that produces it is an alternation with one unanchored self-looping
# branch: the `.*`/`[^\n]*` state both self-loops (so it gets a skip table) and
# accepts (so `last` must survive the skip). Confirmed from the emitted C
# rather than assumed — `a.*|b$` emits rx_fs1[256] with rx_facc[1] == 1.
#
# SABOTAGE-VALIDATED, and the two halves need different patterns. Counts are
# whole-corpus and were re-measured after an R3.2 critic showed the first
# version of this header understated its own block (it said 3 where the real
# figure is 10) and claimed a gap that did not exist:
#   * emitting the EOL accept only at the boundary (`if (pos + 1 >= n &&
#     facc[est])`) fails 3 cases, all here: 2 of `a.*|b$`, 1 of `a[^\n]*|\n$`.
#     Nothing else in the corpus sees it, so this half genuinely had no case.
#   * dropping the non-EOL post-skip `last = pos` (the `!eol &&
#     fd->st[K].accept` line) fails 11 cases: 10 here (`[a-z].*|q$` 3,
#     `a.*|b` 3, `=.*|;` 4) and 1 in tests/base/dot.rxt.
# That last case matters: `dot.rxt`'s `.+` on "hello\nworld" ALREADY caught the
# non-EOL half before this block existed, so the original claim that "the
# forward half had no committed case" was false as written. This block takes it
# from 1 case to 11, which is the honest improvement.
# Note also that neither half catches relaxing the EOL forward skip bound from
# n-1 back to n — other files in tests/base/ catch that one (3 cases:
# eol_engine.rxt and review_r2.rxt); this file does not, despite its header.
#
# `[a-z].*|q$` is a NON-EOL machine even though it is written with a `$`:
# `[a-z].*` subsumes `q$`, so no EOL-variant state survives (no rx_fev table is
# emitted). That is what gives it detection power on the non-EOL path — and it
# is an accident of this pattern, so `a.*|b` and `=.*|;` below carry no `$` at
# all and cannot lose that coverage to a construction change.
#
# All expectations from python3 `re`.

pattern a.*|b$
m "axxxxxxxxxxxxxxxxxxxx" 0 21
m "axxxxxxxxxxxxxxxxxxxx\n" 0 21
m "xxxxxxxxxxb" 10 11
m "xxxxxxxxxxb\n" 10 11
n "xxxxxxxxxxbx"
m "ba" 1 2
m "b" 0 1
m "\nb" 1 2
m "a" 0 1
m "a\n" 0 1
# the skip stops at the \n, well before n-1, and the `b$` branch must not win
m "axxx\nb" 0 4
m "axxx\nb\n" 0 4

pattern =.*|x$
m "k=vvvvvvvvvv" 1 12
m "k=vvvvvvvvvv\n" 1 12
m "abcx" 3 4
m "abcx\n" 3 4
n "abcxy"
m "=" 0 1
m "=\n" 0 1

# `[^\n]*` self-loops on 255 of 256 bytes, so the skip table is near-total
pattern a[^\n]*|\n$
m "aXXXXXXXXXX\nYYY" 0 11
m "XXXXXXXXXX\n" 10 11
m "aaa" 0 3
m "aaa\n" 0 3
m "\n" 0 1
m "XX\nYY\n" 5 6

pattern [a-z].*|q$
m "zzzzzzzzzz" 0 10
m "zzzzzzzzzz\n" 0 10
m "1234q" 4 5
m "1234q\n" 4 5
m "1234q5" 4 6

# no `$` anywhere: guaranteed non-EOL machines with an accepting skip state
pattern a.*|b
m "axxxxxxxxxxxxxxxxxxxx" 0 21
m "axxxxxxxxxxxxxxxxxxxx\n" 0 21
m "xxxxxxxxxxb" 10 11
m "bxxxx" 0 1
m "a\nb" 0 1
m "xxxa\nyyy" 3 4
m "b\n" 0 1
m "ab" 0 2

pattern =.*|;
m "k=vvvvvvvvvv" 1 12
m "k=vvvvvvvvvv\n" 1 12
m "aaa;bbb" 3 4
m "aaa\n=v" 4 6
m ";" 0 1
m "=;" 0 2

# --- R3.4 second gap: a forward skip state that is BOTH plain-accepting AND ---
# --- has an EOL variant                                                    ---
#
# Found by an R3.2 critic sweep after the block above was committed. The file now
# had two shapes and still not their intersection: the original 13 patterns give
# EOL-varianted skip states that do NOT plain-accept, the R3.4 block gives
# plain-accepting skip states with NO EOL variant, and nothing had both at once.
# That intersection is the only place where the two orderings D11 arbitrates can
# actually disagree about the same state, so it is the case the file most needed.
#
# `a(?:$|.)*` emits rx_fs2 with rx_facc[2] == 1 and rx_fev[2] >= 0 — verified in
# the emitted C, not assumed. The critic swept 244 patterns of this shape against
# PCRE2 and all held, so these are a regression net, not a bug report.
#
# All expectations from python3 `re`.

pattern a(?:$|.)*
m "axxxxxxxxxx" 0 11
m "axxxxxxxxxx\n" 0 11
m "a" 0 1
m "a\n" 0 1
n ""
n "\n"
m "zzza\nbbb" 3 4
n "xxx"
n "xxx\n"

pattern x(?:$|[^\n])*
m "axxxxxxxxxx" 1 11
m "axxxxxxxxxx\n" 1 11
n "a"
n "a\n"
n ""
m "xxx" 0 3
m "xxx\n" 0 3
m "x=v\n" 0 3

pattern (?:=|$)(?:.|$)*
m "axxxxxxxxxx" 11 11
m "a" 1 1
m "" 0 0
m "\n" 0 0
m "xxx\n" 3 3
m "x=v\n" 1 3
m "k=v" 1 3
m "k=v\n" 1 3

# --- R3.2 critic: the REVERSE `pp + 1 < n` entry guard, made falsifiable ------
#
# The critic that found this reported that NO .rxt case could distinguish the
# guarded from the unguarded reverse skip. That is overstated, and the measured
# numbers are these — deleting `&& pp + 1 < n` from emit_dfa.c's reverse skip:
#
#   the 19 patterns above this block ....  3 cases fail
#   this block ..........................  14 cases fail
#   all of tests/base/ ..................  17 cases fail
#
# So the guard was already falsifiable, but only just, and by cases that were
# not written for it. The critic's underlying point stands: it found ZERO
# divergences from removing this guard over 7.7 million oracle-checked
# comparisons on a family where `$` always ends a branch, because in that shape
# no REVERSE skip state ever carries an EOL variant.
# The guard is only load-bearing for a MID-PATTERN `$` with content after it:
# reversed, the `$` sits after the first consumed bytes, so a self-looping
# reverse state can sit behind it. With the guard removed, the reverse skip runs
# from the end straight through n-1, never takes the EOL view at the one
# accepting position, and `sfound` stays -1 — the whole match is lost.
#
# The subject must be long enough for the skip to have somewhere to run (>= 7
# bytes here), which is why short-subject corpora miss this entirely.
#
# All expectations from python3 `re`.

pattern x$.*
m "xxxxxxx" 6 7
m "xxxxxxx\n" 6 7
m "\nxxxxxxx" 7 8
m "x" 0 1
m "x\n" 0 1
n ""
n "\n"
n "aaaaaaaa"
n "abcdefgh"

pattern a$.*
m "aaaaaaaa" 7 8
m "aaaaaaaa\n" 7 8
n "xxxxxxx"
n "abcdefgh"
n ""

pattern .*$.*
m "xxxxxxx" 0 7
m "xxxxxxx\n" 0 7
m "\nxxxxxxx" 1 8
m "" 0 0
m "\n" 0 0
m "aaaaaaaa" 0 8

pattern $[^\n]*
m "xxxxxxx" 7 7
m "xxxxxxx\n" 7 7
m "" 0 0
m "\n" 0 0
m "aaaaaaaa" 8 8

# --- R3.2 critic F16: the REVERSE mirror of the rule this file is about ------
#
# emit_dfa.c has the same post-skip accept rule twice, 40 lines apart:
#   forward:  if (!eol && fd->st[K].accept) last   = pos;
#   reverse:  if (!eol && rd->st[K].accept) sfound = pp;
# This file covered the FORWARD one 10 times over and the REVERSE one ZERO
# times, while its header presents it as the home of D11's scan-avoidance-vs-
# accept-evaluation coverage. It even has a section titled "reverse-machine
# skip: the match START must not be skipped past" which does not fire on this
# sabotage at all.
#
# Measured, disabling the reverse line only: 6 cases across tests/base/ fail
# (dot.rxt 2, leftmost_semantics.rxt 2, quantifiers.rxt 2) and 0 of them are
# here. With the four patterns below the file catches it with 10.
#
# The shape needed is a reverse skip state that ACCEPTS: reversed, `[a-z]*=`
# becomes `=[a-z]*`, whose post-`=` state self-loops over the letters and
# accepts at each one, so the match START is exactly the position a reverse
# skip would run past.
#
# All expectations from python3 `re`.

pattern [a-z]*=
m "aaaaaaaaaa=bbb" 0 11
m "aaaaaaaaaa=bbb\n" 0 11
m "zz=" 0 3
m "=" 0 1
n "xaaaaaaaaay"
m "abc\nxyz=q" 4 8
m "k=v=w" 0 2

pattern .*=
m "aaaaaaaaaa=bbb" 0 11
m "zz=" 0 3
m "abc\nxyz=q" 4 8
m "k=v=w" 0 4

pattern x.*y
m "xaaaaaaaaay" 0 11
m "xaaaaaaaaayzzz" 0 11
m "abc\nxyz=q" 4 6
n "k=v=w"

pattern [^\n]*=
m "aaaaaaaaaa=bbb\n" 0 11
m "=" 0 1
m "k=v=w" 0 4
