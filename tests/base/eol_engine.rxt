# M2.7 regressions: `$`-bearing patterns now run on the O(n) unanchored
# engine (EOL-variant states in BOTH the forward and reverse machines).
# All expectations PCRE2- and python-verified.

# $ at end of pattern, with and without a trailing newline
pattern a$
m "a" 0 1
m "a\n" 0 1
m "ba" 1 2
n "ab"

pattern a*b$
m "aaab" 0 4
m "aaab\n" 0 4
m "xaab" 1 4
n "aaabx"
m "b" 0 1

# the R2-A2 shape: $ with no ^ over a long run (was O(n^2), now linear)
pattern a*b$
n "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# $ mid-pattern with a matchable continuation
pattern a$\n
m "a\n" 0 2
n "ab"

# $ as a preferred alternative (priority must beat the consuming branch)
pattern $|\n
m "\n" 0 0
m "" 0 0

pattern (?:$|[^abc]){2,}
m "XY$\n" 0 3

# greedy/lazy interaction with $
pattern .*$
m "ab\n" 0 2
m "ab" 0 2
m "" 0 0

pattern a+?$
m "aaa" 0 3
m "aa\n" 0 2

# $ inside groups and alternations
pattern (?:ab$|a)
m "ab" 0 2
m "ax" 0 1
m "ab\n" 0 2

pattern x*$
m "xxx" 0 3
m "" 0 0
m "yxx" 1 3

# bare $ and empty subject
pattern $
m "" 0 0
m "abc" 3 3
m "\n" 0 0

# match start must be found correctly by the reverse machine with $
pattern [0-9]+z$
m "ab123z" 2 6
m "ab123z\n" 2 6
n "ab123zq"
