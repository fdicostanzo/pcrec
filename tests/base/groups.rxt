# Groups: capturing (...) and non-capturing (?:...), nesting and quantification

pattern (a)
m "a" 0 1
n "b"

pattern (?:a)
m "a" 0 1

pattern (ab)c
m "abc" 0 3
n "ab"

pattern (a(b)c)
m "abc" 0 3

pattern (a(bc)d)
m "abcd" 0 4

pattern (?:ab)+
m "ababab" 0 6
m "aba" 0 2
n "xyz"

pattern (?:a|b)+
m "abab" 0 4
n "cc"

pattern ((a))
m "a" 0 1

pattern (a)(b)(c)
m "abc" 0 3

pattern (a|(b))c
m "ac" 0 2
m "bc" 0 2

pattern (?:a(?:b(?:c)))
m "abc" 0 3

pattern (abc)?
m "abc" 0 3
m "xyz" 0 0

pattern (abc)*
m "abcabc" 0 6
m "" 0 0

pattern (a|b)(c|d)
m "ac" 0 2
m "bd" 0 2
n "ae"

pattern ((ab)+c)+
m "abcabc" 0 6

pattern (?:(?:a))
m "a" 0 1
