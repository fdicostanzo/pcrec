# The VM cursor rung's LAZY rmin prefix ([MEMFN] R-12, lane vmlazy): the
# rmin mandatory iterations are the kit's span scan capped at rmin, then the
# rung's reach test. Witnesses for both halves: a run SHORT of rmin (stride 1
# and 2), exactly rmin, past rmin, and rmin = 200. Each pattern twice: the
# default route and `engine vm` (no prefilter in front, so the prefix is the
# only thing that can refuse a short run). Every expectation is python's re.

pattern (a)(?:ab){2,}?ac
n "aabac"
m "aababac" 0 7
g 1 0 1
m "xaababacy" 1 8
g 1 1 2
n "aab"
n "aabab"

pattern (a)(?:ab){2,}?ac
engine vm
n "aabac"
m "aababac" 0 7
g 1 0 1
m "xaababacy" 1 8
g 1 1 2
n "aab"
n "aabab"

pattern (a)(?:ab){2,}?c
n "aabc"
m "aababc" 0 6
g 1 0 1
m "aabababc" 0 8
g 1 0 1
n "aababx"

pattern (a)(?:ab){2,}?c
engine vm
n "aabc"
m "aababc" 0 6
g 1 0 1
m "aabababc" 0 8
g 1 0 1
n "aababx"

pattern (a)(?:ab){2,}?ab
m "aababab" 0 7
g 1 0 1
n "aabab"
m "aabababab" 0 7
g 1 0 1
m "xaabababx" 1 8
g 1 1 2

pattern (a)(?:ab){2,}?ab
engine vm
m "aababab" 0 7
g 1 0 1
n "aabab"
m "aabababab" 0 7
g 1 0 1
m "xaabababx" 1 8
g 1 1 2

