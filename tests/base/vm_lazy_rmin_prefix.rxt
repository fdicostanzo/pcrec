m "aababababab" 0 7
g 1 0 1
m "aabababababab" 0 7
g 1 0 1

pattern (a)(?:ab){2,4}?ab
engine vm
m "aababab" 0 7
g 1 0 1
m "aababababab" 0 7
g 1 0 1
m "aabababababab" 0 7
g 1 0 1

pattern (a)(?:ab){3}?x
m "aabababx" 0 8
g 1 0 1
n "aababx"
n "aabababab"

pattern (a)(?:ab){3}?x
engine vm
m "aabababx" 0 8
g 1 0 1
n "aababx"
n "aabababab"

pattern (x)(\d{4,}?)\d
m "x12345" 0 6
g 1 0 1
g 2 1 5
n "x1234"
n "x123"
m "yx99999z" 1 7
g 1 1 2
g 2 2 6

pattern (x)(\d{4,}?)\d
engine vm
m "x12345" 0 6
g 1 0 1
g 2 1 5
n "x1234"
n "x123"
m "yx99999z" 1 7
g 1 1 2
g 2 2 6

pattern (a+?)(a+)
n "a"
m "aa" 0 2
g 1 0 1
g 2 1 2
m "aaa" 0 3
g 1 0 1
g 2 1 3
m "baaab" 1 4
g 1 1 2
g 2 2 4

pattern (a+?)(a+)
engine vm
n "a"
m "aa" 0 2
g 1 0 1
g 2 1 2
m "aaa" 0 3
g 1 0 1
g 2 1 3
m "baaab" 1 4
g 1 1 2
g 2 2 4

pattern (a{2,3}?){2,3}
m "aaaa" 0 4
g 1 2 4
m "aaaaaa" 0 6
g 1 4 6
n "aaa"
m "aaaaaaaaa" 0 6
g 1 4 6

