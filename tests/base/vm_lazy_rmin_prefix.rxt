pattern (b)(a){200,}?b
m "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab" 0 202
g 1 0 1
g 2 200 201
n "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"
m "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab" 0 203
g 1 0 1
g 2 201 202

pattern (b)(a){200,}?b
engine vm
m "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab" 0 202
g 1 0 1
g 2 200 201
n "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"
m "baaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab" 0 203
g 1 0 1
g 2 201 202

# Witnesses the necessary-run pre-check cannot see through (2026-11-11, lane
# mechtri2). `(a)(?:ab){2,}?ac` and the other literal-block patterns above
# are decided by the whole-pattern required-run test in front of the VM (even
# under `engine vm`: it demands the 2 blocks outright), so a plant dropping
# the reach test moved no answer there (S706/S708/S711 read UNDETECTED at
# 7d74499bc). A class the run test cannot fold to a mask ([abc], [bcd]) leaves
# the span scan + reach test as the only counter: stride 1 here, stride 2 below.

pattern z[abc]{3,}?d?
n "zabd"
n "zab"
m "zabc" 0 4
m "zabcd" 0 5
m "zabcabcd" 0 4
m "zaabbd" 0 4

pattern z[abc]{3,}?d?
engine vm
n "zabd"
n "zab"
m "zabc" 0 4
m "zabcd" 0 5
m "zabcabcd" 0 4
m "zaabbd" 0 4

pattern (a)(?:a[bcd]){2,}?ae
n "aabae"
n "aabaex"
n "aabcae"
m "aababae" 0 7
g 1 0 1
n "aabcadae"

pattern (a)(?:a[bcd]){2,}?ae
engine vm
n "aabae"
n "aabaex"
n "aabcae"
m "aababae" 0 7
g 1 0 1
n "aabcadae"

# Short subjects with a width-1 alternative: the pattern's minimum width is 1,
# so the min-width search stop does not apply and a short run IS reached by
# the lazy prefix (S708's witness, after [S1]'s stop made aabae/aabcae under
# 7 bytes unreachable); python re.
pattern (a)(?:ab){2,}?ac|q
n "aabac"
m "aababac" 0 7
g 1 0 1
m "xaababacy" 1 8
g 1 1 2
n "aab"
n "aabab"
m "aabacq" 5 6
g 1 -1 -1

pattern (a)(?:ab){2,}?ac|q
engine vm
n "aabac"
m "aababac" 0 7
g 1 0 1
m "xaababacy" 1 8
g 1 1 2
n "aab"
n "aabab"
m "aabacq" 5 6
g 1 -1 -1
