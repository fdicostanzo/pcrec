# Long-subject coverage (docs/dev/reviews/2026-08-09-m1.md P-N1; plan M2.4).
# Subjects range 200-900 bytes: end-of-subject matches, near-miss long
# scans, greedy .* spans, and bounded {50,60} repeats over long runs.

# literal at end of a 250-byte subject (subject length 250)
pattern xyz
m "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaxyz" 247 250

# literal at end of a 900-byte subject (subject length 900)
pattern wxyz
m "" 896 900

# near-miss: long greedy run with no match (subject length 401)
pattern a+b
n ""

# near-miss runs of a{9} before a real a{10} at the end (subject length 310)
pattern a{10}
m "" 300 310

# greedy .* spanning the whole subject (subject length 500)
pattern a.*z
m "" 0 500

# greedy .*z extends to the last z, not the first (subject length 403)
pattern a.*z
m "" 0 403

# bounded repeat {50,60} matches an exact run of 55 (subject length 255)
pattern a{50,60}
m "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" 100 155

# bounded repeat {50,60} greedily caps at 60 within an 80-run (subject length 280)
pattern a{50,60}
m "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" 100 160

# bounded repeat {50,60} rejects a run one short of the minimum (subject length 249)
pattern a{50,60}
n "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# alternation match near the end of a 606-byte subject (subject length 606)
pattern needle|haystack
m "" 300 306

