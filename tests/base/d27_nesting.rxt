# nested alternation, quantified arms, quantified whole
pattern ((ab){1,3}|(cd){1,2}){1,3}
m "ababcdcd" 0 8
g 1 4 8
g 2 2 4
g 3 6 8
m "ab" 0 2
g 1 0 2
g 2 0 2
g 3 -1 -1
m "cdcd" 0 4
g 1 0 4
g 2 -1 -1
g 3 2 4
m "ababab" 0 6
g 1 0 6
g 2 4 6
g 3 -1 -1
m "cd" 0 2
g 1 0 2
g 2 -1 -1
g 3 0 2
m "abcdabcdab" 0 6
g 1 4 6
g 2 4 6
g 3 2 4
n "x"

# nested: quantified class body inside quantified group
pattern ([a-c]{1,3}){2,4}
m "abcabc" 0 6
g 1 3 6
m "aabbcc" 0 6
g 1 3 6
n "a"
m "aaaaaaaaaaaa" 0 12
g 1 9 12
n "xyz"
