m "aaaa" 0 4
g 1 2 4
n "aa"
m "aaaaaa" 0 6
g 1 4 6
m "aaaaaaaaa" 0 6
g 1 4 6
m "aaaaaaaaaa" 0 6
g 1 4 6

# two levels, outer lazy
