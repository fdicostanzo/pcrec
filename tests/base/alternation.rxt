# Alternation

pattern a|b
m "a" 0 1
m "b" 0 1
n "c"

pattern cat|dog
m "cat" 0 3
m "dog" 0 3
n "cow"

pattern a|ab
m "ab" 0 1

pattern ab|a
m "ab" 0 2

pattern a|
m "a" 0 1
m "b" 0 0

pattern |a
m "a" 0 0

pattern a|b|c
m "c" 0 1
m "a" 0 1
n "d"

pattern foo|foobar
m "foobar" 0 3

pattern foobar|foo
m "foobar" 0 6

pattern (a|b)c
m "ac" 0 2
m "bc" 0 2
n "cc"

pattern x(a|b|c)y
m "xay" 0 3
m "xcy" 0 3

pattern a|a
m "a" 0 1

pattern (ab|cd)(ef|gh)
m "abef" 0 4
m "cdgh" 0 4
n "xxxx"
m "abghx" 0 4
