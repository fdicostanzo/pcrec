# Patterns that can match the empty string

pattern a*
m "" 0 0
m "bbb" 0 0
m "aaa" 0 3

pattern a?
m "" 0 0
m "bbb" 0 0

pattern (?:a|)
m "" 0 0
m "a" 0 1

pattern (?:a|)b
m "b" 0 1
m "ab" 0 2
n "c"

pattern (a|)b
m "b" 0 1
m "ab" 0 2

pattern (abc)?
m "" 0 0
m "xyz" 0 0

pattern ()
m "" 0 0
m "abc" 0 0

pattern (?:)
m "" 0 0
m "x" 0 0

pattern a{0}
m "" 0 0
m "a" 0 0

pattern a{0,}
m "" 0 0
m "aaa" 0 3

pattern x*y*
m "" 0 0
m "xxxyyy" 0 6

pattern ^$
m "" 0 0

pattern ^a*$
m "" 0 0
m "aaa" 0 3
n "aab"

pattern (?:x|y|)
m "z" 0 0
m "x" 0 1
