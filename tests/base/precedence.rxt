# Operator precedence: concatenation binds tighter than alternation;
# quantifiers bind to the immediately preceding atom/group.

pattern ab|cd
m "ab" 0 2
m "cd" 0 2
n "ac"

pattern a|bc
m "a" 0 1
m "bc" 0 2

pattern ^a|b
m "ab" 0 1
m "xb" 1 2

pattern a|b$
m "a" 0 1
m "xb" 1 2

pattern abc*
m "ab" 0 2
m "abccc" 0 5

pattern (abc)*
m "abcabc" 0 6

pattern ab*c
m "ac" 0 2
m "abbc" 0 4

pattern a|b*
m "bbb" 0 3
m "a" 0 1

pattern (a|b)*
m "ababba" 0 6

pattern a*|b
m "aaa" 0 3
m "b" 0 0

pattern a(b|c)*d
m "abcbcd" 0 6
m "ad" 0 2

pattern (a|b|c)*d
m "abcabcd" 0 7

pattern a?b?c?
m "abc" 0 3
m "" 0 0

pattern a{2}b{3}
m "aabbb" 0 5
n "aabb"
