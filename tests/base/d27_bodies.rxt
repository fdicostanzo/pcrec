# Quantifier BODIES: classes, alternations (varying arm length / shared prefix / empty arm), capturing and non-capturing groups, multi-char literals.
# Auto-generated for the D27 quantifier/bounded-repeat corpus.
# Every expectation is computed directly from python's re module.

# class body, greedy bounded
pattern [abc]{2,4}
n "a"
m "ab" 0 2
m "abc" 0 3
m "aabbcc" 0 4
m "aabbccd" 0 4
n "zzz"
m "xaabby" 1 5

# class body, lazy bounded
pattern [abc]{2,4}?
n "a"
m "ab" 0 2
m "abc" 0 2
m "aabbcc" 0 2
m "aabbccd" 0 2
n "zzz"
m "xaabby" 1 3

# negated class body, greedy bounded
pattern [^abc]{2,4}
n "x"
m "xy" 0 2
m "xyz" 0 3
m "wxyz" 0 4
m "wxyzq" 0 4
n "aaa"
m "aaxyzaa" 2 5

# negated class body, lazy bounded
pattern [^abc]{2,4}?
n "x"
m "xy" 0 2
m "xyz" 0 2
m "wxyz" 0 2
m "wxyzq" 0 2
n "aaa"
m "aaxyzaa" 2 4

# range class body
pattern [a-c]{1,3}
m "a" 0 1
m "ab" 0 2
m "abc" 0 3
m "abcd" 0 3
n "ddd"

# alternation, different-length arms, greedy
pattern (ab|c){2,4}
m "abab" 0 4
g 1 2 4
m "cc" 0 2
g 1 1 2
m "abc" 0 3
g 1 2 3
m "cabc" 0 4
g 1 3 4
m "ababababc" 0 8
g 1 6 8
m "ababab" 0 6
g 1 4 6
n "z"
m "xabcaby" 1 6
g 1 4 6

# alternation, different-length arms, lazy
pattern (ab|c){2,4}?
m "abab" 0 4
g 1 2 4
m "cc" 0 2
g 1 1 2
m "abc" 0 3
g 1 2 3
m "cabc" 0 3
g 1 1 3
m "ababababc" 0 4
g 1 2 4
m "ababab" 0 4
g 1 2 4

# alternation, shared prefix, greedy
pattern (ab|ac){2,4}
m "abac" 0 4
g 1 2 4
m "acab" 0 4
g 1 2 4
m "abababac" 0 8
g 1 6 8
m "abab" 0 4
g 1 2 4
m "acacacacx" 0 8
g 1 6 8

# alternation, shared prefix, lazy
pattern (ab|ac){2,4}?
m "abac" 0 4
g 1 2 4
m "acab" 0 4
g 1 2 4
m "abababac" 0 4
g 1 2 4
m "abab" 0 4
g 1 2 4

# alternation with empty arm ('a' first), greedy
pattern (a|){2,4}
m "aaaa" 0 4
g 1 3 4
m "aa" 0 2
g 1 2 2
m "a" 0 1
g 1 1 1
m "" 0 0
g 1 0 0
m "aaaaa" 0 4
g 1 3 4

# alternation with empty arm (empty first), greedy
pattern (|a){2,4}
m "aaaa" 0 0
g 1 0 0
m "aa" 0 0
g 1 0 0
m "a" 0 0
g 1 0 0
m "" 0 0
g 1 0 0
m "aaaaa" 0 0
g 1 0 0

# non-capturing group body
pattern (?:ab){2,4}
m "abab" 0 4
m "ababab" 0 6
m "ababababab" 0 8
n "ab"
n "x"

# capturing group body -- last iteration span
pattern (ab){2,4}
m "abab" 0 4
g 1 2 4
m "ababab" 0 6
g 1 4 6
m "ababababab" 0 8
g 1 6 8
n "ab"
m "xababy" 1 5
g 1 3 5

# capturing group body, lazy -- last iteration span
pattern (ab){2,4}?
m "abab" 0 4
g 1 2 4
m "ababab" 0 4
g 1 2 4
m "ababababab" 0 4
g 1 2 4

# quantified group containing a quantified body
pattern (a+){2,3}
m "aaaaaa" 0 6
g 1 5 6
n "a"
m "aa" 0 2
g 1 1 2
m "aaa" 0 3
g 1 2 3
m "aaaa" 0 4
g 1 3 4
m "aaaaaaaaaa" 0 10
g 1 9 10

# quantified group, nullable inner quantifier
pattern (a*){2,3}
m "aaaaaa" 0 6
g 1 6 6
m "" 0 0
g 1 0 0
m "a" 0 1
g 1 1 1
m "aaa" 0 3
g 1 3 3

# quantified group, optional-prefixed literal
pattern (a?b){2,4}
m "ababab" 0 6
g 1 4 6
m "bbb" 0 3
g 1 2 3
m "abbb" 0 4
g 1 3 4
m "ababb" 0 5
g 1 4 5
n "b"

# multi-char literal group body
pattern (abc){2,4}
m "abcabc" 0 6
g 1 3 6
m "abcabcabc" 0 9
g 1 6 9
n "abc"
m "abcabcabcabcabc" 0 12
g 1 9 12
n "ababc"

# quantifier on the LAST literal char only (not the whole run)
pattern abc{2,4}
m "abcc" 0 4
m "abccc" 0 5
m "abccccc" 0 6
n "ab"
m "abccccccc" 0 6
