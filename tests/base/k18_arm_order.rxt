m "a" 0 1
m "b" 0 0
m "aa" 0 2
m "ab" 0 1
m "ba" 0 0
m "bb" 0 0
m "aab" 0 2
m "bab" 0 0
m "aba" 0 1
m "abab" 0 1
m "aabb" 0 2

