# Class-bracket patterns: the MEMBER SETS, not just the verdict
#
# Every pattern here is one FIX-2 changed the verdict of (K3's over-rejection
# half) or pinned as a control at the class-bracket doorway. Until R9 they were
# guarded only by `accept` rows in tests/reject/, which assert exit 0 and a
# non-empty output file — "did not say no". Nothing compiled the emitted matcher
# and ran it, and nothing in the .rxt corpus contained a single one of them.
#
# R9/C1-F4 measured what that costs: a one-line change in parse.c's class member
# loop that SWALLOWS the `:` in `[a[:b]` — dropping it from the member set —
# passed every suite in this repository and the differential fuzzer. The
# verdicts were all still right. The set was wrong.
#
# These are exactly the patterns whose member sets are unusual (a `[`, a `:`, a
# `.` or a `\` as an ordinary member), which is what makes them the likeliest to
# get wrong and made their absence from the corpus the sharpest blind spot at
# this doorway. Expectations oracle-verified against python3 `re`, which agrees
# with libpcre2 10.46 on all of them.


pattern [a[:b]
# K3's over-rejection: an unclosed [: is ordinary members {a,[,:,b}
m ":" 0 1
m "[" 0 1
m "a" 0 1
m "b" 0 1
n "."
n "="
n "]"
n "x"

pattern [[:alpha]
# same, with a name-shaped body: members {[,:,a,l,p,h}
m ":" 0 1
m "[" 0 1
m "a" 0 1
n "b"
n "."
n "="
n "]"

pattern [[:]]
# members {[,:} then a literal ]
m ":]" 0 2
m "[]" 0 2
n "a"
n "b"
n ":"
n "."

pattern [[:]
# members {[,:}
m ":" 0 1
m "[" 0 1
n "a"
n "b"
n "."
n "="

pattern [:]
# the class's own bracket, member {:} — doorway 4a
m ":" 0 1
n "a"
n "b"
n "."
n "="

pattern [:a]
# members {:,a} — doorway 4a
m ":" 0 1
m "a" 0 1
n "b"
n "."
n "="
n "["

pattern [.a]x.]
# K4: the .] is OUTSIDE the class; members {.,a} then literal x.]
m ".x.]" 0 4
m ".x:]" 0 4
m ".x=]" 0 4
m ".x[]" 0 4
m ".x\\]" 0 4
m ".x]]" 0 4
m ".xa]" 0 4
m ".xb]" 0 4
m ".xc]" 0 4
m ".xd]" 0 4
n "a"
n "b"
n ":"
n "."

pattern [=a]x=]
# the same at the = delimiter
m "=x=]" 0 4
m "ax=]" 0 4
n "a"
n "b"
n ":"
n "."

pattern [a[.b]c]d.]
# K4's sharpest case: class closes at offset 7, the .] sits at 9
m ".c]d.]" 0 6
m ".c]d:]" 0 6
m ".c]d=]" 0 6
m ".c]d[]" 0 6
m ".c]d\\]" 0 6
m ".c]d]]" 0 6
m ".c]da]" 0 6
m ".c]db]" 0 6
m ".c]dc]" 0 6
m ".c]dd]" 0 6
n "a"
n "b"
n ":"
n "."

pattern [[.a].]
# a bare ] ends the class before the .] is reached
m "..]" 0 3
m ".:]" 0 3
m ".=]" 0 3
m ".[]" 0 3
m ".\\]" 0 3
m ".]]" 0 3
m ".a]" 0 3
m ".b]" 0 3
m ".c]" 0 3
m ".d]" 0 3
n "a"
n "b"
n ":"
n "."

pattern [.a].]
# the same at the class's own bracket
m "..]" 0 3
m ".:]" 0 3
m ".=]" 0 3
m ".[]" 0 3
m ".\\]" 0 3
m ".]]" 0 3
m ".a]" 0 3
m ".b]" 0 3
m ".c]" 0 3
m ".d]" 0 3
n "a"
n "b"
n ":"
n "."

pattern [[.a\\]x.]
# K4 rule 3: \\ IS a unit, so the ] is unescaped and ends the class
m ".x.]" 0 4
m ".x:]" 0 4
m ".x=]" 0 4
m ".x[]" 0 4
m ".x\\]" 0 4
m ".x]]" 0 4
m ".xa]" 0 4
m ".xb]" 0 4
m ".xc]" 0 4
m ".xd]" 0 4
n "a"
n "b"
n ":"
n "."

pattern [[.b].]
# a bare ] ends it
m "..]" 0 3
m ".:]" 0 3
m ".=]" 0 3
m ".[]" 0 3
m ".\\]" 0 3
m ".]]" 0 3
m ".a]" 0 3
m ".b]" 0 3
m ".c]" 0 3
m ".d]" 0 3
n "a"
n "b"
n ":"
n "."

pattern [[.b\]]
# K4 rule 3: \] IS a unit, so ] is an ordinary member
m "." 0 1
m "[" 0 1
m "]" 0 1
m "b" 0 1
n "a"
n ":"
n "="
n "x"
