# Regression cases from checkpoint review R1 (docs/dev/reviews/2026-08-09-m1.md).
# S-C1: mid-pattern $ with a matchable continuation must work (EOL-variant states)
pattern a$\n
m "a\n" 0 2
n "ab"
n "a\nb"

pattern (a$\n)|ab
m "a\n" 0 2
m "ab" 0 2

# S-C2: $ priority — the earlier zero-width $ branch must beat a longer later branch
pattern $|\n
m "\n" 0 0
m "" 0 0

pattern (a$)*b
m "a\nb" 2 3
m "b" 0 1

# $ still correct in ordinary positions after the EOL-variant rework
pattern .*$
m "ab\n" 0 2
m "ab" 0 2
m "" 0 0

pattern a+?$
m "aaa" 0 3
m "aa\n" 0 2

# S-M2: \x with zero hex digits is an error (PCRE2 error 178); python agrees
pattern \x
perr

pattern a\xgz
perr

# 1- and 2-digit \x forms keep working
pattern \x41\x42
m "AB" 0 2

# S-M1: quantified bare anchors are errors (PCRE2 error 109).
# python re accepts these, so they are excluded from the python oracle.
# pcre2-only
pattern ^*a
perr

# pcre2-only
pattern a$*
perr

# ...but a quantified GROUP containing an anchor stays legal
pattern (^)*ab
m "abc" 0 2
