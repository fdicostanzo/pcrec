# Escapes: metachar escapes, control escapes, \xHH

pattern \.
m "." 0 1
n "a"

pattern \*
m "*" 0 1

pattern \+
m "+" 0 1

pattern \?
m "?" 0 1

pattern \(
m "(" 0 1

pattern \)
m ")" 0 1

pattern \[
m "[" 0 1

pattern \]
m "]" 0 1

pattern \{
m "{" 0 1

pattern \|
m "|" 0 1

pattern \\
m "\\" 0 1

pattern \^
m "^" 0 1

pattern \$
m "$" 0 1

pattern \-
m "-" 0 1

pattern a\.b
m "a.b" 0 3
n "axb"

pattern \n
m "\n" 0 1

pattern \t
m "\t" 0 1

pattern \r
m "\r" 0 1

pattern \f
m "\f" 0 1

pattern \x41
m "A" 0 1

pattern \x2e
m "." 0 1

pattern \x41\x42\x43
m "ABC" 0 3

pattern [\x09\x0a]
m "\t" 0 1
m "\n" 0 1

pattern \(\)
m "()" 0 2

pattern a\{2\}
m "a{2}" 0 4
n "aa"

# Control escapes that compiled but had NO corpus coverage until the
# 2026-08-09 PCRE2 compliance survey found them in the accepted-but-untested
# list. Both verified against libpcre2 10.46 directly, not just python.

pattern \a
m "\x07" 0 1
n "a"

# pcre2-only
# python `re` rejects \e outright ("bad escape \e"), so this block cannot be
# python-verified. PCRE2 defines it as ESC 0x1b, confirmed against libpcre2.
pattern \e
m "\x1b" 0 1

# \b inside a class is BACKSPACE, not a word boundary (PCRE rule); pcrec
# implements it and nothing exercised it.
pattern [\b]
m "\x08" 0 1
n "b"
