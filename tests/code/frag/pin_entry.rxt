# tests/code/frag/pin_entry.rxt — [INLINE-C] stage 3's corpus entry
# (inline_c.md §5.2-§5.5): the harness compiles its fragments' blocks
# through `pcrec --include-block` under this directory's grant, so pcrec
# judges each fragment's code by the include lines that reach it.
# pin_ok.rxt: pinned (upper-case hex), its code runs. pin_mid.rxt: no
# pin, patterns only, compiles; its pinned pin_leaf.rxt is still refused.
include "pin_ok.rxt" sha256 5BAFE76EEC238725E04FFD2ACF282003E0F58DCE888B8310099E22830BB5CC1B
include "pin_mid.rxt"

pattern e(?C`c: return RX_PASS;`)f
m "ef" 0 2
