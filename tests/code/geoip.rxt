# tests/code/geoip.rxt — UC-3 (docs/design/inline_c_requirements.md DT-3.1,
# DT-3.2): a code segment calls a function the user DEFINES in their own
# source (geoip.c, linked by harness.manifest) and declares in their own
# header (geoip.h, one `code-header` line). DT-3.3 and DT-3.4 are build
# checks in run_code_tests.sh.
code-header c "geoip.h"

pattern \b(\d{1,3}(?:\.\d{1,3}){3})\b(?C`c: return geo_is_private(RX_CAP_P(1), (size_t)RX_CAP_LEN(1)) ? RX_FAIL : RX_PASS;`)
features all
# DT-3.1 the user's function is reached and its answer honoured
n "host 10.1.2.3 up"
# DT-3.2 a public address passes
m "host 8.8.8.8 up" 5 12
g 1 5 12
m "a 192.168.0.1 b 1.2.3.4" 16 23
