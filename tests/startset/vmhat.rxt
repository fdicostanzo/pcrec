# edge VMR: recursion
# pcre2-only
pattern \((?:[^()]|(?R))*\)
features all
# tag edge=VMR
ms 0 "(a)" 0 3
ns 1 "(a)"
ns 2 "(a)"
ns 3 "(a)"
ms 0 "x(a)" 1 4
ms 1 "x(a)" 1 4
ns 2 "x(a)"
ns 3 "x(a)"
ns 4 "x(a)"
ms 0 "((a)" 1 4
ms 1 "((a)" 1 4
ns 2 "((a)"
ns 3 "((a)"
ns 4 "((a)"
ms 0 "(()" 1 3
ms 1 "(()" 1 3
ns 2 "(()"
ns 3 "(()"
ms 0 "a(b(c)d)" 1 8
ms 1 "a(b(c)d)" 1 8
ms 2 "a(b(c)d)" 3 6
ms 3 "a(b(c)d)" 3 6
ns 4 "a(b(c)d)"
ns 5 "a(b(c)d)"
