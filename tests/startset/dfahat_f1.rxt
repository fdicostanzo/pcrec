ms 0 "a xy x" 4 6
ms 1 "a xy x" 4 6
ms 2 "a xy x" 4 6
ms 3 "a xy x" 4 6
ms 4 "a xy x" 4 6
ns 5 "a xy x"
ns 6 "a xy x"
ms 0 "ax" 1 2
ms 1 "ax" 1 2
ns 2 "ax"

# under -i (both cases of `a` in S)
pattern (?<=\w)\s*?a
features all
flags i
ms 0 "x A" 1 3
ms 1 "x A" 1 3
ns 2 "x A"
ns 3 "x A"
ms 0 "x  a" 1 4
ms 1 "x  a" 1 4
