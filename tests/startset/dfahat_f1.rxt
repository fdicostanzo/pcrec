# tests/startset/dfahat_f1.rxt -- [START-SET] stage 3: the ss3 D6 panel's BLOCKER
# sound-F1 witnesses (docs/dev/reviews/2026-10-06-r-ss3-panel.md). A byte of the
# start set S leaves every seed state where it is, so `S & E*` dropped a start
# byte and the old `T == S` build assertion REFUSED these at default flags while
# -fno-start-set compiled them. With T = S the admission declines (the byte is
# outside E): each block must COMPILE, and tests/startset/dfahat_checks.py's
# [dfa-deny] holds its artifact byte-identical to the deny arm's.
#
# GENERATED by tests/startset/gen_dfahat_f1.py; every answer is libpcre2's (local
# 10.48), at every startpos. Byte-tier blocks are python-verified as well; the
# `flags u` block is libpcre2-only (python has no UCP).

# S = {' ', a}: a space keeps the non-word seed AND the word-context thread in ` *`; the hand-twin with T = {a} lost (1,3) on "x a"
pattern (?<=\w) *a
features all
ms 0 "x a" 1 3
ms 1 "x a" 1 3
ns 2 "x a"
ns 3 "x a"
ms 0 "x  a" 1 4
ms 1 "x  a" 1 4
ns 2 "x  a"
ns 3 "x  a"
ns 4 "x  a"
ns 0 " a"
ns 1 " a"
ns 2 " a"
ns 0 "a"
ns 1 "a"
ms 0 "xa" 1 2
ms 1 "xa" 1 2
ns 2 "xa"
ns 0 "x "
ns 1 "x "
ns 2 "x "
ns 0 "-- a"
ns 1 "-- a"
ns 2 "-- a"
ns 3 "-- a"
ns 4 "-- a"
ms 0 "x ab a" 1 3
ms 1 "x ab a" 1 3
ms 2 "x ab a" 4 6
ms 3 "x ab a" 4 6
ms 4 "x ab a" 4 6
ns 5 "x ab a"
ns 6 "x ab a"
ms 0 "  x a" 3 5
ms 1 "  x a" 3 5
ms 2 "  x a" 3 5
ms 3 "  x a" 3 5
ns 4 "  x a"
ns 5 "  x a"

# the same shape over `-`
pattern (?<=\w)-*a
features all
ms 0 "x-a" 1 3
ms 1 "x-a" 1 3
ns 2 "x-a"
ns 3 "x-a"
ms 0 "x--a" 1 4
ms 1 "x--a" 1 4
ns 2 "x--a"
ns 3 "x--a"
ns 4 "x--a"
ns 0 "-a"
ns 1 "-a"
ns 2 "-a"
ms 0 "xa" 1 2
ms 1 "xa" 1 2
ns 2 "xa"
ms 0 "--a x-a" 5 7
ms 1 "--a x-a" 5 7
ms 2 "--a x-a" 5 7
ms 3 "--a x-a" 5 7
ms 4 "--a x-a" 5 7
ms 5 "--a x-a" 5 7
ns 6 "--a x-a"
ns 7 "--a x-a"
ms 0 "a-a" 1 3
ms 1 "a-a" 1 3
ns 2 "a-a"
ns 3 "a-a"

# the realistic spelling: a word, spaces, a keyword
pattern (?<=\w) *(?:and|or)\b
features all
ms 0 "cat and dog" 3 7
ms 1 "cat and dog" 3 7
ms 2 "cat and dog" 3 7
ms 3 "cat and dog" 3 7
ns 4 "cat and dog"
ns 5 "cat and dog"
ns 6 "cat and dog"
ns 7 "cat and dog"
ns 8 "cat and dog"
ns 9 "cat and dog"
ns 10 "cat and dog"
ns 11 "cat and dog"
ms 0 "x or" 1 4
ms 1 "x or" 1 4
ns 2 "x or"
ns 3 "x or"
ns 4 "x or"
ms 0 "x  andy or" 7 10
ms 1 "x  andy or" 7 10
ms 2 "x  andy or" 7 10
ms 3 "x  andy or" 7 10
ms 4 "x  andy or" 7 10
ms 5 "x  andy or" 7 10
ms 6 "x  andy or" 7 10
ms 7 "x  andy or" 7 10
ns 8 "x  andy or"
ns 9 "x  andy or"
ns 10 "x  andy or"
ns 0 "and"
ns 1 "and"
ns 2 "and"
ns 3 "and"
ms 0 "x orb or" 5 8
ms 1 "x orb or" 5 8
ms 2 "x orb or" 5 8
ms 3 "x orb or" 5 8
ms 4 "x orb or" 5 8
ms 5 "x orb or" 5 8
ns 6 "x orb or"
ns 7 "x orb or"
ns 8 "x orb or"
ms 0 "ab  or " 2 6
ms 1 "ab  or " 2 6
ms 2 "ab  or " 2 6
ns 3 "ab  or "
ns 4 "ab  or "
ns 5 "ab  or "
ns 6 "ab  or "
ns 7 "ab  or "

# a negative lookbehind's twin
pattern (?<!\s) *[a-z]
features all
ms 0 " a" 0 2
ns 1 " a"
ns 2 " a"
ms 0 "x a" 0 1
ms 1 "x a" 1 3
ns 2 "x a"
ns 3 "x a"
ms 0 "  a" 0 3
ns 1 "  a"
ns 2 "  a"
ns 3 "  a"
ms 0 "a" 0 1
ns 1 "a"
ms 0 "\tb x" 2 4
ms 1 "\tb x" 2 4
ms 2 "\tb x" 2 4
ns 3 "\tb x"
ns 4 "\tb x"
ms 0 "- -c" 3 4
ms 1 "- -c" 3 4
ms 2 "- -c" 3 4
ms 3 "- -c" 3 4
ns 4 "- -c"

# 193 bytes of S dropped (every non-word byte)
pattern (?<=[ab])\W*?b
features all
ms 0 "a b" 1 3
ms 1 "a b" 1 3
ns 2 "a b"
ns 3 "a b"
ms 0 "a--b" 1 4
ms 1 "a--b" 1 4
ns 2 "a--b"
ns 3 "a--b"
ns 4 "a--b"
ns 0 "b"
ns 1 "b"
ns 0 "xb"
ns 1 "xb"
ns 2 "xb"
ms 0 "a  -b" 1 5
ms 1 "a  -b" 1 5
ns 2 "a  -b"
ns 3 "a  -b"
ns 4 "a  -b"
ns 5 "a  -b"
ms 0 "c b ab" 5 6
ms 1 "c b ab" 5 6
ms 2 "c b ab" 5 6
ms 3 "c b ab" 5 6
ms 4 "c b ab" 5 6
ms 5 "c b ab" 5 6
ns 6 "c b ab"
ms 0 "bb" 1 2
ms 1 "bb" 1 2
ns 2 "bb"

# the VM hybrid's prefilter carried the same refusal
pattern (?<=\w) *(a)
features all
ms 0 "x a" 1 3
g 1 2 3
ms 1 "x a" 1 3
g 1 2 3
ns 2 "x a"
ns 3 "x a"
ms 0 "x  a" 1 4
g 1 3 4
ms 1 "x  a" 1 4
g 1 3 4
ns 2 "x  a"
ns 3 "x  a"
ns 4 "x  a"
ns 0 " a"
ns 1 " a"
ns 2 " a"
ms 0 "xa" 1 2
g 1 1 2
ms 1 "xa" 1 2
g 1 1 2
ns 2 "xa"
ms 0 "a a" 1 3
g 1 2 3
ms 1 "a a" 1 3
g 1 2 3
ns 2 "a a"
ns 3 "a a"

# found under -fprefilter-collapse; plain here, collapsed by run_dfahat_checks.sh's second fixture pass
pattern (?<!\W) *-
features all
ms 0 "x -" 1 3
ms 1 "x -" 1 3
ns 2 "x -"
ns 3 "x -"
ms 0 "x  -" 1 4
ms 1 "x  -" 1 4
ns 2 "x  -"
ns 3 "x  -"
ns 4 "x  -"
ms 0 " -" 0 2
ns 1 " -"
ns 2 " -"
ms 0 "-" 0 1
ns 1 "-"
ms 0 "a-" 1 2
ms 1 "a-" 1 2
ns 2 "a-"
ms 0 "--" 0 1
ns 1 "--"
ns 2 "--"

# found under --ucp
pattern (?<![a-])(?<!\W)[ab]*?(?:ab|b)+
features all
flags u
ms 0 "xab" 1 3
ms 1 "xab" 1 3
ns 2 "xab"
ns 3 "xab"
ns 0 "-ab"
ns 1 "-ab"
ns 2 "-ab"
ns 3 "-ab"
ms 0 "cab ab" 1 3
ms 1 "cab ab" 1 3
ns 2 "cab ab"
ns 3 "cab ab"
ns 4 "cab ab"
ns 5 "cab ab"
ns 6 "cab ab"
ms 0 "b" 0 1
ns 1 "b"
ms 0 "ab" 0 2
ns 1 "ab"
ns 2 "ab"
ns 0 "x b"
ns 1 "x b"
ns 2 "x b"
ns 3 "x b"

# a \b seed: a digit loop keeps both seeds
pattern \b\d*b+
features all
ms 0 "1b" 0 2
ns 1 "1b"
ns 2 "1b"
ms 0 "x 12bb" 2 6
ms 1 "x 12bb" 2 6
ms 2 "x 12bb" 2 6
ns 3 "x 12bb"
ns 4 "x 12bb"
ns 5 "x 12bb"
ns 6 "x 12bb"
ms 0 "b" 0 1
ns 1 "b"
ns 0 "a1b"
ns 1 "a1b"
ns 2 "a1b"
ns 3 "a1b"
ms 0 "1 b" 2 3
ms 1 "1 b" 2 3
ms 2 "1 b" 2 3
ns 3 "1 b"
ns 0 "11"
ns 1 "11"
ns 2 "11"

# a lazy loop before a newline
pattern (?<=\s)a*?\n
features all
ms 0 " \n" 1 2
ms 1 " \n" 1 2
ns 2 " \n"
ms 0 "x a\n" 2 4
ms 1 "x a\n" 2 4
ms 2 "x a\n" 2 4
ns 3 "x a\n"
ns 4 "x a\n"
ms 0 " aa\n" 1 4
ms 1 " aa\n" 1 4
ns 2 " aa\n"
ns 3 " aa\n"
ns 4 " aa\n"
ns 0 "\n"
ns 1 "\n"
ms 0 "a\n a\n" 3 5
ms 1 "a\n a\n" 3 5
ms 2 "a\n a\n" 3 5
ms 3 "a\n a\n" 3 5
ns 4 "a\n a\n"
ns 5 "a\n a\n"

# 193 bytes of S dropped, with a trailing \b
pattern (?<=\w)\W*x\b
features all
ms 0 "a x" 1 3
ms 1 "a x" 1 3
ns 2 "a x"
ns 3 "a x"
ms 0 "a--x" 1 4
ms 1 "a--x" 1 4
ns 2 "a--x"
ns 3 "a--x"
ns 4 "a--x"
