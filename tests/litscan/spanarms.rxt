m "xyabzw" 0 6
n "xyabab"
m "qxyabzwq" 1 7

# E-4 two negative lookarounds in a row: the run is `abce`
pattern ab(?!cd)(?<!xy)ce
features all
m "abce" 0 4
n "abcd"
m "zabcez" 1 5

# E-4 two negative lookarounds in a row: the run is `abce` [engine vm]
pattern ab(?!cd)(?<!xy)ce
features all
engine vm
m "abce" 0 4
n "abcd"
m "zabcez" 1 5

# E-1 (span_arms E2, taken from alt_normal_form stage 2a): an empty group is the unit, so the run is `abcdefgh` across it
pattern abcd()efgh
features all
m "abcdefgh" 0 8
g 1 4 4
m "xxabcdefghxx" 2 10
g 1 6 6
n "abcdxefgh"

# E-1 (span_arms E2, taken from alt_normal_form stage 2a): an empty group is the unit, so the run is `abcdefgh` across it [engine vm]
pattern abcd()efgh
features all
engine vm
m "abcdefgh" 0 8
g 1 4 4
m "xxabcdefghxx" 2 10
g 1 6 6
n "abcdxefgh"

# E-1: an alternation of two empty branches is the unit's alternation; the run joins across it
pattern abcd(?:|)efgh
features all
m "abcdefgh" 0 8
n "abcd efgh"
m "zabcdefgh" 1 9

# E-1: an alternation of two empty branches is the unit's alternation; the run joins across it [engine vm]
pattern abcd(?:|)efgh
features all
engine vm
m "abcdefgh" 0 8
n "abcd efgh"
m "zabcdefgh" 1 9

# E-1 beside a consuming branch: the alternation keeps only the common head and tail, so the run stays `cd` (or `ab`)
pattern ab(?:|x)cd
features all
m "abcd" 0 4
m "abxcd" 0 5
n "abycd"

# E-1 beside a consuming branch: the alternation keeps only the common head and tail, so the run stays `cd` (or `ab`) [engine vm]
pattern ab(?:|x)cd
features all
engine vm
m "abcd" 0 4
m "abxcd" 0 5
n "abycd"
