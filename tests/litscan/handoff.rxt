ns 5 "zcat zzcat"
ns 6 "zcat zzcat"
ns 7 "zcat zzcat"
ns 8 "zcat zzcat"
ns 9 "zcat zzcat"
ns 10 "zcat zzcat"
ms 0 "cat" 0 3
ns 1 "cat"
ns 2 "cat"
ns 3 "cat"

