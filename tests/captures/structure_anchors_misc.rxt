# Territory E (anchors + startpos interaction), Territory F (nesting depth /
# sibling order), Territory G (same subject, structurally different
# patterns -> different slot values), and Territory H (misc C1-C11 items:
# C9 non-capturing numbering, C2 slot vs number, bounded classes, caseless).

# case: anchor-01
pattern (a+)$
# end-anchored group reports the trailing run
m "xaaa" 1 4
gp 1 1 4

# case: anchor-02-startpos
pattern (\d+)
features classes
# startpos mid-subject, group tracks the match found from there
ms 3 "12 34" 3 5
gp 1 3 5

# case: anchor-03-startpos-boundary
pattern (a)(b)
# startpos lands exactly on the whole match's start
ms 1 "xaby" 1 3
gp 1 1 2
gp 2 2 3

# case: anchor-04-startpos-explicit-zero
pattern ^(a)
# explicit startpos=0 control case for ^
ms 0 "aaa" 0 1
gp 1 0 1

# case: anchor-05-startpos-skips-earlier
pattern (ab)
# startpos skips the first candidate match entirely
ms 2 "ababab" 2 4
gp 1 2 4

# case: anchor-06-startpos-two-groups
pattern (a+)(b+)
# startpos mid-run, both groups computed relative to the search start
ms 1 "aaabbb" 1 6
gp 1 1 3
gp 2 3 6

# case: nest-01
pattern ((a)(b))c
# two siblings inside one wrapper, from docs/testing.md's own example pattern
m "abc" 0 3
gp 1 0 2
gp 2 0 1
gp 3 1 2

# case: nest-02-depth3
pattern (((a)))
# three levels of nesting collapse to the same span
m "a" 0 1
gp 1 0 1
gp 2 0 1
gp 3 0 1

# case: nest-03-siblings4
pattern ((a)(b)(c))
# three siblings under one wrapper
m "abc" 0 3
gp 1 0 3
gp 2 0 1
gp 3 1 2
gp 4 2 3

# case: nest-04-siblings-varlen
pattern (a)(bb)(ccc)
# siblings of increasing length, no wrapper
m "abbccc" 0 6
gp 1 0 1
gp 2 1 3
gp 3 3 6

# case: nest-05-nested-quantified
pattern ((a)(b))+
# nesting combined with repetition: outer AND inner both report only the last iteration
m "abab" 0 4
gp 1 2 4
gp 2 2 3
gp 3 3 4

# case: nest-06-mixed-alt
pattern (a(b|c)(d|e))
# nested alternation at two different depths
m "ace" 0 3
gp 1 0 3
gp 2 1 2
gp 3 2 3

# case: nest-07-deep-mixed
pattern (a(b(c)d)e)
# three levels, sibling text on both sides at each level
m "abcde" 0 5
gp 1 0 5
gp 2 1 4
gp 3 2 3

# case: struct-01a
pattern (a)(a)(a)
# three singleton groups
m "aaa" 0 3
gp 1 0 1
gp 2 1 2
gp 3 2 3

# case: struct-01b
pattern (a)(aa)
# same subject, 1+2 split
m "aaa" 0 3
gp 1 0 1
gp 2 1 3

# case: struct-01c
pattern (aa)(a)
# same subject, 2+1 split
m "aaa" 0 3
gp 1 0 2
gp 2 2 3

# case: struct-01d
pattern (aaa)
# same subject, single group
m "aaa" 0 3
gp 1 0 3

# case: struct-01e
pattern ((a)(a))(a)
# same subject, nested 1+1 then sibling 1
m "aaa" 0 3
gp 1 0 2
gp 2 0 1
gp 3 1 2
gp 4 2 3

# case: struct-02a
pattern (abc)+
# same subject via a repeated group
m "abcabc" 0 6
gp 1 3 6

# case: struct-02b
pattern (abc)(abc)
# same subject via two sibling groups
m "abcabc" 0 6
gp 1 0 3
gp 2 3 6

# case: c9-noncapturing
pattern (?:x)(a)(?:y)(b)
# non-capturing groups contribute no slot and no number (C9); slots stay contiguous
m "xayb" 0 4
gp 1 1 2
gp 2 3 4

# case: c2-o1-slot
pattern (a)(?:b)(c)
# a non-capturing group between two capturing ones: slot 2 is still group 'c', not 'b'
m "abc" 0 3
gp 1 0 1
gp 2 2 3

# case: classes-bounded
pattern (\d{2,4})-(\d{2,4})
features classes
# bounded {n,m} combined with a character class escape
m "1234-56" 0 7
gp 1 0 4
gp 2 5 7

# case: caseless-01
pattern (ABC)
flags i
# case-insensitive capture of a lowercase run against an uppercase pattern
m "xxabcXX" 2 5
gp 1 2 5

# case: caseless-02-alt
pattern (a|B)+
flags i
# case-insensitive alternation under a quantifier
m "AbAb" 0 4
gp 1 3 4

# case: whole-match-c3
pattern ((a)(b))c
# explicit slot-0 check alongside the nested groups above
m "abc" 0 3
gp 1 0 2
gp 2 0 1
gp 3 1 2
