# K53 — \p{C}, \p{Cn} and \p{L} (both polarities) exceed the emitted-source
# cap under `-e utf8`, so a correct pattern REFUSES.
#
# These twelve blocks are the D27-blinded [M5.0] axis-4 corpus's own, moved
# here at stage 3's promotion rather than deleted or downgraded to `perr`:
# every expectation below is the oracle's, carried verbatim in each block's
# comment header since the corpus was written, and pcrec's ANSWERS on the
# patterns that do compile agree with all of them (462/506 cases green in the
# same run). What fails is not a match, it is the compile — D84's
# `max_emit_bytes` (1,000,000) against an artifact of 1,003,035 to 1,076,640
# bytes.
#
# EXCLUDED FROM `make test` BY THIS DIRECTORY'S OWN RULE, and RUN by the
# ratchet, which fails if one starts passing — which is exactly the signal
# wanted here, because docs/dev/known_issues.md K53 names a specific,
# measured, in-scope cure and this file is what tells us the day it lands.
#
# THE MEASUREMENT THE CURE RESTS ON, repeated here so a reader of this file
# does not have to go and find it: with the OPTIONAL anchored machine
# dropped (`-fno-anchored-dfa`), `\p{L}` under `-e utf8` emits 772,412 bytes
# and compiles. `docs/design/anchored_match_unwrapped.md` §2/§5.2 states that
# machine is "built OPTIONAL (an overflow is a selection outcome, never a
# diagnostic)" — and that promise is kept for the SUBSET-ELEMS budget and
# broken for the emit-BYTES one, because the size cap is applied to the whole
# artifact after all three machines are emitted. An optional machine is
# refusing patterns that compile without it.
#
# Every block is `# pcre2-only`: python `re` has no `\p` at all.

# axis4 block C-\p{C}-A | pattern: \p{C}
#   [ctrl01-Cc-1B U+0001] m "\x01" 0 1   # oracle=PCRE2_UTF
#   [softhyphen-Cf-2B U+00AD] m "\xc2\xad" 0 2   # oracle=PCRE2_UTF
#   [A-Lu-1B U+0041] n "A"   # oracle=PCRE2_UTF
#   [a-Ll-1B U+0061] n "a"   # oracle=PCRE2_UTF
# pcre2-only
pattern \p{C}
encoding utf8
features unicode-props
m "\x01" 0 1
m "\xc2\xad" 0 2
n "A"
n "a"

# axis4 block C-\p{C}-B | pattern: \p{C}
#   [5-Nd-1B U+0035] n "5"   # oracle=PCRE2_UTF
#   [bang-Po-1B U+0021] n "!"   # oracle=PCRE2_UTF
#   [c1ctrl-Cc-2B U+0080] m "\xc2\x80" 0 2   # oracle=PCRE2_UTF
#   [privateuse-Co-3B U+E000] m "\xee\x80\x80" 0 3   # oracle=PCRE2_UTF
# pcre2-only
pattern \p{C}
encoding utf8
features unicode-props
n "5"
n "!"
m "\xc2\x80" 0 2
m "\xee\x80\x80" 0 3

# axis4 block C-\P{C}-A | pattern: \P{C}
#   [ctrl01-Cc-1B U+0001] n "\x01"   # oracle=PCRE2_UTF
#   [softhyphen-Cf-2B U+00AD] n "\xc2\xad"   # oracle=PCRE2_UTF
#   [A-Lu-1B U+0041] m "A" 0 1   # oracle=PCRE2_UTF
#   [a-Ll-1B U+0061] m "a" 0 1   # oracle=PCRE2_UTF
# pcre2-only
pattern \P{C}
encoding utf8
features unicode-props
n "\x01"
n "\xc2\xad"
m "A" 0 1
m "a" 0 1

# axis4 block C-\P{C}-B | pattern: \P{C}
#   [5-Nd-1B U+0035] m "5" 0 1   # oracle=PCRE2_UTF
#   [bang-Po-1B U+0021] m "!" 0 1   # oracle=PCRE2_UTF
#   [c1ctrl-Cc-2B U+0080] n "\xc2\x80"   # oracle=PCRE2_UTF
#   [privateuse-Co-3B U+E000] n "\xee\x80\x80"   # oracle=PCRE2_UTF
# pcre2-only
pattern \P{C}
encoding utf8
features unicode-props
m "5" 0 1
m "!" 0 1
n "\xc2\x80"
n "\xee\x80\x80"

# axis4 block L-\p{L}-A | pattern: \p{L}
#   [A-Lu-1B U+0041] m "A" 0 1   # oracle=PCRE2_UTF
#   [a-Ll-1B U+0061] m "a" 0 1   # oracle=PCRE2_UTF
#   [5-Nd-1B U+0035] n "5"   # oracle=PCRE2_UTF
#   [bang-Po-1B U+0021] n "!"   # oracle=PCRE2_UTF
# pcre2-only
pattern \p{L}
encoding utf8
features unicode-props
m "A" 0 1
m "a" 0 1
n "5"
n "!"

# axis4 block L-\p{L}-B | pattern: \p{L}
#   [space-Zs-1B U+0020] n " "   # oracle=PCRE2_UTF
#   [underscore-Pc-1B U+005F] n "_"   # oracle=PCRE2_UTF
#   [alpha-Ll-2B U+03B1] m "\xce\xb1" 0 2   # oracle=PCRE2_UTF
#   [Alpha-Lu-2B U+0391] m "\xce\x91" 0 2   # oracle=PCRE2_UTF
# pcre2-only
pattern \p{L}
encoding utf8
features unicode-props
n " "
n "_"
m "\xce\xb1" 0 2
m "\xce\x91" 0 2

# axis4 block L-\P{L}-A | pattern: \P{L}
#   [A-Lu-1B U+0041] n "A"   # oracle=PCRE2_UTF
#   [a-Ll-1B U+0061] n "a"   # oracle=PCRE2_UTF
#   [5-Nd-1B U+0035] m "5" 0 1   # oracle=PCRE2_UTF
#   [bang-Po-1B U+0021] m "!" 0 1   # oracle=PCRE2_UTF
# pcre2-only
pattern \P{L}
encoding utf8
features unicode-props
n "A"
n "a"
m "5" 0 1
m "!" 0 1

# axis4 block L-\P{L}-B | pattern: \P{L}
#   [space-Zs-1B U+0020] m " " 0 1   # oracle=PCRE2_UTF
#   [underscore-Pc-1B U+005F] m "_" 0 1   # oracle=PCRE2_UTF
#   [alpha-Ll-2B U+03B1] n "\xce\xb1"   # oracle=PCRE2_UTF
#   [Alpha-Lu-2B U+0391] n "\xce\x91"   # oracle=PCRE2_UTF
# pcre2-only
pattern \P{L}
encoding utf8
features unicode-props
m " " 0 1
m "_" 0 1
n "\xce\xb1"
n "\xce\x91"

# axis4 block Cn-\p{Cn}-A | pattern: \p{Cn}
#   [unassigned-Cn-? U+0378] m "\xcd\xb8" 0 2   # oracle=PCRE2_UTF
#   [A-Lu-1B U+0041] n "A"   # oracle=PCRE2_UTF
#   [a-Ll-1B U+0061] n "a"   # oracle=PCRE2_UTF
# pcre2-only
pattern \p{Cn}
encoding utf8
features unicode-props
m "\xcd\xb8" 0 2
n "A"
n "a"

# axis4 block Cn-\p{Cn}-B | pattern: \p{Cn}
#   [5-Nd-1B U+0035] n "5"   # oracle=PCRE2_UTF
#   [bang-Po-1B U+0021] n "!"   # oracle=PCRE2_UTF
#   [unassigned-Cn-? U+0378] m "\xcd\xb8" 0 2   # oracle=PCRE2_UTF
# pcre2-only
pattern \p{Cn}
encoding utf8
features unicode-props
n "5"
n "!"
m "\xcd\xb8" 0 2

# axis4 block Cn-\P{Cn}-A | pattern: \P{Cn}
#   [unassigned-Cn-? U+0378] n "\xcd\xb8"   # oracle=PCRE2_UTF
#   [A-Lu-1B U+0041] m "A" 0 1   # oracle=PCRE2_UTF
#   [a-Ll-1B U+0061] m "a" 0 1   # oracle=PCRE2_UTF
# pcre2-only
pattern \P{Cn}
encoding utf8
features unicode-props
n "\xcd\xb8"
m "A" 0 1
m "a" 0 1

# axis4 block Cn-\P{Cn}-B | pattern: \P{Cn}
#   [5-Nd-1B U+0035] m "5" 0 1   # oracle=PCRE2_UTF
#   [bang-Po-1B U+0021] m "!" 0 1   # oracle=PCRE2_UTF
#   [unassigned-Cn-? U+0378] n "\xcd\xb8"   # oracle=PCRE2_UTF
# pcre2-only
pattern \P{Cn}
encoding utf8
features unicode-props
m "5" 0 1
m "!" 0 1
n "\xcd\xb8"


