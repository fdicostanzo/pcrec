# K1 (docs/known_issues.md): zero-width $ must beat a consuming alternative in
# a repeated group. Asserts CORRECT PCRE2 behavior — CURRENTLY FAILS (pcrec
# returns the longer [0,4)/[0,N) span instead). Not run by `make test`.

pattern (?:$|[^abc]){2,}
m "XY$\n" 0 3

pattern X(?:$|[^abc])+
m "XY$\n" 0 3

# the exact fuzzer-minimized origin (search finds the match at offset 10)
pattern c{1,}?(?:$|[\n\t]+?01{1,2}|[^abc]){2,}
m "\n?{(\xc8a0b,,ccccX1$\n" 10 17
