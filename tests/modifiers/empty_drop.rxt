# tests/modifiers/empty_drop.rxt -- [FLAG-SPELL] (lane flagfix): a
# concatenation drops an empty node that carries nothing (src/parse/parse.c
# p_cat), so a bare option run `(?i)abc` and the scoped `(?i:abc)` build one
# tree. The drop runs after a quantifier has bound to its operand, so it can
# never change what a quantifier applies to. These cells are the ruling's
# (flagfix_rulings.md R1) pins of that boundary:
#   - `(?i)abc+` repeats the `c`, `(?i:abc)+` repeats the group: different
#     matchers, never paired by the spelling identity check;
#   - a QUANTIFIED empty group (`a(?:)+b`, `a(?:)*b`, `a(?:){3}b`) is a
#     quantifier node, not an empty one, and is left alone;
#   - a quantifier right after a bare run is still libpcre2's err 109;
#   - a branch that is empty after the drop stays an empty branch.
#
# EVERY EXPECTATION WAS PRODUCED BY libpcre2 10.46 (tests/lib/p2gen.py over
# p2probe).

# The bare run: the `+` binds to `c` alone.
pattern (?i)abc+
features modifiers
m "abcc" 0 4
m "abcabc" 0 3
m "ABCC" 0 4
n "ab"

# The scoped run: the `+` binds to the group.
pattern (?i:abc)+
features modifiers
m "abcc" 0 3
m "abcabc" 0 6
m "ABCaBc" 0 6
n "ab"

# A quantified empty group stays a quantifier node: `+`.
pattern a(?:)+b
features modifiers
m "ab" 0 2
n "b"
m "aab" 1 3
n "a"

# ... `*`.
pattern a(?:)*b
features modifiers
m "ab" 0 2
n "b"
m "xaby" 1 3

# ... `{3}`.
pattern a(?:){3}b
features modifiers
m "ab" 0 2
n "aXb"

# An unquantified empty group between two atoms.
pattern a(?:)b
features modifiers
m "ab" 0 2
n "a b"
m "xab" 1 3

# The bare run mid-pattern.
pattern a(?i)bc
features modifiers
m "aBC" 0 3
n "ABC"
m "abc" 0 3

# The run at the END of the pattern.
pattern abc(?i)
features modifiers
m "abc" 0 3
n "ABC"
m "xabcx" 1 4

# The run as the whole pattern: one empty match.
pattern (?i)
features modifiers
m "" 0 0
m "x" 0 0

# Two runs and nothing else.
pattern (?i)(?s)
features modifiers
m "" 0 0
m "x" 0 0

# The run inside a capturing group ends at its `)`: `b` stays case-sensitive.
pattern (a(?i))b
features modifiers
m "ab" 0 2
g 1 0 1
n "aB"
n "Ab"

# An alternation branch that is only a run stays an EMPTY branch (it matches first, at 0).
pattern (?i)|x
features modifiers
m "x" 0 0
m "" 0 0
m "yx" 0 0

# ... and as the second branch, where it leaks into nothing after it.
pattern x|(?i)
features modifiers
m "x" 0 1
m "X" 0 0
m "y" 0 0

# ... and inside a capturing group.
pattern (x|(?i))y
features modifiers
m "xy" 0 2
g 1 0 1
m "y" 0 1
g 1 0 0
n "XY"
n "Y"

# A quantifier on the bare run mid-pattern is err 109 (`+`) ...
pattern a(?i)+b
features modifiers
perr

# ... (`*`) ...
pattern a(?i)*b
features modifiers
perr

# ... and at pattern start.
pattern (?i)+
features modifiers
perr

