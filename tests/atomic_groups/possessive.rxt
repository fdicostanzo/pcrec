# tests/atomic_groups/possessive.rxt -- module `atomic-groups` ([M6.4.2]): the
# POSSESSIVE QUANTIFIER SUFFIXES `*+ ++ ?+ {n,m}+`, including `{n}+`, `{n,}+`
# and `{,n}+`.
#
# THEY ARE THE SAME CONSTRUCT AS `(?>...)`, not a relative of it: PCRE2 defines
# `X*+` as `(?>X*)`, and src/parse/parse.c desugars the suffix to
# `A_ATOMIC(A_REP(X))` at the quantifier site. Section 6 is that equivalence as
# CELLS -- each spelling beside its group twin, same subjects, same answers.
#
# THE BRACE FORMS ARE WHERE python DIVERGES AND `*+`/`++` DO NOT, which is what
# makes it a family rather than a one-off and what makes the `*+`/`++` controls
# in section 8 load-bearing. Over a body whose iteration can end in TWO PLACES,
# python `re` cuts PER ITERATION and PCRE2 cuts at the GROUP EXIT:
# `(?:a|ab){2}+` on "aba" is (0,3) in PCRE2 and NO MATCH in python, while
# `(?:a|ab)*+` on "aba" is (0,1) in BOTH. The divergence runs in the dangerous
# direction -- python reports no match where PCRE2 matches -- so a cell written
# from python would encode a miscompile as the expectation. D26 makes PCRE2 the
# source of truth; those blocks are `# pcre2-only` and say so.
#
# SECTION 9 IS U9 (docs/dev/upstream_issues.md): on libpcre2 10.46 a possessive
# or atomic BOUNDED repeat `{m,n}+` of a GROUP, preceded by an item that
# consumed and can give back, refuses to backtrack into that preceding item.
# python and a hand derivation both disagree. All three conjuncts are necessary
# and the three controls beside it are each missing one, so the block is a
# characterisation rather than a single odd cell.
#
# SECTION 7 IS THE NULLABLE CARVE-OUT in its suffix spelling -- `(?:a*)*+b` and
# `(?>(?:a*)*)b` are the same tree, and both must take the general lowering.
#
# EVERY EXPECTATION IN THIS FILE WAS PRODUCED BY libpcre2 10.46, not written by
# hand: a generator drove every (pattern, subject, startpos) cell through the
# ctypes binding at docs/design/eng_brep_measurements/probes/pcre2_ctypes.py and
# emitted the answer. python3 `re` was driven over the SAME cells in the same
# pass, and a block carries `# pcre2-only` exactly where python disagreed or
# could not compile the pattern -- detected, never assumed. 13 of 729 cells
# diverge across this directory, and they are the four families Appendix B.3 of
# the design names: `\K`/`\G` (python cannot express them at all), the BRACE
# possessive over a two-exit body (python cuts PER ITERATION, PCRE2 at the GROUP
# EXIT), U9 (libpcre2's own recorded oddity), and scoped `(?i)` inside a group
# (python rejects the pattern).
#
# `ms`/`ns` CELLS SWEEP EVERY STARTPOS IN [0, n], not a chosen few. The cut
# makes "the leftmost candidate is not the leftmost match" an ORDINARY
# occurrence rather than an edge case -- `(?>a|ab)c` on "abc" is NO MATCH while
# its uncut twin matches (0,3) -- so which start the search reaches, and what it
# answers there, is the axis this construct moves.

# ====================================================================
# `*+`
# ====================================================================

pattern a*+b
features atomic-groups
m "aaab" 0 4
ms 1 "aaab" 1 4
ms 2 "aaab" 2 4
ms 3 "aaab" 3 4
ns 4 "aaab"
m "b" 0 1
ns 1 "b"
n "aaa"
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"

pattern a*+a
features atomic-groups
n "aaa"
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"

pattern [^"]*+"
features atomic-groups
m "ab\"cd\"" 0 3
ms 1 "ab\"cd\"" 1 3
ms 2 "ab\"cd\"" 2 3
ms 3 "ab\"cd\"" 3 6
ms 4 "ab\"cd\"" 4 6
ms 5 "ab\"cd\"" 5 6
ns 6 "ab\"cd\""
m "\"" 0 1
ns 1 "\""
n "abc"
ns 1 "abc"
ns 2 "abc"
ns 3 "abc"

# ====================================================================
# `++`
# ====================================================================

pattern a++c
features atomic-groups
m "aaac" 0 4
ms 1 "aaac" 1 4
ms 2 "aaac" 2 4
ns 3 "aaac"
ns 4 "aaac"
m "ac" 0 2
ns 1 "ac"
ns 2 "ac"
n "aaa"
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"

pattern a++a
features atomic-groups
n "aaa"
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"

# ====================================================================
# `?+`
# ====================================================================

pattern a?+b
features atomic-groups
m "ab" 0 2
ms 1 "ab" 1 2
ns 2 "ab"
m "b" 0 1
ns 1 "b"
m "aab" 1 3
ms 1 "aab" 1 3
ms 2 "aab" 2 3
ns 3 "aab"

pattern a?+a
features atomic-groups
m "aa" 0 2
ns 1 "aa"
ns 2 "aa"
n "a"
ns 1 "a"

# ====================================================================
# THE BRACE FORMS: {n}+ {n,}+ {n,m}+ and {,n}+
# ====================================================================

pattern a{2}+a
features atomic-groups
m "aaa" 0 3
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"
n "aa"
ns 1 "aa"
ns 2 "aa"

pattern a{2,}+a
features atomic-groups
n "aaaa"
ns 1 "aaaa"
ns 2 "aaaa"
ns 3 "aaaa"
ns 4 "aaaa"
n "aaa"
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"

pattern a{,2}+b
features atomic-groups
m "aab" 0 3
ms 1 "aab" 1 3
ms 2 "aab" 2 3
ns 3 "aab"
m "b" 0 1
ns 1 "b"
m "aaab" 1 4
ms 1 "aaab" 1 4
ms 2 "aaab" 2 4
ms 3 "aaab" 3 4
ns 4 "aaab"

pattern a{1,2}+a
features atomic-groups
m "aaa" 0 3
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"
n "aa"
ns 1 "aa"
ns 2 "aa"

pattern a{2,3}+b
features atomic-groups
m "aaab" 0 4
ms 1 "aaab" 1 4
ns 2 "aaab"
ns 3 "aaab"
ns 4 "aaab"
m "aab" 0 3
ns 1 "aab"
ns 2 "aab"
ns 3 "aab"

# ====================================================================
# OVER A TWO-EXIT BODY, where the cut is what decides
# ====================================================================

pattern (?:a|ab)*+c
features atomic-groups
m "abc" 2 3
ms 1 "abc" 2 3
ms 2 "abc" 2 3
ns 3 "abc"
m "aac" 0 3
ms 1 "aac" 1 3
ms 2 "aac" 2 3
ns 3 "aac"
m "c" 0 1
ns 1 "c"

pattern (?:a|ab)++c
features atomic-groups
m "abac" 2 4
ms 1 "abac" 2 4
ms 2 "abac" 2 4
ns 3 "abac"
ns 4 "abac"
m "ac" 0 2
ns 1 "ac"
ns 2 "ac"

pattern (?:a|ab)?+c
features atomic-groups
m "abc" 2 3
ms 1 "abc" 2 3
ms 2 "abc" 2 3
ns 3 "abc"
m "ac" 0 2
ms 1 "ac" 1 2
ns 2 "ac"
m "c" 0 1
ns 1 "c"

# ====================================================================
# THE EQUIVALENCE, cell for cell: `X q+` beside `(?>X q)`
# ====================================================================

pattern (?>a*)b
features atomic-groups
m "aaab" 0 4
ms 1 "aaab" 1 4
ms 2 "aaab" 2 4
ms 3 "aaab" 3 4
ns 4 "aaab"
m "b" 0 1
ns 1 "b"

pattern (?>a+)c
features atomic-groups
m "aac" 0 3
ms 1 "aac" 1 3
ns 2 "aac"
ns 3 "aac"
n "c"
ns 1 "c"

pattern (?>a?)b
features atomic-groups
m "ab" 0 2
ms 1 "ab" 1 2
ns 2 "ab"
m "b" 0 1
ns 1 "b"

pattern (?>a{1,2})a
features atomic-groups
m "aaa" 0 3
ns 1 "aaa"
ns 2 "aaa"
ns 3 "aaa"
n "aa"
ns 1 "aa"
ns 2 "aa"

# ====================================================================
# NULLABLE BODIES in their SUFFIX spelling -- carve-out one, same tree
# ====================================================================

pattern (?:a*)*+b
features atomic-groups
m "aaab" 0 4
ms 1 "aaab" 1 4
ms 2 "aaab" 2 4
ms 3 "aaab" 3 4
ns 4 "aaab"
m "b" 0 1
ns 1 "b"

pattern (?:a?)*+b
features atomic-groups
m "aab" 0 3
ms 1 "aab" 1 3
ms 2 "aab" 2 3
ns 3 "aab"
m "b" 0 1
ns 1 "b"

pattern (?:|a)*+b
features atomic-groups
m "b" 0 1
ns 1 "b"
m "ab" 1 2
ms 1 "ab" 1 2
ns 2 "ab"

pattern (?:a*)++b
features atomic-groups
m "aab" 0 3
ms 1 "aab" 1 3
ms 2 "aab" 2 3
ns 3 "aab"
m "b" 0 1
ns 1 "b"

# ====================================================================
# THE python DIVERGENCE FAMILY, with its `*+`/`++` controls
# ====================================================================

# python DIVERGES here, measured rather than assumed: "aba" @0 pcre2=('m', 0, 3) python=('n',) (2 of 9 cells)
# pcre2-only
pattern (?:a|ab){2}+
features atomic-groups
m "aba" 0 3
ns 1 "aba"
ns 2 "aba"
ns 3 "aba"
m "abab" 0 3
ns 1 "abab"
ns 2 "abab"
ns 3 "abab"
ns 4 "abab"

# python DIVERGES here, measured rather than assumed: "ababa" @0 pcre2=('m', 0, 3) python=('n',) (3 of 6 cells)
# pcre2-only
pattern (?:a|ab){2,3}+
features atomic-groups
m "ababa" 0 3
ms 1 "ababa" 2 5
ms 2 "ababa" 2 5
ns 3 "ababa"
ns 4 "ababa"
ns 5 "ababa"

# python DIVERGES here, measured rather than assumed: "ababa" @0 pcre2=('m', 0, 3) python=('n',) (3 of 6 cells)
# pcre2-only
pattern (?:a|ab){2,}+
features atomic-groups
m "ababa" 0 3
ms 1 "ababa" 2 5
ms 2 "ababa" 2 5
ns 3 "ababa"
ns 4 "ababa"
ns 5 "ababa"

# python DIVERGES here, measured rather than assumed: "abac" @0 pcre2=('m', 0, 4) python=('n',) (1 of 5 cells)
# pcre2-only
pattern (?:a|ab){2}+c
features atomic-groups
m "abac" 0 4
ns 1 "abac"
ns 2 "abac"
ns 3 "abac"
ns 4 "abac"

# python DIVERGES here, measured rather than assumed: "ababa" @0 pcre2=('m', 0, 5) python=('n',) (1 of 6 cells)
# pcre2-only
pattern (?:a|ab){3}+
features atomic-groups
m "ababa" 0 5
ns 1 "ababa"
ns 2 "ababa"
ns 3 "ababa"
ns 4 "ababa"
ns 5 "ababa"

pattern (?:a|ab)*+
features atomic-groups
m "aba" 0 1
ms 1 "aba" 1 1
ms 2 "aba" 2 3
ms 3 "aba" 3 3

pattern (?:a|ab)++c
features atomic-groups
m "abac" 2 4
ms 1 "abac" 2 4
ms 2 "abac" 2 4
ns 3 "abac"
ns 4 "abac"

# ====================================================================
# U9, with the three controls that each drop one of its conjuncts
# ====================================================================

pattern a?b{0,4}+a
features atomic-groups
m "a" 0 1
ns 1 "a"

pattern a?(?:b)*+a
features atomic-groups
m "a" 0 1
ns 1 "a"

pattern x?(?:b){0,4}+a
features atomic-groups
m "a" 0 1
ns 1 "a"
