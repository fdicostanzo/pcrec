# tests/atomic_groups/possessive_ungreedy.rxt -- K122 (lane langfix2): a
# POSSESSIVE quantifier is GREEDY whatever `(?U)` says. `(?U)` inverts the
# default greed of a plain quantifier and a trailing `?` inverts it back
# (tests/modifiers/), but `X q+` is `(?>X q)` with q GREEDY: libpcre2 10.46
# answers `(?U)a*+` on "aaa" (0,3). pcrec answered (0,0) on both engines
# before the fix (the desugar kept the ungreedy default), so every block
# here is written twice, the default engine and `engine vm`.
#
# EVERY EXPECTATION WAS PRODUCED BY libpcre2 10.46 (tests/lib/p2gen.py over
# p2probe, the adversary's own oracle driver), never by hand. python3 `re`
# has no `(?U)`, so every block is `# pcre2-only`.

# THE ADVERSARY'S CELL: `*+` under `(?U)` takes every `a`.
# pcre2-only
pattern (?U)a*+
features atomic-groups,classes,modifiers
m "aaa" 0 3
m "b" 0 0
m "aab" 0 2

# the same block under engine vm
# pcre2-only
pattern (?U)a*+
features atomic-groups,classes,modifiers
engine vm
m "aaa" 0 3
m "b" 0 0
m "aab" 0 2

# `++` under `(?U)`.
# pcre2-only
pattern (?U)a++
features atomic-groups,classes,modifiers
m "aaa" 0 3
n "b"

# the same block under engine vm
# pcre2-only
pattern (?U)a++
features atomic-groups,classes,modifiers
engine vm
m "aaa" 0 3
n "b"

# `?+` under `(?U)`.
# pcre2-only
pattern (?U)a?+
features atomic-groups,classes,modifiers
m "a" 0 1
m "b" 0 0

# the same block under engine vm
# pcre2-only
pattern (?U)a?+
features atomic-groups,classes,modifiers
engine vm
m "a" 0 1
m "b" 0 0

# `{n,m}+` under `(?U)`: three, not the minimum two.
# pcre2-only
pattern (?U)a{2,3}+
features atomic-groups,classes,modifiers
m "aaa" 0 3
m "aa" 0 2
n "a"

# the same block under engine vm
# pcre2-only
pattern (?U)a{2,3}+
features atomic-groups,classes,modifiers
engine vm
m "aaa" 0 3
m "aa" 0 2
n "a"

# `{n,}+` under `(?U)`.
# pcre2-only
pattern (?U)a{2,}+
features atomic-groups,classes,modifiers
m "aaaa" 0 4
n "a"

# the same block under engine vm
# pcre2-only
pattern (?U)a{2,}+
features atomic-groups,classes,modifiers
engine vm
m "aaaa" 0 4
n "a"

# `{,m}+` under `(?U)` (K117 spelling), after a set-then-scope.
# pcre2-only
pattern a(?U)\s{,2}+
features atomic-groups,classes,modifiers
m "a\x0ab" 0 2
m "a\x0a\x0a\x0ab" 0 3

# the same block under engine vm
# pcre2-only
pattern a(?U)\s{,2}+
features atomic-groups,classes,modifiers
engine vm
m "a\x0ab" 0 2
m "a\x0a\x0a\x0ab" 0 3

# The cut is still a cut: `(?U)a*+a` never matches.
# pcre2-only
pattern (?U)a*+a
features atomic-groups,classes,modifiers
n "aaa"

# the same block under engine vm
# pcre2-only
pattern (?U)a*+a
features atomic-groups,classes,modifiers
engine vm
n "aaa"

# A group body and its capture: the last iteration is the second byte.
# pcre2-only
pattern (?U)(a|b)*+
features atomic-groups,classes,modifiers
m "ab" 0 2
g 1 1 2
m "abba" 0 4
g 1 3 4

# the same block under engine vm
# pcre2-only
pattern (?U)(a|b)*+
features atomic-groups,classes,modifiers
engine vm
m "ab" 0 2
g 1 1 2
m "abba" 0 4
g 1 3 4

# Inside a scoped `(?U:...)` and its unscoped twin.
# pcre2-only
pattern (?U:\s*+)b
features atomic-groups,classes,modifiers
m "a\x0ab" 1 3

# the same block under engine vm
# pcre2-only
pattern (?U:\s*+)b
features atomic-groups,classes,modifiers
engine vm
m "a\x0ab" 1 3

# CONTROL: the lazy `?` still inverts under `(?U)` (greedy), beside a possessive.
# pcre2-only
pattern (?U)a+?b??
features atomic-groups,classes,modifiers
m "aab" 0 3
m "aa" 0 2

# the same block under engine vm
# pcre2-only
pattern (?U)a+?b??
features atomic-groups,classes,modifiers
engine vm
m "aab" 0 3
m "aa" 0 2

# CONTROL: a plain quantifier under `(?U)` stays lazy.
# pcre2-only
pattern (?U)a+
features atomic-groups,classes,modifiers
m "aaa" 0 1

# the same block under engine vm
# pcre2-only
pattern (?U)a+
features atomic-groups,classes,modifiers
engine vm
m "aaa" 0 1

