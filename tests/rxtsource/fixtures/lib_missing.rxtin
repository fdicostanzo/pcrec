# [DD-13b.W1.2] A `lib` PATH THAT RESOLVES TO NOTHING. §1.3's refusal
# table, tier 3: name the path AND the list searched. The reference is
# recorded at parse time and RESOLVED at `--source` time, so
# `--list-source` still dumps this file happily — the two surfaces answer
# different questions and only one of them touches the filesystem.
lib "extra_defs.rxt"
target t = a_run

pattern a+
name a_run
m "aaa" 0 3
