# A HEAD-BEARING .rxt FILE. Every declaration W1 accepts, plus the three
# new block directives, plus `features only`.
#
# It exists because the corpus has NO head-bearing file — measured, 0 of
# 179 — so without it the seam (`--list-source`, the body-start skip, the
# head grammar) would ship with a population of zero and every check
# named as its detector would be green while detecting nothing. That is
# [MECH-REACH]'s failure exactly, and it is cheaper to notice here than
# two milestones later.
description this file exercises W1's head grammar end to end
lib "definitions/common.rxt"
config dev
  pcrec --warn-emit-bytes=100000
  flags i
  features classes
  budget steps=1000000
config release from dev
  engine vm
  encoding byte
target rx = greeting with dev, release

pattern a+
name plain_run
description a bare greedy run, the simplest thing with a head above it
m "aaa" 0 3
n "b"

pattern colou?r
name colour
encoding byte
features only classes
m "colour" 0 6
m "color" 0 5
n "colr"
