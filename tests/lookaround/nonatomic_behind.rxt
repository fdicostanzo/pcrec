# tests/lookaround/nonatomic_behind.rxt -- module `lookaround` ([M6.6.2]): `(?<*`, carrying §3.6's measured witness `(?<*(a)|(ba))c\2` by name
#
# GENERATED BY tests/lookaround/gen_corpus.py, and that is a property rather
# than a convenience. Every expectation below was produced by driving the cell
# through libpcre2 10.46 (the committed ctypes binding at
# docs/design/eng_brep_measurements/probes/pcre2_ctypes.py) BEFORE it was
# written, and python3 `re` was driven over the SAME cells in the same pass; a
# block carries `# pcre2-only` exactly where python diverged or could not
# compile the pattern -- DETECTED, never assumed, with the first divergence and
# the cell count recorded above the marking. The generator never asks pcrec
# anything: an expectation derived from the compiler under test is not an
# expectation.
#
# WHY THE MARKING IS COMPUTED RATHER THAN DECLARED. Design §7 catalogues TWO
# expectations about this module that a hand-marking would have written in and
# that are REFUTED by measurement: python compiles all fourteen QUANTIFIED
# lookaround forms and agrees on all nine behavioural cells (G8), and the two
# oracles agree on all 27 CAPTURE cells including captures in a negative
# lookahead (G9). R32 C3 is the standing precedent -- a test plan that marked
# two files python-verifiable in the direction that LOSES the oracle.
#
# EVERY BLOCK NAMES `lookaround` IN ITS `features` LINE (R33 V-10): `std1` is a
# FROZEN named set, {classes, modifiers}, so it does not contain this module,
# and a corpus cell that forgot the feature would pass by REFUSAL -- S108's
# masking shape applied to a whole file.
#
# Design: docs/design/lookaround_design.md.


# §3.6's MEASURED WITNESS, BY NAME, and it is the ONE cell that goes red if
# the per-branch retry frames are cut. On "bacba" it is (2,5) with g1 UNSET
# and g2=(0,2): the assertion first succeeds through branch 1, the follow
# `\2` fails because g2 is unset, and the failure RETREATS INTO BRANCH 2 --
# re-running the back-step with THAT branch's own `k` and undoing branch 1's
# captures through the ordinary trail rewind. In the atomic form those frames
# are discarded by the cut; here they are LOAD-BEARING.
# python DIVERGES here, measured rather than assumed: 'bacba' @0 pcre2=('m',
# 2, 5, (-1, -1), (0, 2)) python=('ERR', 'unknown extension ?<* at position
# 1') (2 cells in this block)
# pcre2-only
pattern (?<*(a)|(ba))c\2
features lookaround,backrefs
m "bacba" 2 5
g 1 -1 -1
g 2 0 2
n "bac"

# ...AND ITS ATOMIC CONTROL, which is the half that makes the pair a
# measurement rather than an assertion: the same body one character different
# in the spelling is NOMATCH on the same subject, because `(?<=` keeps branch
# 1 and never reconsiders. Sabotage row S131 emits the cut on both and this
# pair collapses; S122 emits it on neither and it collapses the other way.
# python DIVERGES here, measured rather than assumed: 'bacba' @0 pcre2=('n',)
# python=('ERR', 'look-behind requires fixed-width pattern') (2 cells in this
# block)
# pcre2-only
pattern (?<=(a)|(ba))c\2
features lookaround,backrefs
n "bacba"
n "bac"

# §3.6's F4 fourth row: the branch order reversed, so the retry goes from the
# LONGER branch to the shorter one.
# python DIVERGES here, measured rather than assumed: 'baca' @0 pcre2=('m',
# 2, 4, (-1, -1), (1, 2)) python=('ERR', 'unknown extension ?<* at position
# 1') (2 cells in this block)
# pcre2-only
pattern (?<*(ba)|(a))c\2
features lookaround,backrefs
m "baca" 2 4
g 1 -1 -1
g 2 1 2
n "bacba"

# F4's third row -- NO FOLLOW to force a retry, so the non-atomic form
# answers exactly as the atomic one would. It is the control that says the
# previous cells measure RE-ENTRY and not merely `(?<*`.
# python DIVERGES here, measured rather than assumed: 'bac' @0 pcre2=('m', 2,
# 3, (1, 2), (-1, -1)) python=('ERR', 'unknown extension ?<* at position 1')
# (2 cells in this block)
# pcre2-only
pattern (?<*(a)|(ba))c
features lookaround,backrefs
m "bac" 2 3
g 1 1 2
g 2 -1 -1
m "bacba" 2 3
g 1 1 2
g 2 -1 -1

# The plain shape: the same answer as `(?<=a)b`, which is the CONTROL that
# the two spellings differ only where a retry is possible.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 1,
# 2) python=('ERR', 'unknown extension ?<* at position 1') (3 cells in this
# block)
# pcre2-only
pattern (?<*a)b
features lookaround
m "ab" 1 2
n "b"
n "xb"

# A multi-character non-atomic body.
# python DIVERGES here, measured rather than assumed: 'abc' @0 pcre2=('m', 2,
# 3) python=('ERR', 'unknown extension ?<* at position 1') (2 cells in this
# block)
# pcre2-only
pattern (?<*ab)c
features lookaround
m "abc" 2 3
n "bc"

# DIFFERING widths, non-atomic: the branch frames stay live AND the widths
# differ, which is the combination §3.6's drawing exists for. NO MARK SLOT is
# allocated here at all -- that is how a reader tells the two families apart
# in the emitted C and in `--emit-ir`.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('m', 1,
# 2) python=('ERR', 'unknown extension ?<* at position 1') (4 cells in this
# block)
# pcre2-only
pattern (?<*a|bc)x
features lookaround
m "ax" 1 2
m "bcx" 2 3
n "cx"
m "abcx" 3 4

# QUANTIFIED non-atomic behind, so the empty-iteration guard is exercised on
# the arm that allocates no mark.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 1,
# 2) python=('ERR', 'unknown extension ?<* at position 1') (2 cells in this
# block)
# pcre2-only
pattern (?<*a)*b
features lookaround
m "ab" 1 2
m "b" 0 1

# A non-atomic lookbehind nested inside an ATOMIC one: the outer cut discards
# the inner body's live choice points, which is correct and is what makes
# `(?<=` atomic in the first place.
# python DIVERGES here, measured rather than assumed: 'abc' @0 pcre2=('m', 2,
# 3) python=('ERR', 'unknown extension ?<* at position 5') (2 cells in this
# block)
# pcre2-only
pattern (?<=(?<*a)b)c
features lookaround
m "abc" 2 3
n "bc"

# ...and the other nesting order.
# python DIVERGES here, measured rather than assumed: 'abc' @0 pcre2=('m', 2,
# 3) python=('ERR', 'unknown extension ?<* at position 1') (2 cells in this
# block)
# pcre2-only
pattern (?<*(?<=a)b)c
features lookaround
m "abc" 2 3
n "bc"

# Captures inside a non-atomic lookbehind are retained exactly as the atomic
# form's are -- the retention is the TRAIL's, not the cut's.
# python DIVERGES here, measured rather than assumed: 'aa' @0 pcre2=('m', 1,
# 2, (0, 1)) python=('ERR', 'unknown extension ?<* at position 1') (2 cells
# in this block)
# pcre2-only
pattern (?<*(a))a
features lookaround
m "aa" 1 2
g 1 0 1
n "a"
