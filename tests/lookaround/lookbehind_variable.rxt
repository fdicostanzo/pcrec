# tests/lookaround/lookbehind_variable.rxt -- module `lookaround` ([M6.6.2]): [VLOOKBEHIND] stage 1: bounded VARIABLE-width bodies, refused until it
#
# GENERATED BY tests/lookaround/gen_corpus.py, and that is a property rather
# than a convenience. Every expectation below was produced by driving the cell
# through libpcre2 10.46 (the committed ctypes binding at
# docs/design/eng_brep_measurements/probes/pcre2_ctypes.py) BEFORE it was
# written, and python3 `re` was driven over the SAME cells in the same pass; a
# block carries `# pcre2-only` exactly where python diverged or could not
# compile the pattern -- DETECTED, never assumed, with the first divergence and
# the cell count recorded above the marking. The generator never asks pcrec
# anything: an expectation derived from the compiler under test is not an
# expectation.
#
# WHY THE MARKING IS COMPUTED RATHER THAN DECLARED. Design §7 catalogues TWO
# expectations about this module that a hand-marking would have written in and
# that are REFUTED by measurement: python compiles all fourteen QUANTIFIED
# lookaround forms and agrees on all nine behavioural cells (G8), and the two
# oracles agree on all 27 CAPTURE cells including captures in a negative
# lookahead (G9). R32 C3 is the standing precedent -- a test plan that marked
# two files python-verifiable in the direction that LOSES the oracle.
#
# EVERY BLOCK NAMES `lookaround` IN ITS `features` LINE (R33 V-10): `std1` is a
# FROZEN named set, {classes, modifiers}, so it does not contain this module,
# and a corpus cell that forgot the feature would pass by REFUSAL -- S108's
# masking shape applied to a whole file.
#
# Design: docs/design/lookaround_design.md.


# §2.5's DISTINGUISHING CELL, now an answer: ONE top-level branch of width
# 1..2 beside its near-twin `(?<=a|bc)x`, TWO fixed branches
# (lookbehind_widths.rxt). The answers agree; the capture shows which length
# the farthest-first rule picked.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('m', 1,
# 2, (0, 1)) python=('ERR', 'look-behind requires fixed-width pattern') (6
# cells in this block)
# pcre2-only
pattern (?<=(a|bc))x
features lookaround
m "ax" 1 2
g 1 0 1
m "bcx" 2 3
g 1 0 2
n "cx"
n "x"
m "abcx" 3 4
g 1 1 3
ms 1 "zbcx" 3 4
g 1 1 3

# A bounded variable body, two lengths: G2's cell.
# python DIVERGES here, measured rather than assumed: 'aax' @0 pcre2=('m', 2,
# 3) python=('ERR', 'look-behind requires fixed-width pattern') (5 cells in
# this block)
# pcre2-only
pattern (?<=a{2,3})x
features lookaround
m "aax" 2 3
m "aaax" 3 4
n "ax"
m "baax" 3 4
m "aaaax" 4 5

# Width 0..1, the smallest variable body: the empty candidate makes every `x`
# match.
# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('m', 0,
# 1) python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in
# this block)
# pcre2-only
pattern (?<=a?)x
features lookaround
m "x" 0 1
m "ax" 1 2
m "bx" 1 2
ms 1 "aax" 2 3

# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('m', 0,
# 1) python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in
# this block)
# pcre2-only
pattern (?<=a{0,3})x
features lookaround
m "x" 0 1
m "aaax" 3 4
ms 2 "aaaax" 4 5
m "bx" 1 2

# ONE branch whose own INTERIOR alternation makes it variable (2..3); the
# branch split comes from the parse, never from counting `|`.
# python DIVERGES here, measured rather than assumed: 'adx' @0 pcre2=('m', 2,
# 3) python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in
# this block)
# pcre2-only
pattern (?<=(?:a|bc)d)x
features lookaround
m "adx" 2 3
m "bcdx" 3 4
n "cdx"
n "dx"

# python DIVERGES here, measured rather than assumed: 'adx' @0 pcre2=('m', 2,
# 3, (0, 2), (0, 1)) python=('ERR', 'look-behind requires fixed-width
# pattern') (3 cells in this block)
# pcre2-only
pattern (?<=((a|bc)d))x
features lookaround
m "adx" 2 3
g 1 0 2
g 2 0 1
m "bcdx" 3 4
g 1 0 3
g 2 0 2
n "cdx"

# The negative polarity: the assertion holds when no candidate of either
# length ends at the cursor.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('n',)
# python=('ERR', 'look-behind requires fixed-width pattern') (5 cells in this
# block)
# pcre2-only
pattern (?<!(a|bc))x
features lookaround
n "ax"
n "bcx"
m "cx" 1 2
g 1 -1 -1
m "x" 0 1
g 1 -1 -1
m "zzx" 2 3
g 1 -1 -1

# ...and the non-atomic spelling.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('m', 1,
# 2, (0, 1)) python=('ERR', 'unknown extension ?<* at position 1') (3 cells
# in this block)
# pcre2-only
pattern (?<*(a|bc))x
features lookaround
m "ax" 1 2
g 1 0 1
m "bcx" 2 3
g 1 0 2
n "cx"

# §2.5's DISCRIMINATING ROW, answered: `\Z`'s body one direction over (width
# 0..1). `\z` inside a lookbehind holds only at the subject end, and an `x`
# follows, so the pattern never matches; libpcre2 agrees.
# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('n',)
# python=('ERR', 'look-behind requires fixed-width pattern') (3 cells in this
# block)
# pcre2-only
pattern (?<=\n?\z)x
features assertions,lookaround
n "x"
n "\nx"
n "a"

# ...and the same optional shape with a class.
# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('m', 0,
# 1) python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in
# this block)
# pcre2-only
pattern (?<=\w?)x
features lookaround,classes
m "x" 0 1
m "ax" 1 2
m "-x" 1 2
ms 1 "aax" 2 3
