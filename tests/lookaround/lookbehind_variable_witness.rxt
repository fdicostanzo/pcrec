# tests/lookaround/lookbehind_variable_witness.rxt -- [VLOOKBEHIND] stage 1's
# sabotage witnesses (docs/design/vlookbehind.md §7, rows W1-W16): each block
# is the cell one tests/mech/sabotages/S19xx row names, so a plant on the
# varying-branch loop turns a named block red. GENERATED by tests/lib/p2gen.py
# from lookbehind_variable_witness.gen.py; every expectation is libpcre2
# 10.46's (UTF-8 cells under PCRE2_UTF|PCRE2_MATCH_INVALID_UTF).

# W1: candidates farthest first -- the capture shows the length chosen.
# pcre2-only
pattern (?<=(a|aa))c
features lookaround
m "aac" 2 3
g 1 0 2

# W2: the end-check -- length 2 ends at 1, not at the cursor.
# pcre2-only
pattern (?<=a{1,2})x
features lookaround
n "abx"

# W3: the end-check backtracks into the body -- only a later path ends at 3.
# pcre2-only
pattern (?<=(a|ab)(b|))x
features lookaround
m "abbx" 3 4
g 1 0 2
g 2 2 3

# W3b: the body's trailing greedy quantifier gives one back.
# pcre2-only
pattern (?<=a{1,2})a
features lookaround
m "aaa" 1 2

# W4: a varying branch on the negative arm declines, never INTERNAL.
# pcre2-only
pattern (?<!ab?)x
features lookaround
m "acx" 2 3

# W5: the non-atomic retry reaches length 1.
# pcre2-only
pattern (?<*(a{1,3}))c\1
features lookaround,backrefs
m "aaaca" 3 5
g 1 2 3

# W5: ...with a gap at length 2 (every length, not the next accept).
# pcre2-only
pattern (?<*(a|aaa))c\1
features lookaround,backrefs
m "aaaca" 3 5
g 1 2 3

# W6: the UTF-8 far retry: K = 2 returns the sentinel, K = 1 reaches 0.
# pcre2-only
pattern (?<=(é{0,2}))x
features lookaround
encoding utf8
m "\xc3\xa9x" 2 3
g 1 0 2

# W7: the guard is absolute, not relative to startpos.
# pcre2-only
pattern (?<=a{1,2})b
features lookaround
ms 2 "aab" 2 3

# W8: the 255 cap applies to every branch once one varies (err 200).
# pcre2-only
pattern (?<=a{300}|b{1,2})x
features lookaround
perr

# W9: the cap boundary -- 255 compiles...
# pcre2-only
pattern (?<=a{1,255})x
features lookaround
m "ax" 1 2
n "x"

# W9: ...256 is refused (err 200).
# pcre2-only
pattern (?<=a{1,256})x
features lookaround
perr

# W9b: the 65535 ceiling -- fixed, compiles...
# pcre2-only
pattern (?<=a{65535})x
features lookaround
n "x"

# W9b: ...one more is refused (err 187).
# pcre2-only
pattern (?<=a{65535}b)x
features lookaround
perr

# W9b: through a product, compiles...
# pcre2-only
pattern (?<=(?:a{1000}){65})x
features lookaround
n "x"

# W9b: ...and refused one past.
# pcre2-only
pattern (?<=(?:a{1000}){66})x
features lookaround
perr

# W10: written branch order beats length.
# pcre2-only
pattern (?<=(a)|(aa))c
features lookaround
m "aac" 2 3
g 1 1 2
g 2 -1 -1

# W11 (a): exhaustion restores the cursor before the next branch.
# pcre2-only
pattern (?<=a{1,2}|b)x
features lookaround
m "bx" 1 2

# W11 (a): ...the same with a two-character next branch.
# pcre2-only
pattern (?<=a{1,2}|bc)x
features lookaround
m "bcx" 2 3

# W11 (a): ...the guard's control.
# pcre2-only
pattern (?<=a{2,3}|b)x
features lookaround
m "bx" 1 2

# W11 (b): the restore on LO_i's sentinel path (UTF-8).
# pcre2-only
pattern (?<=é{2,3}|é)x
features lookaround
encoding utf8
m "\xc3\xa9x" 2 3

# W12 (a): nine candidates within the O(1) trail term.
# pcre2-only
pattern (?<=a{1,9})x
features lookaround
m "bbbbbbbbbax" 10 11

# W12 (a): the UTF-8 twin.
# pcre2-only
pattern (?<=a{1,9})x
features lookaround
encoding utf8
m "\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9ax" 19 20

# W12 (b): two varying branches, each a trail entry.
# pcre2-only
pattern (?<=a{1,2}|b{1,2})x
features lookaround
m "abx" 2 3

# W13: the step is bounded by the cursor, not the subject (a stray continuation byte AT the cursor).
# pcre2-only
pattern é(?<=(a?))
features lookaround
encoding utf8
m "\xc3\xa9\xa9" 0 2
g 1 2 2

# W13: ...without a capture.
# pcre2-only
pattern é(?<=a{0,1})
features lookaround
encoding utf8
m "\xc3\xa9\xa9" 0 2

# W14: the step moves exactly one character (\G pins the second candidate).
# pcre2-only
pattern (?<=\Ga{1,2})b
features lookaround,assertions
ms 1 "aab" 2 3
m "aab" 2 3
ns 2 "aab"

# W14: ...one character, not one byte, under UTF-8.
# pcre2-only
pattern (?<=\Gé{1,2})b
features lookaround,assertions
encoding utf8
ms 2 "\xc3\xa9\xc3\xa9b" 4 5

# W14: ...a three-byte character inside a caseless branch.
# pcre2-only
pattern (?i)(?<=(k{1,2})|(b))x
features lookaround,modifiers
encoding utf8
m "b\xe2\x84\xaax" 4 5
g 1 1 4
g 2 -1 -1

# W15: the far step clamps at an ill-formed run (byte).
# pcre2-only
pattern (?<=(a{0,2}))b
features lookaround
encoding utf8
m "\xffab" 2 3
g 1 1 2

# W15: ...a stray continuation before a character.
# pcre2-only
pattern (?<=(é{0,2}))b
features lookaround
encoding utf8
m "\xa9\xc3\xa9b" 3 4
g 1 1 3

# W16: the nearest candidate is tried.
# pcre2-only
pattern (?<=a{1,2})x
features lookaround
m "bax" 2 3

# W16: non-atomic re-entry into the next branch.
# pcre2-only
pattern (?<*(a{1,2})|(aa))\2
features lookaround,backrefs
m "aaaa" 2 4
g 1 -1 -1
g 2 0 2

# S136 (re-aimed): a one-length pair wrong at both ends -- the positive cell.
# pcre2-only
pattern (?<=bc|d)x
features lookaround
m "abcx" 3 4

# S136: ...the negative cell, whose end-check would return INTERNAL.
# pcre2-only
pattern (?<!bc|d)x
features lookaround
m "bcax" 3 4

# W-low: LO_i must be trailed -- a non-atomic lookahead moves the cursor backward.
# pcre2-only
pattern (?:(?*.*(?<*a?))b)*$
features lookaround
m "bc" 2 2

