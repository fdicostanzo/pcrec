# tests/lookaround/lookbehind_widths.rxt -- module `lookaround` ([M6.6.2]): DIFFERENT-length branches -- G1's cells, and §2.4's preference order
#
# GENERATED BY tests/lookaround/gen_corpus.py, and that is a property rather
# than a convenience. Every expectation below was produced by driving the cell
# through libpcre2 10.46 (the committed ctypes binding at
# docs/design/eng_brep_measurements/probes/pcre2_ctypes.py) BEFORE it was
# written, and python3 `re` was driven over the SAME cells in the same pass; a
# block carries `# pcre2-only` exactly where python diverged or could not
# compile the pattern -- DETECTED, never assumed, with the first divergence and
# the cell count recorded above the marking. The generator never asks pcrec
# anything: an expectation derived from the compiler under test is not an
# expectation.
#
# WHY THE MARKING IS COMPUTED RATHER THAN DECLARED. Design §7 catalogues TWO
# expectations about this module that a hand-marking would have written in and
# that are REFUTED by measurement: python compiles all fourteen QUANTIFIED
# lookaround forms and agrees on all nine behavioural cells (G8), and the two
# oracles agree on all 27 CAPTURE cells including captures in a negative
# lookahead (G9). R32 C3 is the standing precedent -- a test plan that marked
# two files python-verifiable in the direction that LOSES the oracle.
#
# EVERY BLOCK NAMES `lookaround` IN ITS `features` LINE (R33 V-10): `std1` is a
# FROZEN named set, {classes, modifiers}, so it does not contain this module,
# and a corpus cell that forgot the feature would pass by REFUSAL -- S108's
# masking shape applied to a whole file.
#
# Design: docs/design/lookaround_design.md.


# THE HEADLINE CELL of §2.5: TWO top-level branches, each FIXED, of widths 1
# and 2 -- legal in PCRE2, an ERROR in python (G1), and pcrec SHIPS it. "cx"
# is design §3.4's B5 cell that shows the branches are INDEPENDENT: neither
# `a` nor `bc` precedes the `x`, so the assertion fails through both. Its
# near-twin `(?<=(a|bc))x` -- ONE branch of width 1..2 -- is REFUSED and is
# in refused.rxt; the difference between those two lines is exactly the
# level-1/level-2 split §2.4 measured, and it is the thing in this module
# most likely to be read as a defect.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('m', 1,
# 2) python=('ERR', 'look-behind requires fixed-width pattern') (6 cells in
# this block)
# pcre2-only
pattern (?<=a|bc)x
features lookaround
m "ax" 1 2
m "bcx" 2 3
n "cx"
n "x"
m "zbcx" 3 4
m "abcx" 3 4

# THREE branches of three DIFFERENT widths, so the chain is not the
# two-branch shape a reader generalises from and the middle branch's retry
# frame is load-bearing.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('m', 1,
# 2) python=('ERR', 'look-behind requires fixed-width pattern') (5 cells in
# this block)
# pcre2-only
pattern (?<=a|bc|def)x
features lookaround
m "ax" 1 2
m "bcx" 2 3
m "defx" 3 4
n "efx"
n "x"

# The rule is POLARITY-BLIND (§2.3's own row). And this is the arm where a
# wrong per-branch width is a FALSE MATCH rather than a decline, which is why
# the end-check returns HARD here -- sabotage row S136 carries this spelling
# for exactly that reason.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('n',)
# python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in this
# block)
# pcre2-only
pattern (?<!a|bc)x
features lookaround
n "ax"
n "bcx"
m "cx" 1 2
m "x" 0 1

# §2.4 LEVEL 1, MEASURED, AND IT IS THE SHARPEST CELL IN THE MODULE:
# top-level branches are tried in WRITTEN ORDER, so on "aac" branch 1 wins
# and g1=(1,2) -- the SHORTER match, written first. Compare the next cell,
# which is the same two branches the other way round and answers with the
# LONGER one. An implementation that ordered branches by width would get
# exactly one of these two right.
# python DIVERGES here, measured rather than assumed: 'aac' @0 pcre2=('m', 2,
# 3, (1, 2), (-1, -1)) python=('ERR', 'look-behind requires fixed-width
# pattern') (3 cells in this block)
# pcre2-only
pattern (?<=(a)|(aa))c
features lookaround
m "aac" 2 3
g 1 1 2
g 2 -1 -1
m "ac" 1 2
g 1 0 1
g 2 -1 -1
n "c"

# ...the same two branches reversed: branch 1 wins again, g1=(0,2), the
# LONGER match. Written order, not length.
# python DIVERGES here, measured rather than assumed: 'aac' @0 pcre2=('m', 2,
# 3, (0, 2), (-1, -1)) python=('ERR', 'look-behind requires fixed-width
# pattern') (2 cells in this block)
# pcre2-only
pattern (?<=(aa)|(a))c
features lookaround
m "aac" 2 3
g 1 0 2
g 2 -1 -1
m "ac" 1 2
g 1 -1 -1
g 2 0 1

# Three widths, shortest written first.
# python DIVERGES here, measured rather than assumed: 'aaac' @0 pcre2=('m',
# 3, 4, (2, 3), (-1, -1), (-1, -1)) python=('ERR', 'look-behind requires
# fixed-width pattern') (2 cells in this block)
# pcre2-only
pattern (?<=(a)|(aa)|(aaa))c
features lookaround
m "aaac" 3 4
g 1 2 3
g 2 -1 -1
g 3 -1 -1
m "aac" 2 3
g 1 1 2
g 2 -1 -1
g 3 -1 -1

# ...and longest written first. Both answer through branch 1.
# python DIVERGES here, measured rather than assumed: 'aaac' @0 pcre2=('m',
# 3, 4, (0, 3), (-1, -1), (-1, -1)) python=('ERR', 'look-behind requires
# fixed-width pattern') (2 cells in this block)
# pcre2-only
pattern (?<=(aaa)|(aa)|(a))c
features lookaround
m "aaac" 3 4
g 1 0 3
g 2 -1 -1
g 3 -1 -1
m "ac" 1 2
g 1 -1 -1
g 2 -1 -1
g 3 0 1

# Widths 1 and 3, so the guard rules out the long branch on subjects where
# the short one is still viable.
# python DIVERGES here, measured rather than assumed: 'xy' @0 pcre2=('m', 1,
# 2) python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in
# this block)
# pcre2-only
pattern (?<=x|abc)y
features lookaround
m "xy" 1 2
m "abcy" 3 4
n "y"
n "bcy"

# The long branch written FIRST, which is the order that makes the guard fire
# on branch 1 and fall through to branch 2 rather than reaching the
# back-step.
# python DIVERGES here, measured rather than assumed: 'abx' @0 pcre2=('m', 2,
# 3) python=('ERR', 'look-behind requires fixed-width pattern') (4 cells in
# this block)
# pcre2-only
pattern (?<=ab|c)x
features lookaround
m "abx" 2 3
m "cx" 1 2
n "bx"
n "x"

# A QUANTIFIED differing-width lookbehind: the empty-iteration guard and the
# per-branch retry frames at the same time.
# python DIVERGES here, measured rather than assumed: 'ax' @0 pcre2=('m', 1,
# 2) python=('ERR', 'look-behind requires fixed-width pattern') (3 cells in
# this block)
# pcre2-only
pattern (?<=a|bc)*x
features lookaround
m "ax" 1 2
m "bcx" 2 3
m "x" 0 1

# Mid-pattern, so the entry position is not the attempt position and the two
# branches step back from a CURSOR rather than from 0.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 0,
# 2) python=('ERR', 'look-behind requires fixed-width pattern') (2 cells in
# this block)
# pcre2-only
pattern a(?<=a|xbc)b
features lookaround
m "ab" 0 2
n "xbcb"

# A ZERO-WIDTH BRANCH BESIDE A CONSUMING ONE, and it is here because it FOUND
# A DEFECT. Width 0 is a legal fixed width, so §2.5 admits this body -- and
# the emitted start-of-subject guard for it was `scan_position < 0`, an
# always-false comparison on a `size_t` that gcc REFUSES under the harness's
# `-Wall -Wextra -Werror` generated build (`-Wtype-limits`). The guard is now
# emitted only for k > 0, which is the condition being unsatisfiable rather
# than an exception for one body shape. Branch 1 is width 0 and always
# succeeds, so the assertion is a no-op and the second branch is never
# reached.
# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('m', 0,
# 1) python=('ERR', 'look-behind requires fixed-width pattern') (3 cells in
# this block)
# pcre2-only
pattern (?<=|a)x
features lookaround
m "x" 0 1
m "ax" 1 2
m "bx" 1 2

# ...and the zero-width branch written SECOND, which is the order that makes
# it the LAST branch -- the arm that emits `goto rx_fail` rather than a jump
# to the next branch, and therefore a different guard site from the cell
# above.
# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('m', 0,
# 1) python=('ERR', 'look-behind requires fixed-width pattern') (2 cells in
# this block)
# pcre2-only
pattern (?<=a|)x
features lookaround
m "x" 0 1
m "ax" 1 2

# ...and the negative form, where a zero-width branch that always succeeds
# makes the whole assertion `(*FAIL)`.
# python DIVERGES here, measured rather than assumed: 'x' @0 pcre2=('n',)
# python=('ERR', 'look-behind requires fixed-width pattern') (2 cells in this
# block)
# pcre2-only
pattern (?<!a|)x
features lookaround
n "x"
n "ax"
