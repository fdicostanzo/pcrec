# l3d27: blinded (D27) goal-level witnesses for lookaround unit L3 (a positive
# lookbehind's fixed bytes join the required run in front of the consumed part).
# Groups: A = join, B = dead, C = look-alike controls. Every expectation is libpcre2-8
# 10.46 2025-08-27 (python3 ctypes), find-all spans over every start position; written by an author
# denied src/ and tests/. Each witness appears once per encoding and engine (auto, vm).
# description L3 lookbehind-join D27 witnesses (answers only; listing claims in l3d27_listing.tsv)
# oracle pcre2/10.46

# A01 (A) byte: spec 4.1.2p8 worked example
pattern (?<=foo)bar
features lookaround
n ""
m "foobar" 3 6
ms 3 "foobar" 3 6
ns 4 "foobar"
m "ZfoobarZ" 4 7
ms 4 "ZfoobarZ" 4 7
ns 5 "ZfoobarZ"
n "fobar"
n "ZfobarZ"
n "bar"
n "ZbarZ"
n "xbar"
n "ZxbarZ"
m "foobarfoobar" 3 6
ms 3 "foobarfoobar" 3 6
ms 4 "foobarfoobar" 9 12
ms 9 "foobarfoobar" 9 12
ns 10 "foobarfoobar"
m "ZfoobarfoobarZ" 4 7
ms 4 "ZfoobarfoobarZ" 4 7
ms 5 "ZfoobarfoobarZ" 10 13
ms 10 "ZfoobarfoobarZ" 10 13
ns 11 "ZfoobarfoobarZ"
n "foobaz"
n "ZfoobazZ"
m "ofoobar" 4 7
ms 4 "ofoobar" 4 7
ns 5 "ofoobar"
m "ZofoobarZ" 5 8
ms 5 "ZofoobarZ" 5 8
ns 6 "ZofoobarZ"
n "foo bar"
n "Zfoo barZ"
n "FOOBAR"
n "ZFOOBARZ"
n "foOBar"
n "ZfoOBarZ"
m "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 3 6
ms 3 "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 3 6
ms 4 "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 25 28
ms 25 "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 25 28
ms 26 "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 31 34
ms 31 "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 31 34
ms 32 "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 46 49
mc "foobar.fobar.bar.xbar.foobarfoobar.foobaz.ofoobar.foo bar.FOOBAR.foOBar" 4

