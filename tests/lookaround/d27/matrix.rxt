pattern (?<*(a))*z
features lookaround
m "z" 0 1
g 1 -1 -1
m "aaz" 2 3
g 1 1 2
m "abcz" 3 4
g 1 -1 -1
ms 1 "qz" 1 2
g 1 -1 -1

# pcre2-only
# NAPLB/capture/capture: ((?<*(a))z)
pattern ((?<*(a))z)
features lookaround
m "az" 1 2
g 1 1 2
g 2 0 1
m "aaz" 2 3
g 1 2 3
g 2 1 2
m "baz" 2 3
g 1 2 3
g 2 1 2
ms 1 "qaz" 2 3
g 1 2 3
g 2 1 2

# pcre2-only
# NAPLB/capture/atomic: (?>(?<*(a))z)
pattern (?>(?<*(a))z)
features atomic-groups,lookaround
m "az" 1 2
g 1 0 1
m "aaz" 2 3
g 1 1 2
m "baz" 2 3
g 1 1 2
ms 1 "qaz" 2 3
g 1 1 2

# pcre2-only
# NAPLB/nested_la/start: (?<*a(?!b))z
pattern (?<*a(?!b))z
features lookaround
m "az" 1 2
m "aaz" 2 3
m "baz" 2 3
ms 1 "qaz" 2 3

# pcre2-only
# NAPLB/nested_la/end: z(?<*a(?!b))
pattern z(?<*a(?!b))
features lookaround
n ""
n "a"
n "b"

# pcre2-only
# NAPLB/nested_la/mid: y(?<*a(?!b))z
pattern y(?<*a(?!b))z
features lookaround
n ""
n "a"
n "b"

# pcre2-only
# NAPLB/nested_la/branch: (?:(?<*a(?!b))z|w)
pattern (?:(?<*a(?!b))z|w)
features lookaround
m "waz" 0 1
m "aw" 1 2
m "az" 1 2
ms 1 "qwaz" 1 2

# pcre2-only
# NAPLB/nested_la/quant_star: (?<*a(?!b))*z
pattern (?<*a(?!b))*z
features lookaround
m "z" 0 1
m "aaz" 2 3
m "abcz" 3 4
ms 1 "qz" 1 2

# pcre2-only
# NAPLB/nested_la/capture: ((?<*a(?!b))z)
pattern ((?<*a(?!b))z)
features lookaround
m "az" 1 2
g 1 1 2
m "aaz" 2 3
g 1 2 3
m "baz" 2 3
g 1 2 3
ms 1 "qaz" 2 3
g 1 2 3

# pcre2-only
# NAPLB/nested_la/atomic: (?>(?<*a(?!b))z)
pattern (?>(?<*a(?!b))z)
features atomic-groups,lookaround
m "az" 1 2
m "aaz" 2 3
m "baz" 2 3
ms 1 "qaz" 2 3

