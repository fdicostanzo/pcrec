# matrix.rxt -- [M6.6.3] D27 systematic construct x body-shape x
# context matrix (la_d27_extract.md sec 10.1). 6 constructs x 9 body
# shapes x 7 contexts, canonical `(?...)` spellings; alpha-spelling
# equivalence lives in spellings.rxt, lookbehind-refusal cells for
# variable-width bodies live in refusals.rxt (this file skips those
# combinations rather than asserting a match expectation pcrec would
# never produce). Every m/n/ms/ns/g expectation is a direct oracle
# read from docs/design/lookaround_measurements/probes/la_oracle.py
# (libpcre2 10.46) and, where python re can take the pattern, python3
# `re` too -- generated by gen_matrix.py, never hand-typed.

# PLA/empty/start: (?=)z
pattern (?=)z
features lookaround
m "z" 0 1
m "az" 1 2
m "bz" 1 2

# PLA/empty/end: z(?=)
pattern z(?=)
features lookaround
m "z" 0 1
m "az" 1 2
m "bz" 1 2

# PLA/empty/mid: y(?=)z
pattern y(?=)z
features lookaround
m "yz" 0 2
m "ayz" 1 3
m "byz" 1 3

# PLA/empty/branch: (?:(?=)z|w)
pattern (?:(?=)z|w)
features lookaround
m "zz" 0 1
m "aw" 1 2
m "az" 1 2

# PLA/empty/quant_star: (?=)*z
pattern (?=)*z
features lookaround
m "z" 0 1
m "aaz" 2 3
m "abcz" 3 4

# PLA/empty/capture: ((?=)z)
pattern ((?=)z)
features lookaround
m "z" 0 1
g 1 0 1
m "az" 1 2
g 1 1 2
m "bz" 1 2
g 1 1 2

