g 8 -1 -1
m "bbbbbbbbc" 0 1
g 1 0 1
g 2 1 2
g 3 2 3
g 4 3 4
g 5 4 5
g 6 5 6
g 7 6 7
g 8 7 8
n "a"

# The NEGATIVE spelling, captures in the second branch.
pattern (?!a|(b)(?!a|(b)(?!a|(b)(?!a|(b)(?!a|(b)(?!a|(b)c)*+)*+)*+)*+)*+)*+x
features lookaround,atomic-groups
m "x" 0 1
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
g 6 -1 -1
m "bx" 1 2
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
