g 5 -1 -1
g 6 -1 -1
m "ax" 1 2
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
g 6 -1 -1

# Multi-literal first branches, so the assertion's island enumeration is used
# per level.
pattern (?=abc|abd|(ab)|b(?=abc|abd|(ab)|b(?=abc|abd|(ab)|b(?=abc|abd|(ab)|b(?=abc|abd|(ab)|b(?=abc|abd|(ab)|bc)*+)*+)*+)*+)*+)*+
features lookaround,atomic-groups
m "ab" 0 0
g 1 0 2
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
g 6 -1 -1
m "babd" 0 0
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
g 6 -1 -1
m "bbbc" 0 0
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
g 6 -1 -1

# The LAZY spelling.
pattern (?=a)*?a
features lookaround
m "a" 0 1

# A quantified assertion inside a CAPTURE: the group spans the empty run of
# iterations.
pattern ((?=a)*)a
features lookaround
m "a" 0 1
g 1 0 0

# An assertion inside a CONSUMING loop -- the iteration is not empty, so this
# exercises the ordinary rung with the marks re-set per pass.
pattern (?:(?=a)a)+
features lookaround
m "aa" 0 2
m "ab" 0 1
