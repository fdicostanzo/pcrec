# The same with a plain (greedy) star, a trailing consumer and fewer levels.
pattern (?=(a)|b(?=(a)|b(?=(a)|bc)*)*)*x
features lookaround,atomic-groups
m "bax" 2 3
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
m "bbax" 3 4
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
m "x" 0 1
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1

# Wrapped in a non-capturing group per level, with a consumer after each.
pattern (?:(?=(a)|b(?:(?=(a)|b(?:(?=(a)|b(?:(?=(a)|b(?:(?=(a)|bc)*+b))*+b))*+b))*+b))*+b)
features lookaround,atomic-groups
m "bbba" 0 1
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
m "bbbbbbc" 0 1
g 1 -1 -1
g 2 -1 -1
g 3 -1 -1
g 4 -1 -1
g 5 -1 -1
n "a"

# Captures in the SECOND branch, a consumer after the nest.
pattern ^(?:(?=a|(b)(?=a|(b)(?=a|(b)(?=a|(b)(?=a|(b)(?=a|(b)(?=a|(b)(?=a|(b)c)*+)*+)*+)*+)*+)*+)*+)*+)b
features lookaround,atomic-groups
m "b" 0 1
g 1 0 1
g 2 -1 -1
g 3 -1 -1
