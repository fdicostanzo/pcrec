# tests/lookaround/nonatomic_ahead.rxt -- module `lookaround` ([M6.6.2] wave B+C): `(?*` only -- the wave B+C half of the `nonatomic.rxt` split (R33 C2-9)
#
# GENERATED BY tests/lookaround/gen_corpus.py, and that is a property rather
# than a convenience. Every expectation below was produced by driving the cell
# through libpcre2 10.46 (the committed ctypes binding at
# docs/design/eng_brep_measurements/probes/pcre2_ctypes.py) BEFORE it was
# written, and python3 `re` was driven over the SAME cells in the same pass; a
# block carries `# pcre2-only` exactly where python diverged or could not
# compile the pattern -- DETECTED, never assumed, with the first divergence and
# the cell count recorded above the marking. The generator never asks pcrec
# anything: an expectation derived from the compiler under test is not an
# expectation.
#
# WHY THE MARKING IS COMPUTED RATHER THAN DECLARED. Design §7 catalogues TWO
# expectations about this module that a hand-marking would have written in and
# that are REFUTED by measurement: python compiles all fourteen QUANTIFIED
# lookaround forms and agrees on all nine behavioural cells (G8), and the two
# oracles agree on all 27 CAPTURE cells including captures in a negative
# lookahead (G9). R32 C3 is the standing precedent -- a test plan that marked
# two files python-verifiable in the direction that LOSES the oracle.
#
# EVERY BLOCK NAMES `lookaround` IN ITS `features` LINE (R33 V-10): `std1` is a
# FROZEN named set, {classes, modifiers}, so it does not contain this module,
# and a corpus cell that forgot the feature would pass by REFUSAL -- S108's
# masking shape applied to a whole file.
#
# Design: docs/design/lookaround_design.md.


# §2.2's ATOMICITY DISCRIMINATOR, the NON-ATOMIC half, and the cell that
# fixes `(?*` as a construct rather than a spelling. On "abab" it is (2,4)
# where `(?=(a|ab))\1$` -- lookahead.rxt's own cell -- is NOMATCH: the body
# RETRIES, finds "ab", and \1 ends the subject. Sabotage row S127 always
# emits the cut and this cell goes red.
# python DIVERGES here, measured rather than assumed: 'abab' @0 pcre2=('m',
# 2, 4, (2, 4)) python=('ERR', 'unknown extension ?* at position 1') (2 cells
# in this block)
# pcre2-only
pattern (?*(a|ab))\1$
features lookaround,backrefs
m "abab" 2 4
g 1 2 4
m "aa" 1 2
g 1 1 2

# The plain shape: same answer as `(?=a)b`, which is the CONTROL that the two
# differ only where a retry is possible.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('n',)
# python=('ERR', 'unknown extension ?* at position 1') (2 cells in this
# block)
# pcre2-only
pattern (?*a)b
features lookaround
n "ab"
n "bb"

# §3.2.1's ROW 3, BY NAME. The scoping is a property of the OVERLAP and NOT
# of the cut, so deleting `vm_cut` for this arm does NOT delete it -- an
# implementer following "the atomic shape MINUS the cut" would lose exactly
# this cell (it becomes NOMATCH).
# python DIVERGES here, measured rather than assumed: 'aab' @0 pcre2=('m', 0,
# 3, (0, 2)) python=('ERR', 'unknown extension ?* at position 1') (2 cells in
# this block)
# pcre2-only
pattern (?*(a+)b)a+b
features lookaround
m "aab" 0 3
g 1 0 2
m "aaab" 0 4
g 1 0 3

# Non-atomic in the MIDDLE: the cursor restore is the same line.
# python DIVERGES here, measured rather than assumed: 'abc' @0 pcre2=('m', 0,
# 3) python=('ERR', 'unknown extension ?* at position 2') (2 cells in this
# block)
# pcre2-only
pattern a(?*b)bc
features lookaround
m "abc" 0 3
n "abd"

# Captures inside a non-atomic assertion are retained exactly as the atomic
# form's are -- the retention is the trail's, not the cut's.
# python DIVERGES here, measured rather than assumed: 'a' @0 pcre2=('m', 0,
# 1, (0, 1)) python=('ERR', 'unknown extension ?* at position 1') (1 cells in
# this block)
# pcre2-only
pattern (?*(a))a
features lookaround
m "a" 0 1
g 1 0 1

# A body that cannot succeed fails the whole assertion: the positive form is
# positive whether or not it is atomic.
# python DIVERGES here, measured rather than assumed: 'a' @0 pcre2=('n',)
# python=('ERR', 'unknown extension ?* at position 1') (1 cells in this
# block)
# pcre2-only
pattern (?*x)a
features lookaround
n "a"

# QUANTIFIED non-atomic, so the empty-iteration guard is exercised on the arm
# that allocates NO mark slot.
# python DIVERGES here, measured rather than assumed: 'a' @0 pcre2=('m', 0,
# 1) python=('ERR', 'unknown extension ?* at position 1') (1 cells in this
# block)
# pcre2-only
pattern (?*a)*a
features lookaround
m "a" 0 1

# A non-atomic assertion nested inside an ATOMIC one: the outer cut discards
# the inner body's live choice points, which is correct and is what makes
# `(?=` atomic in the first place.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 0,
# 2) python=('ERR', 'unknown extension ?* at position 4') (1 cells in this
# block)
# pcre2-only
pattern (?=(?*a)a)ab
features lookaround
m "ab" 0 2

# ...and the other nesting order.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 0,
# 2) python=('ERR', 'unknown extension ?* at position 1') (1 cells in this
# block)
# pcre2-only
pattern (?*(?=a)a)ab
features lookaround
m "ab" 0 2

# python DIVERGES here, measured rather than assumed: 'abc' @0 pcre2=('m', 0,
# 3) python=('ERR', 'unknown extension ?* at position 1') (2 cells in this
# block)
# pcre2-only
pattern (?*ab)abc
features lookaround
m "abc" 0 3
n "abd"
