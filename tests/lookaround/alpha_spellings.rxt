# identically.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 1,
# 2) python=('ERR', 'nothing to repeat at position 1') (3 cells in this
# block)
# pcre2-only
pattern (*non_atomic_positive_lookbehind:a)b
features lookaround
m "ab" 1 2
n "b"
n "xb"

# §2.2's ATOMICITY DISCRIMINATOR in alpha spelling: NOMATCH, because `(*pla:`
# is the ATOMIC positive lookahead and commits to the body's first success.
# `(*napla:` and `(*non_atomic_positive_lookahead:` below carry the SAME
# pattern and answer (2,4). This pair is the whole atomicity axis for the
# lookahead spellings, and it is the axis the polarity cells structurally
# cannot see.
# python DIVERGES here, measured rather than assumed: 'abab' @0 pcre2=('n',)
# python=('ERR', 'nothing to repeat at position 1') (1 cells in this block)
# pcre2-only
pattern (*pla:(a|ab))\1$
features lookaround,backrefs
n "abab"

# §2.2's ATOMICITY DISCRIMINATOR in alpha spelling: NOMATCH, because
# `(*positive_lookahead:` is the ATOMIC positive lookahead and commits to the
# body's first success. `(*napla:` and `(*non_atomic_positive_lookahead:`
# below carry the SAME pattern and answer (2,4). This pair is the whole
# atomicity axis for the lookahead spellings, and it is the axis the polarity
# cells structurally cannot see.
# python DIVERGES here, measured rather than assumed: 'abab' @0 pcre2=('n',)
# python=('ERR', 'nothing to repeat at position 1') (1 cells in this block)
# pcre2-only
pattern (*positive_lookahead:(a|ab))\1$
features lookaround,backrefs
n "abab"

# ...and the NON-ATOMIC half of §2.2's discriminator: (2,4) on the same
# subject, because the body RETRIES and finds "ab". Wire `(*napla:` to the
# atomic primary and this cell goes NOMATCH while everything else in the
# module stays green.
# python DIVERGES here, measured rather than assumed: 'abab' @0 pcre2=('m',
# 2, 4, (2, 4)) python=('ERR', 'nothing to repeat at position 1') (1 cells in
# this block)
# pcre2-only
pattern (*napla:(a|ab))\1$
features lookaround,backrefs
m "abab" 2 4
g 1 2 4

# ...and the NON-ATOMIC half of §2.2's discriminator: (2,4) on the same
# subject, because the body RETRIES and finds "ab". Wire
# `(*non_atomic_positive_lookahead:` to the atomic primary and this cell goes
# NOMATCH while everything else in the module stays green.
# python DIVERGES here, measured rather than assumed: 'abab' @0 pcre2=('m',
# 2, 4, (2, 4)) python=('ERR', 'nothing to repeat at position 1') (1 cells in
# this block)
# pcre2-only
pattern (*non_atomic_positive_lookahead:(a|ab))\1$
features lookaround,backrefs
m "abab" 2 4
g 1 2 4

# §3.6's WITNESS, atomic half, in alpha spelling: NOMATCH, because `(*plb:`
# keeps branch 1 and never reconsiders when the follow `\2` fails.
# python DIVERGES here, measured rather than assumed: 'bacba' @0 pcre2=('n',)
# python=('ERR', 'nothing to repeat at position 1') (1 cells in this block)
# pcre2-only
pattern (*plb:(a)|(ba))c\2
features lookaround,backrefs
n "bacba"

# §3.6's WITNESS, atomic half, in alpha spelling: NOMATCH, because
# `(*positive_lookbehind:` keeps branch 1 and never reconsiders when the
# follow `\2` fails.
# python DIVERGES here, measured rather than assumed: 'bacba' @0 pcre2=('n',)
# python=('ERR', 'nothing to repeat at position 1') (1 cells in this block)
# pcre2-only
pattern (*positive_lookbehind:(a)|(ba))c\2
features lookaround,backrefs
n "bacba"

# ...and §3.6's NON-ATOMIC half: (2,5) with g1 unset and g2=(0,2), because
# the failure RETREATS INTO BRANCH 2 and re-runs the back-step with that
# branch's own width. These are the `(*naplb:` cells the `nonatomic.rxt`
# split left owing (R33 C2-9).
# python DIVERGES here, measured rather than assumed: 'bacba' @0 pcre2=('m',
# 2, 5, (-1, -1), (0, 2)) python=('ERR', 'nothing to repeat at position 1')
# (1 cells in this block)
# pcre2-only
pattern (*naplb:(a)|(ba))c\2
features lookaround,backrefs
m "bacba" 2 5
g 1 -1 -1
g 2 0 2

# ...and §3.6's NON-ATOMIC half: (2,5) with g1 unset and g2=(0,2), because
# the failure RETREATS INTO BRANCH 2 and re-runs the back-step with that
# branch's own width. These are the `(*naplb:` cells the `nonatomic.rxt`
# split left owing (R33 C2-9).
# python DIVERGES here, measured rather than assumed: 'bacba' @0 pcre2=('m',
# 2, 5, (-1, -1), (0, 2)) python=('ERR', 'nothing to repeat at position 1')
# (1 cells in this block)
# pcre2-only
pattern (*non_atomic_positive_lookbehind:(a)|(ba))c\2
features lookaround,backrefs
m "bacba" 2 5
g 1 -1 -1
g 2 0 2

# A SECOND, independent separation of the two negative directions: on "ab"
# the LOOKAHEAD form is (1,2) (position 0 is followed by `a`, so the
# assertion fails there) while the LOOKBEHIND form is (0,1) (nothing precedes
# position 0, so it holds). Nothing about polarity is being re-measured here
# -- the axis is direction, and it is measured twice because a single cell
# that happens to separate two constructs is one editing accident away from
# not doing so.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 1,
# 2) python=('ERR', 'nothing to repeat at position 1') (2 cells in this
# block)
# pcre2-only
pattern (*nla:a)(?:a|b)
features lookaround
m "ab" 1 2
m "ba" 0 1

# A SECOND, independent separation of the two negative directions: on "ab"
# the LOOKAHEAD form is (1,2) (position 0 is followed by `a`, so the
# assertion fails there) while the LOOKBEHIND form is (0,1) (nothing precedes
# position 0, so it holds). Nothing about polarity is being re-measured here
# -- the axis is direction, and it is measured twice because a single cell
# that happens to separate two constructs is one editing accident away from
# not doing so.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 1,
# 2) python=('ERR', 'nothing to repeat at position 1') (2 cells in this
# block)
# pcre2-only
pattern (*negative_lookahead:a)(?:a|b)
features lookaround
m "ab" 1 2
m "ba" 0 1

# ...the LOOKBEHIND half of the same separation: (0,1) on "ab".
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 0,
# 1) python=('ERR', 'nothing to repeat at position 1') (2 cells in this
# block)
# pcre2-only
pattern (*nlb:a)(?:a|b)
features lookaround
m "ab" 0 1
m "ba" 0 1

# ...the LOOKBEHIND half of the same separation: (0,1) on "ab".
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 0,
# 1) python=('ERR', 'nothing to repeat at position 1') (2 cells in this
# block)
# pcre2-only
pattern (*negative_lookbehind:a)(?:a|b)
features lookaround
m "ab" 0 1
m "ba" 0 1

# THE WIDTH RULE THROUGH AN ALIAS (§2.5): ONE branch of width 1..2, refused
# with a capability message and a pattern offset, exactly as `(?<=(a|bc))x`
# is. libpcre2 COMPILES it -- the refusal is pcrec's capability limit, not a
# syntax verdict.
# MEASURED: libpcre2 10.46 ACCEPTS this pattern -- pcrec's refusal is a
# CAPABILITY limit, stated as one (D26 tier 2: which constructs are real is
# exact, what pcrec builds is a separate statement); python3 `re` refuses:
# nothing to repeat at position 1
pattern (*plb:(a|bc))x
features lookaround
perr

# §2.7's `\K` REFUSAL THROUGH AN ALIAS, and through the LONG spelling: the
# check is `la_has_kreset` inside the shared port, so an alias that did not
# reach that port would compile today's `\K` inside tomorrow's lookaround and
# silently move the reported match start.
# MEASURED: libpcre2 10.46 also refuses: \K is not allowed in lookarounds
# (but see PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK); python3 `re` refuses: nothing
# to repeat at position 1
pattern (*positive_lookahead:a\K)b
features lookaround,assertions
perr
