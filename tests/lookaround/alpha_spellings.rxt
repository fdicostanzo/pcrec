# pcre2-only
pattern (*non_atomic_positive_lookahead:a)b
features lookaround
n "ab"
n "b"
n "xb"

# `(*naplb:` -- THE POLARITY-AND-DIRECTION CELL. Its three answers are
# distinct for each of the four primaries this shape can reach, so a spelling
# resolved to the wrong polarity or the wrong direction changes them. It is
# the same cell `(?<*a)b` carries in its own file, which is the point: the
# two spellings are ONE construct (§2.1) and must answer identically.
# python DIVERGES here, measured rather than assumed: 'ab' @0 pcre2=('m', 1,
# 2) python=('ERR', 'nothing to repeat at position 1') (3 cells in this
# block)
# pcre2-only
pattern (*naplb:a)b
features lookaround
m "ab" 1 2
n "b"
n "xb"

