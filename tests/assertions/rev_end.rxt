# [OPT-REVEND] L2 THE `rev-end` ANSWER NET (lane revbuild; revend.md §9.3,
# locate_finish.md §5 L2). GENERATED by tests/revend/gen_rev_end.py from
# libpcre2 10.46's answers (every m/n/ms/ns line is the oracle's, never
# pcrec's); tests/revend/verify_stage2.py re-reads this file and re-asks the
# oracle. python `re` is not an oracle here (its `\Z` is PCRE2's `\z`), so
# every block is `# pcre2-only`. Family G aside, capture-free: the default build runs the
# reverse-from-end walk on the DFA (`<PREFIX>_DFA_SCAN "rev-end"`); the axes
# sweep runs the same cells under `-fno-rev-end`, `-fno-anchored-dfa` (the tie
# relocates instead of running the anchored machine) and `--engine=vm`. Family G
# (stage 2's captures net) carries groups: a VM hybrid whose inlined prefilter
# walks, its `g` lines the oracle's group spans.
#
# FAMILIES: T the two seeds and their ties (lazy and greedy); P startpos at 0,
# mid-match, n-1 and n; E empty matches and nullable bodies; X trailing
# lookarounds (a dead seed, X1); M mixed pins; U utf8 tails; W word context
# at the start edge; D declines; S a superset hybrid; G stage 2's captures;
# B bounded widths the end window also serves.

# T: one seed: digits cannot take the final newline (no tie code)
# pcre2-only
pattern \d+$
features classes
m "abc123" 3 6
m "abc123\n" 3 6
n "123\n\n"
n "12a"
n ""
n "\n"
m "7" 0 1

# T: a TIE: whitespace can end at n or at n-1, greedy prefers n
# pcre2-only
pattern \s+$
features classes
m "a  " 1 3
m "a  \n" 1 4
m "a \n" 1 3
m "\n" 0 1
m " \n" 0 2
m "a\n\n" 1 3
m "  \n\n" 0 4
n "a"

# T: the LAZY tie: the anchored run picks n-1 where both ends reach the start
# pcre2-only
pattern \s+?$
features classes
m "a  " 1 3
m "a  \n" 1 3
m " \n" 0 1
m "\n" 0 1
m "  \n" 0 2
n "x"

# T: nullable greedy tie: (0,2) on a space then newline
# pcre2-only
pattern \s*$
features classes
m " \n" 0 2
m "\n" 0 1
m "a \n" 1 3
m "ab" 2 2
m "a\n\n" 1 3

# T: nullable lazy tie: (0,1) on a space then newline
# pcre2-only
pattern \s*?$
features classes
m " \n" 0 1
m "\n" 0 0
m "a \n" 1 2
m "ab" 2 2
m "a\n\n" 1 2

# T: a literal tail, no tie possible
# pcre2-only
pattern [a-z]+\.txt$
features classes
m "file.txt" 0 8
m "file.txt\n" 0 8
n "a.txt.bak"
m "dir/x.txt" 4 9
n ".txt"
n "file.dat\n"

# T: `\z`: one seed only
# pcre2-only
pattern a\z
features assertions
m "a" 0 1
m "ba" 1 2
n "a\n"
n "aa\n"
n ""

# T: `\Z`: both seeds, no tie (a cannot be a newline)
# pcre2-only
pattern a\Z
features assertions
m "a" 0 1
m "a\n" 0 1
n "a\n\n"
m "ba\n" 1 2
n "\n"

# T: a class holding the newline: a tie at every subject ending in it
# pcre2-only
pattern [a\n]+$
features classes
m "aa\n" 0 3
m "a\n\n" 0 3
m "\n" 0 1
m "a" 0 1
m "b\n" 1 2

# T: alternation priority between the ends (shorter arm first)
# pcre2-only
pattern (?:a|a\n)$
m "a\n" 0 1
m "a" 0 1
m "ba\n" 1 2

# T: alternation priority between the ends (longer arm first)
# pcre2-only
pattern (?:a\n|a)$
m "a\n" 0 2
m "a" 0 1
m "ba\n" 1 3

# P: startpos at 0, mid-match, n-1 and n
# pcre2-only
pattern \w+$
features classes
m "ab cd" 3 5
ms 1 "ab cd" 3 5
ms 3 "ab cd" 3 5
ms 4 "ab cd" 4 5
ns 5 "ab cd"
ms 4 "ab cd\n" 4 5
ns 5 "ab cd\n"
ns 6 "ab cd\n"

# P: an empty match at n and at n-1 from a startpos there
# pcre2-only
pattern \s*$
features classes
m "ab\n" 2 3
ms 2 "ab\n" 2 3
ms 3 "ab\n" 3 3
ms 1 "ab" 2 2
ms 2 "ab" 2 2

# P: a seed below the startpos is skipped
# pcre2-only
pattern b\z
features assertions
m "ab" 1 2
ms 1 "ab" 1 2
ns 2 "ab"
ms 2 "abb" 2 3
ns 3 "abb"

# P: tie shapes from inside the match
# pcre2-only
pattern [^\n]*\n?$
features classes
m "ab\n" 0 3
ms 1 "ab\n" 1 3
ms 2 "ab\n" 2 3
ms 3 "ab\n" 3 3
ms 3 "ab\n\n" 3 4
ms 4 "ab\n\n" 4 4

# E: nullable: (2,2) at the end of 'bb'; (0,2) on 'aa\n' from seed n-1
# pcre2-only
pattern a*$
m "bb" 2 2
m "aa\n" 0 2
m "aa" 0 2
m "" 0 0
m "\n" 0 0
m "ba\n\n" 3 3

# E: the empty pattern pinned at the end
# pcre2-only
pattern $
m "" 0 0
m "a" 1 1
m "a\n" 1 1
m "\n\n" 1 1

# E: the empty pattern pinned at n
# pcre2-only
pattern \z
features assertions
m "" 0 0
m "a" 1 1
m "a\n" 2 2

# E: an optional body: the empty end match when it cannot
# pcre2-only
pattern (?:ab)?$
m "ab" 0 2
m "xab\n" 1 3
m "x" 1 1
m "abab\n" 2 4

# X: the seed at n reads no byte: dead, skipped
# pcre2-only
pattern \d+$(?=\n)
features classes,lookaround
m "12\n" 0 2
n "12"
n "12\n\n"
m "a1\n" 1 2

# X: a negative lookahead after the end
# pcre2-only
pattern \d$(?!\n)
features classes,lookaround
m "1" 0 1
n "1\n"
m "12" 1 2
n "1\n\n"

# X: `\Z` then a newline lookahead
# pcre2-only
pattern a\Z(?=\n)
features assertions,lookaround
m "a\n" 0 1
n "a"
m "ba\n" 1 2

# X: a trailing word boundary is zero-width
# pcre2-only
pattern a$\b
features assertions
m "a" 0 1
m "a\n" 0 1
m "aa" 1 2
n "ba "
n "a\n\n"

# M: a `$` branch and a `\z` branch: both seeds, the views reject `\z` at n-1
# pcre2-only
pattern \d+$|\w+\z
features assertions,classes
m "ab12" 0 4
m "ab12\n" 2 4
n "ab\n"
m "ab" 0 2
n "x\n"

# M: a tie-capable mix
# pcre2-only
pattern \s*$|x\z
features assertions,classes
m " \n" 0 2
m "x" 0 1
m "x\n" 1 2
m " x" 1 2

# U: a multi-byte tail; offsets are bytes
# pcre2-only
pattern é+$
encoding utf8
m "a\xc3\xa9\xc3\xa9" 1 5
m "a\xc3\xa9\xc3\xa9\n" 1 5
m "\xc3\xa9" 0 2
n "\xc3\xa9e"

# U: a utf8 tie
# pcre2-only
pattern \s+?$
encoding utf8
features classes
m "\xc3\xa9 \n" 2 3
m " \n" 0 1
n "\xc3\xa9"

# U: one character before the end, after an ASCII and a multi-byte prefix
# pcre2-only
pattern .$
encoding utf8
m "a\xc3\xa9" 1 3
m "a\xc3\xa9\n" 1 3
m "\xc3\xa9\n" 0 2
m "ab\n" 1 2

# W: a leading boundary reads the byte before the start
# pcre2-only
pattern \bab$
features assertions
m "ab" 0 2
n "xab"
m "x ab" 2 4
m "ab\n" 0 2
ms 1 "x ab" 2 4
ms 2 "x ab" 2 4

# W: a non-boundary at the start
# pcre2-only
pattern \Bb$
features assertions
m "ab" 1 2
n "b"
n "a b\n"
ms 1 "ab" 1 2

# D: an optional end-anchored group pins nothing (rmin == 0): the empty match at 0
# pcre2-only
pattern (?:a$)?
m "b" 0 0
m "ab" 0 0
m "a" 0 1
m "a\n" 0 1
m "" 0 0

# D: the same with a trailing zero-width item
# pcre2-only
pattern (?:a$)?\b
features assertions
m "b" 0 0
m "a" 0 1
m " a" 1 2

# D: a multiline `$` holds before every newline: not end-pinned
# pcre2-only
pattern (?m)a$
features assertions,modifiers
m "a\nb" 0 1
m "ba\nc\n" 1 2
m "b\na" 2 3
m "a" 0 1

# D: `\G` anywhere declines (it reads the startpos)
# pcre2-only
pattern \Ga$|b$
features assertions
n "xa"
ms 1 "xa" 1 2
m "ab" 1 2
ms 1 "ab" 1 2
m "a" 0 1

# S: an erased lookaround makes the prefilter a superset; the VM decides
# pcre2-only
pattern \w{1,2}(?:(?=)|)$
features classes,lookaround
m "ab" 0 2
m "abc" 1 3
m "abc\n" 1 3
m "a b\n" 2 3
n " "

# G: digits in a group: the hybrid's inlined walk, the VM places the group
# pcre2-only
pattern (\d+)$
features classes
m "abc123" 3 6
g 1 3 6
m "abc123\n" 3 6
g 1 3 6
n "12a"
n "\n"
m "7" 0 1
g 1 0 1
ms 3 "ab12" 3 4
g 1 3 4

# G: a run that cannot take the final newline
# pcre2-only
pattern (a+)$
m "baa" 1 3
g 1 1 3
m "baa\n" 1 3
g 1 1 3
n "aa\n\n"
n "b"

# G: `\K` moves the reported start; the walk's start bounds the attempt
# pcre2-only
pattern a\Kb$
features assertions
m "ab" 1 2
m "xab\n" 2 3
m "abab" 3 4
n "b"

# G: the unclamped tie: the group can take the final newline
# pcre2-only
pattern ([^c]{1,3})$
features classes
m "ab\n" 0 3
g 1 0 3
m "a\n" 0 2
g 1 0 2
m "\n" 0 1
g 1 0 1
m "abcd\n" 3 5
g 1 3 5
n "c"

# G: a clamped tie (count-collapsed body): greedy
# pcre2-only
pattern (\s+){2}$
features classes
m "a  \n" 1 4
g 1 3 4
m "a \n" 1 3
g 1 2 3
m "  " 0 2
g 1 1 2
m " \n\n" 0 3
g 1 2 3
n "a"

# G: a clamped tie with the pin inside the repeat
# pcre2-only
pattern (\s$){1,3}
features classes
m " \n" 0 2
g 1 1 2
m " " 0 1
g 1 0 1
m "a \n" 1 3
g 1 2 3
m "\n" 0 1
g 1 0 1

# G: the LAZY clamped tie (r2 E3's witness)
# pcre2-only
pattern (\s+?){2}$
features classes
m "a  \n" 1 3
g 1 2 3
m " \n" 0 2
g 1 1 2
m "a   " 1 4
g 1 2 4
m "  \n\n" 0 3
g 1 1 3

# G: the superset witness: an erased lookaround, the walk's start is a bound
# pcre2-only
pattern (\w{1,2})(?:(?=)|)$
features classes,lookaround
m "abc" 1 3
g 1 1 3
m "abc\n" 1 3
g 1 1 3
m "a b\n" 2 3
g 1 2 3
n " "

# B: a fixed literal tail
# pcre2-only
pattern abc$
m "xxabc" 2 5
m "abc\n" 0 3
m "abcabc" 3 6
n "ab"

# B: a bounded class run
# pcre2-only
pattern [a-z]{2,4}$
features classes
m "abcdef" 2 6
m "ab\n" 0 2
n "a"
m "a bc\n" 2 4

# B: bounded with an optional tail
# pcre2-only
pattern x[ab]?\z
features assertions,classes
m "xa" 0 2
m "x" 0 1
n "xab"
n "xb\n"
