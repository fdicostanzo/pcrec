ns 2 "ab_cd ef"
ns 3 "ab_cd ef"
ns 4 "ab_cd ef"
ns 5 "ab_cd ef"
ns 6 "ab_cd ef"
ns 7 "ab_cd ef"
ns 8 "ab_cd ef"

# THE REVERSE TERMINATION POPULATION (§3.8.3.1). `\Bfoo` on
# "xfoo" at startpos 1 is (1,4). Blind, the reverse walk
# reaches pp == startpos, assumes start-of-subject, fails
# `\B`, and returns 0 -- a LOST MATCH that this wave's own
# forward fix is what makes reachable.
