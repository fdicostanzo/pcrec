# tests/assertions/gate.rxt — the D47.5 POSSESSIFICATION GATE, from the
# assertions side ([M6.2] wave A; assertions_design.md §8; D62).
#
# WHAT THIS FILE GUARDS. src/opt/possessify.c exempts `$` from the rule that
# a zero-width assertion in a quantifier's FOLLOW widens FOLLOW to all bytes
# (i.e. declines to possessify). The exemption rests on an upward-closure
# argument — `$` holds only at the top one or two positions of the subject
# and a retreat moves strictly LEFT — and it COLLAPSES PER LINE under `(?m)`,
# which is why D47.5 rules the gate a live check rather than a comment.
#
# Wave A moved that check from `cx->mods.multiline` (the parser's
# END-OF-PATTERN option state, read once after the parse) to `Ast.multiline`
# (resolved at the `$` itself). `(?m)` is still refused, so the flag is
# constant-false today and the move is provably behaviour-preserving — which
# is exactly why it lands NOW and could not be proved later. The cells below
# are the behaviour that must not move.
#
# TWO THINGS THIS FILE CANNOT SEE, both stated rather than implied:
#
#  - It cannot see WHETHER a quantifier was possessified. A possessified
#    quantifier and a backtracking one match identically by construction —
#    that is the claim — so these cells stay green either way. The check that
#    can see it is the artifact's own `<PREFIX>_VM_STRATS` stamp, asserted in
#    tests/assertions/run_assertions_tests.sh (`\z` follow -> POSSESSIVE,
#    `\A` follow -> BACKTRACKING, a live failing direction on the same axis).
#  - It cannot see the SCOPED-`(?m)` miscompile at all, because `(?m)` does
#    not compile yet. D62's controls 1 and 2 — the widened scoped test cells
#    and the permanent flag-reader sabotage — belong to wave C, where the
#    flag can actually be true and those rows can actually go red. Writing
#    them now would be a check with no failing direction, which is this
#    project's recorded check-design failure mode.
#
# `\Z` blocks carry `# pcre2-only` for the reason absolute.rxt's header
# gives; every expectation here comes from libpcre2 10.46.


# ======================================================================
# THE EXEMPTION FIRING, non-multiline — the shapes eng_brep_design.md §2.5
# measures safe at 0 diverging cells, and the ones a regression that
# disabled the exemption wholesale would leave green (which is why the
# STRATS stamp check exists beside them).
# ======================================================================

pattern a{0,4}$
features assertions
m "" 0 0
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
m "ab" 2 2
m "abc" 3 3
m "a\n" 0 1
m "aa\n" 0 2
m "aaa\n" 0 3
m "\nc" 2 2
m "a\nc" 3 3
m "b" 1 1
m "ba" 1 2
m "c" 1 1
m "ac" 2 2
m "aac" 3 3
m "zaa" 1 3
m "zaaa\n" 1 4

pattern [^c]{1,3}$
features assertions
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
m "ab" 0 2
n "abc"
m "a\n" 0 2
m "aa\n" 0 3
m "aaa\n" 0 3
n "\nc"
n "a\nc"
m "b" 0 1
m "ba" 0 2
n "c"
n "ac"
n "aac"
m "zaa" 0 3
m "zaaa\n" 1 4

pattern a{1,3}?$
features assertions
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
n "ab"
n "abc"
m "a\n" 0 1
m "aa\n" 0 2
m "aaa\n" 0 3
n "\nc"
n "a\nc"
n "b"
m "ba" 1 2
n "c"
n "ac"
n "aac"
m "zaa" 1 3
m "zaaa\n" 1 4

pattern a{0,4}c$
features assertions
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "ab"
m "abc" 2 3
n "a\n"
n "aa\n"
n "aaa\n"
m "\nc" 1 2
m "a\nc" 2 3
n "b"
n "ba"
m "c" 0 1
m "ac" 0 2
m "aac" 0 3
n "zaa"
n "zaaa\n"

pattern za{0,4}$
features assertions
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "ab"
n "abc"
n "a\n"
n "aa\n"
n "aaa\n"
n "\nc"
n "a\nc"
n "b"
n "ba"
n "c"
n "ac"
n "aac"
m "zaa" 0 3
m "zaaa\n" 0 4


# ======================================================================
# THE SAME SHAPES WITH `\z` IN THE FOLLOW — the A_END arm added by wave A.
# `\z`'s satisfying set is the SINGLETON {n}, so the upward-closure
# argument is strictly sharper than `$`'s (which also holds at n-1 before
# a final newline) and needs no gate at all: no option makes `\z` true
# anywhere else. If the exemption were wrong here, a retreat would be the
# only route to the match and these cells would lose it.
# ======================================================================

pattern a{0,4}\z
features assertions
m "" 0 0
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
m "ab" 2 2
m "abc" 3 3
m "a\n" 2 2
m "aa\n" 3 3
m "aaa\n" 4 4
m "\nc" 2 2
m "a\nc" 3 3
m "b" 1 1
m "ba" 1 2
m "c" 1 1
m "ac" 2 2
m "aac" 3 3
m "zaa" 1 3
m "zaaa\n" 5 5

pattern [^c]{1,3}\z
features assertions
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
m "ab" 0 2
n "abc"
m "a\n" 0 2
m "aa\n" 0 3
m "aaa\n" 1 4
n "\nc"
n "a\nc"
m "b" 0 1
m "ba" 0 2
n "c"
n "ac"
n "aac"
m "zaa" 0 3
m "zaaa\n" 2 5

pattern a{1,3}?\z
features assertions
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
n "ab"
n "abc"
n "a\n"
n "aa\n"
n "aaa\n"
n "\nc"
n "a\nc"
n "b"
m "ba" 1 2
n "c"
n "ac"
n "aac"
m "zaa" 1 3
n "zaaa\n"

pattern a{0,4}c\z
features assertions
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "ab"
m "abc" 2 3
n "a\n"
n "aa\n"
n "aaa\n"
m "\nc" 1 2
m "a\nc" 2 3
n "b"
n "ba"
m "c" 0 1
m "ac" 0 2
m "aac" 0 3
n "zaa"
n "zaaa\n"

pattern za{0,4}\z
features assertions
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "ab"
n "abc"
n "a\n"
n "aa\n"
n "aaa\n"
n "\nc"
n "a\nc"
n "b"
n "ba"
n "c"
n "ac"
n "aac"
m "zaa" 0 3
n "zaaa\n"


# ======================================================================
# AND WITH `\Z` — which is A_EOL, the same node `$` builds, so these must
# answer exactly as the `$` family above does on every subject with no
# trailing newline, and differently from the `\z` family on every subject
# with one. Both halves are in the subject set on purpose.
# ======================================================================

# pcre2-only
pattern a{0,4}\Z
features assertions
m "" 0 0
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
m "ab" 2 2
m "abc" 3 3
m "a\n" 0 1
m "aa\n" 0 2
m "aaa\n" 0 3
m "\nc" 2 2
m "a\nc" 3 3
m "b" 1 1
m "ba" 1 2
m "c" 1 1
m "ac" 2 2
m "aac" 3 3
m "zaa" 1 3
m "zaaa\n" 1 4

# pcre2-only
pattern [^c]{1,3}\Z
features assertions
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
m "ab" 0 2
n "abc"
m "a\n" 0 2
m "aa\n" 0 3
m "aaa\n" 0 3
n "\nc"
n "a\nc"
m "b" 0 1
m "ba" 0 2
n "c"
n "ac"
n "aac"
m "zaa" 0 3
m "zaaa\n" 1 4

# pcre2-only
pattern a{0,4}c\Z
features assertions
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "ab"
m "abc" 2 3
n "a\n"
n "aa\n"
n "aaa\n"
m "\nc" 1 2
m "a\nc" 2 3
n "b"
n "ba"
m "c" 0 1
m "ac" 0 2
m "aac" 0 3
n "zaa"
n "zaaa\n"


# ======================================================================
# THE FAILING DIRECTION, on the same instrument. `^`/`\A` is DOWNWARD-
# closed where `$` is upward-closed — a retreat CAN reach offset 0 from a
# position that is not offset 0 — so the assertion-in-follow rule must
# DECLINE there. Sabotage S49 is the failing-direction control for the
# `^` spelling; these cells are `\A`'s, which is the same node.
# ======================================================================

pattern a{0,4}\A
features assertions
m "" 0 0
m "a" 0 0
m "aa" 0 0
m "aaa" 0 0
m "aaaa" 0 0
m "ab" 0 0
m "abc" 0 0
m "a\n" 0 0
m "aa\n" 0 0
m "aaa\n" 0 0
m "\nc" 0 0
m "a\nc" 0 0
m "b" 0 0
m "ba" 0 0
m "c" 0 0
m "ac" 0 0
m "aac" 0 0
m "zaa" 0 0
m "zaaa\n" 0 0

pattern \Aa{0,4}\z
features assertions
m "" 0 0
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
n "ab"
n "abc"
n "a\n"
n "aa\n"
n "aaa\n"
n "\nc"
n "a\nc"
n "b"
n "ba"
n "c"
n "ac"
n "aac"
n "zaa"
n "zaaa\n"

pattern \Aa{0,4}$
features assertions
m "" 0 0
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
n "ab"
n "abc"
m "a\n" 0 1
m "aa\n" 0 2
m "aaa\n" 0 3
n "\nc"
n "a\nc"
n "b"
n "ba"
n "c"
n "ac"
n "aac"
n "zaa"
n "zaaa\n"

