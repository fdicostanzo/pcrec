m "a\n\n" 0 3
m "\n\n" 0 2
m "ab\n" 0 3
m "a\nb" 0 3
m "ac\n" 0 1
m "\nac" 0 2
m "abc" 0 2
ns 1 "a"
ns 1 "\n"
ns 1 "a\n"
ns 2 "a\n"
ms 1 "\na" 1 2
ns 2 "\na"
ms 1 "a\n\n" 2 3
ms 2 "a\n\n" 2 3
ns 3 "a\n\n"
ms 1 "\n\n" 1 2
ns 2 "\n\n"
ns 1 "ab\n"
ns 2 "ab\n"
ns 3 "ab\n"
ms 1 "a\nb" 2 3
ms 2 "a\nb" 2 3
ns 3 "a\nb"
ns 1 "ac\n"
ns 2 "ac\n"
ns 3 "ac\n"
