# ======================================================================
# 3. `(?m)$` WITH A LIVE QUANTIFIER — the population §3.6.1 names as the
# one that can actually break the scan-avoidance cure, because the accept
# bit genuinely VARIES inside a run a skip set would pass. A `\b` cannot
# reach that (R30 E5); these can.
# ======================================================================

pattern (?m)[^c]*$
features assertions,modifiers
m "" 0 0
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
m "ab" 0 2
m "abc" 3 3
m "a\n" 0 2
m "aa\n" 0 3
m "aaa\n" 0 4
m "\nc" 0 0
m "a\nc" 0 1
m "b" 0 1
m "ba" 0 2
m "c" 1 1
m "ac" 2 2
m "aac" 3 3
m "zaa" 0 3
m "zaaa\n" 0 5
m "\na" 0 2
m "a\nb" 0 3
m "ab\nc" 0 2
m "\n" 0 1
m "\n\n" 0 2
m "\n\nc" 0 1
m "a\nb\nc" 0 3
m "a\nb\nc\nd" 0 3
m "\nb\nc" 0 2
m "" 0 0
m "a" 0 1
m "\n" 0 1
m "a\n" 0 2
m "\na" 0 2
m "ab" 0 2
m "a\nb" 0 3
m "ab\ncd" 0 2
m "a\n\nb" 0 4
m "\n\n" 0 2
m "abc\ndef\nghi" 3 11
m "a\nc" 0 1
m "\nc" 0 0
m "aaa\nbbb" 0 7
m "x\ny\nz" 0 5
m "b\na" 0 3
m "\nab\n" 0 4

pattern (?m)[^c]+$
features assertions,modifiers
