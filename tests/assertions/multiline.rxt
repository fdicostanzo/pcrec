ns 2 "\na"
ns 1 "a\n\n"
ns 2 "a\n\n"
ns 3 "a\n\n"
ns 1 "\n\n"
ns 2 "\n\n"
ns 1 "ab\n"
ns 2 "ab\n"
ns 3 "ab\n"
ms 1 "a\nb" 2 3
ms 2 "a\nb" 2 3
ns 3 "a\nb"
ns 1 "ac\n"
ns 2 "ac\n"
ns 3 "ac\n"
ms 1 "\nac" 1 2
