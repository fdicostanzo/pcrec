# ======================================================================
# 5. SCOPED `(?m)` — the cells the pre-cure code got WRONG (§8.1.1's two
# measured miscompile shapes) and the ones D47.5's own wording does not
# ask for. `(?m:...)` is python-verifiable; the rest are not.
#
# ONE MID-PATTERN SHAPE IS ABSENT, and the omission is recorded rather
# than silent: `a(?m)^b` can NEVER match — a `^` after a consumed byte
# makes the whole DFA one dead state — and pcrec answers it correctly,
# but the C it emits for that shape does not survive `-Wall -Wextra
# -Werror`: gcc inlines the always-returns-0 `<prefix>_search` into
# `<prefix>_match` and then reports the wrapper's `caps` array as
# maybe-uninitialized, though the `found != 1` short-circuit means it is
# never read. That is KNOWN ISSUE K28, filed this session, and it is NOT
# this wave's defect — the base-tier `^a^b` reproduces it with no module
# enabled at all, and tests/assertions/wordb.rxt records the same
# exclusion for `^\Bfoo`/`^\Bo`/`^ab`. The LIVE equivalents `a(?m)$`
# and `a(?m)^b|c` are here in its place, so the mid-pattern-scope
# coverage this block exists for is not lost; the absent one goes back
# the day the wrapper's warning is fixed.
# ======================================================================

pattern (?m:[^c]{1,3}$)
features assertions,modifiers
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
m "ab" 0 2
n "abc"
m "a\n" 0 2
m "aa\n" 0 3
m "aaa\n" 0 3
n "\nc"
m "a\nc" 0 1
m "b" 0 1
m "ba" 0 2
n "c"
n "ac"
n "aac"
m "zaa" 0 3
m "zaaa\n" 1 4
m "\na" 0 2
m "a\nb" 0 3
m "ab\nc" 0 2
m "\n" 0 1
m "\n\n" 0 2
m "\n\nc" 0 1
m "a\nb\nc" 0 3
m "a\nb\nc\nd" 0 3
m "\nb\nc" 0 2
n ""
m "a" 0 1
m "\n" 0 1
m "a\n" 0 2
m "\na" 0 2
m "ab" 0 2
m "a\nb" 0 3
m "ab\ncd" 0 2
m "a\n\nb" 0 2
m "\n\n" 0 2
m "abc\ndef\nghi" 4 7
m "a\nc" 0 1
n "\nc"
m "aaa\nbbb" 0 3
m "x\ny\nz" 0 3
m "b\na" 0 3
m "\nab\n" 0 3

