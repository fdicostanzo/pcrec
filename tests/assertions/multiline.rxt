# ======================================================================
# 2b. THE TRAILING-NEWLINE ASYMMETRY, at EVERY startpos.
#
# PCRE2's multiline `^` "does not match after a newline that ends the
# string" -- so `(?m)^` on a subject ending in a line break holds at
# offset 0 and NOT at the end, while `(?m)$` on the same subject holds
# at BOTH the position before that break and at the end. `(?m)^` is NOT
# the mirror of `(?m)$`, and assertions_design.md §3.7 and §9.3 both
# state it as if it were.
#
# THE CELLS BELOW SWEEP EVERY STARTPOS, and that is the whole point:
# from startpos 0 an earlier match masks the trailing position on almost
# every subject, which is how this survived a first corpus that only
# searched from 0. tests/assertions/run_mline_diff.sh found it at
# startpos 1. `(?m)^$` is the one shape that shows it from startpos 0
# too, because no earlier position satisfies both halves.
#
# python3 `re` DISAGREES WITH PCRE2 HERE and reports the trailing match,
# so every `(?m)`-with-`^` block in this file is `# pcre2-only` — the
# same WHOLESALE rule the `\Z` blocks follow, for a second reason
# (docs/dev/upstream_issues.md U11b).
# ======================================================================

# pcre2-only
pattern (?m)^
features assertions,modifiers
m "" 0 0
m "a" 0 0
m "\n" 0 0
m "a\n" 0 0
m "\na" 0 0
m "a\n\n" 0 0
m "\n\n" 0 0
m "ab\n" 0 0
m "a\nb" 0 0
m "ac\n" 0 0
m "\nac" 0 0
m "abc" 0 0
ns 1 "a"
ns 1 "\n"
ns 1 "a\n"
ns 2 "a\n"
ms 1 "\na" 1 1
ns 2 "\na"
ms 1 "a\n\n" 2 2
ms 2 "a\n\n" 2 2
ns 3 "a\n\n"
ms 1 "\n\n" 1 1
ns 2 "\n\n"
ns 1 "ab\n"
ns 2 "ab\n"
ns 3 "ab\n"
ms 1 "a\nb" 2 2
ms 2 "a\nb" 2 2
ns 3 "a\nb"
ns 1 "ac\n"
ns 2 "ac\n"
ns 3 "ac\n"
ms 1 "\nac" 1 1
ns 2 "\nac"
ns 3 "\nac"
ns 1 "abc"
ns 2 "abc"
ns 3 "abc"

# pcre2-only
pattern (?m)^$
features assertions,modifiers
m "" 0 0
n "a"
m "\n" 0 0
n "a\n"
m "\na" 0 0
m "a\n\n" 2 2
m "\n\n" 0 0
n "ab\n"
n "a\nb"
n "ac\n"
m "\nac" 0 0
n "abc"
ns 1 "a"
ns 1 "\n"
ns 1 "a\n"
ns 2 "a\n"
ns 1 "\na"
ns 2 "\na"
ms 1 "a\n\n" 2 2
ms 2 "a\n\n" 2 2
ns 3 "a\n\n"
ms 1 "\n\n" 1 1
ns 2 "\n\n"
ns 1 "ab\n"
ns 2 "ab\n"
ns 3 "ab\n"
ns 1 "a\nb"
ns 2 "a\nb"
ns 3 "a\nb"
ns 1 "ac\n"
ns 2 "ac\n"
ns 3 "ac\n"
ns 1 "\nac"
ns 2 "\nac"
ns 3 "\nac"
ns 1 "abc"
ns 2 "abc"
ns 3 "abc"

