# ======================================================================
# 7. `\A`, `\Z`, `\z` ARE NOT AFFECTED BY `(?m)` — PCRE2's rule, and the
# failing direction for mod_assertions.c's pinned-false flag. If any of
# those three ever started copying the scoped state, every cell here that
# differs from its `^`/`$` twin above goes red.
# ======================================================================

pattern (?m)\Aa
features assertions,modifiers
n ""
m "a" 0 1
n "\n"
m "a\n" 0 1
n "\na"
m "ab" 0 1
m "a\nb" 0 1
m "ab\ncd" 0 1
m "a\n\nb" 0 1
n "\n\n"
m "abc\ndef\nghi" 0 1
m "a\nc" 0 1
n "\nc"
m "aaa\nbbb" 0 1
n "x\ny\nz"
n "b\na"
n "\nab\n"
n ""
m "a" 0 1
m "aa" 0 1
m "aaa" 0 1
m "aaaa" 0 1
m "ab" 0 1
m "abc" 0 1
m "a\n" 0 1
m "aa\n" 0 1
m "aaa\n" 0 1
n "\nc"
m "a\nc" 0 1
n "b"
n "ba"
n "c"
m "ac" 0 1
m "aac" 0 1
n "zaa"
n "zaaa\n"
n "\na"
m "a\nb" 0 1
m "ab\nc" 0 1
n "\n"
n "\n\n"
n "\n\nc"
m "a\nb\nc" 0 1
m "a\nb\nc\nd" 0 1
n "\nb\nc"

