# ======================================================================
# 4. THE D47.5 GATE CELLS (D62 control 1; assertions_design.md §8.7).
#
# `src/opt/possessify.c` exempts `$` from the follow-set widening on an
# upward-closure argument that COLLAPSES PER LINE under `(?m)`. The
# recommended guard cell is `(?m)[^c]{1,3}$` on "a\nc" expecting (0,1) —
# the strongest of §8.7's four because a possessified compile produces NO
# MATCH AT ALL, so it cannot pass by accident on an off-by-one.
#
# The non-multiline twin lives in gate.rxt, where the exemption must keep
# firing; a regression that disabled the exemption wholesale would leave
# these green and that one red, which is why both directions exist.
# ======================================================================

pattern (?m)[^c]{1,3}$
features assertions,modifiers
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 1 4
m "ab" 0 2
n "abc"
m "a\n" 0 2
m "aa\n" 0 3
m "aaa\n" 0 3
n "\nc"
m "a\nc" 0 1
m "b" 0 1
m "ba" 0 2
n "c"
n "ac"
n "aac"
m "zaa" 0 3
m "zaaa\n" 1 4
m "\na" 0 2
m "a\nb" 0 3
m "ab\nc" 0 2
m "\n" 0 1
m "\n\n" 0 2
m "\n\nc" 0 1
m "a\nb\nc" 0 3
m "a\nb\nc\nd" 0 3
m "\nb\nc" 0 2

