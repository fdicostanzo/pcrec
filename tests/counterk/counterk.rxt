g 1 1 1
m "aabbc" 0 3
g 1 2 2
m "abbc" 0 2
g 1 1 1
m "baac" 0 1
g 1 0 0
n "aaaaaaaaaaaac"
n "aaaaaaaaaaaaaaaaac"
m "ababababababababc" 0 2
g 1 1 1
n "q"
n "aq"
m "abq" 0 2
g 1 1 1
n "za"
m "zabc" 1 3
g 1 2 2

