# sr_interactions.rxt
# \K, duplicate names, lookarounds, atomic groups, and \G/\A/\z against
# a non-zero startpos (extract 3.4)
#
# [DD-14.D27] blinded corpus for module `recursion`. GENERATED by
# d27/sr_gen.py -- do not hand-edit; edit the spec and regenerate.
# Every m/n span and every g line is libpcre2 10.46's answer through
# docs/design/subroutines_measurements/probes/sr_oracle.py (D26: PCRE2
# is the source of truth). Blocks marked `# perl-diverges` are ones
# where perl 5.40.1 answers differently; perl's answer is RECORDED in
# d27/PERL_DIVERGENCES.md and is never the expectation. Blocks carrying
# a `PARKED` stanza had one or more cells MOVED to tests/known_fail/ --
# a confirmed pcrec defect, not a corpus gap; see the stanza's
# citation.

# extract 3.4(b): \K inside a CALLED body MOVES the reported match
# start, and the last one executed on the successful path wins. \K is a
# PATH fact, not capture state, and unlike every capture it is NOT
# undone by the return -- the reported start lands at 3, inside the
# call's own text.
pattern ^(a\Kb)(?1)$
features recursion,assertions
m "abab" 3 4
g 1 0 2
n "ab"

# extract 3.4(b) row 2: the \K fires in a body that has NO lexical run
# at all, and still moves the start.
pattern ^(?(DEFINE)(?<g>a\Kb))(?&g)$
features recursion,named-groups,assertions
m "ab" 1 2
g 1 -1 -1
n "a"

# extract 3.4(b) row 3: \K AT DEPTH. The last \K executed on the
# successful path wins, so the start is 3 and not 1 -- a lowering that
# restored TOO MUCH on return (undoing \K along with the captures)
# reports 1 here.
pattern ^(a(?1)?\Kb)$
features recursion,assertions
m "aabb" 3 4
g 1 0 4
m "ab" 1 2
g 1 0 2

# MEASURED, and it REFUTES the reading the extract's own 3.4(b) prose
# invites: PCRE2's error-199 rule is about the LEXICAL nesting of the
# \K, and the \K here is lexically inside a DEFINE, not inside the
# lookahead -- so the pattern COMPILES, the call runs the \K from
# inside the lookahead, and the reported start MOVES to 1 even though
# the lookahead itself is zero-width and rewinds. The extract asked for
# this to be measured rather than assumed; this is the measurement.
pattern ^(?(DEFINE)(?<g>a\Kb))(?=(?&g))ab$
features recursion,named-groups,assertions,lookaround
m "ab" 1 2
g 1 -1 -1
n "ba"

# the same refutation through a LOOKBEHIND: a \K reached by a call from
# inside a lookbehind compiles and moves the reported start out of the
# assertion.
pattern ^(?(DEFINE)(?<g>a\Kb))ab(?<=(?&g))$
features recursion,named-groups,assertions,lookaround
m "ab" 1 2
g 1 -1 -1

# …and through a NUMBERED call from a {0}-parked body, so the fact is
# not an artefact of DEFINE or of by-name resolution.
# perl-diverges
pattern ^(?:(a\Kb)){0}(?=(?1))ab$
features recursion,assertions,lookaround
m "ab" 1 2
g 1 -1 -1

# the CONTROL for the three blocks above, and the reason they are
# surprising: written DIRECTLY inside the lookaround the same \K is
# refused (PCRE2 error 199). Refusal tested for EXISTENCE only.
pattern ^(?=a\Kb)ab$
features recursion,assertions,lookaround
perr

# the mirror: the \K is outside, the CALL is inside the lookahead.
# Ordinary, and here to keep the three refutation blocks honest.
pattern ^(?(DEFINE)(?<g>b))a\K(?=(?&g))b$
features recursion,named-groups,assertions,lookaround
m "ab" 1 2
g 1 -1 -1

# extract 3.4(c): a CALL by name to a DUPLICATED name runs the FIRST
# DECLARATION's pattern, STATICALLY, whether or not that group is set.
# 'qyx' matches, 'qyy' does not -- the exact opposite of the reference
# blocks below. Spelling (?&a).
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)(?&a)$
features recursion,named-groups,modifiers,backrefs
m "qyx" 0 3
g 1 -1 -1
g 2 1 2
n "qyy"

# extract 3.4(c): a CALL by name to a DUPLICATED name runs the FIRST
# DECLARATION's pattern, STATICALLY, whether or not that group is set.
# 'qyx' matches, 'qyy' does not -- the exact opposite of the reference
# blocks below. Spelling (?P>a).
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)(?P>a)$
features recursion,named-groups,modifiers,backrefs
m "qyx" 0 3
g 1 -1 -1
g 2 1 2
n "qyy"

# extract 3.4(c): a CALL by name to a DUPLICATED name runs the FIRST
# DECLARATION's pattern, STATICALLY, whether or not that group is set.
# 'qyx' matches, 'qyy' does not -- the exact opposite of the reference
# blocks below. Spelling \g<a>.
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)\g<a>$
features recursion,named-groups,modifiers,backrefs
m "qyx" 0 3
g 1 -1 -1
g 2 1 2
n "qyy"

# extract 3.4(c): a CALL by name to a DUPLICATED name runs the FIRST
# DECLARATION's pattern, STATICALLY, whether or not that group is set.
# 'qyx' matches, 'qyy' does not -- the exact opposite of the reference
# blocks below. Spelling \g'a'.
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)\g'a'$
features recursion,named-groups,modifiers,backrefs
m "qyx" 0 3
g 1 -1 -1
g 2 1 2
n "qyy"

# extract 3.4(c) REFERENCE half: a backreference by name reads the
# first SET member of the run, DYNAMICALLY. 'qyy' matches and 'qyx'
# does not. These two rows on the SAME pattern shape, expecting
# DIFFERENT answers, are the discriminating test -- a corpus with only
# one of the two spellings cannot catch a lowering that resolved a call
# the way it resolves a reference. Spelling \k<a>.
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)\k<a>$
features recursion,named-groups,backrefs,modifiers
n "qyx"
m "qyy" 0 3
g 1 -1 -1
g 2 1 2

# extract 3.4(c) REFERENCE half: a backreference by name reads the
# first SET member of the run, DYNAMICALLY. 'qyy' matches and 'qyx'
# does not. These two rows on the SAME pattern shape, expecting
# DIFFERENT answers, are the discriminating test -- a corpus with only
# one of the two spellings cannot catch a lowering that resolved a call
# the way it resolves a reference. Spelling (?P=a).
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)(?P=a)$
features recursion,named-groups,backrefs,modifiers
n "qyx"
m "qyy" 0 3
g 1 -1 -1
g 2 1 2

# extract 3.4(c) REFERENCE half: a backreference by name reads the
# first SET member of the run, DYNAMICALLY. 'qyy' matches and 'qyx'
# does not. These two rows on the SAME pattern shape, expecting
# DIFFERENT answers, are the discriminating test -- a corpus with only
# one of the two spellings cannot catch a lowering that resolved a call
# the way it resolves a reference. Spelling \k'a'.
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)\k'a'$
features recursion,named-groups,backrefs,modifiers
n "qyx"
m "qyy" 0 3
g 1 -1 -1
g 2 1 2

# extract 3.4(c) REFERENCE half: a backreference by name reads the
# first SET member of the run, DYNAMICALLY. 'qyy' matches and 'qyx'
# does not. These two rows on the SAME pattern shape, expecting
# DIFFERENT answers, are the discriminating test -- a corpus with only
# one of the two spellings cannot catch a lowering that resolved a call
# the way it resolves a reference. Spelling \g{a}.
pattern ^(?J)(?:(?<a>x)|q)(?<a>y)\g{a}$
features recursion,named-groups,backrefs,modifiers
n "qyx"
m "qyy" 0 3
g 1 -1 -1
g 2 1 2

# extract 3.4(c) last row: a call does NOT retry into later same-named
# members. 'xqyxz' matches, 'xqyyz' does not.
pattern ^(?J)(?<a>x)(q)(?<a>y)(?&a)z$
features recursion,named-groups,modifiers,backrefs
m "xqyxz" 0 5
g 1 0 1
g 2 1 2
g 3 2 3
n "xqyyz"

# extract 3.4(d) row 1 and the amendment's first bullet: an ACYCLIC,
# FIXED-PER-BRANCH callee composes and SHIPS. PCRE2 computes the
# callee's width THROUGH the call; pcrec's stricter lookbehind subset
# accepts this one because the callee's one branch is fixed at 2.
pattern ^(?(DEFINE)(?<g>ab))ab(?<=(?&g))$
features recursion,named-groups,lookaround
m "ab" 0 2
g 1 -1 -1
n "aab"

# the amendment's 'two-hop acyclic call chain': the lookbehind calls h,
# which calls g. The width has to be carried through TWO calls.
pattern ^(?(DEFINE)(?<g>ab))(?(DEFINE)(?<h>(?&g)))ab(?<=(?&h))$
features recursion,named-groups,lookaround
m "ab" 0 2
g 1 -1 -1
g 2 -1 -1
n "aab"

# the amendment's 'alternation of calls written at the lookbehind
# body's own top level': two branches, each a single call, each
# individually fixed-width.
pattern ^(?(DEFINE)(?<g>ab))(?(DEFINE)(?<h>cd))abcd(?<=(?&g)|(?&h))$
features recursion,named-groups,lookaround
m "abcd" 0 4
g 1 -1 -1
g 2 -1 -1
n "abc"

# the same, with the two branches at DIFFERENT fixed widths (2 and 3).
# Each top-level branch is still individually fixed, which is the rule
# the amendment names -- so this must be accepted while the
# single-branch variable-width block below is refused. The pair is the
# point; either alone would look arbitrary.
pattern ^(?(DEFINE)(?<g>ab))(?(DEFINE)(?<h>cde))abcde(?<=(?&g)|(?&h))$
features recursion,named-groups,lookaround
m "abcde" 0 5
g 1 -1 -1
g 2 -1 -1

# extract 3.4(d) row 2 / the amendment's SECOND bullet: a single call
# that is itself the lookbehind's ONE top-level branch, whose callee
# has an alternation of DIFFERENT fixed widths (1..2). PCRE2 ACCEPTS
# this and matches (0,2); pcrec REFUSES it by ruling, because from the
# lookbehind body's own point of view this is one branch of variable
# width -- the (?<=(a|bc))x shape module lookaround already refuses.
# Being reached through a call does not change that. Existence only.
# libpcre2 10.46 ACCEPTS this pattern; the refusal expected here is
# pcrec's own, by the [DD-14.LB] amendment. Recorded so a reader does
# not mistake it for a PCRE2 fact.
pattern ^(?(DEFINE)(?<g>a|ab))ab(?<=(?&g))$
features recursion,named-groups,lookaround
perr

# extract 3.4(d) row 5 / the amendment's THIRD bullet: a RECURSIVE
# callee inside a lookbehind is REFUSED ON BOTH SIDES -- PCRE2's own
# error 125, and pcrec refuses it too.
pattern ^(?(DEFINE)(?<g>a(?&g)?b))aabb(?<=(?&g))$
features recursion,named-groups,lookaround
perr

# extract 3.4(d) row 3: an UNBOUNDED callee width. Refused on both
# sides (PCRE2 error 125).
pattern ^(?(DEFINE)(?<g>a+))aa(?<=(?&g))$
features recursion,named-groups,lookaround
perr

# extract 3.4(d) row 4: a callee whose width is BOUNDED but too long
# (PCRE2 error 200). Refused on both sides, for whatever each side's
# own reason is -- existence only, never wording (D26).
pattern ^(?(DEFINE)(?<g>a{1,300}))aaaa(?<=(?&g))$
features recursion,named-groups,lookaround
perr

# the OTHER direction: a LOOKBEHIND INSIDE THE CALLEE, looking back at
# text the CALLER consumed. A call changes neither the subject nor the
# position, so the lookbehind sees the caller's 'x'.
pattern ^(?(DEFINE)(?<g>(?<=x)ab))x(?&g)$
features recursion,named-groups,lookaround
m "xab" 0 3
g 1 -1 -1
n "yab"

# extract 3.4(e): a call inside a POSITIVE lookahead behaves as the
# construct it is wrapped in -- zero-width, and it rewinds.
pattern ^(?(DEFINE)(?<g>a|ab))(?=(?&g))ab$
features recursion,named-groups,lookaround
m "ab" 0 2
g 1 -1 -1
n "ba"

# …inside a NEGATIVE lookahead.
pattern ^(?(DEFINE)(?<g>a|ab))(?!(?&g))xy$
features recursion,named-groups,lookaround
m "xy" 0 2
g 1 -1 -1

# …and the control that shows the negative lookahead really fired.
pattern ^(?(DEFINE)(?<g>a|ab))(?!(?&g))ab$
features recursion,named-groups,lookaround
n "ab"

# extract 3.4(e): inside an ATOMIC group the call's retries are
# suppressed -- the callee takes 'a', cannot give it back, and the 'b?'
# outside the wrapper has to absorb the 'b'.
pattern ^(?(DEFINE)(?<g>a|ab))(?>(?&g))b?c$
features recursion,named-groups,atomic-groups
m "abc" 0 3
g 1 -1 -1
m "ac" 0 2
g 1 -1 -1

# extract 3.4(e2): \G is a test against STARTPOS, and a call changes
# neither the subject nor startpos. At startpos 0 the 'x' blocks it; at
# startpos 1 it holds. These two cases differ ONLY in startpos -- a
# startpos-0-only corpus cannot exercise this at all.
pattern (?(DEFINE)(?<g>\Ga))(?&g)
features recursion,named-groups,assertions
n "xa"
ms 1 "xa" 1 2
g 1 -1 -1
ms 1 "xaa" 1 2
g 1 -1 -1
n "xa"

# extract 3.4(e2): \A is a test against the SUBJECT's absolute start,
# which startpos does not move. Nomatch at either startpos.
pattern (?(DEFINE)(?<g>\Aa))x?(?&g)
features recursion,named-groups,assertions
n "xa"
ns 1 "xa"

# extract 3.4(e2): \z inside a callee tests the subject's absolute end.
pattern (?(DEFINE)(?<g>a\z))x(?&g)
features recursion,named-groups,assertions
m "xa" 0 2
g 1 -1 -1
ms 1 "yxa" 1 3
g 1 -1 -1

# …and the control: with a 'b' after the call, the callee's \z can
# never be satisfied.
pattern (?(DEFINE)(?<g>a\z))x(?&g)b
features recursion,named-groups,assertions
n "xab"

# STARTPOS vs '^': the caret anchors to ABSOLUTE offset 0 regardless of
# startpos, so this call-bearing pattern cannot match from startpos 1
# even though the text there would fit.
pattern ^(a|b)(?1)$
features recursion
ns 1 "xab"
m "ab" 0 2
g 1 0 1

# the unanchored control for the block above: the same call, the same
# subject, the same startpos, and it DOES match -- so the nomatch above
# is the anchor and not the call.
pattern (a|b)(?1)
features recursion
ms 1 "xab" 1 3
g 1 1 2
m "xab" 1 3
g 1 1 2

# a RECURSIVE call from a non-zero startpos.
pattern (a(?1)?b)
features recursion
ms 1 "xaabb" 1 5
g 1 1 5
m "xaabb" 1 5
g 1 1 5

# \K through a call from a non-zero startpos -- the reported start
# moves relative to where the call actually ran, not to startpos.
pattern (?(DEFINE)(?<g>a\Kb))(?&g)
features recursion,named-groups,assertions
ms 1 "xab" 2 3
g 1 -1 -1

# \b inside a callee looks at the real neighbouring bytes, which
# startpos does not hide: at startpos 1 of 'xab' the boundary fails, at
# startpos 2 of 'x ab' it holds.
pattern (?(DEFINE)(?<g>\bab))(?&g)
features recursion,named-groups,assertions
ns 1 "xab"
ms 2 "x ab" 2 4
g 1 -1 -1

# a lookbehind BEFORE a call, exercised at two startpos values: the
# lookbehind may read text before startpos.
pattern (?<=x)(a|b)(?1)
features recursion,lookaround
ms 1 "xab" 1 3
g 1 1 2
m "xab" 1 3
g 1 1 2

