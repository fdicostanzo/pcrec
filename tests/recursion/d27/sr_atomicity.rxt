# sr_atomicity.rxt
# calls are BACKTRACKABLE, each positive cell paired with the atomic
# control that must answer the opposite way (extract 3.2)
#
# [DD-14.D27] blinded corpus for module `recursion`. GENERATED by
# d27/sr_gen.py -- do not hand-edit; edit the spec and regenerate.
# Every m/n span and every g line is libpcre2 10.46's answer through
# docs/design/subroutines_measurements/probes/sr_oracle.py (D26: PCRE2
# is the source of truth). Blocks marked `# perl-diverges` are ones
# where perl 5.40.1 answers differently; perl's answer is RECORDED in
# d27/PERL_DIVERGENCES.md and is never the expectation.

# extract 3.2 row 1: the ISOLATED backtracking cell. The retriable body
# sits where ONLY the call can reach it, so the lexical group cannot
# retry on its behalf. BACKTRACKABLE -- atomic would be nomatch.
pattern ^(?(DEFINE)(?<g>a|ab))(?&g)c$
features recursion,named-groups
m "abc" 0 3
g 1 -1 -1
m "ac" 0 2
g 1 -1 -1
n "abbc"

# ATOMIC CONTROL 1 for the row above: an atomic callee BODY. Must be
# the OPPOSITE answer on 'abc'. The contrast is the fact.
pattern ^(?(DEFINE)(?<g>(?>a|ab)))(?&g)c$
features recursion,named-groups,atomic-groups
n "abc"
m "ac" 0 2
g 1 -1 -1

# ATOMIC CONTROL 2: an atomic wrapper on the CALL SITE.
pattern ^(?(DEFINE)(?<g>a|ab))(?>(?&g))c$
features recursion,named-groups,atomic-groups
n "abc"
m "ac" 0 2
g 1 -1 -1

# ATOMIC CONTROL 3: a POSSESSIVE quantifier on the call.
pattern ^(?(DEFINE)(?<g>a|ab))(?&g)++c$
features recursion,named-groups,atomic-groups
n "abc"
m "ac" 0 2
g 1 -1 -1

# extract 3.2 row 2: the same backtracking fact WITHOUT DEFINE, in case
# DEFINE is special in the lowering.
pattern ^(?!)(?<g>a|ab)|^(?&g)c$
features recursion,named-groups,lookaround
m "abc" 0 3
g 1 -1 -1
m "ac" 0 2
g 1 -1 -1

# …and again with the {0}-parked spelling. Three spellings of one fact,
# because D71 item 4 makes two of them the same program and the third
# an exact substitute.
pattern ^(?:(?<g>a|ab)){0}(?&g)c$
features recursion,named-groups
m "abc" 0 3
g 1 -1 -1
m "ac" 0 2
g 1 -1 -1

# extract 3.2 row 3: a QUANTIFIER, not an alternation, as the callee's
# choice point -- 'a+' has to give back two characters across the
# return.
pattern ^(?(DEFINE)(?<g>a+))(?&g)ab$
features recursion,named-groups
m "aaab" 0 4
g 1 -1 -1
m "aab" 0 3
g 1 -1 -1
m "aaaab" 0 5
g 1 -1 -1
n "ab"

# ATOMIC CONTROL 4: an atomic wrapper around a GIVING-BACK callee.
# Opposite answer to the row above.
pattern ^(?(DEFINE)(?<g>a+))(?>(?&g))ab$
features recursion,named-groups,atomic-groups
n "aaab"
n "aab"

# the possessive form of control 4.
pattern ^(?(DEFINE)(?<g>a+))(?&g)++ab$
features recursion,named-groups,atomic-groups
n "aaab"

# extract 3.2 row 4: a BOUNDED repeat as the callee's choice point.
pattern ^(?(DEFINE)(?<g>a{1,3}))(?&g)aa$
features recursion,named-groups
m "aaa" 0 3
g 1 -1 -1
m "aaaa" 0 4
g 1 -1 -1
n "aa"

# …and its atomic control.
pattern ^(?(DEFINE)(?<g>a{1,3}))(?>(?&g))aa$
features recursion,named-groups,atomic-groups
n "aaa"
m "aaaaa" 0 5
g 1 -1 -1

# extract 3.2's sharpest cell: IT RETRIES ACROSS A RETURN, AT DEPTH.
# The retreat has to re-enter the INNER call after the OUTER one has
# already returned. A lowering that CUT at the return fails exactly
# here and nowhere shallower.
pattern ^(?(DEFINE)(?<g>a(?&g)?b|x|xy))(?&g)$
features recursion,named-groups
m "axyb" 0 4
g 1 -1 -1
m "axb" 0 3
g 1 -1 -1
m "aaxbb" 0 5
g 1 -1 -1
n "axyyb"

# the atomic control for the retry-across-a-return cell: with the
# callee body made atomic, the inner retry is cut off.
pattern ^(?(DEFINE)(?<g>(?>a(?&g)?b|x|xy)))(?&g)$
features recursion,named-groups,atomic-groups
n "axyb"
m "axb" 0 3
g 1 -1 -1

# extract 3.2's own WARNING CELL, kept deliberately: this is the
# OBVIOUS test for atomicity and it does NOT isolate it -- it matches
# under both hypotheses because the LEXICAL group can retry too. It is
# here so the corpus records that it was considered and is not mistaken
# for the isolated cells above.
pattern ^(a|ab)(?1)c$
features recursion
m "ababc" 0 5
g 1 0 2
m "aabc" 0 4
g 1 0 1
m "abac" 0 4
g 1 0 2

