# the RFC 5322 address-spec specimen as ordinarily written -- no calls
# at all. It is here as the CONTROL: the factored form below must agree
# with it on every subject, and neither the corpus nor the compiler
# gets to pick which one is right.
pattern (?:[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*|"(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21\x23-\x5b\x5d-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])*")@(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?|\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-z0-9-]*[a-z0-9]:(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21-\x5a\x53-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])+)\])
features recursion
m "user@example.com" 0 16
m "a.b-c@sub.domain.org" 0 20
m "\"abc\"@example.com" 0 17
m "x@[127.0.0.1]" 0 13
m "user@[1.2.3.4]" 0 14
m "a@b.co" 0 6
m "!#$%&'*+/=?^_`{|}~-@example.com" 0 31
m "first.last@a-b.example.museum" 0 29
m "x@[255.255.255.255]" 0 19
n "bad@@example.com"
n "no-at-sign"
n "user@-bad.com"
n "user@example"
n "@example.com"
n "user@"
n "x@[999.1.1.1]"
n "x@[1.2.3]"
m "a..b@example.com" 3 16
n ""

# the SAME language, hand-factored with (?:(?<name>BODY)){0} callee
# parking and (?&name) calls: four named callees, `atom` and `label`
# each called more than once, `octet` called from inside a {3}-bounded
