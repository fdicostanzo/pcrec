# extract 2.6/3.4(f): ^(?R)*$ is a DEPTH-CAPACITY give-up cell, not a
# match/nomatch guess -- PCRE2 answers rc -52 and pcrec gives up.
# Written as a gu directive precisely because guessing 'matches the
# empty string' is the plausible wrong answer.
pattern ^(?R)*$
features recursion
gu frames ""
gu frames "ab"

# extract 2.6/3.4(f): ^(?R)?$ is a DEPTH-CAPACITY give-up cell, not a
# match/nomatch guess -- PCRE2 answers rc -52 and pcrec gives up.
# Written as a gu directive precisely because guessing 'matches the
# empty string' is the plausible wrong answer.
pattern ^(?R)?$
features recursion
gu frames ""
gu frames "ab"

# extract 2.6/3.4(f): ^(?R){0,2}$ is a DEPTH-CAPACITY give-up cell, not
# a match/nomatch guess -- PCRE2 answers rc -52 and pcrec gives up.
# Written as a gu directive precisely because guessing 'matches the
# empty string' is the plausible wrong answer.
pattern ^(?R){0,2}$
features recursion
gu frames ""
gu frames "ab"

# the ceiling shape again with the callee parked in a DEFINE, so the
# recursion is reached ONLY through calls. Below the ceiling it
# matches; the gu cells check that this spelling gives up too rather
# than diverging.
pattern ^(?(DEFINE)(?<g>a(?&g)?b))(?&g)$
features recursion,named-groups
m "ab" 0 2
g 1 -1 -1
m "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaabbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" 0 200
g 1 -1 -1
gu frames ""

