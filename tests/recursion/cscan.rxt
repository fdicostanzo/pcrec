# anchored: found at its start offset
ms 1 "a(?{ x; })" 1 10
g 1 4 8
# anchored: not found from 0 when it starts later
n "a(?{ x; })"
# anchored: a later segment is not skipped to
ms 10 "a(?{ x; })(?{ y; })" 10 19
g 1 13 17
