m "(?{\n    int i, n = 0;\n    /* count the } chars */\n    for (i = 0; i < len; i++) {\n        if (s[i] == '}') { n++; }  // brace }\n        else if (s[i] == '\"') continue;\n    }\n    printf(\"n=%d }\\n\", n);\n    return n > 1'000 ? 1 : 0;\n})" 0 233
g 1 3 231
