# tests/classes/classes.rxt — module `classes` producers (MOD-0.3c).
#
# Every block carries `features classes`: these constructs REFUSE without it
# (the default empty enabled set), and that refusal stays pinned in
# tests/reject/. Blocks python re cannot express carry `# pcre2-only`; their
# expectations derive from the generated-bitmap censuses
# (tests/probes/probe_cls_bits.c, libpcre2 10.46) and, for the caseless
# posix cells, from the probe_ci_posix measurement recorded in the
# 2026-08-12 journal entry. PC-4 is the live oracle for produced SETS.
#
# THE D33 §9.3 EVIDENCE: this corpus was run against the slice-1 binary
# (which has the vocabulary but no producers) and every features-classes
# match block FAILED — the probes were false the day before the wiring.

# ---- char-type escapes, python-verified --------------------------------

pattern \d+
features classes
m "abc123def" 3 6
m "007" 0 3
n "no digits"

pattern \D+
features classes
m "12ab34" 2 4
n "123"

pattern [\d]+
features classes
m "abc123def" 3 6

pattern [\D]+
features classes
m "12ab34" 2 4

pattern \s\w+
features classes
m "a bc d" 1 4

pattern \S+
features classes
m "  xy  " 2 4

pattern [\w]+
features classes
m "-a_9-" 1 4

pattern [^\W]+
features classes
m "-a_9-" 1 4

pattern [a\d]+
features classes
m "xa1b" 1 3

pattern [\d-]+
features classes
m "a1-2b" 1 4

pattern (\d|x)+
features classes
m "ax1x2" 1 5

pattern \d{2,3}
features classes
m "a1234b" 1 4

pattern [^\d]+
features classes
m "12ab34" 2 4

pattern [\da-c]+
features classes
flags i
m "zA1Bc" 1 5

# ---- \h \H \v \V \N — no python spelling; censuses are the oracle ------

# pcre2-only
pattern \h+
features classes
m "a\t b" 1 3

# pcre2-only
pattern \H+
features classes
m "\t ab\t" 2 4

# pcre2-only
pattern \v+
features classes
m "a\n\fb" 1 3

# pcre2-only
pattern \V+
features classes
m "\nab\r" 1 3

# pcre2-only
pattern \N+
features classes
m "ab\ncd" 0 2

# pcre2-only
pattern [\h\d]+
features classes
m "a\t5 b" 1 4

# ---- POSIX named classes — no python spelling ---------------------------

# pcre2-only
pattern [[:alpha:]]+
features classes
m "12abCD34" 2 6

# pcre2-only
pattern [[:^alpha:]]+
features classes
m "ab123cd" 2 5

# pcre2-only
pattern [[:xdigit:]]+
features classes
m "zzDEADbeef09zz" 2 12

# pcre2-only
pattern [x[:digit:]y]+
features classes
m "axy12za" 1 5

# pcre2-only
pattern [^[:alpha:]]+
features classes
m "ab12_cd" 2 5

# pcre2-only
pattern [[:alpha:][:digit:]]+
features classes
m "_ab12_" 1 5

# pcre2-only
pattern [[:digit:]-]+
features classes
m "a1-2b" 1 4

# pcre2-only
pattern ^[[:blank:]]+
features classes
m " \ta" 0 2

# ---- every POSIX name pinned WITHOUT libpcre2 (R16, checks critic) ------
# PC-4 censuses all fourteen names, but it skips loudly on a box without
# libpcre2 — and before R16 the ten names below had NO non-caseless pin at
# all, so a lower/upper bitmap swap shipped green there (measured: the swap
# left this corpus 43/43 while PC-4 saw 1,151 disagreements). One
# discriminating block per name; lower and upper are the pair the caseless
# blocks are structurally blind to (the -i fold makes them identical).

# pcre2-only
pattern [[:lower:]]+
features classes
m "AbcD" 1 3

# pcre2-only
pattern [[:upper:]]+
features classes
m "aBCd" 1 3

# pcre2-only
pattern [[:alnum:]]+
features classes
m "_ab1_" 1 4

# pcre2-only
pattern [[:^ascii:]]+
features classes
m "a\xff\x80b" 1 3

# pcre2-only
pattern [[:cntrl:]]+
features classes
m "a\t\nb" 1 3

# pcre2-only
pattern [[:graph:]]+
features classes
m " ab " 1 3

# pcre2-only
pattern [[:print:]]+
features classes
m "\tab \t" 1 4

# pcre2-only
pattern [[:punct:]]+
features classes
m "a,;b" 1 3

# pcre2-only
pattern [[:space:]]+
features classes
m "a \tb" 1 3

# pcre2-only
pattern [[:word:]]+
features classes
m "-a_9-" 1 4

# ---- caseless x posix: the probe_ci_posix cells (fold-before-negate) ----

# pcre2-only
pattern ^[[:lower:]]$
features classes
flags i
m "A" 0 1

# pcre2-only
pattern ^[[:^lower:]]$
features classes
flags i
n "a"
n "A"
m "0" 0 1

# pcre2-only
pattern ^[^[:lower:]]$
features classes
flags i
n "A"
m "0" 0 1

# ---- \N{quantifier} — the R16 engine critic's boundary (probe_nbrace.c) --
# PCRE2 tries the brace as a quantifier FIRST; only a non-quantifier-shaped
# body is the unsupported \N{name} construct. One home for the shape:
# pcrec_brace_quant_shape, shared by try_quant and the \N{ recogniser.

# pcre2-only
pattern ^\N{2,3}$
features classes
m "ab" 0 2
n "abcd"
n "a"

# pcre2-only
pattern \N{2}
features classes
m "xy" 0 2

pattern \N{3,2}
features classes
perr

pattern \N{abc}
features classes
perr

# ---- rejections that hold WITH the module enabled -----------------------

pattern [\N]
features classes
perr

pattern [0-\d]
features classes
perr

pattern (?[[a]])
features classes
perr

# pcre2-only
pattern [[:alpha:]-z]
features classes
perr

# pcre2-only
pattern [[:<:]]
features classes
perr

# pcre2-only
pattern [[:foo:]]
features classes
perr

# ---- [STD1b] (D37, 2026-08-13): bare default now includes `classes` -----
# Every block above pins behaviour under EXPLICIT `features classes`, which
# the bare-default flip does not change (an explicit spec always wins).
# What the flip changes is the DEFAULT path itself — no `features` line at
# all now resolves to `std1` = {classes, modifiers} instead of the empty
# set — and that path is worth its own small proof rather than trusting it
# by inference from the explicit-features blocks above (coverage-
# conservation rule, tests/reject/'s companion pin is
# `reject_gated none ...` for the same constructs). A handful of
# representative producers, not the full 51-block sweep already covered
# above.

pattern \d+
m "abc123def" 3 6

pattern \s\w+
m "a bc d" 1 4

# pcre2-only
pattern [[:alpha:]]+
m "ab12" 0 2
