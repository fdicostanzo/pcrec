# [M5.0] D27 axis 3 MIRROR -- byte-encoding control arm for axis03_invalid_utf8.rxt.
# Every primary pattern ('a' / 'a.+a') is plain base grammar, so it compiles
# under `-e byte` today. For before/after positions the byte-mode answer
# usually agrees with the utf8-promised barrier answer (a bare 'a' does not
# care what follows/precedes it). For the THROUGH position it does NOT: a byte
# engine's `.` has no notion of an ill-formed sequence and happily consumes
# the "bad" bytes as ordinary bytes, so `a.+a` MATCHES through them under byte
# encoding where the utf8 promise is NO MATCH -- exactly the reason the utf8
# encoding axis needs to exist. Every real case below is the LIVE agreement of
# pcrec/byte and python's bytes `re` engine.

# axis3 mirror isolated-continuation-before | kind=isolated-continuation | pattern: a | LIVE pcrec/byte == python/re-bytes
pattern a
encoding byte
m "a\x80" 0 1
m "a\x80z" 0 1
n "b\x80"
n "\x80"

# axis3 mirror isolated-continuation-after | kind=isolated-continuation | pattern: a | LIVE pcrec/byte == python/re-bytes
pattern a
encoding byte
m "\x80a" 1 2
m "z\x80a" 2 3
n "\x80b"
n "\x80"

# axis3 mirror isolated-continuation-through | kind=isolated-continuation | pattern: a.+a | LIVE pcrec/byte == python/re-bytes
pattern a.+a
encoding byte
m "a\x80a" 0 3
m "a\x80zza" 0 5
n "a\x80z"
n "\x80"

# axis3 mirror illegal-fe-ff-before | kind=illegal-fe-ff | pattern: a | LIVE pcrec/byte == python/re-bytes
pattern a
encoding byte
m "a\xfe" 0 1
m "a\xfez" 0 1
n "b\xfe"
n "\xfe"

# axis3 mirror illegal-fe-ff-after | kind=illegal-fe-ff | pattern: a | LIVE pcrec/byte == python/re-bytes
pattern a
encoding byte
m "\xfea" 1 2
m "z\xfea" 2 3
n "\xfeb"
n "\xfe"

# axis3 mirror illegal-fe-ff-through | kind=illegal-fe-ff | pattern: a.+a | LIVE pcrec/byte == python/re-bytes
pattern a.+a
encoding byte
m "a\xfea" 0 3
m "a\xfezza" 0 5
n "a\xfez"
n "\xfe"

# axis3 mirror trunc-missing-1-before | kind=trunc-missing-1 | pattern: a | LIVE pcrec/byte == python/re-bytes
pattern a
encoding byte
m "a\xce" 0 1
m "a\xcez" 0 1
n "b\xce"
n "\xce"

# axis3 mirror trunc-missing-1-after | kind=trunc-missing-1 | pattern: a | LIVE pcrec/byte == python/re-bytes
pattern a
encoding byte
m "\xcea" 1 2
m "z\xcea" 2 3
n "\xceb"
n "\xce"

# axis3 mirror trunc-missing-1-through | kind=trunc-missing-1 | pattern: a.+a | LIVE pcrec/byte == python/re-bytes
pattern a.+a
encoding byte
m "a\xcea" 0 3
m "a\xcezza" 0 5
n "a\xcez"
n "\xce"

