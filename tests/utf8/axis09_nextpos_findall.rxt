#   [boundary P=10] ms 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 10 10   # oracle=PCRE2_UTF
# pcre2-only
pattern .{0,1}
encoding utf8
m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 1
ms 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 1 3
ms 3 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 3 6
ms 6 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 6 10
ms 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 10 10

# axis9 block mixed-width-anchored | subject=mixed-width (boundaries [0, 1, 3, 6, 10]) | pattern: ^.
#   [boundary P=0] m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 1   # oracle=PCRE2_UTF
#   [boundary P=1] ns 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"   # oracle=PCRE2_UTF
#   [boundary P=3] ns 3 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"   # oracle=PCRE2_UTF
#   [boundary P=6] ns 6 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"   # oracle=PCRE2_UTF
#   [boundary P=10] ns 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"   # oracle=PCRE2_UTF
# pcre2-only
pattern ^.
encoding utf8
m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 1
ns 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"
ns 3 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"
ns 6 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"
ns 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"

# axis9 block mixed-width-unanchored | subject=mixed-width (boundaries [0, 1, 3, 6, 10]) | pattern: .
#   [boundary P=0] m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 1   # oracle=PCRE2_UTF
#   [boundary P=1] ms 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 1 3   # oracle=PCRE2_UTF
