# [M5.0] D27 axis 9 -- next_pos / find-all over multi-byte subjects (extract
# Sec 2.6.1/2.6.1.1). 16 blocks (4 subject shapes x 4 patterns), one `ms` case
# per CHARACTER BOUNDARY of the subject (a proxy for a find-all loop's
# `next_pos`-driven visits -- `.rxt` has no native find-all directive; see
# generator header), plus 4 more blocks for the mid-character-`startpos` table
# (Sec 2.6.1.1's own measured 4-row table, leading `(?!`/`(?<!`) -> 20 blocks /
# 80 cases total. Oracle: libpcre2, options=
# PCRE2_UTF for the 16 boundary-walk blocks. The 4 mid-character-startpos
# blocks use pcrec's OWN ARGUED design position (Sec 2.6.1.1's fourth column),
# NOT any single PCRE2 oracle answer -- no real engine produces it; the other
# three measured columns (PCRE2_UTF / MATCH_INVALID_UTF / options=0) are kept
# alongside as comments for context, clearly labelled as NOT the expected
# value.
#
# PROMOTED (lane utfprom, [M5.0] stage 2 close): 19 of the resulting 19
# live blocks compile under `-e utf8` (the mid-character-startpos blocks
# additionally need `features lookaround` for their `(?<!.)`/`(?!.)`
# bodies -- added at promotion; missing as authored, same shape as
# axis08) and agree with their recorded expectation, 0 divergences. **ONE
# GENUINE DIVERGENCE WAS FOUND AND MOVED, not papered over**: the
# "midstart-row3-boundary" block disagreed with its ARGUED expectation
# (pcrec answers a match at (3,3), an illegal mid-character byte offset,
# where the design position says no match) -- filed as
# docs/dev/known_issues.md K49 and moved to
# tests/known_fail/k49_utf8_lookbehind_retry.rxt per this project's own
# "disputed answer, not a construct that's merely unbuilt" convention
# (docs/spec/rxt_format.md step 5); see the pointer comment at its former
# position below. This file's own population is therefore 19 blocks / 20
# original minus the one moved, all green.

# axis9 block all-ascii-empty | subject=all-ascii (boundaries [0, 1, 2, 3, 4]) | pattern: (?:)
#   [boundary P=0] m "abcd" 0 0   # oracle=PCRE2_UTF
#   [boundary P=1] ms 1 "abcd" 1 1   # oracle=PCRE2_UTF
#   [boundary P=2] ms 2 "abcd" 2 2   # oracle=PCRE2_UTF
#   [boundary P=3] ms 3 "abcd" 3 3   # oracle=PCRE2_UTF
#   [boundary P=4] ms 4 "abcd" 4 4   # oracle=PCRE2_UTF
pattern (?:)
encoding utf8
m "abcd" 0 0
ms 1 "abcd" 1 1
ms 2 "abcd" 2 2
ms 3 "abcd" 3 3
ms 4 "abcd" 4 4

# axis9 block all-ascii-nullable | subject=all-ascii (boundaries [0, 1, 2, 3, 4]) | pattern: .{0,1}
#   [boundary P=0] m "abcd" 0 1   # oracle=PCRE2_UTF
#   [boundary P=1] ms 1 "abcd" 1 2   # oracle=PCRE2_UTF
#   [boundary P=2] ms 2 "abcd" 2 3   # oracle=PCRE2_UTF
#   [boundary P=3] ms 3 "abcd" 3 4   # oracle=PCRE2_UTF
#   [boundary P=4] ms 4 "abcd" 4 4   # oracle=PCRE2_UTF
pattern .{0,1}
encoding utf8
m "abcd" 0 1
ms 1 "abcd" 1 2
ms 2 "abcd" 2 3
ms 3 "abcd" 3 4
ms 4 "abcd" 4 4

# axis9 block all-ascii-anchored | subject=all-ascii (boundaries [0, 1, 2, 3, 4]) | pattern: ^.
#   [boundary P=0] m "abcd" 0 1   # oracle=PCRE2_UTF
#   [boundary P=1] ns 1 "abcd"   # oracle=PCRE2_UTF
#   [boundary P=2] ns 2 "abcd"   # oracle=PCRE2_UTF
#   [boundary P=3] ns 3 "abcd"   # oracle=PCRE2_UTF
#   [boundary P=4] ns 4 "abcd"   # oracle=PCRE2_UTF
pattern ^.
encoding utf8
m "abcd" 0 1
ns 1 "abcd"
ns 2 "abcd"
ns 3 "abcd"
ns 4 "abcd"

# axis9 block all-ascii-unanchored | subject=all-ascii (boundaries [0, 1, 2, 3, 4]) | pattern: .
#   [boundary P=0] m "abcd" 0 1   # oracle=PCRE2_UTF
#   [boundary P=1] ms 1 "abcd" 1 2   # oracle=PCRE2_UTF
#   [boundary P=2] ms 2 "abcd" 2 3   # oracle=PCRE2_UTF
#   [boundary P=3] ms 3 "abcd" 3 4   # oracle=PCRE2_UTF
#   [boundary P=4] ns 4 "abcd"   # oracle=PCRE2_UTF
pattern .
encoding utf8
m "abcd" 0 1
ms 1 "abcd" 1 2
ms 2 "abcd" 2 3
ms 3 "abcd" 3 4
ns 4 "abcd"

# axis9 block all-2byte-empty | subject=all-2byte (boundaries [0, 2, 4, 6, 8]) | pattern: (?:)
#   [boundary P=0] m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 0   # oracle=PCRE2_UTF
#   [boundary P=2] ms 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 2 2   # oracle=PCRE2_UTF
#   [boundary P=4] ms 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 4 4   # oracle=PCRE2_UTF
#   [boundary P=6] ms 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 6 6   # oracle=PCRE2_UTF
#   [boundary P=8] ms 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 8 8   # oracle=PCRE2_UTF
# pcre2-only
pattern (?:)
encoding utf8
m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 0
ms 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 2 2
ms 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 4 4
ms 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 6 6
ms 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 8 8

# axis9 block all-2byte-nullable | subject=all-2byte (boundaries [0, 2, 4, 6, 8]) | pattern: .{0,1}
#   [boundary P=0] m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 2   # oracle=PCRE2_UTF
#   [boundary P=2] ms 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 2 4   # oracle=PCRE2_UTF
#   [boundary P=4] ms 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 4 6   # oracle=PCRE2_UTF
#   [boundary P=6] ms 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 6 8   # oracle=PCRE2_UTF
#   [boundary P=8] ms 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 8 8   # oracle=PCRE2_UTF
# pcre2-only
pattern .{0,1}
encoding utf8
m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 2
ms 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 2 4
ms 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 4 6
ms 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 6 8
ms 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 8 8

# axis9 block all-2byte-anchored | subject=all-2byte (boundaries [0, 2, 4, 6, 8]) | pattern: ^.
#   [boundary P=0] m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 2   # oracle=PCRE2_UTF
#   [boundary P=2] ns 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"   # oracle=PCRE2_UTF
#   [boundary P=4] ns 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"   # oracle=PCRE2_UTF
#   [boundary P=6] ns 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"   # oracle=PCRE2_UTF
#   [boundary P=8] ns 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"   # oracle=PCRE2_UTF
# pcre2-only
pattern ^.
encoding utf8
m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 2
ns 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"
ns 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"
ns 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"
ns 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"

# axis9 block all-2byte-unanchored | subject=all-2byte (boundaries [0, 2, 4, 6, 8]) | pattern: .
#   [boundary P=0] m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 2   # oracle=PCRE2_UTF
#   [boundary P=2] ms 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 2 4   # oracle=PCRE2_UTF
#   [boundary P=4] ms 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 4 6   # oracle=PCRE2_UTF
#   [boundary P=6] ms 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 6 8   # oracle=PCRE2_UTF
#   [boundary P=8] ns 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"   # oracle=PCRE2_UTF
# pcre2-only
pattern .
encoding utf8
m "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 0 2
ms 2 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 2 4
ms 4 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 4 6
ms 6 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4" 6 8
ns 8 "\xce\xb1\xce\xb2\xce\xb3\xce\xb4"

# axis9 block mixed-width-empty | subject=mixed-width (boundaries [0, 1, 3, 6, 10]) | pattern: (?:)
#   [boundary P=0] m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 0   # oracle=PCRE2_UTF
#   [boundary P=1] ms 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 1 1   # oracle=PCRE2_UTF
#   [boundary P=3] ms 3 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 3 3   # oracle=PCRE2_UTF
#   [boundary P=6] ms 6 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 6 6   # oracle=PCRE2_UTF
#   [boundary P=10] ms 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 10 10   # oracle=PCRE2_UTF
# pcre2-only
pattern (?:)
encoding utf8
m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 0
ms 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 1 1
ms 3 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 3 3
