#   [boundary P=10] ns 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"   # oracle=PCRE2_UTF
# pcre2-only
pattern .
encoding utf8
m "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 0 1
ms 1 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 1 3
ms 3 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 3 6
ms 6 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80" 6 10
ns 10 "a\xce\xb1\xe4\xb8\x80\xf0\x9f\x98\x80"

# axis9 block ill-formed-embedded-empty | subject=ill-formed-embedded (boundaries [0, 1, 2, 3]) | pattern: (?:)
#   [boundary P=0] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=1] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=2] ms 2 "a\xffb" 2 2   # oracle=PCRE2_UTF
#   [boundary P=3] ms 3 "a\xffb" 3 3   # oracle=PCRE2_UTF
# pcre2-only
pattern (?:)
encoding utf8
ms 2 "a\xffb" 2 2
ms 3 "a\xffb" 3 3

# axis9 block ill-formed-embedded-nullable | subject=ill-formed-embedded (boundaries [0, 1, 2, 3]) | pattern: .{0,1}
#   [boundary P=0] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=1] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=2] ms 2 "a\xffb" 2 3   # oracle=PCRE2_UTF
#   [boundary P=3] ms 3 "a\xffb" 3 3   # oracle=PCRE2_UTF
# pcre2-only
pattern .{0,1}
encoding utf8
ms 2 "a\xffb" 2 3
ms 3 "a\xffb" 3 3

# axis9 block ill-formed-embedded-anchored | subject=ill-formed-embedded (boundaries [0, 1, 2, 3]) | pattern: ^.
#   [boundary P=0] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=1] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=2] ns 2 "a\xffb"   # oracle=PCRE2_UTF
#   [boundary P=3] ns 3 "a\xffb"   # oracle=PCRE2_UTF
# pcre2-only
pattern ^.
encoding utf8
ns 2 "a\xffb"
ns 3 "a\xffb"

# axis9 block ill-formed-embedded-unanchored | subject=ill-formed-embedded (boundaries [0, 1, 2, 3]) | pattern: .
#   [boundary P=0] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=1] [NO PCREC-PROMISED VALUE -- oracle returned ('ERRM', -23, 'UTF-8 error: illegal byte (0xfe or 0xff)'); see note]
#   [boundary P=2] ms 2 "a\xffb" 2 3   # oracle=PCRE2_UTF
#   [boundary P=3] ns 3 "a\xffb"   # oracle=PCRE2_UTF
# pcre2-only
pattern .
encoding utf8
ms 2 "a\xffb" 2 3
ns 3 "a\xffb"

# axis9 block midstart-row1-boundary-control | pattern: (?<!.) startpos=0 subject=alpha-beta (CE B1 CE B2)
# measured for context (NOT the expected value): PCRE2_UTF=((0, 0), ())  MATCH_INVALID_UTF=((0, 0), ())  options=0(byte)=((0, 0), ())
# EXPECTED (pcrec's own ARGUED design position, Sec 2.6.1.1): ((0, 0), ())
#   m "\xce\xb1\xce\xb2" 0 0   # oracle=pcrec-ARGUED (no oracle produces this)
# pcre2-only
pattern (?<!.)
encoding utf8
features lookaround
m "\xce\xb1\xce\xb2" 0 0

# axis9 block midstart-row2-MID-la | pattern: (?<!.) startpos=1 subject=alpha-beta (CE B1 CE B2)
# measured for context (NOT the expected value): PCRE2_UTF=('ERRM', -36, 'bad offset into UTF string')  MATCH_INVALID_UTF=((2, 2), ())  options=0(byte)=None
# EXPECTED (pcrec's own ARGUED design position, Sec 2.6.1.1): ((1, 1), ())
#   ms 1 "\xce\xb1\xce\xb2" 1 1   # oracle=pcrec-ARGUED (no oracle produces this)
# pcre2-only
pattern (?<!.)
encoding utf8
features lookaround
ms 1 "\xce\xb1\xce\xb2" 1 1

# axis9 block midstart-row3-boundary | pattern: (?<!.) startpos=2 subject=alpha-beta (CE B1 CE B2)
# [K49] MOVED to tests/known_fail/k49_utf8_lookbehind_retry.rxt, 2026-09-05
# (lane utfprom): pcrec's live answer at this cell is a MATCH at (3,3),
# disagreeing with the ARGUED expectation below (NO MATCH) -- a genuine,
# disputed answer, not a construct that's merely unbuilt, so it belongs in
# known_fail per docs/spec/rxt_format.md step 5, not here. See
# docs/dev/known_issues.md K49 for the full write-up.
# measured for context (NOT the expected value): PCRE2_UTF=None  MATCH_INVALID_UTF=None  options=0(byte)=None
# EXPECTED (pcrec's own ARGUED design position, Sec 2.6.1.1): None
#   ns 2 "\xce\xb1\xce\xb2"   # oracle=pcrec-ARGUED (no oracle produces this)

# axis9 block midstart-row4-MID-leading-neg | pattern: (?!.) startpos=1 subject=alpha-beta (CE B1 CE B2)
# measured for context (NOT the expected value): PCRE2_UTF=('ERRM', -36, 'bad offset into UTF string')  MATCH_INVALID_UTF=((4, 4), ())  options=0(byte)=((4, 4), ())
# EXPECTED (pcrec's own ARGUED design position, Sec 2.6.1.1): ((1, 1), ())
#   ms 1 "\xce\xb1\xce\xb2" 1 1   # oracle=pcrec-ARGUED (no oracle produces this)
# pcre2-only
pattern (?!.)
encoding utf8
features lookaround
ms 1 "\xce\xb1\xce\xb2" 1 1

