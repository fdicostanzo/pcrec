#   [1:n partner, must NOT match] n "\xc3\x9f"   # oracle=PCRE2_UTF|PCRE2_CASELESS
# pcre2-only
pattern SS
encoding utf8
flags i
m "SS" 0 2
n "\xc3\x9f"

