#   [vacuity: matches itself] m "ss" 0 2   # oracle=PCRE2_UTF|PCRE2_CASELESS
#   [1:n partner, must NOT match] n "\xc3\x9f"   # oracle=PCRE2_UTF|PCRE2_CASELESS
# pcre2-only
pattern ss
encoding utf8
flags i
m "ss" 0 2
n "\xc3\x9f"

