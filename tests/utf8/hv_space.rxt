# ---------------------------------------------------------------------------
# 3. byte: the control — \h and \v are the byte sets
# ---------------------------------------------------------------------------

# pcre2-only
pattern ^\h$
m "\x09" 0 1
m "\x20" 0 1
m "\xa0" 0 1
n "\xc2\xa0"
n "\xe3\x80\x80"
n "\x0a"

# pcre2-only
pattern ^\v$
m "\x0a" 0 1
m "\x0b" 0 1
m "\x85" 0 1
n "\xc2\x85"
n "\xe2\x80\xa8"
n "\x20"
