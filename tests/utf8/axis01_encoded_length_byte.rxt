# [M5.0] D27 axis 1 MIRROR -- byte-encoding control arm for axis01_encoded_length.rxt.
# Same 64 pattern shapes, `encoding byte`. A bare literal multi-byte sequence
# compiles and matches identically to the byte-literal reading (LIVE-verified
# against build/pcrec, cross-checked against python re's bytes engine). A
# class/quantifier/range/alternation wrapping a multi-byte literal ALSO
# compiles under byte encoding, but is BYTE-DECOMPOSED -- each byte of the
# literal becomes its own independent class member / quantified unit -- which
# is neither a refusal nor an identity match with the utf8-encoded promise.
# Both outcomes are recorded here as real cases. UPDATED (lane utfprom,
# [M5.0] stage 2 close): `\x{}` is no longer a permanent module gate under
# `byte` -- it is BASE-grammar range-checked per encoding (D27 corpus was
# authored before this landed and assumed the gate was permanent, so its
# 16 `\x{}` blocks carried no future-case comment at all). The 4 L1-esc-*
# blocks (code point <=U+00FF) now compile and are promoted here with
# FRESH live-derived cases (python bytes-`re` on the byte-for-byte-equivalent
# translated pattern, cross-checked against pcrec's own compiled output --
# same "LIVE pcrec/byte == python/re-bytes" methodology this file's other
# real cases use). The 12 L2/L3/L4-esc-* blocks (code point >U+00FF) still
# refuse, but with a RANGE error now, not the module-gate error this file
# originally pinned -- see each such block's own updated comment. Every
# real case's expected value is the LIVE agreement of pcrec's own byte-mode
# output and python re's bytes engine; disagreement is asserted never to
# occur below, not assumed.

# axis1 mirror L1-bare | pattern: a | LIVE pcrec/byte == python/re-bytes
# pcre2-only
pattern a
encoding byte
m "a" 0 1
n "z"
n "\xce\xb1"

# axis1 mirror L1-class | pattern: [a] | LIVE pcrec/byte == python/re-bytes
# pcre2-only
pattern [a]
encoding byte
m "a" 0 1
n "z"
n "\xce\xb1"

# axis1 mirror L1-neg-class | pattern: [^a] | LIVE pcrec/byte == python/re-bytes
# pcre2-only
pattern [^a]
encoding byte
n "a"
m "z" 0 1
m "\xce\xb1" 0 1

# axis1 mirror L1-quantified | pattern: a+ | LIVE pcrec/byte == python/re-bytes
# pcre2-only
pattern a+
encoding byte
m "a" 0 1
n "z"
n "\xce\xb1"

# axis1 mirror L1-esc-bare | pattern: \x{61} | <=U+00FF: BASE-grammar range check compiles under byte too since [M5.0] stage 2 (LIVE pcrec/byte == python/re-bytes)
# pcre2-only
pattern \x{61}
encoding byte
m "a" 0 1
n "z"
n "\xce\xb1"

# axis1 mirror L1-esc-class | pattern: [\x{61}] | <=U+00FF: BASE-grammar range check compiles under byte too since [M5.0] stage 2 (LIVE pcrec/byte == python/re-bytes)
# pcre2-only
pattern [\x{61}]
encoding byte
m "a" 0 1
n "z"
n "\xce\xb1"

# axis1 mirror L1-esc-neg-class | pattern: [^\x{61}] | <=U+00FF: BASE-grammar range check compiles under byte too since [M5.0] stage 2 (LIVE pcrec/byte == python/re-bytes)
# pcre2-only
pattern [^\x{61}]
encoding byte
n "a"
m "z" 0 1
m "\xce\xb1" 0 1

# axis1 mirror L1-esc-quantified | pattern: \x{61}+ | <=U+00FF: BASE-grammar range check compiles under byte too since [M5.0] stage 2 (LIVE pcrec/byte == python/re-bytes)
# pcre2-only
pattern \x{61}+
encoding byte
m "a" 0 1
n "z"
n "\xce\xb1"

