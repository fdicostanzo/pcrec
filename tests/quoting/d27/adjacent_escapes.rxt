# D27 quoting corpus -- \Q...\E adjacent to, and containing, other escapes.

# an ordinary escape ('\d') immediately followed by a quoted run keeps its own meaning; the quoted '+' is literal
pattern \d\Q+\E
features quoting,classes
m "5+" 0 2
n "5"

# an escape sequence spelled INSIDE \Q...\E is not interpreted at all -- it is two literal characters, backslash and 'd', not the digit class
pattern \Q\d\E
features quoting
m "\\d" 0 2
n "5"

# quoting sandwiched between two live escapes on either side
pattern \w\Qxy\E\s
features quoting,classes
m "axy " 0 4
n "a-y "
