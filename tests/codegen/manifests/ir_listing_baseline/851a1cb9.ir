# pcrec VM program listing (DD-8; docs/design/engine_m4.md S10)
#
# Produced BY the emitter's own walk, not by a second walk over the
# AST: every row below was written by the same call that wrote the
# corresponding C. S10's one constraint -- "the dump must be derived
# from the same structure the emitter walks, never a parallel
# description" -- is therefore structural here, not a discipline.
#
# TAB-separated, one #section per table, each with its own #header of
# column names: docs/spec/ir_listing.md is this listing's contract and
# docs/spec/table_contract.md is the TSV contract it conforms to.
# Resolve a column BY NAME; column WIDTH is not a contract. A DEBUG
# listing: complete for control structure, lossy on operands (D106).

#section summary
#fact	value	note
pattern	(?<=a|bc)x	
engine	vm	forced by: (?<=...) at pattern offset 0
prefilter	no-engine-vm	--engine=vm -- the VM scans from search_from itself (R21 E-6)
rungs	none	comma-joined; the rungs section below says which quantifier took which
strategies	none	comma-joined; the strategies section below says which quantifier took which
possessify	0/0	marked/total SOURCE quantifiers possessified (eng_brep_design.md S2)
caps	1	RX_NCAPS; 0 capturing groups in the pattern text
step-budget	500000000	backtrack resumptions
resume-frames	5	
trail-entries	3	
subject-ceiling		exact: no subject ceiling
labels	11	
events	42	
resume-points	2	the PRE-PASS count the resume-point cap is checked against, never a recount of the event stream
max-replicas	0	limit 64, checked before emission
prune-ceiling	subject-end	the subject end -- either no prefilter, or the prefilter's window END is not a bound on this match's end: the pattern carries an ATOMIC GROUP (atomic_groups_design.md 4.4 H3) or a LOOKAROUND (lookaround_design.md 5.6), or the prefilter was built from the COUNT-COLLAPSED superset (prefilter_count_independence.md 2 H3, K39/[OPT-4]) -- the prefilter row above says which
prune-bound-sites	0	
prune-retreats	0	
islands	0	
callout-sites	0	

#section slots
#family	slot	holds	note
group	0,1	$0 whole match	written by the ENTRY, not the VM (S3.4)
guard			no empty-iteration guard slots: no nullable unbounded quantifier on the frames rung
low			no span-loop low-water slots: no cursor rung in this program
mark			
revdet			
lookmark	2	lookaround cut mark	resume-stack depth at the assertion's entry -- the atomic and negative forms commit ([M6.6.2])
lookpos	3	lookaround cursor	the entry position the assertion restores: a lookaround keeps the VERDICT and discards the POSITION

#section rungs
#label	kind	detail
		none: no quantifier in this program consulted the rung ladder at all

#section strategies
#label	kind	detail
		none: this program has no quantifier to possessify

#section pruning
#label	kind	detail
		none: this program has no quantifier to bound

#section program
#label	op	args	target	note
L0	label			positive lookbehind (atomic): record the resume-stack depth to cut back to, and the cursor to come back to (which is also what the END-CHECK compares against)
	set	slot_values[2] <- scan_position		lookaround cut mark (resume-stack depth at the assertion's entry)
	set	slot_values[3] <- scan_position		lookaround: the cursor to restore -- the assertion consumes nothing
	goto		L4	
L4	label			lookbehind branch 1 of 2, fixed width 1: step back and run the branch FORWARD
	assert	lookbehind: fewer than 1 characters precede the cursor, so try the next branch	L7	
	push		L7	lookbehind: the NEXT-BRANCH continuation -- this branch's body failing retreats into the branch written after it
	note			work charge: the back-step, charged as the compile-time width rather than the runtime cost so the accounting does not depend on the encoding backend
	note			lookbehind: the ENCODING SEAM's back-step, 1 character
	note			lookbehind: the back-step ran off the start of the subject -- dead under the byte backend, where the guard above is exact
	goto		L5	
L5	label			
	consume	'a'	L6	
	fail			backtrack
L6	label			lookbehind END-CHECK: the branch must finish exactly where the assertion started -- the only runtime evidence that the width analysis and this emission agree
	note			lookbehind end-check FAILED -- this branch declines
	goto		L3	
L7	label			lookbehind branch 2 of 2, fixed width 2: step back and run the branch FORWARD (the LAST branch: no retry frame)
	note			lookbehind: fewer than 2 characters precede the cursor, and this is the last branch -- the assertion fails here
	note			work charge: the back-step, charged as the compile-time width rather than the runtime cost so the accounting does not depend on the encoding backend
	note			lookbehind: the ENCODING SEAM's back-step, 2 characters
	note			lookbehind: the back-step ran off the start of the subject -- dead under the byte backend, where the guard above is exact
	goto		L8	
L8	label			
	consume	'b'	L10	
	fail			backtrack
L10	label			
	consume	'c'	L9	
	fail			backtrack
L9	label			lookbehind END-CHECK: the branch must finish exactly where the assertion started -- the only runtime evidence that the width analysis and this emission agree
	note			lookbehind end-check FAILED -- this branch declines
	goto		L3	
L3	label			positive lookaround: the body's FIRST success -- cut, restore the cursor, and never reconsider
	note			work charge: frames discarded by this cut
	cut	frames <- slot_values[2]		cut: the assertion is committed; every choice point the body created is discarded, dead or not
	note			lookaround: the position is DISCARDED -- the cursor goes back to the assertion's entry
	goto		L2	
L2	label			
	consume	'x'	L1	
	fail			backtrack
L1	label			the pattern is complete
	accept			
accept	label			return scan_position - ctx->pos; the capture slots at this instant ARE the answer (S3.1)
fail	label			the ONLY backtracker and the only indirect jump; one step charged here (S4.2)

#section choicepoints
#label	resume	note
L4	L7	lookbehind: the NEXT-BRANCH continuation -- this branch's body failing retreats into the branch written after it

#section islands
#label	width	note
		none: no flat alternation in this program has a finite literal language, so src/gen/emit_vm.c's alternation island declined every one -- docs/spec/tuning.md S2.20

#section callouts
#label	note
	none: module 'callouts' has no producer, so no pattern can reach a call site -- engine_m4.md S9.1
