# pcrec VM program listing (DD-8; docs/design/engine_m4.md S10)
#
# Produced BY the emitter's own walk, not by a second walk over the
# AST: every row below was written by the same call that wrote the
# corresponding C. S10's one constraint -- "the dump must be derived
# from the same structure the emitter walks, never a parallel
# description" -- is therefore structural here, not a discipline.
#
# TAB-separated, one #section per table, each with its own #header of
# column names: docs/spec/ir_listing.md is this listing's contract and
# docs/spec/table_contract.md is the TSV contract it conforms to.
# Resolve a column BY NAME; column WIDTH is not a contract. A DEBUG
# listing: complete for control structure, lossy on operands (D106).

#section summary
#fact	value	note
pattern	(a*)*	
engine	vm	forced by: capture group at pattern offset 0
prefilter	no-engine-vm	--engine=vm -- the VM scans from search_from itself (R21 E-6)
rungs	cursor,frames-unbounded	comma-joined; the rungs section below says which quantifier took which
strategies	backtracking	comma-joined; the strategies section below says which quantifier took which
possessify	0/2	marked/total SOURCE quantifiers possessified (eng_brep_design.md S2)
caps	2	RX_NCAPS; 1 capturing group in the pattern text
step-budget	500000000	backtrack resumptions
resume-frames	2048	
trail-entries	3072	
subject-ceiling	768	bytes
labels	9	
events	31	
resume-points	2	the PRE-PASS count the resume-point cap is checked against, never a recount of the event stream
max-replicas	1	limit 64, checked before emission
prune-ceiling	subject-end	the subject end -- either no prefilter, or the prefilter's window END is not a bound on this match's end: the pattern carries an ATOMIC GROUP (atomic_groups_design.md 4.4 H3) or a LOOKAROUND (lookaround_design.md 5.6), or the prefilter was built from the COUNT-COLLAPSED superset (prefilter_count_independence.md 2 H3, K39/[OPT-4]) -- the prefilter row above says which
prune-bound-sites	0	
prune-retreats	0	
islands	0	
callout-sites	0	

#section slots
#family	slot	holds	note
group	0,1	$0 whole match	written by the ENTRY, not the VM (S3.4)
group	2,3	group 1	written on traverse, trailed
guard	4	empty-iteration guard	where the current iteration began (S3.3)
low	5	span-loop low-water	the loop's entry position (S2.5)
mark			
revdet			
lookmark			
lookpos			

#section rungs
#label	kind	detail
L0	frames-unbounded	frames rung, unbounded {0,}, greedy
L5	cursor	span-loop cursor {0,}, stride 1, greedy

#section strategies
#label	kind	detail
L0	backtracking	frames rung, unbounded {0,}, greedy
L5	backtracking	span-loop cursor {0,}, stride 1, greedy

#section pruning
#label	kind	detail
L0	unclamped	frames rung, unbounded {0,}, greedy
L5	unclamped	span-loop cursor {0,}, stride 1, greedy

#section program
#label	op	args	target	note
L0	label			unbounded repeat, greedy, frames rung, nullable body (empty-iteration guard)
	set	slot_values[4] <- scan_position		empty-iteration guard: where this iteration began
	push		L4	another iteration preferred; resume is the EXIT
	goto		L2	
L2	label			group 1 opens
	set	slot_values[2] <- scan_position		group 1 open, written on traverse
	goto		L5	
L5	label			span-loop cursor {0,}, stride 1, greedy
	set	slot_values[5] <- scan_position		span-loop low-water mark (loop entry scan_position)
	goto		L7	
L7	label			span-loop: take the continuation at the cursor
	note			below the low-water mark: exhausted
	push		L8	shorter run is the resume (retreat one stride)
	goto		L6	
L8	label			span-loop retreat (resumed from the frame)
	goto		L7	
L6	label			group 1 closes
	set	slot_values[3] <- scan_position		group 1 close, written on traverse
	goto		L3	
L3	label			unbounded repeat: one iteration done
	goto		L4	
L4	label			unbounded repeat: the exit
	goto		L1	
L1	label			the pattern is complete
	accept			
accept	label			return scan_position - ctx->pos; the capture slots at this instant ARE the answer (S3.1)
fail	label			the ONLY backtracker and the only indirect jump; one step charged here (S4.2)

#section choicepoints
#label	resume	note
L0	L4	another iteration preferred; resume is the EXIT
L7	L8	shorter run is the resume (retreat one stride)

#section islands
#label	width	note
		none: no flat alternation in this program has a finite literal language, so src/gen/emit_vm.c's alternation island declined every one -- docs/spec/tuning.md S2.20

#section callouts
#label	note
	none: module 'callouts' has no producer, so no pattern can reach a call site -- engine_m4.md S9.1
