# pcrec VM program listing (DD-8; docs/design/engine_m4.md S10)
#
# Produced BY the emitter's own walk, not by a second walk over the
# AST: every row below was written by the same call that wrote the
# corresponding C. S10's one constraint -- "the dump must be derived
# from the same structure the emitter walks, never a parallel
# description" -- is therefore structural here, not a discipline.
#
# TAB-separated, one #section per table, each with its own #header of
# column names: docs/spec/ir_listing.md is this listing's contract and
# docs/spec/table_contract.md is the TSV contract it conforms to.
# Resolve a column BY NAME; column WIDTH is not a contract. A DEBUG
# listing: complete for control structure, lossy on operands (D106).

#section summary
#fact	value	note
pattern	^(?:(a{2,5}(?1)?b)((?1)c)){0}(?2)$	
engine	vm	forced by: (?1) at pattern offset 11
prefilter	no-linked-call	LINKED subroutine call -- erasing a call is a DIFFERENT language, not a superset (S8.2), and a call in a cycle has no finite inlining either; no flag changes this, and -fprefilter refuses. A SPLICED call is not a reason: its callee is inlined EXACTLY (S8.3, S6.3)
rungs	cursor,frames-bounded	comma-joined; the rungs section below says which quantifier took which
strategies	backtracking	comma-joined; the strategies section below says which quantifier took which
possessify	0/3	marked/total SOURCE quantifiers possessified (eng_brep_design.md S2)
caps	3	RX_NCAPS; 2 capturing groups in the pattern text
step-budget	500000000	backtrack resumptions
resume-frames	2048	
trail-entries	3072	
subject-ceiling		exact: no subject ceiling
labels	23	
events	97	
resume-points	2	the PRE-PASS count the resume-point cap is checked against, never a recount of the event stream
max-replicas	1	limit 64, checked before emission
prune-ceiling	subject-end	the subject end -- either no prefilter, or the prefilter's window END is not a bound on this match's end: the pattern carries an ATOMIC GROUP (atomic_groups_design.md 4.4 H3) or a LOOKAROUND (lookaround_design.md 5.6), or the prefilter was built from the COUNT-COLLAPSED superset (prefilter_count_independence.md 2 H3, K39/[OPT-4]) -- the prefilter row above says which
prune-bound-sites	2	
prune-retreats	0	
islands	0	
callout-sites	0	

#section slots
#family	slot	holds	note
group	0,1	$0 whole match	written by the ENTRY, not the VM (S3.4)
group	2,3	group 1	written on traverse, trailed
group	4,5	group 2	written on traverse, trailed
guard			no empty-iteration guard slots: no nullable unbounded quantifier on the frames rung
low	6	span-loop low-water	the loop's entry position (S2.5)
mark			
revdet			
lookmark			
lookpos			

#section rungs
#label	kind	detail
L13	cursor	span-loop cursor {2,5}, stride 1, greedy
L15	frames-bounded	frames rung, bounded {0,1}, greedy

#section strategies
#label	kind	detail
L13	backtracking	span-loop cursor {2,5}, stride 1, greedy
L15	backtracking	frames rung, bounded {0,1}, greedy

#section pruning
#label	kind	detail
L13	clamped	span-loop cursor {2,5}, stride 1, greedy
L15	clamped	frames rung, bounded {0,1}, greedy

#section program
#label	op	args	target	note
L0	label			
	assert	^ attempt_position of subject (absolute offset 0)	L4	
	fail			backtrack
L4	label			X{0}: matches empty, no code
	goto		L5	
L5	label			splice a capture group's pattern inline
	set	slot_values[9] <- scan_position		park this site's caller value (a trailed write into this splice's own save slot)
	set	slot_values[10] <- scan_position		park this site's caller value (a trailed write into this splice's own save slot)
	set	slot_values[11] <- scan_position		park this site's caller value (a trailed write into this splice's own save slot)
	set	slot_values[12] <- scan_position		park this site's caller value (a trailed write into this splice's own save slot)
	set	slot_values[13] <- scan_position		park this site's caller value (a trailed write into this splice's own save slot)
	set	slot_values[14] <- scan_position		park this site's caller value (a trailed write into this splice's own save slot)
	call	L7	L8	splice group 2 inline; no frame, no return label
	goto		L7	
L7	label			group 2 opens
	set	slot_values[8] <- scan_position		group 2 open, PENDING until this iteration closes
	goto		L9	
L9	label			call a capture group's pattern
	call	L2	L12	call group 1; the frame carries the return label
	set	slot_values[2] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	set	slot_values[3] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	set	slot_values[6] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	set	slot_values[7] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	goto		L2	
L12	label			the call returned; continue here
	goto		L11	
L11	label			
	consume	'c'	L10	
	fail			backtrack
L10	label			group 2 closes
	set	slot_values[4] <- scan_position		group 2 PUBLISHED: the pair goes out together, so a reference never sees a half-open span
	set	slot_values[5] <- scan_position		group 2 close, written on traverse
	goto		L8	
L8	label			the spliced callee is complete; restore and continue
	set	slot_values[2] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this splice re-establishes the callee's own
	set	slot_values[3] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this splice re-establishes the callee's own
	set	slot_values[4] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this splice re-establishes the callee's own
	set	slot_values[5] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this splice re-establishes the callee's own
	set	slot_values[7] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this splice re-establishes the callee's own
	set	slot_values[8] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this splice re-establishes the callee's own
	return	goto* frame.call_ret		the splice's own exit (never the lexical occurrence's)
	goto		L6	
L6	label			
	assert	$ end of subject, or before a final newline	L1	
	fail			backtrack
L1	label			the pattern is complete
	accept			
L2	label			group 1 opens
	set	slot_values[7] <- scan_position		group 1 open, PENDING until this iteration closes
	goto		L13	
L13	label			span-loop cursor {2,5}, stride 1, greedy
	set	slot_values[6] <- scan_position		span-loop low-water mark (loop entry scan_position)
	note			MRL: the continuation cannot fit from this loop's entry at all
	note			MRL: the clamp IS the scan's own bound, so the doomed suffix is never scanned and never retreated over -- and the bound is self-rounding, since the cursor only ever moves by W
	goto		L16	
L16	label			span-loop: take the continuation at the cursor
	note			below the low-water mark: exhausted
	push		L17	shorter run is the resume (retreat one stride)
	goto		L15	
L17	label			span-loop retreat (resumed from the frame)
	goto		L16	
L15	label			optional copy (1 remaining), greedy
	note			MRL: no room for another iteration and the follow -- take the skip, push nothing
	push		L20	body preferred; resume SKIPS this copy
	goto		L19	
L20	label			optional copy: the skip
	goto		L18	
L19	label			call a capture group's pattern
	call	L2	L22	call group 1; the frame carries the return label
	set	slot_values[2] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	set	slot_values[3] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	set	slot_values[6] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	set	slot_values[7] <- scan_position		park this activation's value on the trail (a trailed SELF-write)
	goto		L2	
L22	label			the call returned; continue here
	goto		L21	
L21	label			bounded repeat: all optional copies exhausted
	goto		L18	
L18	label			
	consume	'b'	L14	
	fail			backtrack
L14	label			group 1 closes
	set	slot_values[2] <- scan_position		group 1 PUBLISHED: the pair goes out together, so a reference never sees a half-open span
	set	slot_values[3] <- scan_position		group 1 close, written on traverse
	goto		L3	
L3	label			the callee region for a capture group returns
	set	slot_values[2] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this callee re-establishes the callee's own
	set	slot_values[3] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this callee re-establishes the callee's own
	set	slot_values[6] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this callee re-establishes the callee's own
	set	slot_values[7] <- scan_position		restore the caller's value, itself TRAILED so a retreat into this callee re-establishes the callee's own
	return	goto* frame.call_ret		return to the caller through the frame's own label
accept	label			return scan_position - ctx->pos; the capture slots at this instant ARE the answer (S3.1)
fail	label			the ONLY backtracker and the only indirect jump; one step charged here (S4.2)

#section choicepoints
#label	resume	note
L16	L17	shorter run is the resume (retreat one stride)
L15	L20	body preferred; resume SKIPS this copy

#section islands
#label	width	note
		none: no flat alternation in this program has a finite literal language, so src/gen/emit_vm.c's alternation island declined every one -- docs/spec/tuning.md S2.20

#section callouts
#label	note
	none: module 'callouts' has no producer, so no pattern can reach a call site -- engine_m4.md S9.1
