         set     slot_values[6] <- scan_position ; counter rung: iteration counter (trailed)
         -> L4
  L4      ; counter trip: another K iterations, or the residue
         ; trip guard: the residue is a compile-time constant
         -> L7
  L7      ; counter iteration (lazy): leaving preferred
         ; MRL: no room for another iteration and the follow
         PUSH    resume L9                    ; lazy: taking another iteration is the resume
         -> L6
  L9      ; group 1 opens
