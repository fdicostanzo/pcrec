# Noncharacter_Code_Point: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Noncharacter_Code_Point}
features unicode-props
encoding utf8
# U+FDD0 first of FDD0..FDEF -- MEMBER
m "\xef\xb7\x90" 0 3
# U+FDEF last of FDD0..FDEF -- MEMBER
m "\xef\xb7\xaf" 0 3
# U+FFFE plane 0 FFFE -- MEMBER
m "\xef\xbf\xbe" 0 3
# U+FFFF plane 0 FFFF -- MEMBER
m "\xef\xbf\xbf" 0 3
# U+1FFFE plane 1 FFFE -- MEMBER
m "\xf0\x9f\xbf\xbe" 0 4
# U+10FFFE plane 16 FFFE -- MEMBER
m "\xf4\x8f\xbf\xbe" 0 4
# U+10FFFF last code point -- MEMBER
m "\xf4\x8f\xbf\xbf" 0 4
# U+FDCF just below FDD0: unassigned but NOT a noncharacter -- non-member
n "\xef\xb7\x8f"
# U+FDF0 just above FDEF: ARABIC LIGATURE SALLA USED AS KORANIC STOP SIGN ISOLATED FORM -- non-member
n "\xef\xb7\xb0"
# U+FFFD REPLACEMENT CHARACTER -- non-member
n "\xef\xbf\xbd"
# U+10000 LINEAR B SYLLABLE B008 A -- non-member
n "\xf0\x90\x80\x80"
# U+10FFFD plane 16 private use -- non-member
n "\xf4\x8f\xbf\xbd"
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+2FFFD plane 2 FFFD: not noncharacter -- non-member
n "\xf0\xaf\xbf\xbd"

