# U+200F RIGHT-TO-LEFT MARK: DI -- MEMBER
n "\xe2\x80\x8f"
# U+202A LEFT-TO-RIGHT EMBEDDING: DI (202A..202E) -- MEMBER
n "\xe2\x80\xaa"
# U+2060 WORD JOINER: DI (2060..206F) -- MEMBER
n "\xe2\x81\xa0"
# U+2065 UNASSIGNED inside 2060..206F: DI (DI covers unassigned code points in its ranges) -- MEMBER
n "\xe2\x81\xa5"
# U+206F NOMINAL DIGIT SHAPES: DI, last of 2060..206F -- MEMBER
n "\xe2\x81\xaf"
# U+3164 HANGUL FILLER: DI -- MEMBER
n "\xe3\x85\xa4"
# U+FE00 VARIATION SELECTOR-1: DI -- MEMBER
n "\xef\xb8\x80"
# U+FEFF BOM / ZWNBSP: DI -- MEMBER
n "\xef\xbb\xbf"
# U+FFA0 HALFWIDTH HANGUL FILLER: DI -- MEMBER
n "\xef\xbe\xa0"
# U+FFF0 unassigned FFF0: DI (FFF0..FFF8) -- MEMBER
n "\xef\xbf\xb0"
# U+FFF8 unassigned FFF8: DI -- MEMBER
n "\xef\xbf\xb8"
# U+1D173 MUSICAL SYMBOL BEGIN BEAM: DI (1D173..1D17A) -- MEMBER
n "\xf0\x9d\x85\xb3"
# U+E0000 unassigned E0000: DI (E0000..E0FFF) -- MEMBER
n "\xf3\xa0\x80\x80"
# U+E0001 LANGUAGE TAG: DI -- MEMBER
n "\xf3\xa0\x80\x81"
# U+E0FFF last of E0000..E0FFF: DI -- MEMBER
n "\xf3\xa0\xbf\xbf"
# U+0020 SPACE -- non-member
m "\x20" 0 1
# U+0061 LATIN SMALL a -- non-member
m "a" 0 1
# U+00AC NOT SIGN: neighbour of AD -- non-member
m "\xc2\xac" 0 2
# U+00AE REGISTERED SIGN: neighbour of AD -- non-member
m "\xc2\xae" 0 2
# U+200A HAIR SPACE: just below 200B -- non-member
m "\xe2\x80\x8a" 0 3
# U+2010 HYPHEN: just above 200F-ish, not DI -- non-member
m "\xe2\x80\x90" 0 3
# U+2029 PARAGRAPH SEPARATOR: just below 202A... not DI -- non-member
m "\xe2\x80\xa9" 0 3
# U+2070 SUPERSCRIPT ZERO: just above 206F -- non-member
m "\xe2\x81\xb0" 0 3
# U+FFF9 INTERLINEAR ANNOTATION ANCHOR: just above FFF8, not DI -- non-member
m "\xef\xbf\xb9" 0 3
# U+FFFD REPLACEMENT CHARACTER: not DI -- non-member
m "\xef\xbf\xbd" 0 3
# U+E1000 just above E0FFF: not DI -- non-member
m "\xf3\xa1\x80\x80" 0 4
# U+1D172 just below 1D173: not DI -- non-member
m "\xf0\x9d\x85\xb2" 0 4

# Default_Ignorable_Code_Point: inside a class with another item (U+0020)
# pcre2-only
pattern [\x{20}\p{Default_Ignorable_Code_Point}]
features unicode-props
encoding utf8
# U+00AD SOFT HYPHEN: DI -- MEMBER
m "\xc2\xad" 0 2
# U+034F COMBINING GRAPHEME JOINER: DI -- MEMBER
m "\xcd\x8f" 0 2
# U+061C ARABIC LETTER MARK: DI -- MEMBER
m "\xd8\x9c" 0 2
# U+115F HANGUL CHOSEONG FILLER: DI -- MEMBER
m "\xe1\x85\x9f" 0 3
# U+180B MONGOLIAN FREE VARIATION SELECTOR ONE: DI -- MEMBER
m "\xe1\xa0\x8b" 0 3
# U+180E MONGOLIAN VOWEL SEPARATOR: DI -- MEMBER
m "\xe1\xa0\x8e" 0 3
# U+200B ZERO WIDTH SPACE: DI (200B..200F) -- MEMBER
m "\xe2\x80\x8b" 0 3
# U+200F RIGHT-TO-LEFT MARK: DI -- MEMBER
m "\xe2\x80\x8f" 0 3
# U+202A LEFT-TO-RIGHT EMBEDDING: DI (202A..202E) -- MEMBER
m "\xe2\x80\xaa" 0 3
# U+2060 WORD JOINER: DI (2060..206F) -- MEMBER
m "\xe2\x81\xa0" 0 3
# U+2065 UNASSIGNED inside 2060..206F: DI (DI covers unassigned code points in its ranges) -- MEMBER
m "\xe2\x81\xa5" 0 3
# U+206F NOMINAL DIGIT SHAPES: DI, last of 2060..206F -- MEMBER
m "\xe2\x81\xaf" 0 3
# U+3164 HANGUL FILLER: DI -- MEMBER
m "\xe3\x85\xa4" 0 3
# U+FE00 VARIATION SELECTOR-1: DI -- MEMBER
m "\xef\xb8\x80" 0 3
# U+FEFF BOM / ZWNBSP: DI -- MEMBER
m "\xef\xbb\xbf" 0 3
# U+FFA0 HALFWIDTH HANGUL FILLER: DI -- MEMBER
m "\xef\xbe\xa0" 0 3
# U+FFF0 unassigned FFF0: DI (FFF0..FFF8) -- MEMBER
m "\xef\xbf\xb0" 0 3
# U+FFF8 unassigned FFF8: DI -- MEMBER
m "\xef\xbf\xb8" 0 3
# U+1D173 MUSICAL SYMBOL BEGIN BEAM: DI (1D173..1D17A) -- MEMBER
m "\xf0\x9d\x85\xb3" 0 4
# U+E0000 unassigned E0000: DI (E0000..E0FFF) -- MEMBER
m "\xf3\xa0\x80\x80" 0 4
# U+E0001 LANGUAGE TAG: DI -- MEMBER
m "\xf3\xa0\x80\x81" 0 4
# U+E0FFF last of E0000..E0FFF: DI -- MEMBER
m "\xf3\xa0\xbf\xbf" 0 4
# U+0020 SPACE -- non-member of the property but IS the extra class item
m "\x20" 0 1
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+00AC NOT SIGN: neighbour of AD -- non-member
n "\xc2\xac"
# U+00AE REGISTERED SIGN: neighbour of AD -- non-member
n "\xc2\xae"
# U+200A HAIR SPACE: just below 200B -- non-member
n "\xe2\x80\x8a"
# U+2010 HYPHEN: just above 200F-ish, not DI -- non-member
n "\xe2\x80\x90"
# U+2029 PARAGRAPH SEPARATOR: just below 202A... not DI -- non-member
n "\xe2\x80\xa9"
# U+2070 SUPERSCRIPT ZERO: just above 206F -- non-member
n "\xe2\x81\xb0"
# U+FFF9 INTERLINEAR ANNOTATION ANCHOR: just above FFF8, not DI -- non-member
n "\xef\xbf\xb9"
# U+FFFD REPLACEMENT CHARACTER: not DI -- non-member
n "\xef\xbf\xbd"
# U+E1000 just above E0FFF: not DI -- non-member
n "\xf3\xa1\x80\x80"
# U+1D172 just below 1D173: not DI -- non-member
n "\xf0\x9d\x85\xb2"

# Default_Ignorable_Code_Point: under flags i the set is UNCHANGED (spec cli.md 1.17.1 para 3: only Lu Ll Lt change)
