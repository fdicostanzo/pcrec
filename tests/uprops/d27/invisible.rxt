# Pattern_White_Space: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Pattern_White_Space}
features unicode-props
encoding utf8
# U+0009 TAB -- MEMBER
m "\x09" 0 1
# U+000A LF -- MEMBER
m "\x0a" 0 1
# U+000D CR -- MEMBER
m "\x0d" 0 1
# U+0020 SPACE -- MEMBER
m "\x20" 0 1
# U+0085 NEXT LINE -- MEMBER
m "\xc2\x85" 0 2
# U+200E LRM -- MEMBER
m "\xe2\x80\x8e" 0 3
# U+200F RLM -- MEMBER
m "\xe2\x80\x8f" 0 3
# U+2028 LINE SEPARATOR -- MEMBER
m "\xe2\x80\xa8" 0 3
# U+2029 PARAGRAPH SEPARATOR -- MEMBER
m "\xe2\x80\xa9" 0 3
# U+00A0 NBSP: White_Space but NOT Pattern_White_Space -- non-member
n "\xc2\xa0"
# U+2000 EN QUAD: not Pattern_White_Space -- non-member
n "\xe2\x80\x80"
# U+1680 OGHAM SPACE MARK: no -- non-member
n "\xe1\x9a\x80"
# U+3000 IDEOGRAPHIC SPACE: no -- non-member
n "\xe3\x80\x80"
# U+200B ZWSP: no -- non-member
n "\xe2\x80\x8b"
# U+001C FILE SEPARATOR: no -- non-member
n "\x1c"
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+002A ASTERISK -- non-member
n "\x2a"
# U+0008 BACKSPACE: just below TAB -- non-member
n "\x08"

