# Bidi_Control: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Bidi_Control}
features unicode-props
encoding utf8
# U+061C ARABIC LETTER MARK -- MEMBER
m "\xd8\x9c" 0 2
# U+200E LEFT-TO-RIGHT MARK -- MEMBER
m "\xe2\x80\x8e" 0 3
# U+200F RIGHT-TO-LEFT MARK -- MEMBER
m "\xe2\x80\x8f" 0 3
# U+202A LRE -- MEMBER
m "\xe2\x80\xaa" 0 3
# U+202B RLE -- MEMBER
m "\xe2\x80\xab" 0 3
# U+202C PDF -- MEMBER
m "\xe2\x80\xac" 0 3
# U+202D LRO -- MEMBER
m "\xe2\x80\xad" 0 3
# U+202E RLO -- MEMBER
m "\xe2\x80\xae" 0 3
# U+2066 LEFT-TO-RIGHT ISOLATE -- MEMBER
m "\xe2\x81\xa6" 0 3
# U+2067 RLI -- MEMBER
m "\xe2\x81\xa7" 0 3
# U+2068 FSI -- MEMBER
m "\xe2\x81\xa8" 0 3
# U+2069 PDI -- MEMBER
m "\xe2\x81\xa9" 0 3
# U+200B ZWSP: DI but not Bidi_Control -- non-member
n "\xe2\x80\x8b"
# U+200D ZWJ -- non-member
n "\xe2\x80\x8d"
# U+2065 unassigned just below LRI -- non-member
n "\xe2\x81\xa5"
# U+206A INHIBIT SYMMETRIC SWAPPING: just above PDI, not Bidi_Control -- non-member
n "\xe2\x81\xaa"
# U+2029 PARAGRAPH SEPARATOR: just below 202A -- non-member
n "\xe2\x80\xa9"
# U+202F NNBSP: just above 202E -- non-member
n "\xe2\x80\xaf"
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+061B ARABIC SEMICOLON: just below 061C -- non-member
n "\xd8\x9b"
# U+061D ARABIC END OF TEXT MARK: just above 061C -- non-member
n "\xd8\x9d"

# Bidi_Control: negated spelling [^\p{X}], utf8; membership flipped
# pcre2-only
pattern [^\p{Bidi_Control}]
features unicode-props
encoding utf8
# U+061C ARABIC LETTER MARK -- MEMBER
n "\xd8\x9c"
# U+200E LEFT-TO-RIGHT MARK -- MEMBER
n "\xe2\x80\x8e"
# U+200F RIGHT-TO-LEFT MARK -- MEMBER
n "\xe2\x80\x8f"
# U+202A LRE -- MEMBER
n "\xe2\x80\xaa"
# U+202B RLE -- MEMBER
n "\xe2\x80\xab"
# U+202C PDF -- MEMBER
n "\xe2\x80\xac"
# U+202D LRO -- MEMBER
n "\xe2\x80\xad"
# U+202E RLO -- MEMBER
n "\xe2\x80\xae"
# U+2066 LEFT-TO-RIGHT ISOLATE -- MEMBER
n "\xe2\x81\xa6"
# U+2067 RLI -- MEMBER
n "\xe2\x81\xa7"
# U+2068 FSI -- MEMBER
n "\xe2\x81\xa8"
# U+2069 PDI -- MEMBER
n "\xe2\x81\xa9"
# U+200B ZWSP: DI but not Bidi_Control -- non-member
m "\xe2\x80\x8b" 0 3
# U+200D ZWJ -- non-member
m "\xe2\x80\x8d" 0 3
# U+2065 unassigned just below LRI -- non-member
m "\xe2\x81\xa5" 0 3
# U+206A INHIBIT SYMMETRIC SWAPPING: just above PDI, not Bidi_Control -- non-member
m "\xe2\x81\xaa" 0 3
# U+2029 PARAGRAPH SEPARATOR: just below 202A -- non-member
m "\xe2\x80\xa9" 0 3
# U+202F NNBSP: just above 202E -- non-member
m "\xe2\x80\xaf" 0 3
# U+0061 LATIN SMALL a -- non-member
m "a" 0 1
# U+061B ARABIC SEMICOLON: just below 061C -- non-member
m "\xd8\x9b" 0 2
# U+061D ARABIC END OF TEXT MARK: just above 061C -- non-member
m "\xd8\x9d" 0 2

# Bidi_Mirrored: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Bidi_Mirrored}
features unicode-props
encoding utf8
# U+0028 LEFT PARENTHESIS -- MEMBER
m "\x28" 0 1
# U+0029 RIGHT PARENTHESIS -- MEMBER
m "\x29" 0 1
# U+003C LESS-THAN SIGN -- MEMBER
m "\x3c" 0 1
# U+003E GREATER-THAN SIGN -- MEMBER
m "\x3e" 0 1
# U+005B LEFT SQUARE BRACKET -- MEMBER
m "\x5b" 0 1
# U+005D RIGHT SQUARE BRACKET -- MEMBER
m "\x5d" 0 1
# U+007B LEFT CURLY BRACKET -- MEMBER
m "\x7b" 0 1
# U+007D RIGHT CURLY BRACKET -- MEMBER
m "\x7d" 0 1
# U+00AB LEFT-POINTING DOUBLE ANGLE QUOTATION MARK -- MEMBER
m "\xc2\xab" 0 2
# U+00BB RIGHT-POINTING DOUBLE ANGLE QUOTATION MARK -- MEMBER
m "\xc2\xbb" 0 2
# U+2208 ELEMENT OF -- MEMBER
m "\xe2\x88\x88" 0 3
# U+2264 LESS-THAN OR EQUAL TO -- MEMBER
m "\xe2\x89\xa4" 0 3
# U+3008 LEFT ANGLE BRACKET -- MEMBER
m "\xe3\x80\x88" 0 3
# U+FF08 FULLWIDTH LEFT PARENTHESIS -- MEMBER
m "\xef\xbc\x88" 0 3
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+0030 DIGIT ZERO -- non-member
n "0"
# U+002F SOLIDUS: not mirrored -- non-member
n "\x2f"
# U+005C REVERSE SOLIDUS: not mirrored -- non-member
n "\x5c"
# U+0022 QUOTATION MARK: not mirrored -- non-member
n "\x22"
# U+2018 LEFT SINGLE QUOTATION MARK: not Bidi_Mirrored -- non-member
n "\xe2\x80\x98"
# U+0027 APOSTROPHE: no -- non-member
n "\x27"
# U+002B PLUS SIGN: Sm but not mirrored -- non-member
n "\x2b"
# U+003D EQUALS SIGN: not mirrored -- non-member
n "\x3d"
# U+2015 HORIZONTAL BAR: no -- non-member
n "\xe2\x80\x95"

# Bidi_Mirrored: negated spelling \P{^X} (is \p{X}), utf8; membership flipped
# pcre2-only
pattern \P{^Bidi_Mirrored}
features unicode-props
encoding utf8
# U+0028 LEFT PARENTHESIS -- MEMBER
m "\x28" 0 1
# U+0029 RIGHT PARENTHESIS -- MEMBER
m "\x29" 0 1
# U+003C LESS-THAN SIGN -- MEMBER
m "\x3c" 0 1
# U+003E GREATER-THAN SIGN -- MEMBER
m "\x3e" 0 1
# U+005B LEFT SQUARE BRACKET -- MEMBER
m "\x5b" 0 1
# U+005D RIGHT SQUARE BRACKET -- MEMBER
m "\x5d" 0 1
# U+007B LEFT CURLY BRACKET -- MEMBER
m "\x7b" 0 1
# U+007D RIGHT CURLY BRACKET -- MEMBER
m "\x7d" 0 1
# U+00AB LEFT-POINTING DOUBLE ANGLE QUOTATION MARK -- MEMBER
m "\xc2\xab" 0 2
# U+00BB RIGHT-POINTING DOUBLE ANGLE QUOTATION MARK -- MEMBER
m "\xc2\xbb" 0 2
# U+2208 ELEMENT OF -- MEMBER
m "\xe2\x88\x88" 0 3
# U+2264 LESS-THAN OR EQUAL TO -- MEMBER
m "\xe2\x89\xa4" 0 3
# U+3008 LEFT ANGLE BRACKET -- MEMBER
m "\xe3\x80\x88" 0 3
# U+FF08 FULLWIDTH LEFT PARENTHESIS -- MEMBER
m "\xef\xbc\x88" 0 3
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+0030 DIGIT ZERO -- non-member
n "0"
# U+002F SOLIDUS: not mirrored -- non-member
n "\x2f"
# U+005C REVERSE SOLIDUS: not mirrored -- non-member
n "\x5c"
# U+0022 QUOTATION MARK: not mirrored -- non-member
n "\x22"
# U+2018 LEFT SINGLE QUOTATION MARK: not Bidi_Mirrored -- non-member
n "\xe2\x80\x98"
# U+0027 APOSTROPHE: no -- non-member
n "\x27"
# U+002B PLUS SIGN: Sm but not mirrored -- non-member
n "\x2b"
# U+003D EQUALS SIGN: not mirrored -- non-member
n "\x3d"
# U+2015 HORIZONTAL BAR: no -- non-member
n "\xe2\x80\x95"

# Bidi_Mirrored: inside a class with another item (U+0061)
# pcre2-only
pattern [\x{61}\p{Bidi_Mirrored}]
features unicode-props
encoding utf8
# U+0028 LEFT PARENTHESIS -- MEMBER
m "\x28" 0 1
# U+0029 RIGHT PARENTHESIS -- MEMBER
