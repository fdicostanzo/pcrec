# byte encoding (Latin-1 clamp): \p{Age=1.1}
# pcre2-only
pattern \p{Age=1.1}
features unicode-props
encoding byte
# byte 0x41 -- Age=1.1 of its Latin-1 code point
m "A" 0 1
# byte 0x20 -- Age=1.1 of its Latin-1 code point
m "\x20" 0 1
# byte 0xA0 -- Age=1.1 of its Latin-1 code point
m "\xa0" 0 1

# byte encoding (Latin-1 clamp): \p{Age=2.1}
# pcre2-only
pattern \p{Age=2.1}
features unicode-props
encoding byte
# byte 0x41 -- Age=1.1 of its Latin-1 code point
n "A"
# byte 0x20 -- Age=1.1 of its Latin-1 code point
n "\x20"
# byte 0xA0 -- Age=1.1 of its Latin-1 code point
n "\xa0"

# byte encoding (Latin-1 clamp): \p{Age=6.0}
# pcre2-only
pattern \p{Age=6.0}
features unicode-props
encoding byte
# byte 0x41 -- Age=1.1 of its Latin-1 code point
n "A"
# byte 0x20 -- Age=1.1 of its Latin-1 code point
n "\x20"
# byte 0xA0 -- Age=1.1 of its Latin-1 code point
n "\xa0"

# REFUSED: no such Unicode version
# pcre2-only
pattern \p{Age=99.0}
features unicode-props
encoding utf8
perr

# REFUSED: empty value
# pcre2-only
pattern \p{Age=}
features unicode-props
encoding utf8
perr

# REFUSED: not a version
# pcre2-only
pattern \p{Age=six}
features unicode-props
encoding utf8
perr

# REFUSED: not a version
# pcre2-only
pattern \p{Age=6.1.1}
features unicode-props
encoding utf8
perr

# REFUSED: prefix with no value
# pcre2-only
pattern \p{Age}
features unicode-props
encoding utf8
perr

# REFUSED: there was no Unicode 1.2 age value
# pcre2-only
pattern \p{Age=1.2}
features unicode-props
encoding utf8
perr

# no features line, byte encoding: Age needs unicode-props
# pcre2-only
pattern \p{Age=6.1}
encoding byte
perr

# no features line, utf8: unicode-props implied by -e utf8, so Age works
# pcre2-only
pattern \p{Age=6.1}
encoding utf8
# U+1F600 Age=6.1
m "\xf0\x9f\x98\x80" 0 4
# A Age=1.1
n "A"
