# upropd27: identifier / ASCII / hex binary properties
# Written spec-first by a D27 blind author from the promise (docs/spec/cli.md 1.17.1,
# docs/design/uprop_more.md) and the Unicode Character Database 16.0 as the author
# knows it.  Every case comment names the code point and the property value claimed.
# "UNSURE:" marks a claim the author is not certain of.

# ASCII: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{ASCII}
features unicode-props
encoding utf8
# U+0001 SOH (the NUL code point cannot be passed in an argv subject) -- MEMBER
m "\x01" 0 1
# U+0041 A -- MEMBER
m "A" 0 1
# U+007E TILDE -- MEMBER
m "\x7e" 0 1
# U+007F DELETE: last ASCII -- MEMBER
m "\x7f" 0 1
# U+0080 first non-ASCII: PAD control -- non-member
n "\xc2\x80"
# U+00A0 NBSP -- non-member
n "\xc2\xa0"
# U+00FF y WITH DIAERESIS -- non-member
n "\xc3\xbf"
# U+0100 A WITH MACRON -- non-member
n "\xc4\x80"
# U+10FFFF last -- non-member
n "\xf4\x8f\xbf\xbf"

# ASCII: negated spelling [\P{X}], utf8; membership flipped
# pcre2-only
pattern [\P{ASCII}]
features unicode-props
encoding utf8
# U+0001 SOH (the NUL code point cannot be passed in an argv subject) -- MEMBER
n "\x01"
# U+0041 A -- MEMBER
n "A"
# U+007E TILDE -- MEMBER
n "\x7e"
# U+007F DELETE: last ASCII -- MEMBER
n "\x7f"
# U+0080 first non-ASCII: PAD control -- non-member
m "\xc2\x80" 0 2
# U+00A0 NBSP -- non-member
m "\xc2\xa0" 0 2
# U+00FF y WITH DIAERESIS -- non-member
m "\xc3\xbf" 0 2
# U+0100 A WITH MACRON -- non-member
m "\xc4\x80" 0 2
# U+10FFFF last -- non-member
m "\xf4\x8f\xbf\xbf" 0 4

# ASCII: inside a class with another item (U+0080)
# pcre2-only
pattern [\x{80}\p{ASCII}]
features unicode-props
encoding utf8
# U+0001 SOH (the NUL code point cannot be passed in an argv subject) -- MEMBER
m "\x01" 0 1
# U+0041 A -- MEMBER
m "A" 0 1
# U+007E TILDE -- MEMBER
m "\x7e" 0 1
# U+007F DELETE: last ASCII -- MEMBER
m "\x7f" 0 1
# U+0080 first non-ASCII: PAD control -- non-member of the property but IS the extra class item
m "\xc2\x80" 0 2
# U+00A0 NBSP -- non-member
n "\xc2\xa0"
# U+00FF y WITH DIAERESIS -- non-member
n "\xc3\xbf"
# U+0100 A WITH MACRON -- non-member
n "\xc4\x80"
# U+10FFFF last -- non-member
n "\xf4\x8f\xbf\xbf"

# ASCII_Hex_Digit: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{ASCII_Hex_Digit}
features unicode-props
encoding utf8
# U+0030 0 -- MEMBER
m "0" 0 1
# U+0039 9 -- MEMBER
m "9" 0 1
# U+0041 A -- MEMBER
m "A" 0 1
# U+0046 F -- MEMBER
m "F" 0 1
# U+0061 a -- MEMBER
m "a" 0 1
# U+0066 f -- MEMBER
m "f" 0 1
# U+002F SOLIDUS: just below 0 -- non-member
n "\x2f"
# U+003A COLON: just above 9 -- non-member
n "\x3a"
# U+0040 COMMERCIAL AT: just below A -- non-member
n "\x40"
# U+0047 G -- non-member
n "G"
# U+0060 GRAVE: just below a -- non-member
n "\x60"
# U+0067 g -- non-member
n "g"
# U+FF10 FULLWIDTH DIGIT ZERO: Hex_Digit but not ASCII_Hex_Digit -- non-member
n "\xef\xbc\x90"
# U+FF21 FULLWIDTH A: not ASCII_Hex_Digit -- non-member
n "\xef\xbc\xa1"

# ASCII_Hex_Digit: negated spelling \P{X}, utf8; membership flipped
# pcre2-only
pattern \P{ASCII_Hex_Digit}
features unicode-props
encoding utf8
# U+0030 0 -- MEMBER
n "0"
# U+0039 9 -- MEMBER
n "9"
# U+0041 A -- MEMBER
n "A"
# U+0046 F -- MEMBER
n "F"
# U+0061 a -- MEMBER
n "a"
# U+0066 f -- MEMBER
n "f"
# U+002F SOLIDUS: just below 0 -- non-member
m "\x2f" 0 1
# U+003A COLON: just above 9 -- non-member
m "\x3a" 0 1
# U+0040 COMMERCIAL AT: just below A -- non-member
m "\x40" 0 1
# U+0047 G -- non-member
m "G" 0 1
# U+0060 GRAVE: just below a -- non-member
m "\x60" 0 1
# U+0067 g -- non-member
m "g" 0 1
# U+FF10 FULLWIDTH DIGIT ZERO: Hex_Digit but not ASCII_Hex_Digit -- non-member
m "\xef\xbc\x90" 0 3
# U+FF21 FULLWIDTH A: not ASCII_Hex_Digit -- non-member
m "\xef\xbc\xa1" 0 3

# Hex_Digit: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Hex_Digit}
features unicode-props
encoding utf8
# U+0030 0 -- MEMBER
m "0" 0 1
# U+0039 9 -- MEMBER
m "9" 0 1
# U+0041 A -- MEMBER
m "A" 0 1
# U+0046 F -- MEMBER
m "F" 0 1
# U+0061 a -- MEMBER
m "a" 0 1
# U+0066 f -- MEMBER
m "f" 0 1
# U+FF10 FULLWIDTH DIGIT ZERO -- MEMBER
m "\xef\xbc\x90" 0 3
# U+FF19 FULLWIDTH DIGIT NINE -- MEMBER
m "\xef\xbc\x99" 0 3
# U+FF21 FULLWIDTH A -- MEMBER
m "\xef\xbc\xa1" 0 3
# U+FF26 FULLWIDTH F -- MEMBER
m "\xef\xbc\xa6" 0 3
# U+FF41 FULLWIDTH a -- MEMBER
m "\xef\xbd\x81" 0 3
# U+FF46 FULLWIDTH f -- MEMBER
m "\xef\xbd\x86" 0 3
# U+0047 G -- non-member
n "G"
# U+0067 g -- non-member
n "g"
# U+FF27 FULLWIDTH G -- non-member
n "\xef\xbc\xa7"
# U+FF47 FULLWIDTH g -- non-member
n "\xef\xbd\x87"
# U+0660 ARABIC-INDIC ZERO: Nd but not Hex_Digit -- non-member
n "\xd9\xa0"
# U+002F SOLIDUS -- non-member
n "\x2f"
# U+FF0F FULLWIDTH SOLIDUS -- non-member
n "\xef\xbc\x8f"
# U+FF1A FULLWIDTH COLON -- non-member
n "\xef\xbc\x9a"

# Hex_Digit: negated spelling \p{^X}, utf8; membership flipped
