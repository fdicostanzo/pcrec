m "\xf0\x9f\xa4\x80" 0 4
# U+1F9FF last code point of the block -- inside
m "\xf0\x9f\xa7\xbf" 0 4
# U+1F8FF one below the block -- outside
n "\xf0\x9f\xa3\xbf"
# U+1FA00 one above the block -- outside
n "\xf0\x9f\xa8\x80"
# U+1F97F middle of the block -- inside
m "\xf0\x9f\xa5\xbf" 0 4

# Block short alias Sup_Symbols_And_Pictographs via blk=
# pcre2-only
pattern \p{blk=Sup_Symbols_And_Pictographs}
features unicode-props
encoding utf8
# U+1F900 first code point of the block -- inside
m "\xf0\x9f\xa4\x80" 0 4
# U+1F9FF last code point of the block -- inside
m "\xf0\x9f\xa7\xbf" 0 4
# U+1F8FF one below the block -- outside
n "\xf0\x9f\xa3\xbf"
# U+1FA00 one above the block -- outside
n "\xf0\x9f\xa8\x80"
# U+1F97F middle of the block -- inside
m "\xf0\x9f\xa5\xbf" 0 4

# Block=Tags (U+E0000..U+E007F), long name spelling
# pcre2-only
pattern \p{Block=Tags}
features unicode-props
encoding utf8
# U+E0000 first code point of the block -- inside
m "\xf3\xa0\x80\x80" 0 4
# U+E007F last code point of the block -- inside
m "\xf3\xa0\x81\xbf" 0 4
# U+DFFFF one below the block -- outside
n "\xf3\x9f\xbf\xbf"
# U+E0080 one above the block -- outside
n "\xf3\xa0\x82\x80"
# U+E003F middle of the block -- inside
m "\xf3\xa0\x80\xbf" 0 4

# Block short alias Tags via blk=
# pcre2-only
pattern \p{blk=Tags}
features unicode-props
encoding utf8
# U+E0000 first code point of the block -- inside
m "\xf3\xa0\x80\x80" 0 4
# U+E007F last code point of the block -- inside
m "\xf3\xa0\x81\xbf" 0 4
# U+DFFFF one below the block -- outside
n "\xf3\x9f\xbf\xbf"
# U+E0080 one above the block -- outside
n "\xf3\xa0\x82\x80"
# U+E003F middle of the block -- inside
m "\xf3\xa0\x80\xbf" 0 4

# Block=Supplementary_Private_Use_Area-A (U+F0000..U+FFFFF), long name spelling
# pcre2-only
pattern \p{Block=Supplementary_Private_Use_Area_A}
features unicode-props
encoding utf8
# U+F0000 first code point of the block -- inside
m "\xf3\xb0\x80\x80" 0 4
# U+FFFFF last code point of the block -- inside
m "\xf3\xbf\xbf\xbf" 0 4
# U+EFFFF one below the block -- outside
n "\xf3\xaf\xbf\xbf"
# U+100000 one above the block -- outside
n "\xf4\x80\x80\x80"
# U+F7FFF middle of the block -- inside
m "\xf3\xb7\xbf\xbf" 0 4

# Block short alias Sup_PUA_A via blk=
# pcre2-only
pattern \p{blk=Sup_PUA_A}
features unicode-props
encoding utf8
# U+F0000 first code point of the block -- inside
m "\xf3\xb0\x80\x80" 0 4
# U+FFFFF last code point of the block -- inside
m "\xf3\xbf\xbf\xbf" 0 4
# U+EFFFF one below the block -- outside
n "\xf3\xaf\xbf\xbf"
# U+100000 one above the block -- outside
n "\xf4\x80\x80\x80"
# U+F7FFF middle of the block -- inside
m "\xf3\xb7\xbf\xbf" 0 4

# Block=Supplementary_Private_Use_Area-B (U+100000..U+10FFFF), long name spelling
# pcre2-only
pattern \p{Block=Supplementary_Private_Use_Area_B}
features unicode-props
encoding utf8
# U+100000 first code point of the block -- inside
m "\xf4\x80\x80\x80" 0 4
# U+10FFFF last code point of the block -- inside
m "\xf4\x8f\xbf\xbf" 0 4
# U+FFFFF one below the block -- outside
n "\xf3\xbf\xbf\xbf"
# U+107FFF middle of the block -- inside
m "\xf4\x87\xbf\xbf" 0 4

# Block short alias Sup_PUA_B via blk=
# pcre2-only
pattern \p{blk=Sup_PUA_B}
features unicode-props
encoding utf8
# U+100000 first code point of the block -- inside
m "\xf4\x80\x80\x80" 0 4
# U+10FFFF last code point of the block -- inside
m "\xf4\x8f\xbf\xbf" 0 4
# U+FFFFF one below the block -- outside
n "\xf3\xbf\xbf\xbf"
# U+107FFF middle of the block -- inside
m "\xf4\x87\xbf\xbf" 0 4

# Block: unassigned code point U+0378 is still inside Greek and Coptic (block membership is not assignment)
# pcre2-only
pattern \p{Block=Greek}
features unicode-props
encoding utf8
# U+0378 unassigned in Greek and Coptic -- inside
m "\xcd\xb8" 0 2
# U+03FF last of block -- inside
m "\xcf\xbf" 0 2
# U+0400 Cyrillic -- outside
n "\xd0\x80"

# Block: colon separator, Block:Cyrillic
# pcre2-only
pattern \p{Block:Cyrillic}
features unicode-props
encoding utf8
# U+0400 first code point of the block -- inside
m "\xd0\x80" 0 2
# U+04FF last code point of the block -- inside
m "\xd3\xbf" 0 2
# U+03FF one below the block -- outside
n "\xcf\xbf"
# U+0500 one above the block -- outside
n "\xd4\x80"
# U+047F middle of the block -- inside
m "\xd1\xbf" 0 2

# Block: negation \P{Block=Cyrillic}
# pcre2-only
pattern \P{Block=Cyrillic}
features unicode-props
encoding utf8
# U+0400 first code point of the block -- inside
n "\xd0\x80"
# U+04FF last code point of the block -- inside
n "\xd3\xbf"
# U+03FF one below the block -- outside
m "\xcf\xbf" 0 2
# U+0500 one above the block -- outside
m "\xd4\x80" 0 2
# U+047F middle of the block -- inside
n "\xd1\xbf"

# Block: \p{^Block=Cyrillic}
# pcre2-only
pattern \p{^Block=Cyrillic}
features unicode-props
encoding utf8
# U+0400 first code point of the block -- inside
n "\xd0\x80"
# U+04FF last code point of the block -- inside
n "\xd3\xbf"
# U+03FF one below the block -- outside
m "\xcf\xbf" 0 2
# U+0500 one above the block -- outside
m "\xd4\x80" 0 2
# U+047F middle of the block -- inside
n "\xd1\xbf"

# Block: in a class, [\p{Block=Cyrillic}\p{Block=Hebrew}]
# pcre2-only
pattern [\p{Block=Cyrillic}\p{Block=Hebrew}]
features unicode-props
encoding utf8
# U+0400 first code point of the block -- inside
m "\xd0\x80" 0 2
# U+04FF last code point of the block -- inside
m "\xd3\xbf" 0 2
# U+0590 first of Hebrew -- inside
m "\xd6\x90" 0 2
# U+05FF last of Hebrew -- inside
m "\xd7\xbf" 0 2
# U+0500 Cyrillic Supplement -- outside both
n "\xd4\x80"
# U+0041 -- outside
n "A"

# Block: caseless matching leaves it alone, flags i
# pcre2-only
pattern \p{Block=Basic_Latin}
features unicode-props
encoding utf8
flags i
# U+0041 -- inside
m "A" 0 1
# U+0061 -- inside
m "a" 0 1
# U+00E9 -- outside
n "\xc3\xa9"

# UNSURE: loose spelling (cli.md 1.17.1 para 2 states loose matching for scripts; Block says "long name or short alias") \p{BLK=Greek}
# pcre2-only
pattern \p{BLK=Greek}
features unicode-props
encoding utf8
# U+0370 first of Greek and Coptic -- inside
m "\xcd\xb0" 0 2
# U+0400 -- outside
n "\xd0\x80"

