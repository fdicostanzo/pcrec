# Block=No_Block: code points no block holds
# pcre2-only
pattern \p{Block=No_Block}
features unicode-props
encoding utf8
# U+2FE0 gap between Kangxi Radicals (ends 2FDF) and Ideographic Description Characters (2FF0..) -- No_Block
m "\xe2\xbf\xa0" 0 3
# U+2FEF last of the 2FE0..2FEF gap -- No_Block
m "\xe2\xbf\xaf" 0 3
# U+E0080 gap between Tags (ends E007F) and Variation Selectors Supplement (E0100..) -- No_Block
m "\xf3\xa0\x82\x80" 0 4
# U+E00FF last of the E0080..E00FF gap -- No_Block
m "\xf3\xa0\x83\xbf" 0 4
# U+2FDF last of Kangxi Radicals -- in a block
n "\xe2\xbf\x9f"
# U+2FF0 first of Ideographic Description Characters -- in a block
n "\xe2\xbf\xb0"
# U+E007F last of Tags -- in a block
n "\xf3\xa0\x81\xbf"
# U+E0100 first of Variation Selectors Supplement -- in a block
n "\xf3\xa0\x84\x80"
# U+0041 -- in Basic Latin
n "A"

# Block=NB (short alias for No_Block, per the spec text)
# pcre2-only
pattern \p{blk=NB}
features unicode-props
encoding utf8
# U+2FE0 -- No_Block
m "\xe2\xbf\xa0" 0 3
# U+0041 -- Basic Latin
n "A"

# byte encoding (clamped to Latin-1): \p{Block=Basic_Latin}
# pcre2-only
pattern \p{Block=Basic_Latin}
features unicode-props
encoding byte
# byte 0x41 -- inside
m "A" 0 1
# byte 0x7F -- inside
m "\x7f" 0 1
# byte 0x80 -- outside
n "\x80"
# byte 0xE9 -- outside
n "\xe9"

# byte encoding (clamped to Latin-1): \p{Block=Latin_1_Sup}
# pcre2-only
pattern \p{Block=Latin_1_Sup}
features unicode-props
encoding byte
# byte 0x41 -- outside
n "A"
# byte 0x7F -- outside
n "\x7f"
# byte 0x80 -- inside
m "\x80" 0 1
# byte 0xE9 -- inside
m "\xe9" 0 1
# byte 0xFF -- inside
m "\xff" 0 1

# byte encoding (clamped to Latin-1): \p{Block=Greek}
# pcre2-only
pattern \p{Block=Greek}
features unicode-props
encoding byte
# byte 0x41 -- outside
n "A"
# byte 0xE9 -- outside
n "\xe9"
# byte 0xFF -- outside
n "\xff"

