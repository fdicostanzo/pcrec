# upropd27: Block extension (cli.md 1.17.1 para 5): Block=, blk=, Block:
# Written spec-first by a D27 blind author from the promise (docs/spec/cli.md 1.17.1,
# docs/design/uprop_more.md) and the Unicode Character Database 16.0 as the author
# knows it.  Every case comment names the code point and the property value claimed.
# "UNSURE:" marks a claim the author is not certain of.

# Block=Basic_Latin (U+0000..U+007F), long name spelling
# pcre2-only
pattern \p{Block=Basic_Latin}
features unicode-props
encoding utf8
# U+0000 first code point of the block -- inside
m "\x00" 0 1
# U+007F last code point of the block -- inside
m "\x7f" 0 1
# U+0080 one above the block -- outside
n "\xc2\x80"
# U+003F middle of the block -- inside
m "\x3f" 0 1

# Block short alias ASCII via blk=
# pcre2-only
pattern \p{blk=ASCII}
features unicode-props
encoding utf8
# U+0000 first code point of the block -- inside
m "\x00" 0 1
# U+007F last code point of the block -- inside
m "\x7f" 0 1
# U+0080 one above the block -- outside
n "\xc2\x80"
# U+003F middle of the block -- inside
m "\x3f" 0 1

