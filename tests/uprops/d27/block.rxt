# no features line, byte encoding: Block needs unicode-props (only -e utf8 implies it, cli.md 1.7 para 3)
# pcre2-only
pattern \p{Block=Greek}
encoding byte
perr

# no features line, utf8: unicode-props is implied by -e utf8 (cli.md 1.7 para 3), so Block works
# pcre2-only
pattern \p{Block=Greek}
encoding utf8
# U+03B1
m "\xce\xb1" 0 2
# A
n "A"
