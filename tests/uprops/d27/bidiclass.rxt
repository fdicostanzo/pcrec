# no features line, byte encoding: bc needs unicode-props
# pcre2-only
pattern \p{bc=L}
encoding byte
perr

# no features line, utf8: unicode-props implied by -e utf8, so bc works
# pcre2-only
pattern \p{bc=L}
encoding utf8
# A bc=L
m "A" 0 1
# 0 bc=EN
n "0"
