# upropd27: short property aliases (PropertyAliases.txt)
# Written spec-first by a D27 blind author from the promise (docs/spec/cli.md 1.17.1,
# docs/design/uprop_more.md) and the Unicode Character Database 16.0 as the author
# knows it.  Every case comment names the code point and the property value claimed.
# "UNSURE:" marks a claim the author is not certain of.

# Emoji_Presentation: short alias EPres (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{EPres}
features unicode-props
encoding utf8
# U+231A WATCH: Emoji_Presentation=Yes -- MEMBER
m "\xe2\x8c\x9a" 0 3
# U+231B HOURGLASS: Emoji_Presentation=Yes -- MEMBER
m "\xe2\x8c\x9b" 0 3
# U+0023 NUMBER SIGN: Emoji but text presentation by default -- non-member
n "\x23"
# U+0030 DIGIT ZERO: Emoji but not Emoji_Presentation -- non-member
n "0"

# Emoji_Modifier: short alias EMod (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{EMod}
features unicode-props
encoding utf8
# U+1F3FB FITZPATRICK TYPE-1-2: Emoji_Modifier (first of 5) -- MEMBER
m "\xf0\x9f\x8f\xbb" 0 4
# U+1F3FC FITZPATRICK TYPE-3 -- MEMBER
m "\xf0\x9f\x8f\xbc" 0 4
# U+1F3FA AMPHORA: just below the range -- non-member
n "\xf0\x9f\x8f\xba"
# U+1F400 RAT: just above the range -- non-member
n "\xf0\x9f\x90\x80"

# Emoji_Modifier_Base: short alias EBase (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{EBase}
features unicode-props
encoding utf8
# U+261D WHITE UP POINTING INDEX: Emoji_Modifier_Base=Yes -- MEMBER
m "\xe2\x98\x9d" 0 3
# U+26F9 PERSON WITH BALL: Emoji_Modifier_Base=Yes -- MEMBER
m "\xe2\x9b\xb9" 0 3
# U+1F600 GRINNING FACE: Emoji, not a modifier base -- non-member
n "\xf0\x9f\x98\x80"
# U+1F3FB FITZPATRICK modifier itself: not a base -- non-member
n "\xf0\x9f\x8f\xbb"

# Emoji_Component: short alias EComp (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{EComp}
features unicode-props
encoding utf8
# U+0023 NUMBER SIGN: Emoji_Component=Yes (keycap) -- MEMBER
m "\x23" 0 1
# U+002A ASTERISK: Emoji_Component=Yes -- MEMBER
m "\x2a" 0 1
# U+0041 LATIN CAPITAL A: no -- non-member
n "A"
# U+200C ZWNJ: neighbour of ZWJ, not Emoji_Component -- non-member
n "\xe2\x80\x8c"

# Extended_Pictographic: short alias ExtPict (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{ExtPict}
features unicode-props
encoding utf8
# U+00A9 COPYRIGHT SIGN: Extended_Pictographic=Yes -- MEMBER
m "\xc2\xa9" 0 2
# U+00AE REGISTERED SIGN: Extended_Pictographic=Yes -- MEMBER
m "\xc2\xae" 0 2
# U+0023 NUMBER SIGN: Emoji but NOT Extended_Pictographic -- non-member
n "\x23"
# U+0030 DIGIT ZERO: Emoji but NOT Extended_Pictographic -- non-member
n "0"

# Alphabetic: short alias Alpha (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Alpha}
features unicode-props
encoding utf8
# U+0041 LATIN CAPITAL A: Lu -- MEMBER
m "A" 0 1
# U+007A LATIN SMALL z: Ll -- MEMBER
m "z" 0 1
# U+0030 DIGIT ZERO: Nd -- non-member
n "0"
# U+0020 SPACE -- non-member
n "\x20"

# Lowercase: short alias Lower (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Lower}
features unicode-props
encoding utf8
# U+0061 LATIN SMALL a: Ll -- MEMBER
m "a" 0 1
# U+00AA FEMININE ORDINAL INDICATOR: Other_Lowercase -- MEMBER
m "\xc2\xaa" 0 2
# U+0041 LATIN CAPITAL A: Lu -- non-member
n "A"
# U+0031 DIGIT ONE -- non-member
n "1"

# Uppercase: short alias Upper (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Upper}
features unicode-props
encoding utf8
# U+0041 LATIN CAPITAL A: Lu -- MEMBER
m "A" 0 1
# U+005A LATIN CAPITAL Z: Lu -- MEMBER
m "Z" 0 1
# U+0061 LATIN SMALL a: Ll -- non-member
n "a"
# U+00DF LATIN SMALL SHARP S -- non-member
n "\xc3\x9f"

# Case_Ignorable: short alias CI (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{CI}
features unicode-props
encoding utf8
# U+0027 APOSTROPHE: Word_Break MidNumLet -> Case_Ignorable -- MEMBER
m "\x27" 0 1
# U+002E FULL STOP: MidNumLet -- MEMBER
m "\x2e" 0 1
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+0041 LATIN CAPITAL A -- non-member
n "A"

# Changes_When_Lowercased: short alias CWL (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{CWL}
features unicode-props
encoding utf8
# U+0041 A lowercases to a -- MEMBER
m "A" 0 1
# U+00C0 A WITH GRAVE lowercases -- MEMBER
m "\xc3\x80" 0 2
# U+0061 a is already lowercase -- non-member
n "a"
# U+0031 DIGIT ONE -- non-member
n "1"

# Changes_When_Uppercased: short alias CWU (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{CWU}
features unicode-props
encoding utf8
# U+0061 a uppercases -- MEMBER
m "a" 0 1
# U+00DF sharp s uppercases (full mapping SS) -- MEMBER
m "\xc3\x9f" 0 2
# U+0041 A is already uppercase -- non-member
n "A"
# U+0031 DIGIT ONE -- non-member
n "1"

# Changes_When_Titlecased: short alias CWT (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{CWT}
features unicode-props
encoding utf8
# U+0061 a titlecases to A -- MEMBER
m "a" 0 1
# U+00DF sharp s titlecases to Ss -- MEMBER
m "\xc3\x9f" 0 2
# U+0041 A already titlecase -- non-member
n "A"
# U+01C5 Dz IS titlecase: unchanged -- non-member
n "\xc7\x85"

# Changes_When_Casefolded: short alias CWCF (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{CWCF}
features unicode-props
encoding utf8
# U+0041 A folds to a -- MEMBER
m "A" 0 1
# U+00DF sharp s full-folds to ss -- MEMBER
m "\xc3\x9f" 0 2
# U+0061 a is its own fold -- non-member
n "a"
# U+0031 DIGIT ONE -- non-member
n "1"

# Changes_When_Casemapped: short alias CWCM (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{CWCM}
features unicode-props
encoding utf8
# U+0041 A maps to a -- MEMBER
m "A" 0 1
# U+0061 a maps to A -- MEMBER
m "a" 0 1
# U+0031 DIGIT ONE -- non-member
n "1"
# U+0020 SPACE -- non-member
n "\x20"

# Default_Ignorable_Code_Point: short alias DI (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{DI}
features unicode-props
encoding utf8
# U+00AD SOFT HYPHEN: DI -- MEMBER
m "\xc2\xad" 0 2
# U+034F COMBINING GRAPHEME JOINER: DI -- MEMBER
m "\xcd\x8f" 0 2
# U+0020 SPACE -- non-member
n "\x20"
# U+0061 LATIN SMALL a -- non-member
n "a"

# Bidi_Control: short alias Bidi_C (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Bidi_C}
features unicode-props
encoding utf8
# U+061C ARABIC LETTER MARK -- MEMBER
m "\xd8\x9c" 0 2
# U+200E LEFT-TO-RIGHT MARK -- MEMBER
m "\xe2\x80\x8e" 0 3
# U+200B ZWSP: DI but not Bidi_Control -- non-member
n "\xe2\x80\x8b"
# U+200D ZWJ -- non-member
n "\xe2\x80\x8d"

# Bidi_Mirrored: short alias Bidi_M (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Bidi_M}
features unicode-props
encoding utf8
# U+0028 LEFT PARENTHESIS -- MEMBER
m "\x28" 0 1
# U+0029 RIGHT PARENTHESIS -- MEMBER
m "\x29" 0 1
# U+0061 LATIN SMALL a -- non-member
n "a"
# U+0030 DIGIT ZERO -- non-member
n "0"

# Join_Control: short alias Join_C (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Join_C}
features unicode-props
encoding utf8
# U+200C ZERO WIDTH NON-JOINER -- MEMBER
m "\xe2\x80\x8c" 0 3
# U+200D ZERO WIDTH JOINER -- MEMBER
m "\xe2\x80\x8d" 0 3
# U+200B ZWSP: just below -- non-member
n "\xe2\x80\x8b"
# U+200E LRM: just above -- non-member
n "\xe2\x80\x8e"

# Variation_Selector: short alias VS (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{VS}
features unicode-props
encoding utf8
# U+180B MONGOLIAN FVS1 -- MEMBER
m "\xe1\xa0\x8b" 0 3
# U+180C MONGOLIAN FVS2 -- MEMBER
m "\xe1\xa0\x8c" 0 3
# U+180E MONGOLIAN VOWEL SEPARATOR: between FVS3 and FVS4 but NOT a variation selector -- non-member
n "\xe1\xa0\x8e"
# U+180A MONGOLIAN NIRUGU: no -- non-member
n "\xe1\xa0\x8a"

# Noncharacter_Code_Point: short alias NChar (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{NChar}
features unicode-props
encoding utf8
# U+FDD0 first of FDD0..FDEF -- MEMBER
m "\xef\xb7\x90" 0 3
# U+FDEF last of FDD0..FDEF -- MEMBER
m "\xef\xb7\xaf" 0 3
# U+FDCF just below FDD0: unassigned but NOT a noncharacter -- non-member
n "\xef\xb7\x8f"
# U+FDF0 just above FDEF: ARABIC LIGATURE SALLA USED AS KORANIC STOP SIGN ISOLATED FORM -- non-member
n "\xef\xb7\xb0"

# Pattern_White_Space: short alias Pat_WS (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Pat_WS}
features unicode-props
encoding utf8
# U+0009 TAB -- MEMBER
m "\x09" 0 1
# U+000A LF -- MEMBER
m "\x0a" 0 1
# U+00A0 NBSP: White_Space but NOT Pattern_White_Space -- non-member
n "\xc2\xa0"
# U+2000 EN QUAD: not Pattern_White_Space -- non-member
n "\xe2\x80\x80"

# White_Space: short alias space (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{space}
features unicode-props
encoding utf8
# U+0009 TAB -- MEMBER
m "\x09" 0 1
# U+000D CR -- MEMBER
m "\x0d" 0 1
# U+180E MONGOLIAN VOWEL SEPARATOR: was White_Space before 6.3, no longer -- non-member
n "\xe1\xa0\x8e"
# U+200B ZWSP: not White_Space -- non-member
n "\xe2\x80\x8b"

# White_Space: short alias WSpace (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{WSpace}
features unicode-props
encoding utf8
# U+0009 TAB -- MEMBER
m "\x09" 0 1
# U+000D CR -- MEMBER
m "\x0d" 0 1
# U+180E MONGOLIAN VOWEL SEPARATOR: was White_Space before 6.3, no longer -- non-member
n "\xe1\xa0\x8e"
# U+200B ZWSP: not White_Space -- non-member
n "\xe2\x80\x8b"

# ASCII_Hex_Digit: short alias AHex (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{AHex}
features unicode-props
encoding utf8
# U+0030 0 -- MEMBER
m "0" 0 1
# U+0039 9 -- MEMBER
m "9" 0 1
# U+002F SOLIDUS: just below 0 -- non-member
n "\x2f"
# U+003A COLON: just above 9 -- non-member
n "\x3a"

# Hex_Digit: short alias Hex (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Hex}
features unicode-props
encoding utf8
# U+0030 0 -- MEMBER
m "0" 0 1
# U+0039 9 -- MEMBER
m "9" 0 1
# U+0047 G -- non-member
n "G"
# U+0067 g -- non-member
n "g"

# ID_Start: short alias IDS (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{IDS}
features unicode-props
encoding utf8
# U+0041 A -- MEMBER
m "A" 0 1
# U+007A z -- MEMBER
m "z" 0 1
# U+0030 DIGIT ZERO: ID_Continue only -- non-member
n "0"
# U+005F LOW LINE: ID_Continue only -- non-member
n "\x5f"

# ID_Continue: short alias IDC (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{IDC}
features unicode-props
encoding utf8
# U+0030 DIGIT ZERO: Nd -- MEMBER
m "0" 0 1
# U+0041 A -- MEMBER
m "A" 0 1
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"
# U+0020 SPACE -- non-member
n "\x20"

# XID_Start: short alias XIDS (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{XIDS}
features unicode-props
encoding utf8
# U+0041 A -- MEMBER
m "A" 0 1
# U+007A z -- MEMBER
m "z" 0 1
# U+037A GREEK YPOGEGRAMMENI: ID_Start but XID_Start excluded (NFKC is space+iota) -- non-member
n "\xcd\xba"
# U+309B KATAKANA-HIRAGANA VOICED SOUND MARK: ID_Start but not XID_Start (NFKC starts with space) -- non-member
n "\xe3\x82\x9b"

# XID_Continue: short alias XIDC (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{XIDC}
features unicode-props
encoding utf8
# U+0030 DIGIT ZERO -- MEMBER
m "0" 0 1
# U+0041 A -- MEMBER
m "A" 0 1
# U+037A GREEK YPOGEGRAMMENI: ID_Continue but not XID_Continue -- non-member
n "\xcd\xba"
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"

# Ideographic: short alias Ideo (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Ideo}
features unicode-props
encoding utf8
# U+3006 IDEOGRAPHIC CLOSING MARK: Lo, Ideographic -- MEMBER
m "\xe3\x80\x86" 0 3
# U+3007 IDEOGRAPHIC NUMBER ZERO -- MEMBER
m "\xe3\x80\x87" 0 3
# U+3005 IDEOGRAPHIC ITERATION MARK: Lm, not Ideographic -- non-member
n "\xe3\x80\x85"
# U+3008 LEFT ANGLE BRACKET -- non-member
n "\xe3\x80\x88"

# Unified_Ideograph: short alias UIdeo (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{UIdeo}
features unicode-props
encoding utf8
# U+3400 EXT A first -- MEMBER
m "\xe3\x90\x80" 0 3
# U+4DBF EXT A last -- MEMBER
m "\xe4\xb6\xbf" 0 3
# U+F900 COMPATIBILITY IDEOGRAPH-F900: Ideographic but NOT Unified_Ideograph -- non-member
n "\xef\xa4\x80"
# U+FA10 COMPATIBILITY IDEOGRAPH-FA10: not unified -- non-member
n "\xef\xa8\x90"

# IDS_Binary_Operator: short alias IDSB (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{IDSB}
features unicode-props
encoding utf8
# U+2FF0 LEFT TO RIGHT -- MEMBER
m "\xe2\xbf\xb0" 0 3
# U+2FF1 ABOVE TO BELOW -- MEMBER
m "\xe2\xbf\xb1" 0 3
# U+2FF2 LEFT TO MIDDLE AND RIGHT: trinary -- non-member
n "\xe2\xbf\xb2"
# U+2FF3 ABOVE TO MIDDLE AND BELOW: trinary -- non-member
n "\xe2\xbf\xb3"

# IDS_Trinary_Operator: short alias IDST (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{IDST}
features unicode-props
encoding utf8
# U+2FF2 LEFT TO MIDDLE AND RIGHT -- MEMBER
m "\xe2\xbf\xb2" 0 3
# U+2FF3 ABOVE TO MIDDLE AND BELOW -- MEMBER
m "\xe2\xbf\xb3" 0 3
# U+2FF0 binary -- non-member
n "\xe2\xbf\xb0"
# U+2FF1 binary -- non-member
n "\xe2\xbf\xb1"

# Quotation_Mark: short alias QMark (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{QMark}
features unicode-props
encoding utf8
# U+0022 QUOTATION MARK -- MEMBER
m "\x22" 0 1
# U+0027 APOSTROPHE -- MEMBER
m "\x27" 0 1
# U+0060 GRAVE ACCENT: not Quotation_Mark -- non-member
n "\x60"
# U+00B4 ACUTE ACCENT -- non-member
n "\xc2\xb4"

# Terminal_Punctuation: short alias Term (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Term}
features unicode-props
encoding utf8
# U+0021 EXCLAMATION MARK -- MEMBER
m "\x21" 0 1
# U+002C COMMA -- MEMBER
m "\x2c" 0 1
# U+0028 LEFT PARENTHESIS -- non-member
n "\x28"
# U+0022 QUOTATION MARK -- non-member
n "\x22"

# Sentence_Terminal: short alias STerm (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{STerm}
features unicode-props
encoding utf8
# U+0021 EXCLAMATION MARK -- MEMBER
m "\x21" 0 1
# U+002E FULL STOP -- MEMBER
m "\x2e" 0 1
# U+002C COMMA: Terminal_Punctuation but not Sentence_Terminal -- non-member
n "\x2c"
# U+003A COLON: Terminal_Punctuation only -- non-member
n "\x3a"

# Pattern_Syntax: short alias Pat_Syn (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Pat_Syn}
features unicode-props
encoding utf8
# U+0021 EXCLAMATION MARK -- MEMBER
m "\x21" 0 1
# U+002F SOLIDUS -- MEMBER
m "\x2f" 0 1
# U+005F LOW LINE: NOT Pattern_Syntax (it is ID_Continue) -- non-member
n "\x5f"
# U+0030 DIGIT ZERO -- non-member
n "0"

# Deprecated: short alias Dep (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Dep}
features unicode-props
encoding utf8
# U+0149 LATIN SMALL N PRECEDED BY APOSTROPHE -- MEMBER
m "\xc5\x89" 0 2
# U+0673 ARABIC LETTER ALEF WITH WAVY HAMZA BELOW -- MEMBER
m "\xd9\xb3" 0 2
# U+0148 LATIN SMALL N WITH CARON: neighbour -- non-member
n "\xc5\x88"
# U+232B ERASE TO THE LEFT: just above 232A -- non-member
n "\xe2\x8c\xab"

# Soft_Dotted: short alias SD (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{SD}
features unicode-props
encoding utf8
# U+0069 LATIN SMALL i -- MEMBER
m "i" 0 1
# U+006A LATIN SMALL j -- MEMBER
m "j" 0 1
# U+0049 LATIN CAPITAL I -- non-member
n "I"
# U+006C LATIN SMALL l -- non-member
n "l"

# Diacritic: short alias Dia (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Dia}
features unicode-props
encoding utf8
# U+005E CIRCUMFLEX ACCENT -- MEMBER
m "\x5e" 0 1
# U+0060 GRAVE ACCENT -- MEMBER
m "\x60" 0 1
# U+0061 a -- non-member
n "a"
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"

# Extender: short alias Ext (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Ext}
features unicode-props
encoding utf8
# U+00B7 MIDDLE DOT -- MEMBER
m "\xc2\xb7" 0 2
# U+02D0 MODIFIER LETTER TRIANGULAR COLON -- MEMBER
m "\xcb\x90" 0 2
# U+02CF just below 02D0 -- non-member
n "\xcb\x8f"
# U+0641 ARABIC LETTER FEH: just above tatweel -- non-member
n "\xd9\x81"

# Logical_Order_Exception: short alias LOE (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{LOE}
features unicode-props
encoding utf8
# U+0E40 THAI CHARACTER SARA E -- MEMBER
m "\xe0\xb9\x80" 0 3
# U+0E44 THAI CHARACTER SARA AI MAIMALAI -- MEMBER
m "\xe0\xb9\x84" 0 3
# U+0E45 THAI CHARACTER LAKKHANGYAO: just above -- non-member
n "\xe0\xb9\x85"
# U+0E3F THAI BAHT: just below -- non-member
n "\xe0\xb8\xbf"

# Regional_Indicator: short alias RI (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{RI}
features unicode-props
encoding utf8
# U+1F1E6 REGIONAL INDICATOR SYMBOL LETTER A -- MEMBER
m "\xf0\x9f\x87\xa6" 0 4
# U+1F1FF REGIONAL INDICATOR SYMBOL LETTER Z -- MEMBER
m "\xf0\x9f\x87\xbf" 0 4
# U+1F1E5 just below -- non-member
n "\xf0\x9f\x87\xa5"
# U+1F200 SQUARE HIRAGANA HOKA: just above -- non-member
n "\xf0\x9f\x88\x80"

# Prepended_Concatenation_Mark: short alias PCM (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{PCM}
features unicode-props
encoding utf8
# U+0600 ARABIC NUMBER SIGN -- MEMBER
m "\xd8\x80" 0 2
# U+0605 ARABIC NUMBER MARK ABOVE -- MEMBER
m "\xd8\x85" 0 2
# U+0606 ARABIC-INDIC CUBE ROOT: just above -- non-member
n "\xd8\x86"
# U+06DE ARABIC START OF RUB EL HIZB -- non-member
n "\xdb\x9e"

# Grapheme_Base: short alias Gr_Base (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Gr_Base}
features unicode-props
encoding utf8
# U+0061 a -- MEMBER
m "a" 0 1
# U+0020 SPACE: Zs is a base -- MEMBER
m "\x20" 0 1
# U+0001 SOH: Cc -- non-member
n "\x01"
# U+007F DELETE: Cc -- non-member
n "\x7f"

# Grapheme_Extend: short alias Gr_Ext (spec: every short alias PropertyAliases.txt lists)
# pcre2-only
pattern \p{Gr_Ext}
features unicode-props
encoding utf8
# U+0300 COMBINING GRAVE: Mn -- MEMBER
m "\xcc\x80" 0 2
# U+036F COMBINING LATIN SMALL LETTER X: Mn -- MEMBER
m "\xcd\xaf" 0 2
# U+0061 a -- non-member
n "a"
# U+0903 DEVANAGARI SIGN VISARGA: Mc, not extend -- non-member
n "\xe0\xa4\x83"
