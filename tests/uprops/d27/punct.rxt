m "\xe2\x80\x95" 0 3
# U+2053 SWUNG DASH -- MEMBER
m "\xe2\x81\x93" 0 3
# U+207B SUPERSCRIPT MINUS -- MEMBER
m "\xe2\x81\xbb" 0 3
# U+2212 MINUS SIGN -- MEMBER
m "\xe2\x88\x92" 0 3
# U+301C WAVE DASH -- MEMBER
m "\xe3\x80\x9c" 0 3
# U+30A0 KATAKANA-HIRAGANA DOUBLE HYPHEN -- MEMBER
m "\xe3\x82\xa0" 0 3
# U+FF0D FULLWIDTH HYPHEN-MINUS -- MEMBER
m "\xef\xbc\x8d" 0 3
# U+10EAD YEZIDI HYPHENATION MARK -- MEMBER
m "\xf0\x90\xba\xad" 0 4
# U+005F LOW LINE: not Dash -- non-member of the property but IS the extra class item
m "\x5f" 0 1
# U+2016 DOUBLE VERTICAL LINE: just above 2015 -- non-member
n "\xe2\x80\x96"
# U+200F RLM -- non-member
n "\xe2\x80\x8f"
# U+2009 THIN SPACE -- non-member
n "\xe2\x80\x89"
# U+00AD SOFT HYPHEN: not Dash -- non-member
n "\xc2\xad"
# U+002B PLUS SIGN -- non-member
n "\x2b"
# U+0061 a -- non-member
n "a"
# U+002F SOLIDUS -- non-member
n "\x2f"

# Quotation_Mark: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Quotation_Mark}
features unicode-props
encoding utf8
# U+0022 QUOTATION MARK -- MEMBER
m "\x22" 0 1
# U+0027 APOSTROPHE -- MEMBER
m "\x27" 0 1
# U+00AB LEFT DOUBLE ANGLE QUOTATION -- MEMBER
m "\xc2\xab" 0 2
# U+00BB RIGHT DOUBLE ANGLE QUOTATION -- MEMBER
m "\xc2\xbb" 0 2
# U+2018 LEFT SINGLE QUOTATION MARK -- MEMBER
m "\xe2\x80\x98" 0 3
# U+201F DOUBLE HIGH-REVERSED-9 QUOTATION MARK -- MEMBER
m "\xe2\x80\x9f" 0 3
# U+2039 SINGLE LEFT-POINTING ANGLE QUOTATION -- MEMBER
m "\xe2\x80\xb9" 0 3
# U+300C LEFT CORNER BRACKET -- MEMBER
m "\xe3\x80\x8c" 0 3
# U+FF02 FULLWIDTH QUOTATION MARK -- MEMBER
m "\xef\xbc\x82" 0 3
# U+0060 GRAVE ACCENT: not Quotation_Mark -- non-member
n "\x60"
# U+00B4 ACUTE ACCENT -- non-member
n "\xc2\xb4"
# U+2017 DOUBLE LOW LINE: just below 2018 -- non-member
n "\xe2\x80\x97"
# U+2020 DAGGER: just above 201F -- non-member
n "\xe2\x80\xa0"
# U+3010 LEFT BLACK LENTICULAR BRACKET: not a quotation mark -- non-member
n "\xe3\x80\x90"
# U+0028 LEFT PARENTHESIS -- non-member
n "\x28"
# U+0061 a -- non-member
n "a"

# Quotation_Mark: negated spelling [^\p{X}], utf8; membership flipped
# pcre2-only
pattern [^\p{Quotation_Mark}]
features unicode-props
encoding utf8
# U+0022 QUOTATION MARK -- MEMBER
n "\x22"
# U+0027 APOSTROPHE -- MEMBER
n "\x27"
# U+00AB LEFT DOUBLE ANGLE QUOTATION -- MEMBER
n "\xc2\xab"
# U+00BB RIGHT DOUBLE ANGLE QUOTATION -- MEMBER
n "\xc2\xbb"
# U+2018 LEFT SINGLE QUOTATION MARK -- MEMBER
n "\xe2\x80\x98"
# U+201F DOUBLE HIGH-REVERSED-9 QUOTATION MARK -- MEMBER
n "\xe2\x80\x9f"
# U+2039 SINGLE LEFT-POINTING ANGLE QUOTATION -- MEMBER
n "\xe2\x80\xb9"
# U+300C LEFT CORNER BRACKET -- MEMBER
n "\xe3\x80\x8c"
# U+FF02 FULLWIDTH QUOTATION MARK -- MEMBER
n "\xef\xbc\x82"
# U+0060 GRAVE ACCENT: not Quotation_Mark -- non-member
m "\x60" 0 1
# U+00B4 ACUTE ACCENT -- non-member
m "\xc2\xb4" 0 2
# U+2017 DOUBLE LOW LINE: just below 2018 -- non-member
m "\xe2\x80\x97" 0 3
# U+2020 DAGGER: just above 201F -- non-member
m "\xe2\x80\xa0" 0 3
# U+3010 LEFT BLACK LENTICULAR BRACKET: not a quotation mark -- non-member
m "\xe3\x80\x90" 0 3
# U+0028 LEFT PARENTHESIS -- non-member
m "\x28" 0 1
# U+0061 a -- non-member
m "a" 0 1

# Terminal_Punctuation: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Terminal_Punctuation}
features unicode-props
encoding utf8
# U+0021 EXCLAMATION MARK -- MEMBER
m "\x21" 0 1
# U+002C COMMA -- MEMBER
m "\x2c" 0 1
# U+002E FULL STOP -- MEMBER
m "\x2e" 0 1
# U+003A COLON -- MEMBER
m "\x3a" 0 1
# U+003B SEMICOLON -- MEMBER
m "\x3b" 0 1
# U+003F QUESTION MARK -- MEMBER
m "\x3f" 0 1
# U+037E GREEK QUESTION MARK -- MEMBER
m "\xcd\xbe" 0 2
# U+203C DOUBLE EXCLAMATION MARK -- MEMBER
m "\xe2\x80\xbc" 0 3
# U+3001 IDEOGRAPHIC COMMA -- MEMBER
m "\xe3\x80\x81" 0 3
# U+3002 IDEOGRAPHIC FULL STOP -- MEMBER
m "\xe3\x80\x82" 0 3
# U+FF01 FULLWIDTH EXCLAMATION MARK -- MEMBER
m "\xef\xbc\x81" 0 3
# U+0028 LEFT PARENTHESIS -- non-member
n "\x28"
# U+0022 QUOTATION MARK -- non-member
n "\x22"
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"
# U+00BF INVERTED QUESTION MARK: not terminal -- non-member
n "\xc2\xbf"
# U+00A1 INVERTED EXCLAMATION MARK: not terminal -- non-member
n "\xc2\xa1"
# U+0061 a -- non-member
n "a"

