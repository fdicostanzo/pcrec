# Sentence_Terminal: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Sentence_Terminal}
features unicode-props
encoding utf8
# U+0021 EXCLAMATION MARK -- MEMBER
m "\x21" 0 1
# U+002E FULL STOP -- MEMBER
m "\x2e" 0 1
# U+003F QUESTION MARK -- MEMBER
m "\x3f" 0 1
# U+0589 ARMENIAN FULL STOP -- MEMBER
m "\xd6\x89" 0 2
# U+203C DOUBLE EXCLAMATION MARK -- MEMBER
m "\xe2\x80\xbc" 0 3
# U+3002 IDEOGRAPHIC FULL STOP -- MEMBER
m "\xe3\x80\x82" 0 3
# U+FF01 FULLWIDTH EXCLAMATION MARK -- MEMBER
m "\xef\xbc\x81" 0 3
# U+FF0E FULLWIDTH FULL STOP -- MEMBER
m "\xef\xbc\x8e" 0 3
# U+FF1F FULLWIDTH QUESTION MARK -- MEMBER
m "\xef\xbc\x9f" 0 3
# U+002C COMMA: Terminal_Punctuation but not Sentence_Terminal -- non-member
n "\x2c"
# U+003A COLON: Terminal_Punctuation only -- non-member
n "\x3a"
# U+003B SEMICOLON: Terminal_Punctuation only -- non-member
n "\x3b"
# U+3001 IDEOGRAPHIC COMMA: Terminal_Punctuation only -- non-member
n "\xe3\x80\x81"
# U+FF0C FULLWIDTH COMMA: Terminal_Punctuation only -- non-member
n "\xef\xbc\x8c"
# U+0028 LEFT PARENTHESIS -- non-member
n "\x28"
# U+0061 a -- non-member
n "a"

