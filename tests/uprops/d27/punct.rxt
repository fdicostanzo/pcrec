# U+203C DOUBLE EXCLAMATION MARK -- MEMBER
n "\xe2\x80\xbc"
# U+3002 IDEOGRAPHIC FULL STOP -- MEMBER
n "\xe3\x80\x82"
# U+FF01 FULLWIDTH EXCLAMATION MARK -- MEMBER
n "\xef\xbc\x81"
# U+FF0E FULLWIDTH FULL STOP -- MEMBER
n "\xef\xbc\x8e"
# U+FF1F FULLWIDTH QUESTION MARK -- MEMBER
n "\xef\xbc\x9f"
# U+002C COMMA: Terminal_Punctuation but not Sentence_Terminal -- non-member
m "\x2c" 0 1
# U+003A COLON: Terminal_Punctuation only -- non-member
m "\x3a" 0 1
# U+003B SEMICOLON: Terminal_Punctuation only -- non-member
m "\x3b" 0 1
# U+3001 IDEOGRAPHIC COMMA: Terminal_Punctuation only -- non-member
m "\xe3\x80\x81" 0 3
# U+FF0C FULLWIDTH COMMA: Terminal_Punctuation only -- non-member
m "\xef\xbc\x8c" 0 3
# U+0028 LEFT PARENTHESIS -- non-member
m "\x28" 0 1
# U+0061 a -- non-member
m "a" 0 1

# Pattern_Syntax: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Pattern_Syntax}
features unicode-props
encoding utf8
# U+0021 EXCLAMATION MARK -- MEMBER
m "\x21" 0 1
# U+002F SOLIDUS -- MEMBER
m "\x2f" 0 1
# U+003A COLON -- MEMBER
m "\x3a" 0 1
# U+0040 COMMERCIAL AT -- MEMBER
m "\x40" 0 1
# U+005B LEFT SQUARE BRACKET -- MEMBER
m "\x5b" 0 1
# U+005E CIRCUMFLEX -- MEMBER
m "\x5e" 0 1
# U+0060 GRAVE -- MEMBER
m "\x60" 0 1
# U+007B LEFT CURLY -- MEMBER
m "\x7b" 0 1
# U+007E TILDE -- MEMBER
m "\x7e" 0 1
# U+00A1 INVERTED EXCLAMATION -- MEMBER
m "\xc2\xa1" 0 2
# U+00D7 MULTIPLICATION SIGN -- MEMBER
m "\xc3\x97" 0 2
# U+2010 HYPHEN -- MEMBER
m "\xe2\x80\x90" 0 3
# U+2190 LEFTWARDS ARROW -- MEMBER
m "\xe2\x86\x90" 0 3
# U+2E00 RIGHT ANGLE SUBSTITUTION MARKER -- MEMBER
m "\xe2\xb8\x80" 0 3
# U+3008 LEFT ANGLE BRACKET -- MEMBER
m "\xe3\x80\x88" 0 3
# U+3030 WAVY DASH -- MEMBER
m "\xe3\x80\xb0" 0 3
# U+FD3E ORNATE LEFT PARENTHESIS -- MEMBER
m "\xef\xb4\xbe" 0 3
# U+005F LOW LINE: NOT Pattern_Syntax (it is ID_Continue) -- non-member
n "\x5f"
# U+0030 DIGIT ZERO -- non-member
n "0"
# U+0041 A -- non-member
n "A"
# U+00A8 DIAERESIS: gap between A1..A7 and A9 -- non-member
n "\xc2\xa8"
# U+00AA FEMININE ORDINAL: gap -- non-member
n "\xc2\xaa"
# U+00B2 SUPERSCRIPT TWO: gap -- non-member
n "\xc2\xb2"
# U+2028 LINE SEPARATOR: not Pattern_Syntax (it is Pattern_White_Space) -- non-member
n "\xe2\x80\xa8"
# U+0061 a -- non-member
n "a"

