# upropd27: punctuation binary properties
# Written spec-first by a D27 blind author from the promise (docs/spec/cli.md 1.17.1,
# docs/design/uprop_more.md) and the Unicode Character Database 16.0 as the author
# knows it.  Every case comment names the code point and the property value claimed.
# "UNSURE:" marks a claim the author is not certain of.

# Dash: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Dash}
features unicode-props
encoding utf8
# U+002D HYPHEN-MINUS -- MEMBER
m "\x2d" 0 1
# U+058A ARMENIAN HYPHEN -- MEMBER
m "\xd6\x8a" 0 2
# U+05BE HEBREW PUNCTUATION MAQAF -- MEMBER
m "\xd6\xbe" 0 2
# U+2010 HYPHEN (2010..2015) -- MEMBER
m "\xe2\x80\x90" 0 3
# U+2015 HORIZONTAL BAR -- MEMBER
m "\xe2\x80\x95" 0 3
# U+2053 SWUNG DASH -- MEMBER
m "\xe2\x81\x93" 0 3
# U+207B SUPERSCRIPT MINUS -- MEMBER
m "\xe2\x81\xbb" 0 3
# U+2212 MINUS SIGN -- MEMBER
m "\xe2\x88\x92" 0 3
# U+301C WAVE DASH -- MEMBER
m "\xe3\x80\x9c" 0 3
# U+30A0 KATAKANA-HIRAGANA DOUBLE HYPHEN -- MEMBER
m "\xe3\x82\xa0" 0 3
# U+FF0D FULLWIDTH HYPHEN-MINUS -- MEMBER
m "\xef\xbc\x8d" 0 3
# U+10EAD YEZIDI HYPHENATION MARK -- MEMBER
m "\xf0\x90\xba\xad" 0 4
# U+005F LOW LINE: not Dash -- non-member
n "\x5f"
# U+2016 DOUBLE VERTICAL LINE: just above 2015 -- non-member
n "\xe2\x80\x96"
# U+200F RLM -- non-member
n "\xe2\x80\x8f"
# U+2009 THIN SPACE -- non-member
n "\xe2\x80\x89"
# U+00AD SOFT HYPHEN: not Dash -- non-member
n "\xc2\xad"
# U+002B PLUS SIGN -- non-member
n "\x2b"
# U+0061 a -- non-member
n "a"
# U+002F SOLIDUS -- non-member
n "\x2f"

# Dash: negated spelling \p{^X}, utf8; membership flipped
# pcre2-only
pattern \p{^Dash}
features unicode-props
encoding utf8
# U+002D HYPHEN-MINUS -- MEMBER
n "\x2d"
# U+058A ARMENIAN HYPHEN -- MEMBER
n "\xd6\x8a"
# U+05BE HEBREW PUNCTUATION MAQAF -- MEMBER
n "\xd6\xbe"
# U+2010 HYPHEN (2010..2015) -- MEMBER
n "\xe2\x80\x90"
# U+2015 HORIZONTAL BAR -- MEMBER
n "\xe2\x80\x95"
# U+2053 SWUNG DASH -- MEMBER
n "\xe2\x81\x93"
# U+207B SUPERSCRIPT MINUS -- MEMBER
n "\xe2\x81\xbb"
# U+2212 MINUS SIGN -- MEMBER
n "\xe2\x88\x92"
# U+301C WAVE DASH -- MEMBER
n "\xe3\x80\x9c"
# U+30A0 KATAKANA-HIRAGANA DOUBLE HYPHEN -- MEMBER
n "\xe3\x82\xa0"
# U+FF0D FULLWIDTH HYPHEN-MINUS -- MEMBER
n "\xef\xbc\x8d"
# U+10EAD YEZIDI HYPHENATION MARK -- MEMBER
n "\xf0\x90\xba\xad"
# U+005F LOW LINE: not Dash -- non-member
m "\x5f" 0 1
# U+2016 DOUBLE VERTICAL LINE: just above 2015 -- non-member
m "\xe2\x80\x96" 0 3
# U+200F RLM -- non-member
m "\xe2\x80\x8f" 0 3
# U+2009 THIN SPACE -- non-member
m "\xe2\x80\x89" 0 3
# U+00AD SOFT HYPHEN: not Dash -- non-member
m "\xc2\xad" 0 2
# U+002B PLUS SIGN -- non-member
m "\x2b" 0 1
# U+0061 a -- non-member
m "a" 0 1
# U+002F SOLIDUS -- non-member
m "\x2f" 0 1

# Dash: inside a class with another item (U+005F)
# pcre2-only
pattern [\x{5F}\p{Dash}]
features unicode-props
encoding utf8
# U+002D HYPHEN-MINUS -- MEMBER
m "\x2d" 0 1
# U+058A ARMENIAN HYPHEN -- MEMBER
m "\xd6\x8a" 0 2
# U+05BE HEBREW PUNCTUATION MAQAF -- MEMBER
m "\xd6\xbe" 0 2
# U+2010 HYPHEN (2010..2015) -- MEMBER
m "\xe2\x80\x90" 0 3
