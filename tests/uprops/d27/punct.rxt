# U+037E GREEK QUESTION MARK -- MEMBER
m "\xcd\xbe" 0 2
# U+203C DOUBLE EXCLAMATION MARK -- MEMBER
m "\xe2\x80\xbc" 0 3
# U+3001 IDEOGRAPHIC COMMA -- MEMBER
m "\xe3\x80\x81" 0 3
# U+3002 IDEOGRAPHIC FULL STOP -- MEMBER
m "\xe3\x80\x82" 0 3
# U+FF01 FULLWIDTH EXCLAMATION MARK -- MEMBER
m "\xef\xbc\x81" 0 3
# U+0028 LEFT PARENTHESIS -- non-member
n "\x28"
# U+0022 QUOTATION MARK -- non-member
n "\x22"
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"
# U+00BF INVERTED QUESTION MARK: not terminal -- non-member
n "\xc2\xbf"
# U+00A1 INVERTED EXCLAMATION MARK: not terminal -- non-member
n "\xc2\xa1"
# U+0061 a -- non-member
n "a"

