# Deprecated: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Deprecated}
features unicode-props
encoding utf8
# U+0149 LATIN SMALL N PRECEDED BY APOSTROPHE -- MEMBER
m "\xc5\x89" 0 2
# U+0673 ARABIC LETTER ALEF WITH WAVY HAMZA BELOW -- MEMBER
m "\xd9\xb3" 0 2
# U+0F77 TIBETAN VOWEL SIGN VOCALIC RR -- MEMBER
m "\xe0\xbd\xb7" 0 3
# U+17A3 KHMER INDEPENDENT VOWEL QAQ -- MEMBER
m "\xe1\x9e\xa3" 0 3
# U+206A INHIBIT SYMMETRIC SWAPPING (206A..206F) -- MEMBER
m "\xe2\x81\xaa" 0 3
# U+206F NOMINAL DIGIT SHAPES -- MEMBER
m "\xe2\x81\xaf" 0 3
# U+2329 LEFT-POINTING ANGLE BRACKET -- MEMBER
m "\xe2\x8c\xa9" 0 3
# U+232A RIGHT-POINTING ANGLE BRACKET -- MEMBER
m "\xe2\x8c\xaa" 0 3
# U+E0001 LANGUAGE TAG -- MEMBER
m "\xf3\xa0\x80\x81" 0 4
# U+0148 LATIN SMALL N WITH CARON: neighbour -- non-member
n "\xc5\x88"
# U+232B ERASE TO THE LEFT: just above 232A -- non-member
n "\xe2\x8c\xab"
# U+2069 PDI: just below 206A -- non-member
n "\xe2\x81\xa9"
# U+E0020 TAG SPACE: not Deprecated -- non-member
n "\xf3\xa0\x80\xa0"
# U+0061 a -- non-member
n "a"
# U+3008 LEFT ANGLE BRACKET (the non-deprecated one) -- non-member
n "\xe3\x80\x88"

# Deprecated: negated spelling \p{^X}, utf8; membership flipped
# pcre2-only
pattern \p{^Deprecated}
features unicode-props
encoding utf8
# U+0149 LATIN SMALL N PRECEDED BY APOSTROPHE -- MEMBER
n "\xc5\x89"
# U+0673 ARABIC LETTER ALEF WITH WAVY HAMZA BELOW -- MEMBER
n "\xd9\xb3"
# U+0F77 TIBETAN VOWEL SIGN VOCALIC RR -- MEMBER
n "\xe0\xbd\xb7"
# U+17A3 KHMER INDEPENDENT VOWEL QAQ -- MEMBER
n "\xe1\x9e\xa3"
# U+206A INHIBIT SYMMETRIC SWAPPING (206A..206F) -- MEMBER
n "\xe2\x81\xaa"
# U+206F NOMINAL DIGIT SHAPES -- MEMBER
n "\xe2\x81\xaf"
# U+2329 LEFT-POINTING ANGLE BRACKET -- MEMBER
n "\xe2\x8c\xa9"
# U+232A RIGHT-POINTING ANGLE BRACKET -- MEMBER
n "\xe2\x8c\xaa"
# U+E0001 LANGUAGE TAG -- MEMBER
n "\xf3\xa0\x80\x81"
# U+0148 LATIN SMALL N WITH CARON: neighbour -- non-member
m "\xc5\x88" 0 2
# U+232B ERASE TO THE LEFT: just above 232A -- non-member
m "\xe2\x8c\xab" 0 3
# U+2069 PDI: just below 206A -- non-member
m "\xe2\x81\xa9" 0 3
# U+E0020 TAG SPACE: not Deprecated -- non-member
m "\xf3\xa0\x80\xa0" 0 4
# U+0061 a -- non-member
m "a" 0 1
# U+3008 LEFT ANGLE BRACKET (the non-deprecated one) -- non-member
m "\xe3\x80\x88" 0 3
