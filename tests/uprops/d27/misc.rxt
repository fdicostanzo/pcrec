# upropd27: diacritic, extender, math and other binary properties
# Written spec-first by a D27 blind author from the promise (docs/spec/cli.md 1.17.1,
# docs/design/uprop_more.md) and the Unicode Character Database 16.0 as the author
# knows it.  Every case comment names the code point and the property value claimed.
# "UNSURE:" marks a claim the author is not certain of.

# Soft_Dotted: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Soft_Dotted}
features unicode-props
encoding utf8
# U+0069 LATIN SMALL i -- MEMBER
m "i" 0 1
# U+006A LATIN SMALL j -- MEMBER
m "j" 0 1
# U+012F LATIN SMALL I WITH OGONEK -- MEMBER
m "\xc4\xaf" 0 2
# U+0249 LATIN SMALL J WITH STROKE -- MEMBER
m "\xc9\x89" 0 2
# U+0268 LATIN SMALL I WITH STROKE -- MEMBER
m "\xc9\xa8" 0 2
# U+02B2 MODIFIER LETTER SMALL J -- MEMBER
m "\xca\xb2" 0 2
# U+0456 CYRILLIC SMALL BYELORUSSIAN-UKRAINIAN I -- MEMBER
m "\xd1\x96" 0 2
# U+0458 CYRILLIC SMALL JE -- MEMBER
m "\xd1\x98" 0 2
# U+2071 SUPERSCRIPT LATIN SMALL I -- MEMBER
m "\xe2\x81\xb1" 0 3
# U+2148 DOUBLE-STRUCK ITALIC SMALL I -- MEMBER
m "\xe2\x85\x88" 0 3
# U+0049 LATIN CAPITAL I -- non-member
n "I"
# U+006C LATIN SMALL l -- non-member
n "l"
# U+0131 LATIN SMALL DOTLESS I -- non-member
n "\xc4\xb1"
# U+00EF I WITH DIAERESIS precomposed: not Soft_Dotted -- non-member
n "\xc3\xaf"
# U+0237 LATIN SMALL DOTLESS J -- non-member
n "\xc8\xb7"
# U+0061 a -- non-member
n "a"

# Soft_Dotted: negated spelling [^\p{X}], utf8; membership flipped
# pcre2-only
pattern [^\p{Soft_Dotted}]
features unicode-props
encoding utf8
# U+0069 LATIN SMALL i -- MEMBER
n "i"
# U+006A LATIN SMALL j -- MEMBER
n "j"
# U+012F LATIN SMALL I WITH OGONEK -- MEMBER
n "\xc4\xaf"
# U+0249 LATIN SMALL J WITH STROKE -- MEMBER
n "\xc9\x89"
# U+0268 LATIN SMALL I WITH STROKE -- MEMBER
n "\xc9\xa8"
# U+02B2 MODIFIER LETTER SMALL J -- MEMBER
n "\xca\xb2"
# U+0456 CYRILLIC SMALL BYELORUSSIAN-UKRAINIAN I -- MEMBER
n "\xd1\x96"
# U+0458 CYRILLIC SMALL JE -- MEMBER
n "\xd1\x98"
# U+2071 SUPERSCRIPT LATIN SMALL I -- MEMBER
n "\xe2\x81\xb1"
# U+2148 DOUBLE-STRUCK ITALIC SMALL I -- MEMBER
n "\xe2\x85\x88"
# U+0049 LATIN CAPITAL I -- non-member
m "I" 0 1
# U+006C LATIN SMALL l -- non-member
m "l" 0 1
# U+0131 LATIN SMALL DOTLESS I -- non-member
m "\xc4\xb1" 0 2
# U+00EF I WITH DIAERESIS precomposed: not Soft_Dotted -- non-member
m "\xc3\xaf" 0 2
# U+0237 LATIN SMALL DOTLESS J -- non-member
m "\xc8\xb7" 0 2
# U+0061 a -- non-member
m "a" 0 1

# Soft_Dotted: inside a class with another item (U+0049)
# pcre2-only
pattern [\x{49}\p{Soft_Dotted}]
features unicode-props
encoding utf8
# U+0069 LATIN SMALL i -- MEMBER
m "i" 0 1
# U+006A LATIN SMALL j -- MEMBER
m "j" 0 1
# U+012F LATIN SMALL I WITH OGONEK -- MEMBER
m "\xc4\xaf" 0 2
# U+0249 LATIN SMALL J WITH STROKE -- MEMBER
m "\xc9\x89" 0 2
# U+0268 LATIN SMALL I WITH STROKE -- MEMBER
m "\xc9\xa8" 0 2
# U+02B2 MODIFIER LETTER SMALL J -- MEMBER
m "\xca\xb2" 0 2
# U+0456 CYRILLIC SMALL BYELORUSSIAN-UKRAINIAN I -- MEMBER
m "\xd1\x96" 0 2
# U+0458 CYRILLIC SMALL JE -- MEMBER
m "\xd1\x98" 0 2
# U+2071 SUPERSCRIPT LATIN SMALL I -- MEMBER
m "\xe2\x81\xb1" 0 3
# U+2148 DOUBLE-STRUCK ITALIC SMALL I -- MEMBER
m "\xe2\x85\x88" 0 3
# U+0049 LATIN CAPITAL I -- non-member of the property but IS the extra class item
m "I" 0 1
# U+006C LATIN SMALL l -- non-member
n "l"
# U+0131 LATIN SMALL DOTLESS I -- non-member
n "\xc4\xb1"
# U+00EF I WITH DIAERESIS precomposed: not Soft_Dotted -- non-member
n "\xc3\xaf"
# U+0237 LATIN SMALL DOTLESS J -- non-member
n "\xc8\xb7"
# U+0061 a -- non-member
n "a"

# Diacritic: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Diacritic}
features unicode-props
encoding utf8
# U+005E CIRCUMFLEX ACCENT -- MEMBER
m "\x5e" 0 1
# U+0060 GRAVE ACCENT -- MEMBER
m "\x60" 0 1
# U+00A8 DIAERESIS -- MEMBER
m "\xc2\xa8" 0 2
# U+00AF MACRON -- MEMBER
m "\xc2\xaf" 0 2
# U+00B4 ACUTE ACCENT -- MEMBER
m "\xc2\xb4" 0 2
# U+00B7 MIDDLE DOT -- MEMBER
m "\xc2\xb7" 0 2
# U+00B8 CEDILLA -- MEMBER
m "\xc2\xb8" 0 2
# U+02B0 MODIFIER LETTER SMALL H -- MEMBER
m "\xca\xb0" 0 2
# U+0300 COMBINING GRAVE -- MEMBER
m "\xcc\x80" 0 2
# U+0345 COMBINING YPOGEGRAMMENI -- MEMBER
m "\xcd\x85" 0 2
# U+0061 a -- non-member
n "a"
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"
# U+00A9 COPYRIGHT SIGN: neighbour of A8 -- non-member
n "\xc2\xa9"
# U+00B5 MICRO SIGN: neighbour of B4 -- non-member
n "\xc2\xb5"
# U+4E00 CJK ideograph -- non-member
n "\xe4\xb8\x80"
# U+0030 DIGIT ZERO -- non-member
n "0"

# Diacritic: negated spelling \P{^X} (is \p{X}), utf8; membership flipped
# pcre2-only
pattern \P{^Diacritic}
features unicode-props
encoding utf8
# U+005E CIRCUMFLEX ACCENT -- MEMBER
m "\x5e" 0 1
# U+0060 GRAVE ACCENT -- MEMBER
m "\x60" 0 1
# U+00A8 DIAERESIS -- MEMBER
m "\xc2\xa8" 0 2
# U+00AF MACRON -- MEMBER
m "\xc2\xaf" 0 2
# U+00B4 ACUTE ACCENT -- MEMBER
m "\xc2\xb4" 0 2
# U+00B7 MIDDLE DOT -- MEMBER
m "\xc2\xb7" 0 2
# U+00B8 CEDILLA -- MEMBER
m "\xc2\xb8" 0 2
# U+02B0 MODIFIER LETTER SMALL H -- MEMBER
m "\xca\xb0" 0 2
# U+0300 COMBINING GRAVE -- MEMBER
m "\xcc\x80" 0 2
# U+0345 COMBINING YPOGEGRAMMENI -- MEMBER
m "\xcd\x85" 0 2
# U+0061 a -- non-member
n "a"
# U+002D HYPHEN-MINUS -- non-member
n "\x2d"
# U+00A9 COPYRIGHT SIGN: neighbour of A8 -- non-member
n "\xc2\xa9"
# U+00B5 MICRO SIGN: neighbour of B4 -- non-member
n "\xc2\xb5"
# U+4E00 CJK ideograph -- non-member
n "\xe4\xb8\x80"
# U+0030 DIGIT ZERO -- non-member
n "0"

# Extender: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Extender}
features unicode-props
encoding utf8
# U+00B7 MIDDLE DOT -- MEMBER
m "\xc2\xb7" 0 2
# U+02D0 MODIFIER LETTER TRIANGULAR COLON -- MEMBER
m "\xcb\x90" 0 2
# U+02D1 MODIFIER LETTER HALF TRIANGULAR COLON -- MEMBER
m "\xcb\x91" 0 2
# U+0640 ARABIC TATWEEL -- MEMBER
m "\xd9\x80" 0 2
# U+0E46 THAI CHARACTER MAIYAMOK -- MEMBER
m "\xe0\xb9\x86" 0 3
# U+3005 IDEOGRAPHIC ITERATION MARK -- MEMBER
m "\xe3\x80\x85" 0 3
# U+30FC KATAKANA-HIRAGANA PROLONGED SOUND MARK -- MEMBER
m "\xe3\x83\xbc" 0 3
# U+FF70 HALFWIDTH KATAKANA-HIRAGANA PROLONGED SOUND MARK -- MEMBER
m "\xef\xbd\xb0" 0 3
# U+02CF just below 02D0 -- non-member
n "\xcb\x8f"
# U+0641 ARABIC LETTER FEH: just above tatweel -- non-member
n "\xd9\x81"
# U+3006 IDEOGRAPHIC CLOSING MARK -- non-member
n "\xe3\x80\x86"
# U+00B8 CEDILLA -- non-member
n "\xc2\xb8"
# U+0061 a -- non-member
n "a"
# U+30FB KATAKANA MIDDLE DOT: just below 30FC, not Extender -- non-member
n "\xe3\x83\xbb"

# Extender: negated spelling [\P{X}], utf8; membership flipped
# pcre2-only
pattern [\P{Extender}]
features unicode-props
encoding utf8
# U+00B7 MIDDLE DOT -- MEMBER
n "\xc2\xb7"
# U+02D0 MODIFIER LETTER TRIANGULAR COLON -- MEMBER
n "\xcb\x90"
# U+02D1 MODIFIER LETTER HALF TRIANGULAR COLON -- MEMBER
n "\xcb\x91"
# U+0640 ARABIC TATWEEL -- MEMBER
n "\xd9\x80"
# U+0E46 THAI CHARACTER MAIYAMOK -- MEMBER
n "\xe0\xb9\x86"
# U+3005 IDEOGRAPHIC ITERATION MARK -- MEMBER
n "\xe3\x80\x85"
# U+30FC KATAKANA-HIRAGANA PROLONGED SOUND MARK -- MEMBER
n "\xe3\x83\xbc"
# U+FF70 HALFWIDTH KATAKANA-HIRAGANA PROLONGED SOUND MARK -- MEMBER
n "\xef\xbd\xb0"
# U+02CF just below 02D0 -- non-member
m "\xcb\x8f" 0 2
# U+0641 ARABIC LETTER FEH: just above tatweel -- non-member
m "\xd9\x81" 0 2
# U+3006 IDEOGRAPHIC CLOSING MARK -- non-member
m "\xe3\x80\x86" 0 3
# U+00B8 CEDILLA -- non-member
m "\xc2\xb8" 0 2
# U+0061 a -- non-member
m "a" 0 1
# U+30FB KATAKANA MIDDLE DOT: just below 30FC, not Extender -- non-member
m "\xe3\x83\xbb" 0 3

# Extender: inside a class with another item (U+02CF)
# pcre2-only
pattern [\x{2CF}\p{Extender}]
features unicode-props
encoding utf8
# U+00B7 MIDDLE DOT -- MEMBER
m "\xc2\xb7" 0 2
# U+02D0 MODIFIER LETTER TRIANGULAR COLON -- MEMBER
m "\xcb\x90" 0 2
# U+02D1 MODIFIER LETTER HALF TRIANGULAR COLON -- MEMBER
m "\xcb\x91" 0 2
# U+0640 ARABIC TATWEEL -- MEMBER
m "\xd9\x80" 0 2
# U+0E46 THAI CHARACTER MAIYAMOK -- MEMBER
m "\xe0\xb9\x86" 0 3
# U+3005 IDEOGRAPHIC ITERATION MARK -- MEMBER
m "\xe3\x80\x85" 0 3
# U+30FC KATAKANA-HIRAGANA PROLONGED SOUND MARK -- MEMBER
m "\xe3\x83\xbc" 0 3
# U+FF70 HALFWIDTH KATAKANA-HIRAGANA PROLONGED SOUND MARK -- MEMBER
m "\xef\xbd\xb0" 0 3
# U+02CF just below 02D0 -- non-member of the property but IS the extra class item
m "\xcb\x8f" 0 2
# U+0641 ARABIC LETTER FEH: just above tatweel -- non-member
n "\xd9\x81"
# U+3006 IDEOGRAPHIC CLOSING MARK -- non-member
n "\xe3\x80\x86"
# U+00B8 CEDILLA -- non-member
n "\xc2\xb8"
# U+0061 a -- non-member
n "a"
# U+30FB KATAKANA MIDDLE DOT: just below 30FC, not Extender -- non-member
n "\xe3\x83\xbb"

# Math: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Math}
features unicode-props
encoding utf8
# U+002B PLUS SIGN: Sm -- MEMBER
m "\x2b" 0 1
# U+003C LESS-THAN SIGN -- MEMBER
m "\x3c" 0 1
# U+003D EQUALS SIGN -- MEMBER
m "\x3d" 0 1
# U+003E GREATER-THAN SIGN -- MEMBER
m "\x3e" 0 1
# U+005E CIRCUMFLEX ACCENT: Other_Math -- MEMBER
m "\x5e" 0 1
# U+007C VERTICAL LINE: Sm -- MEMBER
m "\x7c" 0 1
# U+007E TILDE: Sm -- MEMBER
m "\x7e" 0 1
# U+00AC NOT SIGN -- MEMBER
m "\xc2\xac" 0 2
# U+00D7 MULTIPLICATION SIGN -- MEMBER
m "\xc3\x97" 0 2
# U+2200 FOR ALL -- MEMBER
m "\xe2\x88\x80" 0 3
# U+221E INFINITY -- MEMBER
m "\xe2\x88\x9e" 0 3
# U+1D400 MATHEMATICAL BOLD CAPITAL A: Other_Math (Math alphanumerics) -- MEMBER
m "\xf0\x9d\x90\x80" 0 4
# U+002D HYPHEN-MINUS: Pd, not Math -- non-member
n "\x2d"
# U+002A ASTERISK: Po, not Math -- non-member
n "\x2a"
# U+002F SOLIDUS: Po, not Math -- non-member
n "\x2f"
# U+0061 a -- non-member
n "a"
# U+0024 DOLLAR SIGN -- non-member
n "\x24"
# U+0025 PERCENT SIGN -- non-member
n "\x25"
# U+00A9 COPYRIGHT SIGN -- non-member
n "\xc2\xa9"
# U+0030 DIGIT ZERO -- non-member
n "0"

# Math: negated spelling \P{X}, utf8; membership flipped
# pcre2-only
pattern \P{Math}
features unicode-props
encoding utf8
# U+002B PLUS SIGN: Sm -- MEMBER
n "\x2b"
# U+003C LESS-THAN SIGN -- MEMBER
n "\x3c"
# U+003D EQUALS SIGN -- MEMBER
n "\x3d"
# U+003E GREATER-THAN SIGN -- MEMBER
n "\x3e"
# U+005E CIRCUMFLEX ACCENT: Other_Math -- MEMBER
n "\x5e"
# U+007C VERTICAL LINE: Sm -- MEMBER
n "\x7c"
# U+007E TILDE: Sm -- MEMBER
n "\x7e"
# U+00AC NOT SIGN -- MEMBER
n "\xc2\xac"
# U+00D7 MULTIPLICATION SIGN -- MEMBER
n "\xc3\x97"
# U+2200 FOR ALL -- MEMBER
n "\xe2\x88\x80"
# U+221E INFINITY -- MEMBER
n "\xe2\x88\x9e"
# U+1D400 MATHEMATICAL BOLD CAPITAL A: Other_Math (Math alphanumerics) -- MEMBER
n "\xf0\x9d\x90\x80"
# U+002D HYPHEN-MINUS: Pd, not Math -- non-member
m "\x2d" 0 1
# U+002A ASTERISK: Po, not Math -- non-member
m "\x2a" 0 1
# U+002F SOLIDUS: Po, not Math -- non-member
m "\x2f" 0 1
# U+0061 a -- non-member
m "a" 0 1
# U+0024 DOLLAR SIGN -- non-member
m "\x24" 0 1
# U+0025 PERCENT SIGN -- non-member
m "\x25" 0 1
# U+00A9 COPYRIGHT SIGN -- non-member
m "\xc2\xa9" 0 2
# U+0030 DIGIT ZERO -- non-member
m "0" 0 1

# Math: under flags i the set is UNCHANGED (spec cli.md 1.17.1 para 3: only Lu Ll Lt change)
# pcre2-only
pattern \p{Math}
features unicode-props
encoding utf8
flags i
# U+002B PLUS SIGN: Sm -- MEMBER
m "\x2b" 0 1
# U+003C LESS-THAN SIGN -- MEMBER
m "\x3c" 0 1
# U+003D EQUALS SIGN -- MEMBER
m "\x3d" 0 1
# U+003E GREATER-THAN SIGN -- MEMBER
m "\x3e" 0 1
# U+005E CIRCUMFLEX ACCENT: Other_Math -- MEMBER
m "\x5e" 0 1
# U+007C VERTICAL LINE: Sm -- MEMBER
m "\x7c" 0 1
# U+007E TILDE: Sm -- MEMBER
m "\x7e" 0 1
# U+00AC NOT SIGN -- MEMBER
m "\xc2\xac" 0 2
# U+00D7 MULTIPLICATION SIGN -- MEMBER
m "\xc3\x97" 0 2
# U+2200 FOR ALL -- MEMBER
m "\xe2\x88\x80" 0 3
# U+221E INFINITY -- MEMBER
m "\xe2\x88\x9e" 0 3
# U+1D400 MATHEMATICAL BOLD CAPITAL A: Other_Math (Math alphanumerics) -- MEMBER
m "\xf0\x9d\x90\x80" 0 4
# U+002D HYPHEN-MINUS: Pd, not Math -- non-member
n "\x2d"
# U+002A ASTERISK: Po, not Math -- non-member
n "\x2a"
# U+002F SOLIDUS: Po, not Math -- non-member
n "\x2f"
# U+0061 a -- non-member
n "a"
# U+0024 DOLLAR SIGN -- non-member
n "\x24"
# U+0025 PERCENT SIGN -- non-member
n "\x25"
# U+00A9 COPYRIGHT SIGN -- non-member
n "\xc2\xa9"
# U+0030 DIGIT ZERO -- non-member
n "0"

# Logical_Order_Exception: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Logical_Order_Exception}
features unicode-props
encoding utf8
# U+0E40 THAI CHARACTER SARA E -- MEMBER
m "\xe0\xb9\x80" 0 3
# U+0E44 THAI CHARACTER SARA AI MAIMALAI -- MEMBER
m "\xe0\xb9\x84" 0 3
# U+0EC0 LAO VOWEL SIGN E -- MEMBER
m "\xe0\xbb\x80" 0 3
# U+0EC4 LAO VOWEL SIGN AI -- MEMBER
m "\xe0\xbb\x84" 0 3
# U+19B5 NEW TAI LUE VOWEL SIGN E -- MEMBER
m "\xe1\xa6\xb5" 0 3
# U+19BA NEW TAI LUE VOWEL SIGN AY -- MEMBER
m "\xe1\xa6\xba" 0 3
# U+AAB5 TAI VIET VOWEL E -- MEMBER
m "\xea\xaa\xb5" 0 3
# U+0E45 THAI CHARACTER LAKKHANGYAO: just above -- non-member
n "\xe0\xb9\x85"
# U+0E3F THAI BAHT: just below -- non-member
n "\xe0\xb8\xbf"
# U+0EC5 just above lao -- non-member
n "\xe0\xbb\x85"
# U+19B8 NEW TAI LUE VOWEL SIGN OA: not LOE -- non-member
n "\xe1\xa6\xb8"
# U+0061 a -- non-member
n "a"

# Logical_Order_Exception: negated spelling \p{^X}, utf8; membership flipped
# pcre2-only
pattern \p{^Logical_Order_Exception}
features unicode-props
encoding utf8
# U+0E40 THAI CHARACTER SARA E -- MEMBER
n "\xe0\xb9\x80"
# U+0E44 THAI CHARACTER SARA AI MAIMALAI -- MEMBER
n "\xe0\xb9\x84"
# U+0EC0 LAO VOWEL SIGN E -- MEMBER
n "\xe0\xbb\x80"
# U+0EC4 LAO VOWEL SIGN AI -- MEMBER
n "\xe0\xbb\x84"
# U+19B5 NEW TAI LUE VOWEL SIGN E -- MEMBER
n "\xe1\xa6\xb5"
# U+19BA NEW TAI LUE VOWEL SIGN AY -- MEMBER
n "\xe1\xa6\xba"
# U+AAB5 TAI VIET VOWEL E -- MEMBER
n "\xea\xaa\xb5"
# U+0E45 THAI CHARACTER LAKKHANGYAO: just above -- non-member
m "\xe0\xb9\x85" 0 3
# U+0E3F THAI BAHT: just below -- non-member
m "\xe0\xb8\xbf" 0 3
# U+0EC5 just above lao -- non-member
m "\xe0\xbb\x85" 0 3
# U+19B8 NEW TAI LUE VOWEL SIGN OA: not LOE -- non-member
m "\xe1\xa6\xb8" 0 3
# U+0061 a -- non-member
m "a" 0 1

# Logical_Order_Exception: inside a class with another item (U+0E45)
# pcre2-only
pattern [\x{E45}\p{Logical_Order_Exception}]
features unicode-props
encoding utf8
# U+0E40 THAI CHARACTER SARA E -- MEMBER
m "\xe0\xb9\x80" 0 3
# U+0E44 THAI CHARACTER SARA AI MAIMALAI -- MEMBER
m "\xe0\xb9\x84" 0 3
# U+0EC0 LAO VOWEL SIGN E -- MEMBER
m "\xe0\xbb\x80" 0 3
# U+0EC4 LAO VOWEL SIGN AI -- MEMBER
m "\xe0\xbb\x84" 0 3
# U+19B5 NEW TAI LUE VOWEL SIGN E -- MEMBER
m "\xe1\xa6\xb5" 0 3
# U+19BA NEW TAI LUE VOWEL SIGN AY -- MEMBER
m "\xe1\xa6\xba" 0 3
# U+AAB5 TAI VIET VOWEL E -- MEMBER
m "\xea\xaa\xb5" 0 3
# U+0E45 THAI CHARACTER LAKKHANGYAO: just above -- non-member of the property but IS the extra class item
m "\xe0\xb9\x85" 0 3
# U+0E3F THAI BAHT: just below -- non-member
n "\xe0\xb8\xbf"
# U+0EC5 just above lao -- non-member
n "\xe0\xbb\x85"
# U+19B8 NEW TAI LUE VOWEL SIGN OA: not LOE -- non-member
n "\xe1\xa6\xb8"
# U+0061 a -- non-member
n "a"

# Regional_Indicator: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Regional_Indicator}
features unicode-props
encoding utf8
# U+1F1E6 REGIONAL INDICATOR SYMBOL LETTER A -- MEMBER
m "\xf0\x9f\x87\xa6" 0 4
# U+1F1FF REGIONAL INDICATOR SYMBOL LETTER Z -- MEMBER
m "\xf0\x9f\x87\xbf" 0 4
# U+1F1E5 just below -- non-member
n "\xf0\x9f\x87\xa5"
# U+1F200 SQUARE HIRAGANA HOKA: just above -- non-member
n "\xf0\x9f\x88\x80"
# U+0041 LATIN CAPITAL A -- non-member
n "A"
# U+1F600 GRINNING FACE -- non-member
n "\xf0\x9f\x98\x80"

# Regional_Indicator: negated spelling [^\p{X}], utf8; membership flipped
# pcre2-only
pattern [^\p{Regional_Indicator}]
features unicode-props
encoding utf8
# U+1F1E6 REGIONAL INDICATOR SYMBOL LETTER A -- MEMBER
n "\xf0\x9f\x87\xa6"
# U+1F1FF REGIONAL INDICATOR SYMBOL LETTER Z -- MEMBER
n "\xf0\x9f\x87\xbf"
# U+1F1E5 just below -- non-member
m "\xf0\x9f\x87\xa5" 0 4
# U+1F200 SQUARE HIRAGANA HOKA: just above -- non-member
m "\xf0\x9f\x88\x80" 0 4
# U+0041 LATIN CAPITAL A -- non-member
m "A" 0 1
# U+1F600 GRINNING FACE -- non-member
m "\xf0\x9f\x98\x80" 0 4

# Prepended_Concatenation_Mark: positive form, utf8; one code point per subject
# pcre2-only
pattern \p{Prepended_Concatenation_Mark}
features unicode-props
encoding utf8
# U+0600 ARABIC NUMBER SIGN -- MEMBER
m "\xd8\x80" 0 2
# U+0605 ARABIC NUMBER MARK ABOVE -- MEMBER
m "\xd8\x85" 0 2
# U+06DD ARABIC END OF AYAH -- MEMBER
m "\xdb\x9d" 0 2
# U+070F SYRIAC ABBREVIATION MARK -- MEMBER
m "\xdc\x8f" 0 2
# U+0890 ARABIC POUND MARK ABOVE -- MEMBER
m "\xe0\xa2\x90" 0 3
# U+08E2 ARABIC DISPUTED END OF AYAH -- MEMBER
m "\xe0\xa3\xa2" 0 3
# U+110BD KAITHI NUMBER SIGN -- MEMBER
m "\xf0\x91\x82\xbd" 0 4
# U+0606 ARABIC-INDIC CUBE ROOT: just above -- non-member
n "\xd8\x86"
# U+06DE ARABIC START OF RUB EL HIZB -- non-member
n "\xdb\x9e"
# U+0710 SYRIAC LETTER ALAPH -- non-member
n "\xdc\x90"
# U+08E3 ARABIC TURNED DAMMA BELOW -- non-member
n "\xe0\xa3\xa3"
# U+0061 a -- non-member
n "a"

# Prepended_Concatenation_Mark: negated spelling \P{^X} (is \p{X}), utf8; membership flipped
# pcre2-only
pattern \P{^Prepended_Concatenation_Mark}
features unicode-props
encoding utf8
# U+0600 ARABIC NUMBER SIGN -- MEMBER
m "\xd8\x80" 0 2
# U+0605 ARABIC NUMBER MARK ABOVE -- MEMBER
m "\xd8\x85" 0 2
# U+06DD ARABIC END OF AYAH -- MEMBER
m "\xdb\x9d" 0 2
# U+070F SYRIAC ABBREVIATION MARK -- MEMBER
m "\xdc\x8f" 0 2
# U+0890 ARABIC POUND MARK ABOVE -- MEMBER
m "\xe0\xa2\x90" 0 3
# U+08E2 ARABIC DISPUTED END OF AYAH -- MEMBER
m "\xe0\xa3\xa2" 0 3
# U+110BD KAITHI NUMBER SIGN -- MEMBER
m "\xf0\x91\x82\xbd" 0 4
# U+0606 ARABIC-INDIC CUBE ROOT: just above -- non-member
n "\xd8\x86"
# U+06DE ARABIC START OF RUB EL HIZB -- non-member
n "\xdb\x9e"
# U+0710 SYRIAC LETTER ALAPH -- non-member
n "\xdc\x90"
# U+08E3 ARABIC TURNED DAMMA BELOW -- non-member
n "\xe0\xa3\xa3"
# U+0061 a -- non-member
n "a"

# Prepended_Concatenation_Mark: inside a class with another item (U+0606)
# pcre2-only
pattern [\x{606}\p{Prepended_Concatenation_Mark}]
features unicode-props
encoding utf8
# U+0600 ARABIC NUMBER SIGN -- MEMBER
m "\xd8\x80" 0 2
# U+0605 ARABIC NUMBER MARK ABOVE -- MEMBER
m "\xd8\x85" 0 2
# U+06DD ARABIC END OF AYAH -- MEMBER
m "\xdb\x9d" 0 2
# U+070F SYRIAC ABBREVIATION MARK -- MEMBER
m "\xdc\x8f" 0 2
# U+0890 ARABIC POUND MARK ABOVE -- MEMBER
m "\xe0\xa2\x90" 0 3
# U+08E2 ARABIC DISPUTED END OF AYAH -- MEMBER
m "\xe0\xa3\xa2" 0 3
# U+110BD KAITHI NUMBER SIGN -- MEMBER
m "\xf0\x91\x82\xbd" 0 4
# U+0606 ARABIC-INDIC CUBE ROOT: just above -- non-member of the property but IS the extra class item
m "\xd8\x86" 0 2
# U+06DE ARABIC START OF RUB EL HIZB -- non-member
n "\xdb\x9e"
# U+0710 SYRIAC LETTER ALAPH -- non-member
n "\xdc\x90"
# U+08E3 ARABIC TURNED DAMMA BELOW -- non-member
n "\xe0\xa3\xa3"
# U+0061 a -- non-member
n "a"
