# composition_d27.rxt -- possessification composition corpus (D27-blinded author).
#
# ORACLE: libpcre2 10.46 (2025-08-27, 8-bit, no UTF/UCP, interpretive pcre2_match, no JIT)
# compiled with PCRE2_NO_AUTO_POSSESS (0x4000), plus PCRE2_CASELESS where a block says
# `flags i`. Every m/n/ms/ns/gp line below is that oracle's answer, recorded 2026-10-07 on
# the Linux box through a ctypes driver over libpcre2-8.so.0 (offsets are byte offsets;
# capture lines record every group, -1 -1 = unset). Each pattern was also run with PCRE2's
# DEFAULT options (auto-possess ON): the answers were identical in every cell, see
# composition_d27_notes.md. The promise tested: possessification never changes a match.
#
# Every block carries `# pcre2-only` because python re is not the oracle here (backrefs to
# unset groups, \b/\B in empty-able loops, lookbehind alternatives and recursion all differ).
# `features all` is set per block so no module gate decides the verdict.
#
# Subjects containing no escapes are literal; `ms P` cases use startpos P on the block's
# longest subject (lookbehind / \b / \G see the bytes before P).
oracle pcre2/10.46
description possessification composition corpus: word boundaries, gates, backrefs, recursion, loops

# pcre2-only
pattern [a-]{0,2}?(?:(?<!\w)|)\B
features all
m "  " 0 0
m "--" 0 0
m "aa" 0 1
m "aaa" 0 1
m "-aa-" 0 0
m ".a1a" 0 0
m "aa aa" 0 1
m "aa-aa." 0 1
m "aaaaaaa" 0 1
ms 1 "aaaaaaa" 1 1
ms 2 "aaaaaaa" 2 2

# pcre2-only
pattern \w{0,2}?(?:\b)??\b
features all
n ""
n "-"
m "a" 0 0
m "1a" 0 0
m "a1" 0 0
m "aa" 0 0
m "-aa-" 1 1
m "  1aa" 2 2
m "aa aa" 0 0
ms 1 "  1aa" 2 2
ms 2 "  1aa" 2 2

# pcre2-only
pattern a{2}(?:(?<!\w)|)b
features all
n "ab"
n "b -"
n "-ab-"
n "_,- "
n "aa-b"
n "ab ab"
n "bbb-b"
n "bbb_."
n " -bb- b"
ns 1 " -bb- b"
ns 2 " -bb- b"

# pcre2-only
pattern [a-]{1,3}?(?:\b|)a
features all
n " b"
n "ba"
n "- 1"
n "1 -"
m "aab" 0 2
n "-ba-"
n "ba ba"
m "aaaabb" 0 2
m "baaa -" 1 3
ms 1 "aaaabb" 1 3
ms 2 "aaaabb" 2 4

