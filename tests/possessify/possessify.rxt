n "abc"
n "aabc"
m "za" 0 2
m "zaa" 0 2
m "zaaa" 0 2
m "zaaaa" 0 2
m "zac" 0 2
m "zaac" 0 2
m "zaaac" 0 2
n "q"
n "aq"

