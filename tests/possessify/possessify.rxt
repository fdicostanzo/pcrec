m "aabc" 0 4
m "aabbc" 0 5
m "aabbbbc" 0 7
n "aabbbbbc"
m "aac" 0 3


# ======================================================================
# DECLINES, one per declining condition
# ======================================================================

# DECLINE, (U1) ambiguous body. THE 117-COUNTEREXAMPLE FAMILY (§2.4): the
# branches share a first byte, so one iteration has TWO possible ends and a
# retreat can move the exit position RIGHT rather than only left.
# `(a|ab){0,4}c` on "abc" is (0,3) greedy with group 1 = "ab" and would be
# (2,3) with group 1 unset if this were possessified.
pattern (a|ab){0,4}c
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
n "b"
n "ab"
n "abab"
n "ababab"
m "ac" 0 2
g 1 0 1
m "aac" 0 3
g 1 1 2
m "aaac" 0 4
g 1 2 3
m "aaaac" 0 5
g 1 3 4
m "aaaaac" 1 6
g 1 4 5
m "c" 0 1
g 1 -1 -1
m "bc" 1 2
g 1 -1 -1
m "abc" 0 3
g 1 0 2
m "aabc" 0 4
g 1 1 3
n "za"
n "zaa"
n "zaaa"
n "zaaaa"
m "zac" 1 3
g 1 1 2
m "zaac" 1 4
g 1 2 3
m "zaaac" 1 5
g 1 3 4
n "q"
n "aq"
m "abc" 0 3
g 1 0 2
m "ababc" 0 5
g 1 2 4
n "abab"
m "abababc" 0 7
g 1 4 6

# DECLINE, (U1), the same ambiguity spelled the other way round. §2.4's
# "one thing v1 got right by accident": this family passed the first
# differential only because its follow set had no follow beginning with the
# body's SECOND byte.
pattern (?:ab|a){0,4}b
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
m "b" 0 1
m "ab" 0 2
m "abab" 0 4
m "ababab" 0 6
n "ac"
n "aac"
n "aaac"
n "aaaac"
n "aaaaac"
n "c"
m "bc" 0 1
m "abc" 0 2
m "aabc" 0 3
n "za"
n "zaa"
n "zaaa"
n "zaaaa"
n "zac"
n "zaac"
n "zaaac"
n "q"
n "aq"
m "abb" 0 3
m "ababb" 0 5
m "aab" 0 3
m "abab" 0 4

# DECLINE, (U2) not prefix-free -- and it needs no alternation at all. The
# body is one-unambiguous; its accepting position `a` (with `b?` matching
# empty) simply has an outgoing edge. `(?:ab?){0,4}b` on "ab" is (0,2)
# greedy and NO MATCH possessive.
pattern (?:ab?){0,4}b
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
m "b" 0 1
m "ab" 0 2
m "abab" 0 4
m "ababab" 0 6
n "ac"
n "aac"
n "aaac"
n "aaaac"
n "aaaaac"
n "c"
m "bc" 0 1
m "abc" 0 2
m "aabc" 0 3
n "za"
n "zaa"
n "zaaa"
n "zaaaa"
n "zac"
n "zaac"
n "zaaac"
n "q"
n "aq"
m "ab" 0 2
m "abab" 0 4
m "abb" 0 3
m "aab" 0 3

# DECLINE, nullable body. §2.3's chain is strictly increasing only because
# the body consumes; a nullable body has no chain.
pattern (?:a|){0,4}c
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
n "b"
n "ab"
n "abab"
n "ababab"
m "ac" 0 2
m "aac" 0 3
m "aaac" 0 4
m "aaaac" 0 5
m "aaaaac" 1 6
m "c" 0 1
m "bc" 1 2
m "abc" 2 3
m "aabc" 3 4
n "za"
n "zaa"
n "zaaa"
n "zaaaa"
m "zac" 1 3
m "zaac" 1 4
m "zaaac" 1 5
n "q"
n "aq"

# DECLINE, nullable body with a capture -- §5.3 names `(|a){m,n}` as its
# own dense cell because R24 measured it as the family where the ORACLES
# disagree (python vs libpcre2 on 106 of 15,600 cells, all of them this
# shape's captures). Every expectation here agreed three ways or it is not
# in this file.
pattern (|a){2,4}c
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
n "b"
n "ab"
n "abab"
n "ababab"
m "ac" 0 2
# ^ SPAN ONLY: the two oracles disagree on this
#   cell's group 1 (python ((1, 1),), libpcre2 ((0, 1),)) and
#   this is the `(|a){m,n}` family [R24 S-F5]
#   measured as the one where they do. pcrec agreed
#   with libpcre2 on all 15,600 cells of that sweep,
#   so the slot is not pinned here rather than pinned
#   to whichever oracle was asked first.
m "aac" 0 3
g 1 1 2
m "aaac" 0 4
g 1 2 3
m "aaaac" 0 5
g 1 3 4
m "aaaaac" 1 6
g 1 4 5
m "c" 0 1
g 1 0 0
m "bc" 1 2
g 1 1 1
m "abc" 2 3
g 1 2 2
m "aabc" 3 4
g 1 3 3
n "za"
n "zaa"
n "zaaa"
n "zaaaa"
m "zac" 1 3
# ^ SPAN ONLY: the two oracles disagree on this
#   cell's group 1 (python ((2, 2),), libpcre2 ((1, 2),)) and
#   this is the `(|a){m,n}` family [R24 S-F5]
#   measured as the one where they do. pcrec agreed
#   with libpcre2 on all 15,600 cells of that sweep,
#   so the slot is not pinned here rather than pinned
#   to whichever oracle was asked first.
m "zaac" 1 4
g 1 2 3
m "zaaac" 1 5
g 1 3 4
n "q"
n "aq"

# DECLINE, overlapping follow. FIRST(body) meets FOLLOW, so a retreat can
# genuinely help.
pattern a{0,4}a
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 4
m "aaaaa" 0 5
n "b"
m "ab" 0 1
m "abab" 0 1
m "ababab" 0 1
m "ac" 0 1
m "aac" 0 2
m "aaac" 0 3
m "aaaac" 0 4
m "aaaaac" 0 5
n "c"
n "bc"
m "abc" 0 1
m "aabc" 0 2
m "za" 1 2
m "zaa" 1 3
m "zaaa" 1 4
m "zaaaa" 1 5
m "zac" 1 2
m "zaac" 1 3
m "zaaac" 1 4
n "q"
m "aq" 0 1

# DECLINE, SUBSUMED follow -- §2.7's named conservatism. FOLLOW contains
# `b` because of the `b?`, and a `b` at any retreat position was already
# consumable by the loop, so the retreat cannot actually help. PCRE2's
# auto-possessification does this subsumption reasoning; pcrec's first
# version deliberately does not, and this cell is what that costs.
pattern [ab]{0,4}b?c
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
n "b"
n "ab"
n "abab"
n "ababab"
m "ac" 0 2
m "aac" 0 3
m "aaac" 0 4
m "aaaac" 0 5
m "aaaaac" 1 6
m "c" 0 1
m "bc" 0 2
m "abc" 0 3
m "aabc" 0 4
n "za"
n "zaa"
n "zaaa"
n "zaaaa"
m "zac" 1 3
m "zaac" 1 4
m "zaaac" 1 5
n "q"
n "aq"
m "abbc" 0 4
m "abc" 0 3
m "bbc" 0 3
m "abbbc" 0 5

# DECLINE, `^` in the follow. An assertion reached at the follow's first
# position widens FOLLOW to all bytes: `^` is DOWNWARD-closed, so a retreat
# CAN reach a position satisfying it from one that does not (80 of 240
# diverging cells on the panel's instrument).
pattern a{0,4}^
m "" 0 0
m "a" 0 0
m "aa" 0 0
m "aaa" 0 0
m "aaaa" 0 0
m "aaaaa" 0 0
m "b" 0 0
m "ab" 0 0
m "abab" 0 0
m "ababab" 0 0
m "ac" 0 0
m "aac" 0 0
m "aaac" 0 0
m "aaaac" 0 0
m "aaaaac" 0 0
m "c" 0 0
m "bc" 0 0
m "abc" 0 0
m "aabc" 0 0
m "za" 0 0
m "zaa" 0 0
m "zaaa" 0 0
m "zaaaa" 0 0
m "zac" 0 0
m "zaac" 0 0
m "zaaac" 0 0
m "q" 0 0
m "aq" 0 0


# ======================================================================
# THE LAZY CONJUNCT'S GUARD CELLS
# ======================================================================

# THE LAZY CONJUNCT'S OWN GUARD CELLS (D47.6, ruled into this corpus).
# 
# These are the cells a regressed lazy conjunct would miscompile. The
# remainder is NULLABLE -- the match can simply END at the quantifier -- so
# the follow's first-byte test is VACUOUS and the disjointness argument
# says nothing. A greedy loop is unharmed (it tops out at the chain's top,
# where the vacuous follow succeeds anyway); a LAZY loop stops at the
# BOTTOM of the same chain and reports a shorter span.
# 
# `a{1,3}?` on "aaaa" is (0,1) lazy and (0,3) possessive: 316 measured
# diverging cells, python and libpcre2 agreeing [R24 S-F1].
# 
# The `z`-prefixed rows are the D47.6 lesson itself. The design lane's own
# sweep reported these as twenty FALSE declines; pulling them for
# inspection showed all twenty GENUINELY diverge, and the reason the sweep
# could not see it is that its random-subject alphabet was "abcd " -- so
# every z-prefixed pattern was swept essentially without its prefix. A
# generator whose alphabet omits a pattern character measures the
# generator.
pattern a{1,3}?
n ""
m "a" 0 1
m "aa" 0 1
m "aaa" 0 1
m "aaaa" 0 1
m "aaaaa" 0 1
n "b"
m "ab" 0 1
m "abab" 0 1
m "ababab" 0 1
m "ac" 0 1
m "aac" 0 1
m "aaac" 0 1
m "aaaac" 0 1
m "aaaaac" 0 1
n "c"
n "bc"
m "abc" 0 1
m "aabc" 0 1
m "za" 1 2
m "zaa" 1 2
m "zaaa" 1 2
m "zaaaa" 1 2
m "zac" 1 2
m "zaac" 1 2
m "zaaac" 1 2
n "q"
m "aq" 0 1

