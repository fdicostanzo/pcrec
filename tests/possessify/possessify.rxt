n "aaa"
n "aaaa"
n "aaaaa"
n "b"
n "ab"
n "abab"
n "ababab"
n "ac"
n "aac"
n "aaac"
n "aaaac"
n "aaaaac"
n "c"
n "bc"
n "abc"
n "aabc"
m "za" 0 2
m "zaa" 0 2
m "zaaa" 0 2
m "zaaaa" 0 2
m "zac" 0 3
m "zaac" 0 2
m "zaaac" 0 2
n "q"
n "aq"

# The GREEDY spelling of the same shape, which possessifies: the conjunct
# is scoped to lazy and provably does not disturb the family that was
# already clean (§2.4's v3 greedy rows are byte-identical to v2's).
pattern a{1,3}
n ""
m "a" 0 1
m "aa" 0 2
m "aaa" 0 3
m "aaaa" 0 3
m "aaaaa" 0 3
n "b"
m "ab" 0 1
m "abab" 0 1
m "ababab" 0 1
m "ac" 0 1
m "aac" 0 2
m "aaac" 0 3
m "aaaac" 0 3
m "aaaaac" 0 3
n "c"
n "bc"
m "abc" 0 1
m "aabc" 0 2
m "za" 1 2
m "zaa" 1 3
m "zaaa" 1 4
m "zaaaa" 1 4
m "zac" 1 2
m "zaac" 1 3
m "zaaac" 1 4
n "q"
m "aq" 0 1

# 
pattern za{1,3}
n ""
n "a"
n "aa"
n "aaa"
n "aaaa"
n "aaaaa"
n "b"
n "ab"
n "abab"
n "ababab"
n "ac"
n "aac"
n "aaac"
n "aaaac"
n "aaaaac"
