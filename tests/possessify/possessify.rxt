g 2 2 3
m "babc" 0 4
g 1 0 4
g 2 1 2
m "bbc" 0 3
g 1 0 3
g 2 -1 -1
m "bc" 0 2
g 1 0 2
g 2 -1 -1
m "abbc" 0 4
g 1 0 4
g 2 0 1

# (capture-wrapped) The LAZY inner spelling of the same nesting -- §5.3 makes greedy AND
# lazy mandatory at every shape, because a sweep that spells every shape
# greedy is structurally incapable of exercising the lazy conjunct.
pattern ((?:a{0,2}?b)+c)
m "abc" 0 3
g 1 0 3
m "aabc" 0 4
g 1 0 4
m "ababc" 0 5
g 1 0 5
m "bc" 0 2
g 1 0 2
n "c"
m "aaabc" 1 5
g 1 1 5


# ======================================================================
# THE [ART-POSS-ARMS] WITNESS BLOCKS (docs/design/poss_arms.md rev 2.1:
# 2.4/3.2 refutations, 8.2 sabotage witnesses, 4 the combined witness)
# ======================================================================
# Every block is `# pcre2-only` (python re has no subroutines, duplicate names
# or empty-alternative \b parity) and EVERY expectation below was produced by
# libpcre2 10.46 through the committed ctypes binding
# (docs/design/eng_brep_measurements/probes/pcre2_ctypes.py), run with
# PCRE2_NO_AUTO_POSSESS and again with the default options: the two answers
# agreed in every cell. Each witness is a PAIR of blocks: the GREEDY spelling
# (the one an arm marks or must decline) and its POSSESSIVE spelling, which is
# what a wrongly claimed arm would behave like. The subjects are the witness's
# own plus the shortest ones, found by exhaustive search over the pattern's
# alphabet (length <= 5), on which the two spellings DISAGREE, so a miscompile
# that possessifies the greedy one flips a cell. `engine vm` forces the VM
# (where possessify runs); a capture-free witness would otherwise route to the
# DFA. Not here: (*ACCEPT) and (?|...) witnesses (modules not built), and the
# Latin-1 byte + --ucp caseless-backref cells (K94's to settle).

# A-m0 (greedy): A1 needs m>=1: the e_0 exit has an unknown left character. Greedy (0,1); possessive NOMATCH on ' aa'. [32 discriminating subjects found by exhaustive search]
# pcre2-only
pattern  \w?\b
features all
engine vm
m " aa" 0 1
m "  aa" 1 2
m " aa " 0 1
m " aaa" 0 1
m " a" 0 2
m "  a" 1 3
n ""
n " "

# A-m0 (possessive spelling): A1 needs m>=1: the e_0 exit has an unknown left character. Greedy (0,1); possessive NOMATCH on ' aa'.
# pcre2-only
pattern  \w?+\b
features all
engine vm
n " aa"
n "  aa"
n " aa "
n " aaa"
m " a" 0 2
m "  a" 1 3
n ""
n " "

# A-firstpol (greedy): polarity is read from LAST(X), not FIRST(X). [3 discriminating subjects found by exhaustive search]
# pcre2-only
pattern (?:a\.)+\b
features all
engine vm
m "a.a." 0 2
m "aa.a." 1 3
m "a.a.." 0 2
m ".a.a." 1 3
m "a.a" 0 2
m "aa.a" 1 3
n ""
n "a"

# A-firstpol (possessive spelling): polarity is read from LAST(X), not FIRST(X).
