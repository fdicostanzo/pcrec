features all
engine vm
n "abxa"
n "abx"
n ""
n "a"

# B-depth (possessive spelling): B-depth: the cyclic references COMPILE (the depth guard terminates).
# pcre2-only
pattern (a\2)(b\1)x++\1
features all
engine vm
n "abxa"
n "abx"
n ""
n "a"

# B-depth, BRANCHING cycle (lane possbuild): a group referencing two groups
# that each reference it back. Its compile is bounded only by the capture
# fact's IN-PROGRESS guard -- without it PCREC_MAX_POSS_REF_DEPTH still ends
# every chain, but a branching cycle explores 2^64 paths first (sabotage
# S602's witness: the compile times out). Matches nothing (every reference is
# unset when first read); libpcre2 10.46 via the ctypes binding, both
# spellings, every subject below: no match.
# pcre2-only
pattern (a\2\3)(b\1)(c\1)x+\1
features all
engine vm
n "axa"
n "abcxa"
n "axxa"
n ""

# combo-doubled-word (greedy): the combined witness: A1 on \w+ and B on \s+; frameless. [0 discriminating subjects found by exhaustive search]
# pcre2-only
pattern \b(\w+)\b\s+\1\b
features all
engine vm
m "the the cat" 0 7
g 1 0 3
m "the  the" 0 8
g 1 0 3
m "a the the" 2 9
g 1 2 5
m "a a" 0 3
g 1 0 1
m "b b" 0 3
g 1 0 1
n ""
n "a"

# combo-doubled-word (possessive spelling): the combined witness: A1 on \w+ and B on \s+; frameless.
# pcre2-only
pattern \b(\w++)\b\s++\1\b
features all
engine vm
m "the the cat" 0 7
g 1 0 3
m "the  the" 0 8
g 1 0 3
m "a the the" 2 9
g 1 2 5
m "a a" 0 3
g 1 0 1
m "b b" 0 3
g 1 0 1
n ""
n "a"

# A-fold-utf (greedy): wordness is read on the FOLDED code-point class: (?i)k folds to {k,K,U+212A}, U+212A is not \w without UCP. 10.46 utf,i: k+\b on k<U+212A> is (0,1); k++\b NOMATCH.
# pcre2-only
pattern k+\b
features all
flags i
encoding utf8
engine vm
m "k" 0 1
m "k\xe2\x84\xaa" 0 1
n "\xe2\x84\xaa"
m "kk" 0 2
m "kK" 0 2
m "K\xe2\x84\xaa" 0 1
m "kk\xe2\x84\xaak" 0 6
m "k." 0 1
m "kK." 0 2

# A-fold-utf (possessive spelling): wordness is read on the FOLDED code-point class: (?i)k folds to {k,K,U+212A}, U+212A is not \w without UCP. 10.46 utf,i: k+\b on k<U+212A> is (0,1); k++\b NOMATCH.
# pcre2-only
pattern k++\b
features all
flags i
encoding utf8
engine vm
m "k" 0 1
n "k\xe2\x84\xaa"
n "\xe2\x84\xaa"
m "kk" 0 2
m "kK" 0 2
n "K\xe2\x84\xaa"
m "kk\xe2\x84\xaak" 0 6
m "k." 0 1
m "kK." 0 2
