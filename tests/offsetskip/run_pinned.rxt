# tests/offsetskip/run_pinned.rxt — [OPT-LITSCAN] S1, the RUN-PINNED
# prefilter rows (docs/design/litscan_s1.md §3.4's witness file).
#
# The run rows verify the pattern's necessary run as ONE compare inside the
# `<p>_ofsskip` block at the offset the walk pins it to, and G1 then elides
# the run pre-check. Both are answer-identity-preserving by construction
# (§3.1, §3.3); this file is the ARITHMETIC where it can be wrong: the run at
# the subject's start and end, a candidate whose run would end exactly at n,
# a scan hit whose run fails at every occurrence, a run straddling startpos,
# the empty subject, the bounded twins under a view or word context, the C1
# shapes (a model verify beside the run term), a VM hybrid consuming the row,
# and caseless patterns, whose folded letters are never run singletons.
# tests/codegen/run_offset_skip.sh and run_prechecks.sh §5.10 check that the
# patterns here really take the rows; a case here passes as well on a pattern
# that got no row, which is why both files name the same patterns.
#
# ORACLE: python3 `re` via tests/harness/verify_rxt.py; every expectation was
# written by running it. The NULL-subject obligation is not expressible in a
# `.rxt` (an empty subject here has a non-NULL pointer); the loop guard that
# closes it is asserted on the emitted text by run_offset_skip.sh §2.

# ---- router: class B, the scan at offset 0 --------------------------------
pattern /user|/users
m "/user" 0 5
m "/users" 0 5
m "a/users" 1 6
m "xx/user" 2 7
m "/usa/usb/use/user" 12 17
n "/use"
n "/usa/usb/usc"
n "/USER"
n ""
n "/"
ms 1 "/user/user" 5 10
ns 2 "a/user"
ms 1 "a/user" 1 6

# ---- the bounded twins: a view / a word context ----------------------------
pattern /user$
features assertions
m "/user" 0 5
m "x/user" 1 6
m "/user\n" 0 5
n "/users"
n "/use"
n ""

pattern /user\z
features assertions
m "a/user" 1 6
n "/user\n"
n "/user/"

pattern foo\b
features assertions
m "foo" 0 3
m "a foo" 2 5
m "foofoo foo" 3 6
n "food"
n "fo"
n ""

pattern foo\B
features assertions
m "food" 0 3
m "foo food" 4 7
n "foo"
n "foo foo"

# ---- C1: the model's own scan offset is the run's member ------------------
pattern [ab]/user
features classes
m "a/user" 0 6
m "xb/user" 1 7
n "c/user"
n "xxa/us"
n "a/usa/usb"
m "a/usb/user" 4 10
ms 1 "a/user b/user" 7 13

# ---- a VM hybrid consuming the row: \K is VM-only -------------------------
pattern a\K/user
features assertions
m "a/user" 1 6
m "ba/user" 2 7
n "xxa/us"
n "b/user"

# ---- caseless: folded letters are two-member sets, never run bytes --------
pattern (?i)/1234
features modifiers
m "/1234" 0 5
m "x/1234" 1 6
n "/123"

pattern (?i)x/1234
features modifiers
m "x/1234" 0 6
m "X/1234" 0 6
m "aX/1234" 1 7
n "y/1234"
n "X/123"

# ---- C0: the run is pinned, but not where the scan runs --------------------
# The walk's singletons spell `/abcd` at 0 and `/user` at 6; the run `/user`
# is pinned at 6, the offset-0 memchr byte `/` is not its scan member there,
# so no run row applies (clause 3). A pin that ignored the BYTES would take
# the first all-singleton window (offset 0) and compare `/user` there,
# losing every match — sabotage row (g)'s witness, litscan_s1.md §7.1.
pattern /abcd[xy]/user
features classes
m "/abcdx/user" 0 11
m "a/abcdy/user" 1 12
n "/abcdz/user"
n "/user"
