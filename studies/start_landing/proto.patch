  * carries both a stay skip and an edge, and no seed target is a head on a
  * machine whose prefilter reseeds — and they are worth having precisely
  * because they cannot share a source with what they check. */
+/* ==== [START-LANDING] PROTOTYPE PROBE (studies/start_landing/proto.patch) ====
+ * NOT A BUILD PATH. Prints, per forward form derivation, the facts the
+ * design's two RECOVER rows read, when PCREC_LANDPROBE is set. */
+#define LP_MAXW 4096
+typedef struct {
+    const Nfa *nfa; uint8_t *seen; unsigned gen; int *stack;
+    long budget;
+    const unsigned char *scls;   /* [rev 2, SL-G2] the seam's start_cls; NULL = every byte starts */
+    int maxdepth;                /* deepest mid-character frontier reached */
+} LpWalk;
+
+/* EXACT closure of `seeds`: N_CLASS members into cur[], accept reached on an
+ * assertion-free epsilon path -> *acc; any assertion node reached -> *asrt
+ * (not passed: an assertion makes the walk decline, never widen). */
+static int lp_close(LpWalk *w, const int *seeds, int ns, int *cur, bool *acc, bool *asrt)
+{
+    int sp = 0, nc = 0;
+    if (++w->gen == 0) { memset(w->seen, 0, (size_t)w->nfa->n * sizeof *w->seen); w->gen = 1; }
+    *acc = false; *asrt = false;
+    for (int i = 0; i < ns; i++) {
+        int s = seeds[i];
+        if (s < 0 || s >= w->nfa->n || w->seen[s] == (uint8_t)w->gen) continue;
+        w->seen[s] = (uint8_t)w->gen; w->stack[sp++] = s;
+    }
+    while (sp > 0) {
+        int s = w->stack[--sp];
+        const NState *st = &w->nfa->st[s];
+        int nx[2], nn = 0;
+        switch (st->k) {
+        case N_CLASS: cur[nc++] = s; break;
+        case N_ACCEPT: *acc = true; break;
+        case N_SPLIT: nx[nn++] = st->t1; nx[nn++] = st->t2; break;
+        case N_EPS: nx[nn++] = st->t1; break;
+        case N_BOT: case N_EOL: case N_END: case N_BOT_M: case N_EOL_M:
+        case N_CTX: case N_GSTART: case N_CSTART:
+            *asrt = true; break;
+        }
+        for (int i = 0; i < nn; i++) {
+            int t = nx[i];
+            if (t < 0 || t >= w->nfa->n || w->seen[t] == (uint8_t)w->gen) continue;
+            w->seen[t] = (uint8_t)w->gen; w->stack[sp++] = t;
+        }
+    }
+    return nc;
+}
+
+static int lp_cmp(const void *a, const void *b) { int x = *(const int *)a, y = *(const int *)b; return (x > y) - (x < y); }
+
+/* One-CHARACTER dead-or-accept from frontier `cur` at byte depth `depth`.
+ * Returns NULL on success, else the decline reason. */
+static const char *lp_char(LpWalk *w, const int *cur, int nc, int depth, bool mb)
+{
+    if (depth > w->maxdepth) w->maxdepth = depth;
+    if (--w->budget < 0) return "budget";
+    int n = w->nfa->n;
+    int *seeds = malloc(sizeof(int) * (size_t)(nc ? nc : 1));
+    int *nxt = malloc(sizeof(int) * (size_t)n);
+    /* distinct successor seed lists, deduped per frontier */
+    int **done = malloc(sizeof(int *) * 256); int *dlen = malloc(sizeof(int) * 256); int nd = 0;
+    const char *why = NULL;
+    for (int b = 0; b < 256 && !why; b++) {
+        int ns = 0;
+        for (int i = 0; i < nc; i++)
+            if (cls_has(w->nfa->st[cur[i]].cls, (unsigned)b)) seeds[ns++] = w->nfa->st[cur[i]].t1;
+        if (ns == 0) continue;                       /* dead on b */
+        qsort(seeds, (size_t)ns, sizeof(int), lp_cmp);
+        int dup = 0;
+        for (int k = 0; k < nd && !dup; k++)
+            if (dlen[k] == ns && !memcmp(done[k], seeds, sizeof(int) * (size_t)ns)) dup = 1;
+        if (dup) continue;
+        done[nd] = malloc(sizeof(int) * (size_t)ns); memcpy(done[nd], seeds, sizeof(int) * (size_t)ns); dlen[nd++] = ns;
+        bool acc, asrt;
+        int nn = lp_close(w, seeds, ns, nxt, &acc, &asrt);
+        if (acc) continue;                           /* unconditional accept */
+        if (asrt) { why = "assert-after"; break; }
+        if (nn == 0) continue;                       /* dead */
+        /* alive, not accepted: only mid-character under a multibyte enc */
+        /* [rev 2, SL-G2] mid-character iff every live state reads only bytes
+         * the seam's start_cls does NOT admit; the depth is bounded by the walk
+         * (a frontier deeper than the NFA has states is a cycle: decline) */
+        if (!mb || depth >= w->nfa->n) { why = "alive-not-accept"; break; }
+        for (int i = 0; i < nn && !why; i++)
+            for (int c = 0; c < 256; c++)
+                if (cls_has(w->nfa->st[nxt[i]].cls, (unsigned)c) && cls_has(w->scls, (unsigned)c)) { why = "alive-not-accept"; break; }
+        if (why) break;
+        int *cp = malloc(sizeof(int) * (size_t)nn); memcpy(cp, nxt, sizeof(int) * (size_t)nn);
+        why = lp_char(w, cp, nn, depth + 1, mb);
+        free(cp);
+    }
+    for (int k = 0; k < nd; k++) free(done[k]);
+    free(done); free(dlen); free(seeds); free(nxt);
+    return why;
+}
+
+/* THE LANDING FACT (design §2): NULL when it holds, else the reason. */
+static const char *lp_land_fact(const Nfa *nfa, const unsigned char *scls, unsigned onebyte_max,
+                                int *hi, int *maxdepth)
+{
+    bool mb = scls != NULL;
+    *hi = 0; *maxdepth = 0;
+    if (nfa->n <= 0 || nfa->anch_start < 0) return "no-nfa";
+    LpWalk w = { nfa, calloc((size_t)nfa->n, 1), 0, malloc(sizeof(int) * (size_t)nfa->n * 2 + 8), 200000, scls, 0 };
+    int *cur = malloc(sizeof(int) * (size_t)nfa->n);
+    bool acc, asrt; int seed = nfa->anch_start;
+    int nc = lp_close(&w, &seed, 1, cur, &acc, &asrt);
+    const char *why = NULL;
+    if (acc) why = "nullable";
+    else if (asrt) why = "assert-at-start";
+    else if (nc == 0) why = "empty";
+    /* [rev 2] the guard's condition (SL-G2): a first byte above the seam's
+     * one-byte repertoire -- read before any decline, it is a census column */
+    for (int i = 0; i < nc; i++)
+        for (unsigned c = onebyte_max + 1; c < 256; c++)
+            if (cls_has(nfa->st[cur[i]].cls, c)) *hi = 1;
+    if (!why && mb)
+        for (int i = 0; i < nc && !why; i++)
+            for (int c = 0; c < 256; c++)
+                if (cls_has(nfa->st[cur[i]].cls, (unsigned)c) && !cls_has(scls, (unsigned)c)) { why = "cont-in-start-set"; break; }
+    if (!why) why = lp_char(&w, cur, nc, 0, mb);
+    *maxdepth = w.maxdepth;
+    free(cur); free(w.seen); free(w.stack);
+    return why;
+}
+
+/* THE FIXED BYTE WIDTH: W >= 0 when every path from anch_start to accept has
+ * exactly W bytes (assertions PASSED: zero-width, a superset of paths), else -1. */
+static long lp_fixed_width(const Nfa *nfa)
+{
+    if (nfa->n <= 0 || nfa->anch_start < 0) return -1;
+    int n = nfa->n;
+    uint8_t *seen = calloc((size_t)n, 1); int *stack = malloc(sizeof(int) * (size_t)n * 2 + 8);
+    int *cur = malloc(sizeof(int) * (size_t)n), *seeds = malloc(sizeof(int) * (size_t)n);
+    int ns = 1; seeds[0] = nfa->anch_start; long W = -1;
+    for (long j = 0; j <= n + 1 && j <= LP_MAXW; j++) {
+        memset(seen, 0, (size_t)n);
+        int sp = 0, nc = 0; bool acc = false;
+        for (int i = 0; i < ns; i++) if (!seen[seeds[i]]) { seen[seeds[i]] = 1; stack[sp++] = seeds[i]; }
+        while (sp > 0) {
+            int s = stack[--sp]; const NState *st = &nfa->st[s]; int nx[2], nn = 0;
+            switch (st->k) {
+            case N_CLASS: cur[nc++] = s; break;
+            case N_ACCEPT: acc = true; break;
+            case N_SPLIT: nx[nn++] = st->t1; nx[nn++] = st->t2; break;
+            default: nx[nn++] = st->t1; break;  /* every assertion and N_EPS: passed */
+            }
+            for (int i = 0; i < nn; i++) { int t = nx[i]; if (t >= 0 && t < n && !seen[t]) { seen[t] = 1; stack[sp++] = t; } }
+        }
+        if (acc) { W = (nc == 0) ? j : -1; break; }
+        if (nc == 0) break;
+        ns = 0;
+        for (int i = 0; i < nc; i++) seeds[ns++] = nfa->st[cur[i]].t1;
+    }
+    free(seen); free(stack); free(cur); free(seeds);
+    return W;
+}
+
+/* [rev 2, SL-G3] THE BYTE WIDTH INTERVAL [bmin, bmax] from ONE union-frontier
+ * iterator (assertions PASSED, a superset of paths): bmin = the first depth
+ * whose frontier reaches accept, bmax = the last (-1 when a frontier is
+ * still live past the NFA's state count: a cycle, unbounded). W = bmin when
+ * bmin == bmax. */
+static void lp_width_interval(const Nfa *nfa, long *bmin, long *bmax)
+{
+    *bmin = -1; *bmax = -1;
+    if (nfa->n <= 0 || nfa->anch_start < 0) return;
+    int n = nfa->n;
+    uint8_t *seen = calloc((size_t)n, 1); int *stack = malloc(sizeof(int) * (size_t)n * 2 + 8);
+    int *cur = malloc(sizeof(int) * (size_t)n), *seeds = malloc(sizeof(int) * (size_t)n);
+    int ns = 1; seeds[0] = nfa->anch_start; long last = -1; bool bounded = false;
+    for (long j = 0; j <= n + 1 && j <= LP_MAXW; j++) {
+        memset(seen, 0, (size_t)n);
+        int sp = 0, nc = 0; bool acc = false;
+        for (int i = 0; i < ns; i++) if (!seen[seeds[i]]) { seen[seeds[i]] = 1; stack[sp++] = seeds[i]; }
+        while (sp > 0) {
+            int s = stack[--sp]; const NState *st = &nfa->st[s]; int nx[2], nn = 0;
+            switch (st->k) {
+            case N_CLASS: cur[nc++] = s; break;
+            case N_ACCEPT: acc = true; break;
+            case N_SPLIT: nx[nn++] = st->t1; nx[nn++] = st->t2; break;
+            default: nx[nn++] = st->t1; break;
+            }
+            for (int i = 0; i < nn; i++) { int t = nx[i]; if (t >= 0 && t < n && !seen[t]) { seen[t] = 1; stack[sp++] = t; } }
+        }
+        if (acc) { if (*bmin < 0) *bmin = j; last = j; }
+        if (nc == 0) { bounded = true; break; }
+        ns = 0;
+        for (int i = 0; i < nc; i++) seeds[ns++] = nfa->st[cur[i]].t1;
+    }
+    *bmax = bounded ? last : -1;
+    free(seen); free(stack); free(cur); free(seeds);
+}
+
+static void lp_probe(Ctx *cx, const Dfa *d, const CandRow *pf)
+{
+    if (!getenv("PCREC_LANDPROBE") || d != &cx->job->dfa) return;
+    const PcrecEnc *enc = pcrec_enc_by_id(cx->opt->encoding);
+    bool mb = enc->start_cls != NULL;
+    int hi, ldepth; long bmin, bmax;
+    const char *lf = lp_land_fact(&cx->job->nfa, enc->start_cls, enc->onebyte_max, &hi, &ldepth);
+    long W = lp_fixed_width(&cx->job->nfa);
+    lp_width_interval(&cx->job->nfa, &bmin, &bmax);
+    bool seeded = dfa_needs_seed(d) || d->s1u[UPC_PLAIN] != d->s0;
+    for (int u = 0; u < d->natoms; u++) if (d->s1g[u] != d->s1u[u]) seeded = true;
+    fprintf(stderr, "LANDPROBE\troute=%s\tfit=%s\tnext=%s\tseeded=%d\tland=%s\tfixedw=%ld\trecover=%s\tmb=%d\tbmin=%ld\tbmax=%ld\thi=%d\tldepth=%d\tdecode=%d\n",
+            CAND_ROUTE_NAME(cand_route_of(cx)),
+            cx->job->fit.chosen == ENGM_DFA ? "dfa" : "vm", pf->tok, seeded,
+            lf ? lf : "OK", W, dfa_search_start_of(cx)->tok, mb, bmin, bmax, hi, ldepth,
+            (int)pcrec_enc_has_entry(enc, PCREC_ENCE_DECODE));
+}
+/* ==== end PROTOTYPE PROBE ==== */
